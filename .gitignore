web/.pagefind-site/
web/public/pagefind/

# Local scratch (screenshots, etc.)
tmp/
tmp-*/
.iter-logs/

# Local dogfood scratch (screenshots, recordings) — never commit
artifacts/
!Packages/Shared/BreeAgentChat/Sources/BreeAgentChat/Artifacts/
!Packages/Shared/BreeAgentChat/Sources/BreeAgentChat/Artifacts/*.swift
!Packages/iOS/BreeAgentChatUI/Sources/BreeAgentChatUI/Artifacts/
