    "settings.automation.cursor.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hooks must be installed with `bree hooks cursor install`. They no-op outside Bree terminals."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フックは`bree hooks cursor install`でインストールする必要があります。Breeターミナル外では動作しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "`bree hooks cursor install`로 훅을 설치해야 합니다. Bree 터미널 외부에서는 작동하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "必须用 `bree hooks cursor install` 安装钩子。它们在 Bree 终端之外不生效。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hooks müssen mit `bree hooks cursor install` installiert werden. Sie haben außerhalb von Bree-Terminals keine Funktion (no-op)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les hooks doivent être installés avec `bree hooks cursor install`. Ils n’ont aucun effet en dehors des terminaux Bree."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب تثبيت الخطافات باستخدام `bree hooks cursor install`. وهي لا تؤدي أي وظيفة خارج طرفيات Bree."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ganchos se deben instalar con `bree hooks cursor install`. No realizan ninguna operación fuera de las terminales de Bree."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "必須透過 `bree hooks cursor install` 安裝 Hook。它們在 Bree 終端機外不會執行任何操作。"
          }
        }
      }
    },
