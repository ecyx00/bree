    "remote.disconnectBanner.reconnectHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] اضغط على Enter لإعادة الاتصال. ستظل هذه الطرفية غير متصلة حتى تقوم بذلك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "new",
            "value": "[Bree] Press Enter to reconnect. This terminal will stay disconnected until then."
          }
        },
        "da": {
          "stringUnit": {
            "state": "new",
            "value": "[Bree] Press Enter to reconnect. This terminal will stay disconnected until then."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Drücken Sie die Eingabetaste, um die Verbindung wiederherzustellen. Dieses Terminal bleibt bis dahin getrennt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Press Enter to reconnect. This terminal will stay disconnected until then."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Presiona Enter para volver a conectar. Esta terminal permanecerá desconectada hasta entonces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Appuyez sur Entrée pour vous reconnecter. Ce terminal restera déconnecté d'ici là."
          }
        },
        "it": {
          "stringUnit": {
            "state": "new",
            "value": "[Bree] Press Enter to reconnect. This terminal will stay disconnected until then."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Enter キーを押すと再接続します。それまではこのターミナルは切断されたままです。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "new",
            "value": "[Bree] Press Enter to reconnect. This terminal will stay disconnected until then."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] 다시 연결하려면 Enter 키를 누르세요. 그전까지 이 터미널은 연결되지 않은 상태로 유지됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "new",
            "value": "[Bree] Press Enter to reconnect. This terminal will stay disconnected until then."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "new",
            "value": "[Bree] Press Enter to reconnect. This terminal will stay disconnected until then."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "new",
            "value": "[Bree] Press Enter to reconnect. This terminal will stay disconnected until then."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "new",
            "value": "[Bree] Press Enter to reconnect. This terminal will stay disconnected until then."
          }
        },
        "th": {
          "stringUnit": {
            "state": "new",
            "value": "[Bree] Press Enter to reconnect. This terminal will stay disconnected until then."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "new",
            "value": "[Bree] Press Enter to reconnect. This terminal will stay disconnected until then."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "new",
            "value": "[Bree] Press Enter to reconnect. This terminal will stay disconnected until then."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] 按 Enter 重新连接。在此之前，此终端将保持断开状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] 按 Enter 鍵重新連線。在此之前，此終端機將保持斷線狀態。"
          }
        }
      }
    },
    "remote.disconnectBanner.reconnectUnavailableHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] أعد توصيل مساحة العمل هذه من الشريط الجانبي أو شغّل أمر Bree البعيد الأصلي مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Ponovo povežite ovaj radni prostor iz bočne trake ili ponovo pokrenite originalnu Bree udaljenu naredbu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Genopret forbindelsen til dette arbejdsområde fra sidepanelet, eller kør den oprindelige Bree-fjernkommando igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Verbinde diesen Arbeitsbereich über die Seitenleiste erneut oder führe den ursprünglichen Bree-Remote-Befehl noch einmal aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Reconnect this workspace from the sidebar or by running the original bree remote command again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Vuelve a conectar este espacio de trabajo desde la barra lateral o ejecuta de nuevo el comando remoto original de Bree."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Reconnectez cet espace de travail depuis la barre latérale ou relancez la commande distante Bree d'origine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Riconnetti questo spazio di lavoro dalla barra laterale oppure esegui di nuovo il comando remoto Bree originale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] サイドバーからこのワークスペースを再接続するか、元の Bree リモートコマンドをもう一度実行してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] ភ្ជាប់កន្លែងធ្វើការនេះឡើងវិញពីរបារចំហៀង ឬដំណើរការពាក្យបញ្ជា Bree ពីចម្ងាយដើមម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] 사이드바에서 이 워크스페이스를 다시 연결하거나 원래 Bree 원격 명령을 다시 실행하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Koble til dette arbeidsområdet på nytt fra sidefeltet, eller kjør den opprinnelige Bree-fjernkommandoen på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Połącz ponownie ten obszar roboczy z paska bocznego albo ponownie uruchom oryginalne polecenie zdalne Bree."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Reconecte este espaço de trabalho pela barra lateral ou execute novamente o comando remoto original do Bree."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Повторно подключите это рабочее пространство из боковой панели или снова выполните исходную удаленную команду Bree."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] เชื่อมต่อพื้นที่ทำงานนี้ใหม่จากแถบด้านข้าง หรือเรียกใช้คำสั่งรีโมต Bree เดิมอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Bu çalışma alanını kenar çubuğundan yeniden bağlayın veya özgün Bree uzak komutunu tekrar çalıştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Повторно підключіть цей робочий простір із бічної панелі або ще раз запустіть початкову віддалену команду Bree."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] 请从边栏重新连接此工作区，或再次运行原始 Bree 远程命令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] 請從側邊欄重新連接此工作區，或再次執行原始 Bree 遠端命令。"
          }
        }
      }
    },
