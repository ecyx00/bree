    "browser.repl.auth.embedded": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu form, %2$@ sayfasındaki %1$@ kaynaklı bir çerçevede yer alıyor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This form is in a frame from %1$@, inside a page from %2$@."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا النموذج داخل إطار من %1$@، ضمن صفحة من %2$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Formular ist in einem Frame von %1$@, innerhalb einer Seite von %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este formulario está en un marco de %1$@, dentro de una página de %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce formulaire se trouve dans un cadre de %1$@, à l’intérieur d’une page de %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォームは %2$@ のページ内にある %1$@ のフレームにあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 양식은 %2$@ 페이지 안에 있는 %1$@ 프레임에 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此表单位于来自 %2$@ 的网页中、来自 %1$@ 的框架内。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此表單位於來自 %2$@ 的網頁中、來自 %1$@ 的框架內。"
          }
        }
      }
    },
    "browser.repl.auth.notice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An agent asked Bree to fill this sign-in form. The agent does not receive what you type, but scripts on the page, and code the agent runs in the page, can read the filled fields."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طلب وكيل من Bree تعبئة نموذج تسجيل الدخول هذا. لا يتلقى الوكيل ما تكتبه، لكن البرامج النصية في الصفحة، والتعليمات البرمجية التي يشغلها الوكيل في الصفحة، يمكنها قراءة الحقول المعبأة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Agent hat Bree gebeten, dieses Anmeldeformular auszufüllen. Der Agent erhält nicht, was du eingibst, aber Skripte der Seite und Code, den der Agent in der Seite ausführt, können die ausgefüllten Felder lesen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un agente pidió a Bree que rellene este formulario de inicio de sesión. El agente no recibe lo que escribes, pero los scripts de la página y el código que el agente ejecuta en la página pueden leer los campos rellenados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un agent a demandé à Bree de remplir ce formulaire de connexion. L’agent ne reçoit pas ce que vous saisissez, mais les scripts de la page, et le code que l’agent exécute dans la page, peuvent lire les champs remplis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントが Bree にこのサインインフォームへの入力を依頼しました。入力した内容はエージェントには送られませんが、ページのスクリプトや、エージェントがページ内で実行するコードは入力済みのフィールドを読み取れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 Bree에 이 로그인 양식을 채우도록 요청했습니다. 에이전트는 입력한 내용을 받지 않지만, 페이지의 스크립트와 에이전트가 페이지에서 실행하는 코드는 채워진 필드를 읽을 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有智能体请求 Bree 填写此登录表单。智能体不会收到你输入的内容，但网页上的脚本以及智能体在网页中运行的代码可以读取已填写的字段。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有代理程式要求 Bree 填寫此登入表單。代理程式不會收到你輸入的內容，但網頁上的指令碼，以及代理程式在網頁中執行的程式碼，可以讀取已填寫的欄位。"
          }
        }
      }
    },
    "browser.repl.auth.requester": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%2$@” çalışma alanındaki “%1$@” sekmesinde çalışan bir aracı tarafından istendi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asked by an agent working in the tab “%1$@” of the workspace “%2$@”."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طلبه وكيل يعمل في علامة التبويب ”%1$@“ في مساحة العمل ”%2$@“."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angefragt von einem Agenten im Tab „%1$@“ des Arbeitsbereichs „%2$@“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo pide un agente que trabaja en la pestaña «%1$@» del espacio de trabajo «%2$@»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandé par un agent qui travaille dans l’onglet « %1$@ » de l’espace de travail « %2$@ »."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークスペース「%2$@」のタブ「%1$@」で作業中のエージェントからの要求です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 공간 “%2$@”의 탭 “%1$@”에서 작업 중인 에이전트가 요청했습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由在工作区“%2$@”的标签页“%1$@”中工作的代理请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由在工作區「%2$@」的分頁「%1$@」中工作的代理請求。"
          }
        }
      }
    },
