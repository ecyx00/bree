    "settings.terminal.ghostty.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These rows show the value in effect and save to Bree's Ghostty config, which loads after your own Ghostty config. The caption under each row is its config key."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعرض هذه الصفوف القيمة السارية وتحفظ في إعدادات Ghostty الخاصة بـ Bree، والتي تُحمَّل بعد إعدادات Ghostty الخاصة بك. التسمية أسفل كل صف هي مفتاح الإعداد الخاص به."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Zeilen zeigen den wirksamen Wert und speichern in die Ghostty-Konfiguration von Bree, die nach deiner eigenen Ghostty-Konfiguration geladen wird. Die Beschriftung unter jeder Zeile ist ihr Konfigurationsschlüssel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas filas muestran el valor en vigor y se guardan en la configuración de Ghostty de Bree, que se carga después de tu propia configuración de Ghostty. El texto bajo cada fila es su clave de configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces lignes affichent la valeur en vigueur et enregistrent dans la configuration Ghostty de Bree, chargée après votre propre configuration Ghostty. La légende sous chaque ligne est sa clé de configuration."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの行は現在有効な値を表示し、Bree の Ghostty 設定に保存します。この設定はご自身の Ghostty 設定の後に読み込まれます。各行の下のキャプションはその設定キーです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 행들은 현재 적용 중인 값을 보여 주며, 사용자의 Ghostty 설정 다음에 로드되는 Bree의 Ghostty 설정에 저장됩니다. 각 행 아래의 캡션은 해당 설정 키입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些行显示当前生效的值，并保存到 Bree 的 Ghostty 配置，该配置会在你自己的 Ghostty 配置之后加载。每行下方的说明文字是其配置键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些列顯示目前生效的值，並儲存到 Bree 的 Ghostty 設定，該設定會在你自己的 Ghostty 設定之後載入。每列下方的說明文字是其設定鍵。"
          }
        }
      }
    },
