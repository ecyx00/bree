    "fileExplorer.move.crossVolume.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move to another volume?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir birime taşınsın mı?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf ein anderes Volume verschieben?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacer vers un autre volume ?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد النقل إلى وحدة تخزين أخرى؟"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
