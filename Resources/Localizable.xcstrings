    "cli.hooks.setup.wrapperNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "  (Claude Code and Pi hooks are injected automatically via their Bree wrappers)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "  (يتم حقن خطافات Claude Code وPi تلقائيًا عبر أغلفة Bree)"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "  (Claude Code i Pi kukice se automatski ubacuju putem Bree omotača)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "  (Claude Code- og Pi-hooks indsættes automatisk via deres Bree-wrappere)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "  (Claude-Code- und Pi-Hooks werden automatisch über ihre Bree-Wrapper eingefügt)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "  (Los hooks de Claude Code y Pi se inyectan automáticamente mediante sus wrappers de Bree)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "  (Les hooks de Claude Code et Pi sont injectés automatiquement par leurs wrappers Bree)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "  (Gli hook di Claude Code e Pi vengono iniettati automaticamente tramite i rispettivi wrapper Bree)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "  (Claude Code と Pi のフックは Bree ラッパーによって自動的に注入されます)"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "  (hooks របស់ Claude Code និង Pi ត្រូវបានបញ្ចូលដោយស្វ័យប្រវត្តិតាមរយៈ wrapper របស់ Bree)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "  (Claude Code 및 Pi 훅은 Bree 래퍼를 통해 자동으로 주입됩니다)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "  (Claude Code- og Pi-hooker settes inn automatisk via Bree-innpakningene)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "  (Hooki Claude Code i Pi są automatycznie wstrzykiwane przez ich opakowania Bree)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "  (Os hooks do Claude Code e do Pi são injetados automaticamente pelos respectivos wrappers do Bree)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "  (Хуки Claude Code и Pi автоматически внедряются их оболочками Bree)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "  (hooks ของ Claude Code และ Pi จะถูกฉีดโดยอัตโนมัติผ่าน wrapper ของ Bree)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "  (Claude Code ve Pi kancaları, Bree sarmalayıcıları aracılığıyla otomatik olarak eklenir)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "  (Хуки Claude Code і Pi автоматично додаються їхніми обгортками Bree)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "  （Claude Code 和 Pi 的钩子会通过各自的 Bree 包装器自动注入）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "  （Claude Code 和 Pi 的掛鉤會透過各自的 Bree 包裝器自動注入）"
          }
        }
      }
    },
