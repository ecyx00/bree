    "settings.app.warnBeforeClosingWorkspace.subtitleOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Workspaces close immediately without confirmation. Pinned workspaces still ask."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُغلق مساحات العمل فورًا دون تأكيد. لا تزال مساحات العمل المثبتة تطلب التأكيد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arbeitsbereiche werden sofort und ohne Bestätigung geschlossen. Angepinnte Arbeitsbereiche fragen weiterhin nach."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los espacios de trabajo se cierran inmediatamente sin confirmación. Los espacios de trabajo fijados siguen pidiendo confirmación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les espaces de travail se ferment immédiatement sans confirmation. Les espaces de travail épinglés demandent toujours."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認なしにすぐワークスペースを閉じます。ピン留めされたワークスペースは引き続き確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인 창 없이 워크스페이스가 즉시 닫힙니다. 고정된 워크스페이스는 계속 확인합니다."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Робочі області закриваються одразу без підтвердження. Закріплені робочі області все одно запитують."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作区会直接关闭，不做确认。已固定的工作区仍会确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作區將立即關閉，無需確認。釘選的工作區仍會確認。"
          }
        }
      }
    },
    "settings.app.warnBeforeClosingWorkspace.subtitleOn": {
