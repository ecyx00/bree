    "settings.automation.pi.subtitleOn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidebar shows Pi session status and notifications."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض الشريط الجانبي حالة جلسة Pi والإشعارات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Seitenleiste zeigt den Pi-Sitzungsstatus und Benachrichtigungen an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra lateral muestra el estado de la sesión de Pi y las notificaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La barre latérale affiche le statut de la session Pi et les notifications."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイドバーにPiセッションのステータスと通知が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사이드바에 Pi 세션 상태와 알림이 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "侧边栏显示 Pi 会话状态和通知。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "側邊欄顯示 Pi 工作階段狀態和通知。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bočna traka prikazuje status Pi sesije i obavijesti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidepanelet viser Pi-sessionens status og notifikationer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra laterale mostra lo stato della sessione Pi e le notifiche."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "របារចំហៀងបង្ហាញស្ថានភាពសម័យ Pi និងការជូនដំណឹង។"
