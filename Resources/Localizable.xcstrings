          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用法：bree new-window [--name <标题>]\n\n创建新窗口。\n\n选项：\n  --name <标题>   在显示前设置标题。\n\n示例：\n  Bree new-window\n  Bree new-window --name \"Build server\""
          }
