    "agent.deliveryTarget.error.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delivery target resolution is unavailable; retry after Bree finishes starting."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "配信先の解決を利用できません。Bree の起動が完了してから再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "投递目标解析不可用；请在 Bree 启动完成后重试。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auflösung des Zustellungsziels ist nicht verfügbar; versuchen Sie es erneut, nachdem Bree den Start abgeschlossen hat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La résolution de la cible de livraison est indisponible ; réessayez après le démarrage complet de Bree."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حل هدف التسليم غير متاح؛ أعد المحاولة بعد انتهاء Bree من بدء التشغيل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La resolución del destino de entrega no está disponible; vuelve a intentarlo una vez que Bree termine de iniciarse."
          }
        },
        "zh-Hant": {
