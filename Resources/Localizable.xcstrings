    "browser.profile.new.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a separate browser profile for cookies, history, and local storage."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cookie、履歴、ローカルストレージを分けるためのブラウザープロファイルを作成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쿠키, 방문 기록, 로컬 스토리지를 위한 별도의 브라우저 프로필을 생성합니다."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Створити окремий профіль браузера для cookies, історії та локального сховища."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为 Cookie、历史记录和本地存储创建独立的浏览器配置文件。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellen Sie ein separates Browserprofil für Cookies, Verlauf und lokalen Speicher."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez un profil de navigateur distinct pour les cookies, l'historique et le stockage local."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنشئ ملف تعريف متصفح منفصل لملفات تعريف الارتباط، والسجل، والتخزين المحلي."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un perfil de navegador independiente para cookies, historial y almacenamiento local."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為 Cookie、歷史紀錄和本機儲存空間建立獨立的瀏覽器設定檔。"
          }
        }
      }
    },
