    "dialog.deleteGroup.message.lone": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد حذف المجموعة «%@» وإغلاق مساحة العمل التابعة لها؟"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrisati grupu „%@“ i zatvoriti njen radni prostor?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slet gruppen “%@” og luk dens arbejdsområde?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gruppe „%@“ löschen und ihren Arbeitsbereich schließen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete the group “%@” and close its workspace?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar el grupo «%@» y cerrar su espacio de trabajo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer le groupe « %@ » et fermer son espace de travail ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare il gruppo «%@» e chiudere la sua area di lavoro?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループ「%@」を削除してワークスペースを閉じますか？"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete the group “%@” and close its workspace?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그룹 “%@”을(를) 삭제하고 해당 작업 공간을 닫을까요?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slette gruppen «%@» og lukke arbeidsområdet?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunąć grupę „%@” i zamknąć jej przestrzeń?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir o grupo “%@” e fechar sua área de trabalho?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить группу «%@» и закрыть её рабочее пространство?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบกลุ่ม “%@” และปิดเวิร์กสเปซในนั้นใช่ไหม?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” grubunu silip içindeki çalışma alanını kapatayım mı?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалити групу «%@» та закрити її робочу область?"
          }
