    "settings.automation.rules.createFailed.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check that the configuration folder is writable and the disk has free space, then try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe, ob der Konfigurationsordner beschreibbar ist und genügend Speicherplatz verfügbar ist, und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez que le dossier de configuration est accessible en écriture et que le disque dispose d’espace libre, puis réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقّق من إمكانية الكتابة في مجلد الإعدادات وتوفّر مساحة خالية على القرص، ثم حاول مجددًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba que se puede escribir en la carpeta de configuración y que hay espacio libre en el disco. Después, inténtalo de nuevo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請確認設定資料夾可供寫入且磁碟有可用空間，然後再試一次。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确认配置文件夹可写且磁盘有可用空间，然后重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 폴더에 쓸 수 있고 디스크에 여유 공간이 있는지 확인한 다음 다시 시도하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定フォルダに書き込めることと、ディスクに空き容量があることを確認してから、もう一度お試しください。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Provjerite da li možete pisati u konfiguracijsku mapu i ima li slobodnog prostora na disku, pa pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollér, at der kan skrives til konfigurationsmappen, og at der er ledig plads på disken. Prøv derefter igen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica che la cartella di configurazione sia scrivibile e che il disco abbia spazio libero, quindi riprova."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សូមពិនិត្យថាអាចសរសេរទៅក្នុងថតកំណត់រចនាសម្ព័ន្ធបាន ហើយថាសមានទំហំទំនេរ រួចព្យាយាមម្តងទៀត។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontroller at konfigurasjonsmappen er skrivbar og at disken har ledig plass, og prøv deretter på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź, czy folder konfiguracji umożliwia zapis i czy na dysku jest wolne miejsce, a następnie spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique se é possível gravar na pasta de configuração e se há espaço livre no disco. Depois, tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убедитесь, что папка конфигурации доступна для записи и на диске есть свободное место, затем повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบว่าสามารถเขียนลงในโฟลเดอร์การกำหนดค่าได้และดิสก์มีพื้นที่ว่าง จากนั้นลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapılandırma klasörüne yazılabildiğini ve diskte boş alan bulunduğunu kontrol edip yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переконайтеся, що папка конфігурації доступна для запису й на диску є вільне місце, а потім спробуйте знову."
          }
        }
      }
    },
    "cli.guide.usage": {
