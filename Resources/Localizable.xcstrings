    "socketControl.breeOnly.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط العمليات التي بدأت داخل طرفيات Bree يمكنها إرسال الأوامر."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo procesi pokrenuti unutar Bree terminala mogu slati naredbe."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun processer startet i Bree-terminaler kan sende kommandoer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Prozesse, die in Bree-Terminals gestartet wurden, können Befehle senden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only processes started inside Bree terminals can send commands."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo los procesos iniciados dentro de terminales de Bree pueden enviar comandos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les processus lancés dans les terminaux Bree peuvent envoyer des commandes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo i processi avviati nei terminali Bree possono inviare comandi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree ターミナル内で起動したプロセスのみがコマンドを送信できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree 터미널 내에서 시작된 프로세스만 명령을 보낼 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare prosesser startet innenfor Bree-terminaler kan sende kommandoer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko procesy uruchomione wewnątrz terminali Bree mogą wysyłać polecenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas processos iniciados dentro de terminais do Bree podem enviar comandos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только процессы, запущенные в терминалах Bree, могут отправлять команды."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
