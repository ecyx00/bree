    "dialog.textURL.prompt.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطلب رابط %@:// من Bree لصق مطالبة في مساحة العمل الحالية. لا يمكن لـ Bree التحقق من موقع الويب أو التطبيق الذي فتح هذا الرابط.\n\nسيقوم Bree بلصق النص في الطرفية ولن يضغط على Return. تابع فقط إذا كنت تثق بهذه المطالبة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Veza %@:// traži od Bree da zalijepi prompt u trenutni radni prostor. Bree ne može provjeriti koja je web lokacija ili aplikacija otvorila ovu vezu.\n\nBree će zalijepiti tekst u terminal i neće pritisnuti Return. Nastavite samo ako vjerujete ovom upitu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et %@://-link beder Bree om at indsætte en prompt i det aktuelle arbejdsområde. Bree kan ikke bekræfte, hvilken hjemmeside eller app der åbnede dette link.\n\nBree indsætter teksten i terminalen og vil ikke trykke på Return. Fortsæt kun, hvis du stoler på denne prompt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein %@://-Link fordert Bree auf, eine Eingabeaufforderung in den aktuellen Arbeitsbereich einzufügen. Bree kann nicht überprüfen, welche Website oder App diesen Link geöffnet hat.\n\nBree fügt den Text in das Terminal ein und drückt nicht Return. Fahren Sie nur fort, wenn Sie dieser Aufforderung vertrauen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A %@:// link is asking Bree to paste a prompt into the current workspace. Bree cannot verify which website or app opened this link.\n\nBree will paste the text into the terminal and will not press Return. Only continue if you trust this prompt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un enlace %@:// solicita a Bree que pegue un mensaje en el espacio de trabajo actual. Bree no puede verificar qué sitio web o aplicación abrió este enlace.\n\nBree pegará el texto en el terminal y no presionará Return. Continúe solo si confía en este mensaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lien %@:// demande à Bree de coller une invite dans l'espace de travail actuel. Bree ne peut pas vérifier quel site Web ou quelle application a ouvert ce lien.\n\nBree collera le texte dans le terminal et n'appuiera pas sur Return. Continuez uniquement si vous faites confiance à cette invite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un collegamento %@:// chiede a Bree di incollare un prompt nell'area di lavoro corrente. Bree non può verificare quale sito Web o app ha aperto questo collegamento.\n\nBree incollerà il testo nel terminale e non premerà Return. Continua solo se ti fidi di questo messaggio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:// リンクが現在のワークスペースにプロンプトをペーストするよう Bree に要求しています。Bree は、このリンクを開いた Web サイトやアプリを確認できません。\n\nBree はテキストをターミナルに貼り付け、Return は押しません。このプロンプトを信頼している場合のみ続行してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "តំណ %@:// កំពុងស្នើសុំឱ្យ Bree បិទភ្ជាប់ការជម្រុញទៅក្នុងកន្លែងធ្វើការបច្ចុប្បន្ន។ Bree មិនអាចផ្ទៀងផ្ទាត់គេហទំព័រ ឬកម្មវិធីណាមួយដែលបើកតំណនេះទេ។\n\nBree នឹងបិទភ្ជាប់អត្ថបទទៅក្នុងស្ថានីយ ហើយនឹងមិនចុច Return ទេ។ បន្ត លុះត្រាតែអ្នកជឿជាក់លើការជម្រុញនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:// 링크는 Bree에게 현재 작업 공간에 프롬프트를 붙여넣도록 요청합니다. Bree는 어떤 웹사이트나 앱이 이 링크를 열었는지 확인할 수 없습니다.\n\nBree는 텍스트를 터미널에 붙여넣고 Return를 누르지 않습니다. 이 메시지를 신뢰하는 경우에만 계속하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En %@://-kobling ber Bree om å lime inn en melding i det gjeldende arbeidsområdet. Bree kan ikke bekrefte hvilken nettside eller app som åpnet denne koblingen.\n\nBree vil lime inn teksten i terminalen og vil ikke trykke Return. Fortsett bare hvis du stoler på denne forespørselen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Łącze %@:// prosi Bree o wklejenie podpowiedzi do bieżącego obszaru roboczego. Bree nie może sprawdzić, która witryna lub aplikacja otworzyła ten link.\n\nBree wklei tekst do terminala i nie naciśnie Return. Kontynuuj tylko wtedy, gdy ufasz temu monitowi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um link %@:// está solicitando que Bree cole um prompt no espaço de trabalho atual. Bree não pode verificar qual site ou aplicativo abriu este link.\n\nBree colará o texto no terminal e não pressionará Return. Continue apenas se você confiar neste prompt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылка %@:// просит Bree вставить приглашение в текущую рабочую область. Bree не может проверить, какой веб-сайт или приложение открыло эту ссылку.\n\nBree вставит текст в терминал и не нажмет Return. Продолжайте, только если вы доверяете этой подсказке."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลิงก์ %@:// กำลังขอให้ Bree วางพร้อมต์ลงในพื้นที่ทำงานปัจจุบัน Bree ไม่สามารถตรวจสอบได้ว่าเว็บไซต์หรือแอปใดเปิดลิงก์นี้\n\nBree จะวางข้อความลงในเทอร์มินัลและจะไม่กด Return ดำเนินการต่อเมื่อคุณเชื่อถือข้อความแจ้งนี้เท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir %@:// bağlantısı, Bree'den mevcut çalışma alanına bir bilgi istemi yapıştırmasını istiyor. Bree bu bağlantıyı hangi web sitesinin veya uygulamanın açtığını doğrulayamıyor.\n\nBree, metni terminale yapıştıracak ve Return tuşuna basmayacaktır. Yalnızca bu isteme güveniyorsanız devam edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Посилання %@:// просить Bree вставити підказку в поточну робочу область. Bree не може перевірити, який веб-сайт або додаток відкрив це посилання.\n\nBree вставить текст у термінал і не натисне Return. Продовжуйте, лише якщо ви довіряєте цій підказці."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:// 链接要求 Bree 将提示粘贴到当前工作区中。 Bree 无法验证哪个网站或应用程序打开了此链接。\n\nBree 会将文本粘贴到终端中，并且不会按 Return。仅当您信任此提示时才继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:// 連結要求 Bree 將提示貼到目前工作區。 Bree 無法驗證哪個網站或應用程式開啟了此連結。\n\nBree 會將文字貼到終端機中，不會按 Return。僅當您信任此提示時才繼續。"
          }
        }
      }
    },
