    "cli.localZellij.error.livenessUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "local-zellij could not verify the existing surface; no new client was created"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر على local-zellij التحقق من السطح الحالي؛ لم يتم إنشاء عميل جديد"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "local-zellij konnte die bestehende Oberfläche nicht verifizieren; es wurde kein neuer Client erstellt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "local-zellij no pudo verificar la superficie existente; no se creó ningún cliente nuevo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "local-zellij n'a pas pu vérifier la surface d’affichage existante ; aucun nouveau client n'a été créé"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "local-zellij で既存サーフェスを確認できなかったため、新しいクライアントは作成されませんでした"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "local-zellij가 기존 화면을 확인할 수 없습니다. 새 클라이언트가 생성되지 않았습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "local-zellij 无法验证现有表面；未创建新客户端"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "local-zellij 無法驗證現有的介面；未建立新的用戶端"
          }
        }
      }
    },
