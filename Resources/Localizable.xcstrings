    "forkConversation.destination.bottom.description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechtsklick auf „Konversation forken“ erstellt eine Teilung unter dem aktuellen Bereich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right-click Fork Conversation creates a split below the current pane."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fork Conversation con clic derecho crea una división debajo del panel actual."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右クリックの「会話をフォーク」で現在のペインの下に分割を作成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽 클릭의 Fork Conversation은 현재 패널 아래에 분할을 만듭니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右键点击 Fork Conversation 会在当前窗格下方创建拆分。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "右鍵點按 Fork Conversation 會在目前窗格下方建立分割。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un clic droit sur Bifurquer la conversation crée une division sous le volet actuel."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النقر بزر الماوس الأيمن على تفريع المحادثة ينشئ تقسيمًا أسفل الجزء الحالي."
          }
        }
      }
    },
