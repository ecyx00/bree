          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] ssh avsluttet med status %s; kobler til på nytt (forsøk %s/%s)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] ssh zakończył działanie ze statusem %s; ponowne łączenie (próba %s/%s)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] ssh saiu com status %s; reconectando (tentativa %s/%s)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] ssh завершился со статусом %s; переподключение (попытка %s/%s)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] ssh ออกจากการทำงานด้วยสถานะ %s; กำลังเชื่อมต่อใหม่ (ครั้งที่ %s/%s)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] ssh %s durumuyla çıktı; yeniden bağlanıyor (deneme %s/%s)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
