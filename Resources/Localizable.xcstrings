    "cli.session.move.output.pathsRewritten": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paths were rewritten: %@ -> %@. Absolute paths inside the transcript still name the old home."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paths were rewritten: %@ -> %@. Absolute paths inside the transcript still name the old home."
          }
