    "settings.workspaceColors.dictionaryNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit bree.json to add or remove named colors. \"Choose Custom Color...\" still adds local Custom N entries."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前付きカラーの追加や削除は bree.json を編集してください。「カスタムカラーを選択…」は引き続きローカルの Custom N エントリを追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "bree.json을 편집하여 이름이 지정된 색상을 추가하거나 제거하세요. \"사용자 지정 색상 선택...\"으로 로컬 Custom N 항목을 추가할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑 bree.json 可添加或移除命名颜色。「选取自定义颜色...」仍会添加本地的「自定义 N」条目。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bearbeiten Sie bree.json, um benannte Farben hinzuzufügen oder zu entfernen. \"Benutzerdefinierte Farbe wählen...\" fügt weiterhin lokale Einträge vom Typ \"Custom N\" hinzu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifiez bree.json pour ajouter ou supprimer des couleurs nommées. \"Choisir une couleur personnalisée...\" ajoute toujours des entrées locales Custom N."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتحرير bree.json لإضافة أو إزالة الألوان المسماة. لا يزال \"Choose Custom Color...\" يضيف إدخالات Custom N المحلية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Edita bree.json para añadir o eliminar colores con nombre. \"Choose Custom Color...\" sigue añadiendo entradas locales de Custom N."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編輯 bree.json 以新增或移除命名的顏色。「選擇自訂顏色...」仍會新增本機的「自訂 N」項目。"
          }
        }
      }
    },
    "settings.workspaceColors.emptyPalette": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No palette entries. Add colors in bree.json or use \"Choose Custom Color...\" from a workspace context menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パレット項目はありません。bree.json でカラーを追加するか、ワークスペースのコンテキストメニューから「カスタムカラーを選択…」を使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팔레트 항목이 없습니다. bree.json에서 색상을 추가하거나 워크스페이스 컨텍스트 메뉴의 \"사용자 지정 색상 선택...\"을 사용하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有调色板条目。请在 bree.json 中添加颜色，或在工作区右键菜单中使用「选取自定义颜色...」。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Paletteneinträge. Fügen Sie Farben in bree.json hinzu oder verwenden Sie \"Benutzerdefinierte Farbe wählen...\" aus dem Kontextmenü eines Arbeitsbereichs."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune entrée dans la palette. Ajoutez des couleurs dans bree.json ou utilisez \"Choisir une couleur personnalisée...\" depuis un menu contextuel d'espace de travail."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد عناصر في لوحة الألوان. أضف ألوانًا في bree.json أو استخدم \"Choose Custom Color...\" من القائمة السياقية لمساحة العمل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin entradas de paleta. Añade colores en bree.json o usa \"Choose Custom Color...\" desde el menú contextual de un espacio de trabajo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "調色盤無任何項目。請在 bree.json 中新增顏色，或從工作區右鍵選單中使用「選擇自訂顏色...」"
          }
        }
      }
    },
