          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chemins réécrits : %1$@ -> %2$@. Les chemins absolus de la transcription désignent encore l'ancien dossier personnel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスを書き換えました: %1$@ -> %2$@。トランスクリプト内の絶対パスは古いホームのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "경로를 다시 썼습니다: %1$@ -> %2$@. 트랜스크립트 안의 절대 경로는 여전히 이전 홈을 가리킵니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已改写路径：%1$@ -> %2$@。记录中的绝对路径仍指向旧的主目录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
