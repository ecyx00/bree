    "settings.terminal.colors.reset.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل تجاوزات الألوان هذه فقط. تبقى السمة وبقية الإعدادات كما هي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt nur diese Farbüberschreibungen. Theme und andere Einstellungen bleiben unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes only these color overrides. Your theme and other settings stay as they are."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina solo estas anulaciones de color. El tema y los demás ajustes no cambian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime uniquement ces remplacements de couleur. Votre thème et les autres réglages restent inchangés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの色の上書きだけを削除します。テーマやその他の設定は変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 색상 재정의만 제거합니다. 테마와 다른 설정은 그대로 유지됩니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca bu renk geçersiz kılmalarını kaldırır. Temanız ve diğer ayarlarınız olduğu gibi kalır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅移除这些颜色覆盖项。主题和其他设置保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅移除這些顏色覆寫項。主題和其他設定維持不變。"
          }
        }
      }
    },
    "settings.terminal.colors.saveFailed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حفظ الألوان. يرجى المحاولة مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Farben konnten nicht gespeichert werden. Bitte versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't save the colors. Please try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron guardar los colores. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'enregistrer les couleurs. Veuillez réessayer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "色を保存できませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "색상을 저장하지 못했습니다. 다시 시도해 주세요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renkler kaydedilemedi. Lütfen tekrar deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存颜色。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存顏色。請再試一次。"
          }
        }
      }
    },
    "settings.terminal.colors.selectionBackground": {
      "extractionState": "manual",
