    "browser.import.noBrowsers.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree could not find browser profiles to import from on this Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacでインポート元にできるブラウザープロファイルが見つかりませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 가져올 수 있는 브라우저 프로필을 찾을 수 없습니다."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree не знайшов профілів браузерів для імпорту на цьому Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree 在这台 Mac 上找不到可导入的浏览器配置文件。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree konnte auf diesem Mac keine Browserprofile zum Importieren finden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree n'a trouvé aucun profil de navigateur à importer sur ce Mac."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر على Bree العثور على ملفات تعريف متصفح للاستيراد منها على جهاز Mac هذا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree no pudo encontrar perfiles de navegador desde los cuales importar en este Mac."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree 在這台 Mac 上找不到可供匯入的瀏覽器設定檔。"
          }
        }
      }
    },
