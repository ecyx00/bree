    "cli.sshPtyAttach.retryStatus": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] SSH disconnected (%s); retry %s in %ss; input discarded."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] SSH が切断されました（%s）。%s 回目を %s 秒後に再試行します。入力は破棄されます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
