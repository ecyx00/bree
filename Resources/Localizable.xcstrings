    "settings.browser.autoRestoreUnloadedPages": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore Unloaded Pages Automatically"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entladene Seiten automatisch wiederherstellen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurer automatiquement les pages déchargées"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استعادة الصفحات التي أُلغي تحميلها تلقائيًا"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
