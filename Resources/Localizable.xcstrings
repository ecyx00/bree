    "cli.help.topic.commandUsage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run `bree <command> --help` for command-specific usage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führe `bree <command> --help` für die Hilfe zu einem bestimmten Befehl aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécutez `bree <command> --help` pour l’utilisation détaillée d’une commande."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شغّل `bree <command> --help` لعرض استخدام الأمر المحدد."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecuta `bree <command> --help` para ver el uso específico del comando."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "執行 `bree <command> --help` 以查看特定命令的用法。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行 `bree <command> --help` 查看特定命令的用法。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명령별 사용법은 `bree <command> --help`를 실행하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンド固有の使い方は `bree <command> --help` を実行してください。"
          }
        }
      }
    },
