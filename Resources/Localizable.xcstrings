          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此終端機未在執行，沒有可休眠的內容。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此终端未在运行，没有可休眠的内容。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 터미널은 실행 중이 아니어서 휴면할 대상이 없습니다."
          }
        }
      }
    },
    "agentHibernation.manual.processScopeUnsafe": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This terminal is running other work, such as background jobs, that hibernation would stop."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このターミナルでは、休止すると停止してしまうバックグラウンドジョブなどの作業が実行中です。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diesem Terminal läuft weitere Arbeit, etwa Hintergrundjobs, die das Ruhen beenden würde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce terminal exécute d’autres tâches, comme des tâches en arrière-plan, que la mise en veille arrêterait."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشغّل هذه الطرفية أعمالًا أخرى، مثل مهام الخلفية، سيوقفها السبات."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta terminal está ejecutando otro trabajo, como tareas en segundo plano, que la hibernación detendría."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此終端機正在執行其他工作（例如背景工作），休眠會使其停止。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此终端正在运行其他工作（例如后台任务），休眠会使其停止。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 터미널에서 백그라운드 작업 등 휴면하면 중단될 다른 작업이 실행 중입니다."
          }
        }
      }
    },
    "agentHibernation.manual.recentlyActive": {
      "extractionState": "manual",
