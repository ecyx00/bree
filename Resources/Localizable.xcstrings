        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid --id '%@'. Use letters, digits, '.', '_', or '-' (no spaces)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無効な --id '%@' です。英数字、'.'、'_'、'-' のみ使用できます（空白不可）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잘못된 --id '%@'입니다. 영문자, 숫자, '.', '_', '-'만 사용할 수 있습니다(공백 불가)."
