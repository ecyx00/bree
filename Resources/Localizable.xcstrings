    "settings.terminal.resumeCommands.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review signed command prefixes that can restore non-agent terminal surfaces."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非エージェントのターミナルサーフェスを復元できる署名済みコマンドプレフィックスを確認します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看可用于恢复非代理终端表面的已签名命令前缀。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfen Sie signierte Befehlspräfixe, die Terminal-Oberflächen von Nicht-Agenten wiederherstellen können."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez en revue les préfixes de commande signés qui peuvent restaurer les surfaces d’affichage de terminal autres que celles des agents."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مراجعة بادئات الأوامر الموقعة التي يمكنها استعادة أسطح الطرفيات غير التابعة لوكلاء."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa los prefijos de comandos firmados que pueden restaurar superficies de terminal que no sean de agentes."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢視可還原非代理終端機介面的已簽署指令前綴。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 아닌 터미널 화면을 복원할 수 있는 서명된 명령 접두사를 검토합니다."
          }
        }
      }
    },
