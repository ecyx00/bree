    "browser.externalOpenPrompt.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A web page in Bree wants to open a link in another app. You can stay in the browser instead."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree のウェブページが別のアプリでリンクを開こうとしています。代わりにブラウザに留まることもできます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree 中的网页想在其他应用中打开链接。你也可以留在浏览器中。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Webseite in Bree möchte einen Link in einer anderen App öffnen. Sie können stattdessen im Browser bleiben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une page Web dans Bree souhaite ouvrir un lien dans une autre application. Vous pouvez plutôt rester dans le navigateur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تريد صفحة ويب في Bree فتح رابط في تطبيق آخر. يمكنك البقاء في المتصفح بدلاً من ذلك."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una página web en Bree quiere abrir un enlace en otra aplicación. Puedes permanecer en el navegador en su lugar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree 中的網頁想要在其他應用程式中開啟連結。您也可以選擇留在瀏覽器中。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree의 웹 페이지가 다른 앱에서 링크를 열려고 합니다. 대신 브라우저에 계속 머무를 수 있습니다."
          }
        }
      }
    },
