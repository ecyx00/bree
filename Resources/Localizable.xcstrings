    "cli.hooks.error.configDirectoryCreateFailed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على Bree إنشاء دليل hooks في %@. تحقّق من أذونات الدليل الأصل ثم أعد المحاولة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree nije mogao kreirati direktorij hookova na %@. Provjerite dozvole nadređenog direktorija i pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree kunne ikke oprette hookmappen på %@. Kontrollér tilladelserne for den overordnede mappe, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree konnte das Hook-Verzeichnis unter %@ nicht erstellen. Prüfe die Berechtigungen des übergeordneten Verzeichnisses und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree could not create the hooks directory at %@. Check the parent directory permissions and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree no pudo crear el directorio de hooks en %@. Comprueba los permisos del directorio superior e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree n’a pas pu créer le dossier des hooks à l’emplacement %@. Vérifiez les autorisations du dossier parent et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree non è riuscito a creare la directory degli hook in %@. Controlla i permessi della directory principale e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree は %@ に hooks ディレクトリを作成できませんでした。親ディレクトリの権限を確認して、もう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree មិនអាចបង្កើតថត hooks នៅ %@ បានទេ។ ពិនិត្យសិទ្ធិរបស់ថតមេ ហើយព្យាយាមម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree가 %@에 hooks 디렉터리를 만들지 못했습니다. 상위 디렉터리 권한을 확인한 후 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree kunne ikke opprette hookmappen på %@. Kontroller tillatelsene for den overordnede mappen og prøv på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree nie mógł utworzyć katalogu hooków w %@. Sprawdź uprawnienia katalogu nadrzędnego i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Bree não conseguiu criar o diretório de hooks em %@. Verifique as permissões do diretório pai e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree не удалось создать каталог хуков по пути %@. Проверьте разрешения родительского каталога и повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree ไม่สามารถสร้างไดเรกทอรี hooks ที่ %@ ได้ โปรดตรวจสอบสิทธิ์ของไดเรกทอรีหลักแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree %@ konumunda hooks dizinini oluşturamadı. Üst dizinin izinlerini kontrol edip yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree не вдалося створити каталог хуків за шляхом %@. Перевірте дозволи батьківського каталогу та повторіть спробу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree 无法在 %@ 创建 hooks 目录。请检查父目录权限，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree 無法在 %@ 建立 hooks 目錄。請檢查上層目錄權限，然後再試一次。"
          }
        }
      }
    },
    "cli.hooks.error.configDirectoryIsFile": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على Bree إنشاء دليل hooks: يوجد ملف في %@. أزل الملف المتعارض أو أعد تسميته، ثم شغّل `bree hooks setup` مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree nije mogao kreirati direktorij hookova: datoteka postoji na %@. Uklonite ili preimenujte konfliktnu datoteku, a zatim ponovo pokrenite `bree hooks setup`."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree kunne ikke oprette hookmappen: der findes en fil på %@. Fjern eller omdøb filen, og kør derefter `bree hooks setup` igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree konnte das Hook-Verzeichnis nicht erstellen: Unter %@ ist bereits eine Datei vorhanden. Entferne die Datei oder benenne sie um und führe dann `bree hooks setup` erneut aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree could not create the hooks directory: a file exists at %@. Remove or rename the conflicting file, then run `bree hooks setup` again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree no pudo crear el directorio de hooks: ya existe un archivo en %@. Elimina o cambia el nombre del archivo en conflicto y vuelve a ejecutar `bree hooks setup`."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree n’a pas pu créer le dossier des hooks : un fichier existe à l’emplacement %@. Supprimez ou renommez ce fichier, puis relancez `bree hooks setup`."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree non è riuscito a creare la directory degli hook: esiste già un file in %@. Rimuovi o rinomina il file in conflitto, quindi esegui di nuovo `bree hooks setup`."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree は hooks ディレクトリを作成できませんでした。%@ にファイルがあります。競合するファイルを削除または名前変更してから `bree hooks setup` を再実行してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree មិនអាចបង្កើតថត hooks បានទេ៖ មានឯកសារមួយនៅ %@។ លុប ឬប្តូរឈ្មោះឯកសារដែលប៉ះទង្គិច រួចដំណើរការ `bree hooks setup` ម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree가 hooks 디렉터리를 만들지 못했습니다. %@에 파일이 있습니다. 충돌하는 파일을 제거하거나 이름을 바꾼 다음 `bree hooks setup`을 다시 실행하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree kunne ikke opprette hookmappen: det finnes en fil på %@. Fjern eller gi nytt navn til filen, og kjør deretter `bree hooks setup` på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree nie mógł utworzyć katalogu hooków: w %@ istnieje plik. Usuń plik powodujący konflikt lub zmień jego nazwę, a następnie ponownie uruchom `bree hooks setup`."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Bree não conseguiu criar o diretório de hooks: existe um arquivo em %@. Remova ou renomeie o arquivo conflitante e execute `bree hooks setup` novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree не удалось создать каталог хуков: по пути %@ уже существует файл. Удалите или переименуйте этот файл, затем снова выполните `bree hooks setup`."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree ไม่สามารถสร้างไดเรกทอรี hooks ได้ เนื่องจากมีไฟล์อยู่ที่ %@ โปรดลบหรือเปลี่ยนชื่อไฟล์ที่ขัดแย้ง แล้วเรียกใช้ `bree hooks setup` อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "bree hooks dizinini oluşturamadı: %@ konumunda bir dosya var. Çakışan dosyayı kaldırın veya yeniden adlandırın, ardından `bree hooks setup` komutunu tekrar çalıştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree не вдалося створити каталог хуків: за шляхом %@ вже існує файл. Видаліть або перейменуйте цей файл, а потім знову виконайте `bree hooks setup`."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree 无法创建 hooks 目录：%@ 处已有文件。请移除或重命名冲突文件，然后再次运行 `bree hooks setup`。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree 無法建立 hooks 目錄：%@ 已有檔案。請移除或重新命名衝突的檔案，然後再次執行 `bree hooks setup`。"
          }
        }
      }
    },
    "cli.hooks.error.pinnedTargetMissing": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على Bree ربط تثبيت الـ hooks هذا بتطبيق قيد التشغيل. افتح مساحة عمل في Bree وشغّل هذا الأمر مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree nije mogao povezati ovu instalaciju hookova s pokrenutom aplikacijom. Otvorite Bree radni prostor i ponovo pokrenite ovu naredbu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree kunne ikke forbinde denne hookinstallation med en kørende app. Åbn et Bree-arbejdsområde, og kør kommandoen igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree konnte diese Hook-Installation nicht mit einer laufenden App verbinden. Öffne einen Bree-Arbeitsbereich und führe diesen Befehl erneut aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree could not connect this hook installation to a running app. Open a Bree workspace and run this command again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree no pudo conectar esta instalación de hooks con una aplicación en ejecución. Abre un espacio de trabajo de Bree y vuelve a ejecutar este comando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree n’a pas pu relier cette installation de hooks à une application en cours d’exécution. Ouvrez un espace de travail Bree et relancez cette commande."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree non è riuscito a collegare questa installazione di hook a un’app in esecuzione. Apri uno spazio di lavoro Bree ed esegui di nuovo questo comando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree はこの hook のインストールを実行中のアプリに接続できませんでした。Bree ワークスペースを開き、このコマンドをもう一度実行してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree មិនអាចភ្ជាប់ការដំឡើង hooks នេះទៅកម្មវិធីដែលកំពុងដំណើរការបានទេ។ បើក workspace ក្នុង Bree ហើយដំណើរការពាក្យបញ្ជានេះម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree가 이 훅 설치를 실행 중인 앱에 연결하지 못했습니다. Bree 작업 공간을 열고 이 명령을 다시 실행하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree kunne ikke koble denne hookinstallasjonen til en app som kjører. Åpne et Bree-arbeidsområde og kjør kommandoen på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree nie mógł połączyć tej instalacji hooków z uruchomioną aplikacją. Otwórz obszar roboczy Bree i uruchom to polecenie ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Bree não conseguiu conectar esta instalação de hooks a um aplicativo em execução. Abra um espaço de trabalho do Bree e execute este comando novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree не удалось связать эту установку хуков с запущенным приложением. Откройте рабочее пространство Bree и выполните эту команду снова."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree ไม่สามารถเชื่อมต่อการติดตั้ง hooks นี้กับแอปที่กำลังทำงานอยู่ได้ เปิดพื้นที่ทำงาน Bree แล้วเรียกใช้คำสั่งนี้อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree bu hook kurulumunu çalışan bir uygulamaya bağlayamadı. Bir Bree çalışma alanı açın ve bu komutu yeniden çalıştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree не вдалося пов’язати це встановлення хуків із запущеною програмою. Відкрийте робочий простір Bree і виконайте цю команду ще раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree 无法将此 hooks 安装连接到正在运行的应用。请打开一个 Bree 工作区，然后再次运行此命令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree 無法將此 hooks 安裝連接到執行中的應用程式。請開啟 Bree 工作區，然後再次執行此命令。"
          }
        }
      }
    },
