    "cli.fork.error.execveFailed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: لا يمكن بدء العملية المحفوظة. أعد محاولة أمر الشوكة المرئية."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: Sačuvani proces nije moguće pokrenuti. Ponovo pokrenite prikazanu fork naredbu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: Den gemte proces kunne ikke startes. Kør den viste fork-kommando igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: Der gespeicherte Prozess konnte nicht gestartet werden. Führen Sie den angezeigten Fork-Befehl erneut aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: the saved process could not be started. Retry the visible fork command."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: No se pudo iniciar el proceso guardado. Vuelva a intentar el comando de bifurcación visible."
