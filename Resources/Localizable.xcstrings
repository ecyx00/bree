    "cli.workflow.docs-workspace.instantiate.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the Docs Workspace recipe, replace the docs command, Markdown path, and preview URL, merge it into bree.json, then run bree reload-config."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Vorlage Docs Workspace öffnen, Dokumentationsbefehl, Markdown-Pfad und Vorschau-URL ersetzen, in bree.json übernehmen und Bree reload-config ausführen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez la recette Docs Workspace, remplacez la commande de documentation, le chemin Markdown et l’URL d’aperçu, ajoutez-la à bree.json, puis exécutez Bree reload-config."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la receta Docs Workspace, sustituye el comando de documentación, la ruta Markdown y la URL de vista previa, incorpórala en bree.json y ejecuta Bree reload-config."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح وصفة Docs Workspace، واستبدل أمر التوثيق ومسار Markdown وعنوان URL للمعاينة، وأضفها إلى bree.json، ثم شغّل Bree reload-config."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Docs Workspace 配方，替换文档命令、Markdown 路径和预览 URL，合并到 bree.json，然后运行 Bree reload-config。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟 Docs Workspace 配方，替換文件命令、Markdown 路徑和預覽 URL，合併到 bree.json，然後執行 Bree reload-config。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Docs Workspace 설정 예제를 열고 문서 명령, Markdown 경로, 미리보기 URL을 교체한 뒤 bree.json에 병합하고 Bree reload-config를 실행하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Docs Workspace レシピを開き、ドキュメントのコマンド、Markdown パス、プレビュー URL を変更し、bree.json に追加して Bree reload-config を実行します。"
          }
        }
      }
    },
