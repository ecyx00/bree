    "socket.agentMessage.error.notSaved": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The message was not sent: Bree could not save it to the message journal."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم إرسال الرسالة: تعذّر على Bree حفظها في سجل الرسائل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Nachricht wurde nicht gesendet: Bree konnte sie nicht im Nachrichtenjournal speichern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mensaje no se envió: Bree no pudo guardarlo en el registro de mensajes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le message n’a pas été envoyé : Bree n’a pas pu l’enregistrer dans le journal des messages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージは送信されませんでした: Bree がメッセージジャーナルに保存できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시지를 보내지 못했습니다: Bree가 메시지 저널에 저장하지 못했습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "消息未发送：Bree 无法将其保存到消息日志。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訊息未傳送：Bree 無法將其儲存到訊息日誌。"
          }
        }
      }
    },
