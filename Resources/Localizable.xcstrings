          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sustituye las rutas, comandos, URL, nombres de herramientas y ubicaciones de ejemplo por los de este repositorio."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將範例路徑、指令、URL、工具名稱與位置替換為此儲存庫的值。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将示例路径、命令、URL、工具名称和位置替换为此存储库的值。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예시 경로, 명령, URL, 도구 이름과 배치를 이 저장소의 값으로 바꿉니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "例のパス、コマンド、URL、ツール名、配置をこのリポジトリの値に置き換えます。"
          }
        }
      }
    },
    "cli.workflow.guidance.validate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Validate the JSON or JSONC, run bree reload-config, and check the resulting entry point."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Validiere JSON oder JSONC, führe Bree reload-config aus und prüfe den resultierenden Einstiegspunkt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Validez le JSON ou JSONC, exécutez Bree reload-config et vérifiez le point d’accès obtenu."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من JSON أو JSONC، وشغّل Bree reload-config، ثم افحص نقطة الدخول الناتجة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Valida el JSON o JSONC, ejecuta Bree reload-config y comprueba el punto de entrada resultante."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "驗證 JSON 或 JSONC，執行 Bree reload-config，並檢查產生的入口。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证 JSON 或 JSONC，运行 Bree reload-config，并检查生成的入口。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON 또는 JSONC를 검증하고 Bree reload-config를 실행한 뒤 결과 진입점을 확인합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON または JSONC を検証し、bree reload-config を実行して生成された入口を確認します。"
          }
        }
      }
    },
    "cli.workflow.guidance.save": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the workspace looks right, save it with bree layout save <name> --description \"<what this creates>\"."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn der Workspace passt, speichere ihn mit Bree layout save <name> --description \"<what this creates>\"."
          }
        },
        "fr": {
