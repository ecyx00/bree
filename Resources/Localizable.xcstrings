    "cli.workflow.review-pr.instantiate.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the Review PR recipe, point its command and URL at the repository's review flow, merge it into bree.json, then run bree reload-config."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Vorlage Review PR öffnen, Befehl und URL an den Review-Ablauf des Repositorys anpassen, in bree.json übernehmen und Bree reload-config ausführen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez la recette Review PR, adaptez sa commande et son URL au processus de revue du dépôt, ajoutez-la à bree.json, puis exécutez Bree reload-config."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la receta Review PR, adapta su comando y URL al proceso de revisión del repositorio, incorpórala en bree.json y ejecuta Bree reload-config."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح وصفة Review PR، وعدّل الأمر وعنوان URL ليتوافقا مع سير المراجعة في المستودع، وأضفها إلى bree.json، ثم شغّل Bree reload-config."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Review PR 配方，将命令和 URL 指向仓库的审查流程，合并到 bree.json，然后运行 Bree reload-config。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟 Review PR 配方，將命令和 URL 指向儲存庫的審查流程，合併到 bree.json，然後執行 Bree reload-config。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Review PR 설정 예제를 열고 명령과 URL을 저장소의 검토 흐름에 맞춘 뒤 bree.json에 병합하고 Bree reload-config를 실행하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Review PR レシピを開き、コマンドと URL をリポジトリのレビュー手順に合わせ、bree.json に追加して Bree reload-config を実行します。"
          }
        }
      }
    },
