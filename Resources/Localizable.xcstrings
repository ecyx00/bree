    "settings.terminal.tabBarFontSize.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Controls the font size of the terminal and browser tab titles at the top of each pane."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ペーン上部のターミナルとブラウザのタブタイトルのフォントサイズを調整します。"
          }
