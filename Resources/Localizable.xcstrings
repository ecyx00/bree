    "dock.error.loadFailed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحميل إعدادات Dock. تحقق من dock.json وحاول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
