    "socket.mainActorHop.timeout.mayHaveRun": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree did not respond within 10 seconds after the command started, so its result is unknown. Check the effect before retrying."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドの開始後 10 秒以内に Bree が応答しなかったため、結果は不明です。再試行する前に効果を確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "命令开始后 10 秒内 Bree 没有响应，因此结果未知。请先确认效果再重试。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree hat innerhalb von 10 Sekunden nach dem Start des Befehls nicht geantwortet, das Ergebnis ist daher unbekannt. Prüfe die Auswirkung, bevor du es erneut versuchst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree n’a pas répondu dans les 10 secondes suivant le démarrage de la commande, son résultat est donc inconnu. Vérifiez l’effet avant de réessayer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يستجب Bree خلال 10 ثوانٍ بعد بدء الأمر، لذا فإن نتيجته غير معروفة. تحقق من الأثر قبل إعادة المحاولة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree no respondió en los 10 segundos posteriores al inicio del comando, por lo que su resultado es desconocido. Comprueba el efecto antes de reintentar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "命令開始後 10 秒內 Bree 沒有回應，因此結果未知。請先確認效果再重試。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명령이 시작된 후 10초 안에 Bree가 응답하지 않아 결과를 알 수 없습니다. 다시 시도하기 전에 효과를 확인하세요."
          }
        }
      }
    },
    "socket.mainActorHop.timeout.notRun": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree did not respond within 10 seconds, so the command was not run. Retry in a moment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree が 10 秒以内に応答しなかったため、コマンドは実行されませんでした。しばらくしてから再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree 在 10 秒内没有响应，因此未运行该命令。请稍后重试。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree hat innerhalb von 10 Sekunden nicht geantwortet, der Befehl wurde daher nicht ausgeführt. Versuche es gleich noch einmal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree n’a pas répondu dans les 10 secondes, la commande n’a donc pas été exécutée. Réessayez dans un instant."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يستجب Bree خلال 10 ثوانٍ، لذا لم يتم تنفيذ الأمر. أعد المحاولة بعد لحظات."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree no respondió en 10 segundos, por lo que el comando no se ejecutó. Reintenta en un momento."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree 在 10 秒內沒有回應，因此未執行該命令。請稍後重試。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree가 10초 안에 응답하지 않아 명령이 실행되지 않았습니다. 잠시 후 다시 시도하세요."
          }
        }
      }
    },
    "socket.overloaded.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree is handling too many control-socket requests right now, so this one was not run. Retry in a moment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree は現在、制御ソケットの要求を処理しきれないため、この要求は実行されませんでした。しばらくしてから再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree 当前正在处理过多的控制套接字请求，因此未运行此请求。请稍后重试。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree verarbeitet gerade zu viele Control-Socket-Anfragen, diese wurde daher nicht ausgeführt. Versuche es gleich noch einmal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree traite actuellement trop de requêtes du socket de contrôle, celle-ci n’a donc pas été exécutée. Réessayez dans un instant."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعالج Bree حاليًا عددًا كبيرًا جدًا من طلبات مقبس التحكم، لذا لم يتم تنفيذ هذا الطلب. أعد المحاولة بعد لحظات."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree está gestionando demasiadas solicitudes del socket de control ahora mismo, por lo que esta no se ejecutó. Reintenta en un momento."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree 目前正在處理過多的控制 socket 請求，因此未執行此請求。請稍後重試。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree가 지금 너무 많은 제어 소켓 요청을 처리하고 있어 이 요청은 실행되지 않았습니다. 잠시 후 다시 시도하세요."
          }
        }
      }
    },
    "socket.request.cancelled": {
