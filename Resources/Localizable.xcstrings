    "cli.sshPtyAttach.reconciliationUnavailableReattach": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The SSH terminal connection ended before the remote session state could be confirmed; preserving the remote session for reconnection."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモートセッションの状態を確認できる前に SSH ターミナル接続が終了しました。再接続のためセッションを維持します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 终端连接在远程会话状态确认前就已结束；将保留该远程会话以便重连。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die SSH-Terminal-Verbindung endete, bevor der Status der Remote-Sitzung bestätigt werden konnte; die Remote-Sitzung wird für eine erneute Verbindung beibehalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion SSH du terminal s’est terminée avant que l’état de la session distante n’ait pu être confirmé ; conservation de la session distante pour reconnexion."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهى اتصال طرفية SSH قبل تأكيد حالة الجلسة البعيدة؛ سيتم الحفاظ على الجلسة البعيدة لإعادة الاتصال."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Finalizó la conexión de terminal SSH antes de que pudiera confirmarse el estado de la sesión remota; se conserva la sesión remota para la reconexión."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在確認遠端工作階段狀態前，SSH 終端機連線已結束；保留遠端工作階段以便重新連線。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원격 세션 상태를 확인하기 전에 SSH 터미널 연결이 종료되었습니다. 재연결을 위해 원격 세션을 보존합니다."
          }
        }
      }
    },
    "cli.sshPtyAttach.remoteSessionLostRespawn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] remote session was lost; starting a new shell."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] リモートセッションが失われました。新しいシェルを開始します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] 远程会话已丢失；正在启动新的 shell。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Remote-Sitzung ging verloren; eine neue Shell wird gestartet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] la session distante a été perdue ; démarrage d’un nouveau shell."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] فُقدت الجلسة البعيدة؛ يجري بدء شل جديد."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] se perdió la sesión remota; iniciando un nuevo shell."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] 遠端工作階段已遺失；正在啟動新的 Shell。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] 원격 세션이 유실되었습니다. 새로운 셸을 시작합니다."
          }
        }
      }
    },
    "cli.sshSessionList.remoteStateUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote PTY session state is unavailable for one or more workspaces."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 つ以上のワークスペースでリモート PTY セッションの状態を取得できません。"
