          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’hôte ou l’utilisateur SSH ne peut pas commencer par un tiret."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن أن يبدأ مضيف أو مستخدم SSH بشرطة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El usuario o host SSH no puede comenzar con un guion."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 主機或使用者不能以減號開頭。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 호스트 또는 사용자는 대시(-)로 시작할 수 없습니다."
          }
        }
      }
    },
