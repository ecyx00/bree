    "settings.terminal.inlineSuggestions.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show the most recent matching history line in grey after the cursor while typing in zsh. Press Right Arrow at the end of the line to accept it. Applies to new terminals."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "zsh での入力中、最も新しく一致した履歴行をカーソルの後ろにグレーで表示します。行末で右矢印キーを押すと確定します。新しいターミナルに適用されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt beim Tippen in zsh den neuesten passenden Verlaufseintrag grau hinter dem Cursor an. Mit der Pfeiltaste nach rechts am Zeilenende übernimmst du ihn. Gilt für neue Terminals."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche en gris, après le curseur, la ligne d’historique correspondante la plus récente pendant la saisie dans zsh. Appuyez sur la flèche droite en fin de ligne pour l’accepter. S’applique aux nouveaux terminaux."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض أحدث سطر مطابق من السجل باللون الرمادي بعد المؤشر أثناء الكتابة في zsh. اضغط على السهم الأيمن في نهاية السطر لقبوله. ينطبق على الطرفيات الجديدة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra en gris, tras el cursor, la línea de historial coincidente más reciente mientras escribes en zsh. Pulsa la flecha derecha al final de la línea para aceptarla. Se aplica a las terminales nuevas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 zsh 中输入时，以灰色在光标后显示最近一条匹配的历史记录。在行尾按右方向键即可接受。对新终端生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 zsh 中輸入時，以灰色在游標後顯示最近一筆符合的歷史記錄。在行尾按右方向鍵即可接受。對新終端機生效。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "zsh에서 입력하는 동안 가장 최근에 일치한 기록 줄을 커서 뒤에 회색으로 표시합니다. 줄 끝에서 오른쪽 화살표를 누르면 적용됩니다. 새 터미널에 적용됩니다."
          }
        }
      }
    },
