    "controlSocket.reportShellState.invalidTerminalLifecycleID": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ERROR: Terminal session is out of date; restart the shell and try again"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エラー: ターミナルセッションが古いため、シェルを再起動してもう一度お試しください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "错误：终端会话已过期；请重启 shell 后重试"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "FEHLER: Terminal-Sitzung ist veraltet; starten Sie die Shell neu und versuchen Sie es erneut"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ERREUR : La session du terminal est obsolète ; redémarrez le shell et réessayez"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خطأ: جلسة الطرفية منتهية الصلاحية؛ أعد تشغيل مفسر الأوامر وحاول مجددًا"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ERROR: La sesión de la terminal está desactualizada; reinicia la shell e inténtalo de nuevo"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錯誤：終端機工作階段已過期；請重新啟動 Shell 並重試"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오류: 터미널 세션이 만료되었습니다. 셸을 다시 시작하고 다시 시도하세요."
          }
        }
      }
    },
