    "dialog.textURL.rules.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطلب رابط %@:// من Bree لصق القواعد في مساحة العمل الحالية. لا يمكن لـ Bree التحقق من موقع الويب أو التطبيق الذي فتح هذا الرابط.\n\nسيقوم Bree بلصق القواعد في الطرفية ولن يقوم بكتابة الملفات أو الضغط على Return. استمر فقط إذا كنت تثق بهذه القواعد."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:// link traži od Bree da zalijepi pravila u trenutni radni prostor. Bree ne može provjeriti koja je web lokacija ili aplikacija otvorila ovu vezu.\n\nBree će zalijepiti pravila u terminal i neće pisati datoteke niti pritisnuti Return. Nastavite samo ako vjerujete ovim pravilima."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et %@://-link beder Bree om at indsætte regler i det aktuelle arbejdsområde. Bree kan ikke bekræfte, hvilken hjemmeside eller app der åbnede dette link.\n\nBree indsætter reglerne i terminalen og vil ikke skrive filer eller trykke på Return. Fortsæt kun, hvis du stoler på disse regler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein %@://-Link fordert Bree auf, Regeln in den aktuellen Arbeitsbereich einzufügen. Bree kann nicht überprüfen, welche Website oder App diesen Link geöffnet hat.\n\nBree fügt die Regeln in das Terminal ein, schreibt keine Dateien und drückt auch nicht Return. Fahren Sie nur fort, wenn Sie diesen Regeln vertrauen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A %@:// link is asking Bree to paste rules into the current workspace. Bree cannot verify which website or app opened this link.\n\nBree will paste the rules into the terminal and will not write files or press Return. Only continue if you trust these rules."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un enlace %@:// solicita a Bree que pegue reglas en el espacio de trabajo actual. Bree no puede verificar qué sitio web o aplicación abrió este enlace.\n\nBree pegará las reglas en el terminal y no escribirá archivos ni presionará Return. Continúe solo si confía en estas reglas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lien %@:// demande à Bree de coller des règles dans l'espace de travail actuel. Bree ne peut pas vérifier quel site Web ou quelle application a ouvert ce lien.\n\nBree collera les règles dans le terminal, n'écrira pas de fichiers et n'appuiera pas sur Return. Ne continuez que si vous faites confiance à ces règles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un collegamento %@:// chiede a Bree di incollare le regole nell'area di lavoro corrente. Bree non può verificare quale sito Web o app ha aperto questo collegamento.\n\nBree incollerà le regole nel terminale e non scriverà file né premerà Return. Continua solo se ti fidi di queste regole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:// リンクが現在のワークスペースにルールをペーストするよう Bree に要求しています。Bree は、このリンクを開いた Web サイトやアプリを確認できません。\n\nBree はルールをターミナルに貼り付け、ファイルへの書き込みや Return の押下は行いません。このルールを信頼している場合のみ続行してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "តំណ %@:// កំពុងស្នើសុំឱ្យ Bree បិទភ្ជាប់ច្បាប់ទៅក្នុងកន្លែងធ្វើការបច្ចុប្បន្ន។ Bree មិនអាចផ្ទៀងផ្ទាត់គេហទំព័រ ឬកម្មវិធីណាមួយដែលបើកតំណនេះទេ។\n\nBree នឹងបិទភ្ជាប់ច្បាប់ទៅក្នុងស្ថានីយ ហើយនឹងមិនសរសេរឯកសារ ឬចុច Return ទេ។ បន្ត ប្រសិនបើអ្នកជឿជាក់លើច្បាប់ទាំងនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:// 링크는 Bree에게 규칙을 현재 작업 공간에 붙여넣도록 요청합니다. Bree는 어떤 웹사이트나 앱이 이 링크를 열었는지 확인할 수 없습니다.\n\nBree는 규칙을 터미널에 붙여넣고 파일을 쓰거나 Return를 누르지 않습니다. 이 규칙을 신뢰하는 경우에만 계속하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En %@://-kobling ber Bree lime inn regler i det gjeldende arbeidsområdet. Bree kan ikke bekrefte hvilken nettside eller app som åpnet denne koblingen.\n\nBree vil lime inn reglene i terminalen og vil ikke skrive filer eller trykke Return. Fortsett bare hvis du stoler på disse reglene."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Link %@:// prosi Bree o wklejenie reguł do bieżącego obszaru roboczego. Bree nie może sprawdzić, która witryna lub aplikacja otworzyła ten link.\n\nBree wklei reguły do terminala, nie zapisze plików ani nie naciśnie Return. Kontynuuj tylko wtedy, gdy ufasz tym zasadom."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um link %@:// está solicitando que Bree cole regras no espaço de trabalho atual. Bree não pode verificar qual site ou aplicativo abriu este link.\n\nBree colará as regras no terminal e não gravará arquivos nem pressionará Return. Continue apenas se você confiar nessas regras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылка %@:// запрашивает Bree вставить правила в текущую рабочую область. Bree не может проверить, какой веб-сайт или приложение открыло эту ссылку.\n\nBree вставит правила в терминал, не будет записывать файлы или нажимать Return. Продолжайте, только если вы доверяете этим правилам."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลิงก์ %@:// กำลังขอให้ Bree วางกฎลงในพื้นที่ทำงานปัจจุบัน Bree ไม่สามารถตรวจสอบได้ว่าเว็บไซต์หรือแอปใดเปิดลิงก์นี้\n\nBree จะวางกฎลงในเทอร์มินัล และจะไม่เขียนไฟล์หรือกด Return ดำเนินการต่อหากคุณเชื่อถือกฎเหล่านี้เท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir %@:// bağlantısı, Bree'den kuralları geçerli çalışma alanına yapıştırmasını istiyor. Bree bu bağlantıyı hangi web sitesinin veya uygulamanın açtığını doğrulayamıyor.\n\nBree, kuralları terminale yapıştıracak ve dosya yazmayacak veya Return'e basmayacak. Yalnızca bu kurallara güveniyorsanız devam edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Посилання %@:// просить Bree вставити правила в поточну робочу область. Bree не може перевірити, який веб-сайт або додаток відкрив це посилання.\n\nBree вставить правила в термінал і не буде записувати файли або натискати Return. Продовжуйте, лише якщо ви довіряєте цим правилам."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:// 链接要求 Bree 将规则粘贴到当前工作区中。 Bree 无法验证哪个网站或应用程序打开了此链接。\n\nBree 会将规则粘贴到终端中，并且不会写入文件或按 Return。仅当您信任这些规则时才继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:// 連結要求 Bree 將規則貼到目前工作區。 Bree 無法驗證哪個網站或應用程式開啟了此連結。\n\nBree 會將規則貼到終端機中，並且不會寫入檔案或按 Return。僅當您信任這些規則時才繼續。"
          }
        }
      }
    },
    "dialog.textURL.rules.pasteFailed.title": {
      "extractionState": "manual",
      "localizations": {
