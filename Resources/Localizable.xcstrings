        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーフェスでプロセスが実行中です。--force を指定して再試行してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표면에서 실행 중인 프로세스가 있습니다. --force로 다시 시도하세요"
