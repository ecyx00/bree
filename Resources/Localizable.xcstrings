    "cli.workflow.full-stack-dev.instantiate.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the Full-Stack Dev recipe, merge the workspace command and optional Dock controls, replace the sample bun commands and preview URL, then run bree reload-config."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Vorlage Full-Stack Dev öffnen, Arbeitsbereichsbefehl und optionale Dock-Steuerelemente übernehmen, bun-Beispielbefehle und Vorschau-URL ersetzen und Bree reload-config ausführen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez la recette Full-Stack Dev, ajoutez la commande d’espace de travail et les contrôles Dock facultatifs, remplacez les commandes bun et l’URL d’aperçu d’exemple, puis exécutez Bree reload-config."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la receta Full-Stack Dev, incorpora el comando del espacio de trabajo y los controles Dock opcionales, sustituye los comandos bun y la URL de ejemplo, y ejecuta Bree reload-config."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح وصفة Full-Stack Dev، وأضف أمر مساحة العمل وعناصر Dock الاختيارية، واستبدل أوامر bun وعنوان URL للمعاينة في المثال، ثم شغّل Bree reload-config."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Full-Stack Dev 配方，合并工作区命令和可选的 Dock 控件，替换示例 bun 命令和预览 URL，然后运行 Bree reload-config。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟 Full-Stack Dev 配方，合併工作區命令和可選的 Dock 控制項，替換範例 bun 命令和預覽 URL，然後執行 Bree reload-config。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Full-Stack Dev 설정 예제를 열고 작업 공간 명령과 선택적 Dock 컨트롤을 병합한 뒤 예제 bun 명령과 미리보기 URL을 교체하고 Bree reload-config를 실행하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Full-Stack Dev レシピを開き、ワークスペースのコマンドと任意の Dock コントロールを追加し、サンプルの bun コマンドとプレビュー URL を変更して Bree reload-config を実行します。"
          }
        }
      }
    },
