        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "browser.hiddenWebViewDiscardMode memory saver budget timer hidden tabs discard unload 内存节省 方式 预算 计时器 隐藏 标签页 丢弃 卸载"
          }
        },
        "ko": {
