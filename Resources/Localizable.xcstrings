    "projectSchemes.empty.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a scheme on the left to inspect its run / test / profile / archive targets and launch settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左側のスキームを選択して、実行 / テスト / プロファイル / アーカイブのターゲットと起動設定を確認します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在左侧选择一个 scheme，查看其运行 / 测试 / 性能分析 / 归档目标和启动设置。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie links ein Schema aus, um dessen Ausführungs-, Test-, Profilierungs- und Archivierungsziele sowie Starteinstellungen zu untersuchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un schéma à gauche pour inspecter ses cibles d’exécution, de test, de profilage et d’archivage ainsi que ses paramètres de lancement."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مخططًا من اليسار لمعاينة أهداف التشغيل / الاختبار / التحليل / الأرشفة وإعدادات الإطلاق الخاصة به."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un esquema a la izquierda para inspeccionar sus destinos de ejecución, prueba, perfilado y archivado, así como su configuración de lanzamiento."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在左側選擇一個配置方案以檢查其執行 / 測試 / 分析 / 封存目標與啟動設定。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왼쪽에서 스키마를 선택하여 실행 / 테스트 / 프로파일 / 아카이브 대상 및 실행 설정을 확인하세요."
          }
        }
      }
    },
