        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entladen der Seite im Hintergrund erlauben"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser le déchargement de la page lorsqu’elle est masquée"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السماح بإلغاء تحميل الصفحة أثناء إخفائها"
          }
        },
        "es": {
