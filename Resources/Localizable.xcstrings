    "settings.browser.hiddenWebViewMemoryBudget.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How much memory hidden browser tabs may use before Bree frees the ones hidden longest."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مقدار الذاكرة التي يمكن أن تستخدمها علامات تبويب المتصفح المخفية قبل أن يحرر Bree العلامات المخفية منذ أطول مدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie viel Speicher ausgeblendete Browser-Tabs belegen dürfen, bevor Bree die am längsten ausgeblendeten freigibt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánta memoria pueden usar las pestañas ocultas del navegador antes de que Bree libere las que llevan más tiempo ocultas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quantité de mémoire que les onglets de navigateur masqués peuvent utiliser avant que Bree libère ceux masqués depuis le plus longtemps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree が最も長く非表示になっているタブを解放するまでに、非表示のブラウザタブが使用できるメモリ量です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree가 가장 오래 숨겨진 탭을 해제하기 전까지 숨겨진 브라우저 탭이 사용할 수 있는 메모리 양입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏的浏览器标签页可使用的内存上限，超过后 Bree 会释放隐藏最久的标签页。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隱藏的瀏覽器標籤頁可使用的記憶體上限，超過後 Bree 會釋放隱藏最久的標籤頁。"
          }
        }
      }
    },
    "command.browserKeepPageActive.enable.title": {
      "extractionState": "manual",
      "localizations": {
