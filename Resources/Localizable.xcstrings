    "dialog.sshURL.error.conflictingDestinationParameters": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The link included conflicting SSH target fields."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクに競合する SSH 接続先フィールドが含まれています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该链接包含相互冲突的 SSH 目标字段。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Link enthielt widersprüchliche SSH-Zielfelder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lien contenait des champs de cible SSH conflictuels."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تضمن الرابط حقول هدف SSH متعارضة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El enlace incluía campos de destino SSH en conflicto."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該連結包含衝突的 SSH 目標欄位。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크에 충돌하는 SSH 대상 필드가 포함되어 있습니다."
          }
        }
      }
    },
    "dialog.sshURL.error.conflictingTitleParameters": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The link included both title and name. Use only one workspace title field."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクに title と name の両方が含まれています。ワークスペース名のフィールドは 1 つだけ使用してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该链接同时包含 title 和 name。只能使用一个工作区标题字段。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Link enthielt sowohl einen Titel als auch einen Namen. Verwenden Sie nur ein Titel-Feld für den Arbeitsbereich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lien contenait à la fois un titre et un nom. Utilisez un seul champ de titre d’espace de travail."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تضمن الرابط كلاً من العنوان والاسم. استخدم حقل عنوان مساحة عمل واحد فقط."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El enlace incluía tanto el título como el nombre. Usa solo un campo de título de espacio de trabajo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該連結同時包含了標題和名稱。請僅使用一個工作區標題欄位。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크에 제목과 이름이 모두 포함되어 있습니다. 작업 공간 제목 필드는 하나만 사용하세요."
          }
        }
      }
    },
    "dialog.sshURL.error.destinationContainsUnsafeCharacters": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The SSH host or user contains unsupported or hidden characters, so Bree refused to use it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH ホストまたはユーザーに未対応の文字または隠れた文字が含まれているため、Bree は使用を拒否しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 主机或用户名包含不支持或隐藏的字符，因此 Bree 拒绝使用。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der SSH-Host oder -Benutzer enthält nicht unterstützte oder versteckte Zeichen, weshalb Bree die Verwendung verweigert hat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’hôte ou l’utilisateur SSH contient des caractères non pris en charge ou masqués, Bree a donc refusé de l’utiliser."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي مضيف أو مستخدم SSH على أحرف غير مدعومة أو مخفية، لذا رفض Bree استخدامه."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El usuario o host SSH contiene caracteres ocultos o no admitidos, por lo que Bree se negó a usarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 主機或使用者包含不受支援或隱藏的字元，因此 Bree 拒絕使用。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 호스트 또는 사용자에 지원되지 않거나 숨겨진 문자가 포함되어 있어 Bree가 연결을 거부했습니다."
          }
        }
      }
    },
    "dialog.sshURL.error.destinationStartsWithDash": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The SSH host or user cannot start with a dash."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH ホストまたはユーザーをダッシュで始めることはできません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
