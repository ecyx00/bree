        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede eliminar el perfil de navegador de Bree '%@' mientras %#@count2@"
          },
          "substitutions": {
            "count2": {
              "argNum": 2,
              "formatSpecifier": "d",
