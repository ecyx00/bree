    "settings.config.status.reloadBusy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reload queued; too many requests are pending to confirm completion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再読み込みをキューに追加しましたが、保留中のリクエストが多すぎるため完了を確認できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
