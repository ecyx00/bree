    "settings.automation.autoNamingAgent.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic uses each session's own agent. Other supported agents need their command-line tool on the PATH."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Automatisch“ verwendet den Agenten der jeweiligen Sitzung. Andere unterstützte Agenten benötigen ihr Befehlszeilentool im PATH."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Automatique » utilise l’agent propre à chaque session. Les autres agents pris en charge nécessitent que leur outil en ligne de commande soit dans le PATH."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم خيار «تلقائي» الوكيل الخاص بكل جلسة. يحتاج الوكلاء المدعومون الآخرون إلى وجود أداة سطر الأوامر الخاصة بهم في PATH."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Automático» usa el agente de cada sesión. Los demás agentes compatibles necesitan su herramienta de línea de comandos en el PATH."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「自動」會使用各工作階段本身的代理。若要使用其他支援的代理，其命令列工具必須位於 PATH 中。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“自动”会使用各会话自身的代理。要使用其他受支持的代理，其命令行工具必须位于 PATH 中。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘자동’은 세션마다 해당 세션의 에이전트를 사용합니다. 지원되는 다른 에이전트를 사용하려면 해당 명령줄 도구가 PATH에 있어야 합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「自動」では、各セッションのエージェントを使用します。ほかの対応エージェントを使うには、そのコマンドラインツールが PATH に含まれている必要があります。"
          }
        }
      }
    },
