        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree konnte Seitenleisten-Erweiterungen nicht laden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree could not load sidebar extensions."
