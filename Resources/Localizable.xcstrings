          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic e trascina per selezionare. Esc annulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグで選択。Escでキャンセル。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ចុចហើយអូសដើម្បីជ្រើស។ Esc បោះបង់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택하려면 클릭하고 드래그하세요. Esc 취소."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikk og dra for å velge. Esc avbryter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij i przeciągnij, aby zaznaczyć. Esc anuluje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique e arraste para selecionar. Esc cancela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите и перетащите, чтобы выбрать. Esc отменяет."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลิกแล้วลากเพื่อเลือก กด Esc เพื่อยกเลิก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçmek için tıklayıp sürükleyin. Esc iptal eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клацніть і перетягніть, щоб вибрати. Esc скасовує."
