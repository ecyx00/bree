        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택자는 디렉터리 선택이 없는 파일 입력 요소와 일치해야 합니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
