    "cli.restore.codexCheckpointUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: the saved agent session is unavailable. The terminal remains in its saved directory; retry later or start a new agent session."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: 保存されたエージェント セッションを利用できません。ターミナルは保存されたディレクトリに残っています。後でもう一度試すか、新しいエージェント セッションを開始してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: 已保存的代理会话不可用。终端仍留在其保存目录中；请稍后重试，或新建一个代理会话。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: Die gespeicherte Agenten-Sitzung ist nicht verfügbar. Das Terminal verbleibt in seinem gespeicherten Verzeichnis; versuchen Sie es später erneut oder starten Sie eine neue Agenten-Sitzung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "restore : la session d'agent enregistrée n'est pas disponible. Le terminal reste dans son répertoire enregistré ; réessayez plus tard ou démarrez une nouvelle session d'agent."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: جلسة الوكيل المحفوظة غير متاحة. تظل الطرفية في دليلها المحفوظ؛ أعد المحاولة لاحقًا أو ابدأ جلسة وكيل جديدة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: la sesión del agente guardada no está disponible. La terminal permanece en su directorio guardado; reinténtelo más tarde o inicie una nueva sesión del agente."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "restore：儲存的代理程式工作階段無法使用。終端機仍保留在儲存的目錄中；請稍後重試或啟動新的代理程式工作階段。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
