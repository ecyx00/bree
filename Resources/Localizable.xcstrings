    "surfaceResumeApproval.runPrompt.message": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree bir terminali bu devam komutuyla geri yüklüyor:\n\nÇalışma dizini: %1$@\n\n%2$@"
          }
        },
        "en": {
          "stringUnit": {
