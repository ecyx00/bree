          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: 保存されたプロセスを開始できませんでした。表示されているフォークコマンドを再実行してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: ដំណើរការដែលបានរក្សាទុកមិនអាចចាប់ផ្តើមបានទេ។ សាកល្បងពាក្យបញ្ជា fork ដែលអាចមើលឃើញម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
