    "cli.error.notifyClearSurfaceRequiresTarget": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "notify --clear --surface requires workspace or window context; specify --workspace or --window"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "notify --clear --surface にはワークスペースまたはウィンドウのコンテキストが必要です。--workspace または --window を指定してください"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب notify --clear --surface سياق مساحة عمل أو نافذة؛ حدّد --workspace أو --window"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "notify --clear --surface zahtijeva kontekst radnog prostora ili prozora; navedite --workspace ili --window"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "notify --clear --surface kræver workspace- eller vindueskontekst; angiv --workspace eller --window"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "notify --clear --surface erfordert einen Workspace- oder Fensterkontext; geben Sie --workspace oder --window an"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "notify --clear --surface requiere un contexto de espacio de trabajo o ventana; especifica --workspace o --window"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "notify --clear --surface nécessite un contexte d’espace de travail ou de fenêtre ; indiquez --workspace ou --window"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "notify --clear --surface richiede il contesto di uno spazio di lavoro o di una finestra; specifica --workspace o --window"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "notify --clear --surface ត្រូវការបរិបទ workspace ឬ window; បញ្ជាក់ --workspace ឬ --window"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "notify --clear --surface에는 워크스페이스 또는 창 컨텍스트가 필요합니다. --workspace 또는 --window를 지정하십시오"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "notify --clear --surface krever arbeidsområde- eller vinduskontekst; angi --workspace eller --window"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "notify --clear --surface wymaga kontekstu obszaru roboczego lub okna; podaj --workspace lub --window"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "notify --clear --surface exige um contexto de workspace ou janela; informe --workspace ou --window"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для notify --clear --surface требуется контекст рабочего пространства или окна; укажите --workspace или --window"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "notify --clear --surface ต้องมีบริบทเวิร์กสเปซหรือหน้าต่าง โปรดระบุ --workspace หรือ --window"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "notify --clear --surface bir çalışma alanı veya pencere bağlamı gerektirir; --workspace veya --window belirtin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "notify --clear --surface потребує контексту робочого простору або вікна; вкажіть --workspace або --window"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "notify --clear --surface 需要工作区或窗口上下文；请指定 --workspace 或 --window"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "notify --clear --surface 需要工作區或視窗內容；請指定 --workspace 或 --window"
          }
        }
      }
    },
