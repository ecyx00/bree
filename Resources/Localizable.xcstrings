    "dialog.sshURL.error.titleContainsControlCharacters": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The workspace title contains hidden control or formatting characters, so Bree refused to use it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークスペース名に隠れた制御文字または書式制御文字が含まれているため、Bree は使用を拒否しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作区标题包含隐藏的控制字符或格式字符，因此 Bree 拒绝使用。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Titel des Arbeitsbereichs enthält versteckte Steuer- oder Formatierungszeichen, weshalb Bree die Verwendung verweigert hat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le titre de l’espace de travail contient des caractères de contrôle ou de formatage masqués, Bree a donc refusé de l’utiliser."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي عنوان مساحة العمل على أحرف تحكم أو تنسيق مخفية، لذا رفض Bree استخدامه."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El título del espacio de trabajo contiene caracteres ocultos de control o formato, por lo que Bree se negó a usarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作區標題包含隱藏的控制或格式化字元，因此 Bree 拒絕使用。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 공간 제목에 숨겨진 제어 문자나 서식 문자가 포함되어 있어 Bree가 연결을 거부했습니다."
          }
        }
      }
    },
