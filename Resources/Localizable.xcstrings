    "cli.workflow.ssh-devbox.instantiate.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the SSH Devbox recipe, replace ssh devbox and the preview URL for the project, merge the command into bree.json, then run bree reload-config."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Vorlage SSH Devbox öffnen, ssh devbox und Vorschau-URL an das Projekt anpassen, den Befehl in bree.json übernehmen und Bree reload-config ausführen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez la recette SSH Devbox, adaptez ssh devbox et l’URL d’aperçu au projet, ajoutez la commande à bree.json, puis exécutez Bree reload-config."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la receta SSH Devbox, adapta ssh devbox y la URL de vista previa al proyecto, incorpora el comando en bree.json y ejecuta Bree reload-config."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح وصفة SSH Devbox، واستبدل ssh devbox وعنوان URL للمعاينة بما يناسب المشروع، وأضف الأمر إلى bree.json، ثم شغّل Bree reload-config."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 SSH Devbox 配方，按项目需要替换 ssh devbox 和预览 URL，将命令合并到 bree.json，然后运行 Bree reload-config。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟 SSH Devbox 配方，依專案需求替換 ssh devbox 和預覽 URL，將命令合併到 bree.json，然後執行 Bree reload-config。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH Devbox 설정 예제를 열고 ssh devbox와 미리보기 URL을 프로젝트에 맞게 교체한 뒤 명령을 bree.json에 병합하고 Bree reload-config를 실행하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH Devbox レシピを開き、ssh devbox とプレビュー URL をプロジェクトに合わせて変更し、コマンドを bree.json に追加して Bree reload-config を実行します。"
          }
        }
      }
    },
