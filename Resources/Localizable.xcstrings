    "settings.browser.hiddenWebViewDiscardDelay.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How long a browser tab must stay hidden before Bree may free its page memory. Active downloads, popups, developer tools, fullscreen, and loading pages are skipped."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザタブが非表示になってから、Bree がページメモリを解放できるようになるまでの時間です。進行中のダウンロード、ポップアップ、開発者ツール、フルスクリーン、読み込み中のページは対象外です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览器标签页需隐藏多久，Bree 才可以释放其页面内存。正在下载、弹出窗口、开发者工具、全屏和加载中的页面会被跳过。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie lange ein Browser-Tab ausgeblendet bleiben muss, bevor Bree seinen Seitenspeicher freigeben darf. Aktive Downloads, Popups, Entwicklertools, Vollbild und ladende Seiten werden übersprungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durée pendant laquelle un onglet de navigateur doit rester masqué avant que Bree puisse libérer sa mémoire de page. Les téléchargements actifs, les fenêtres surgissantes, les outils de développement, le mode plein écran et les pages en cours de chargement sont ignorés."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المدة التي يجب أن تظل فيها علامة تبويب المتصفح مخفية قبل أن يتمكن Bree من تحرير ذاكرة صفحتها. يتم تخطي التنزيلات النشطة والنوافذ المنبثقة وأدوات المطورين وملء الشاشة والصفحات التي يتم تحميلها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto tiempo debe permanecer oculta una pestaña del navegador antes de que Bree pueda liberar la memoria de su página. Se omiten las descargas activas, las ventanas emergentes, las herramientas de desarrollo, la pantalla completa y las páginas en carga."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "瀏覽器標籤頁必須保持隱藏多久，Bree 才可以釋放其網頁記憶體。作用中的下載、彈出式視窗、開發者工具、全螢幕和載入中的網頁將會跳過。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree가 페이지 메모리를 해제할 수 있기 전까지 브라우저 탭이 숨겨진 상태로 유지되어야 하는 시간입니다. 진행 중인 다운로드, 팝업, 개발자 도구, 전체 화면 및 로딩 중인 페이지는 제외됩니다."
          }
        }
      }
    },
