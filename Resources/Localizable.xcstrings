      }
    },
    "taskManager.killProcess.message.one": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (PID %2$lld) sürecinden düzgün biçimde sonlanmasını iste. Bree kısa bir ek süre sonra hâlâ çalışıyorsa zorla sonlandırır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask %@ (PID %lld) to terminate gracefully. Bree will force-kill it if it is still running after a short grace period."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（PID %lld）に正常終了を要求します。短い猶予時間の後も実行中の場合、Bree が強制終了します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求 %@（PID %lld）正常退出。若短暂宽限期后仍在运行，Bree 会强制结束它。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufforderung an %@ (PID %lld), sich ordnungsgemäß zu beenden. Bree wird das Beenden erzwingen, wenn der Prozess nach einer kurzen Nachfrist noch läuft."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demander à %@ (PID %lld) de se terminer correctement. Bree le forcera à s’arrêter s’il est toujours en cours d’exécution après un court délai de grâce."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلب من %@ (PID %lld) الإنهاء بشكل منظم. سيقوم Bree بإنهائه إجباريًا إذا ظل قيد التشغيل بعد فترة سماح قصيرة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicitar a %@ (PID %lld) que finalice de forma ordenada. Bree lo forzará a finalizar si aún se está ejecutando después de un breve período de gracia."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要求 %@ (PID %lld) 正常結束。如果它在短暫的寬限期後仍在執行，Bree 將會強制結束它。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@(PID %lld)의 정상 종료를 요청합니다. 짧은 유예 기간 후에도 계속 실행 중인 경우 Bree가 강제 종료합니다."
          }
        }
      }
    },
    "taskManager.killProcess.message.other": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "variations": {
