          }
        }
      }
    },
    "cli.session.move.output.sourceKept": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "The copy on %@ stays; do not resume it there too."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The copy on %@ stays; do not resume it there too."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى النسخة على %@؛ لا تستأنفها هناك أيضًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kopie auf %@ bleibt erhalten; setze sie dort nicht ebenfalls fort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
