    "cli.events.help.timeout": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exit unsuccessfully if no matching event arrives before the deadline"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "期限までに一致するイベントが届かない場合はエラーで終了"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제한 시간 전에 일치하는 이벤트가 도착하지 않으면 오류로 종료"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершити з помилкою, якщо відповідна подія не надійде до кінцевого терміну"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若在截止前没有匹配事件到达，则以失败退出"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fehlgeschlagen beenden, wenn vor Ablauf der Frist kein passendes Ereignis eintrifft"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitte en échec si aucun événement correspondant n’arrive avant l’échéance"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الخروج غير الناجح في حال عدم وصول أي حدث مطابق قبل الموعد النهائي"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sale de forma incorrecta si no llega ningún evento coincidente antes del tiempo límite"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果在截止時間前沒有相符事件到達，則結束並顯示失敗"
          }
        }
      }
    },
