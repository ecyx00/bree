    "socket.client.accessDenied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access denied - only processes started inside Bree can connect"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセスが拒否されました。Bree 内で起動されたプロセスのみ接続できます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "访问被拒绝 - 只有在 Bree 内启动的进程才能连接"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugriff verweigert – nur innerhalb von Bree gestartete Prozesse können eine Verbindung herstellen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accès refusé - seuls les processus démarrés dans Bree peuvent se connecter"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم رفض الوصول - يمكن فقط للعمليات التي بدأت داخل Bree الاتصال"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceso denegado: solo los procesos iniciados dentro de Bree pueden conectarse"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "存取被拒 - 僅限在 Bree 內部啟動的程序才能連線"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "액세스 거부됨 - Bree 내부에서 시작된 프로세스만 연결할 수 있습니다"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pristup je odbijen - povezati se mogu samo procesi pokrenuti unutar Bree-a"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Adgang nægtet - kun processer, der er startet i Bree, kan oprette forbindelse"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesso negato: solo i processi avviati all'interno di Bree possono connettersi"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការចូលប្រើត្រូវបានបដិសេធ - មានតែដំណើរការដែលបានចាប់ផ្តើមនៅក្នុង Bree ប៉ុណ្ណោះដែលអាចតភ្ជាប់បាន"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilgang nektet - bare prosesser som er startet i Bree, kan koble til"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odmowa dostępu - łączyć się mogą tylko procesy uruchomione w Bree"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acesso negado - somente processos iniciados dentro do Bree podem se conectar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ запрещён — подключаться могут только процессы, запущенные внутри Bree"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปฏิเสธการเข้าถึง — เฉพาะกระบวนการที่เริ่มต้นภายใน Bree เท่านั้นที่เชื่อมต่อได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişim reddedildi — yalnızca Bree içinde başlatılan işlemler bağlanabilir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ заборонено — підключатися можуть лише процеси, запущені всередині Bree"
          }
        }
      }
    },
