        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] ssh បានបញ្ចប់ដោយស្ថានភាព %s; កំពុងភ្ជាប់ឡើងវិញ (ការព្យាយាម %s/%s)។"
          }
