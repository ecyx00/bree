          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要移動到另一個檔案卷宗嗎?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 볼륨으로 이동할까요?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のボリュームに移動しますか?"
          }
        }
      }
    },
    "fileExplorer.move.crossVolume.info": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The items are copied to the other volume and the originals are deleted. This can't be undone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öğeler diğer birime kopyalanır ve orijinaller silinir. Bu işlem geri alınamaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Objekte werden auf das andere Volume kopiert und die Originale werden gelöscht. Dies kann nicht widerrufen werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments sont copiés vers l'autre volume et les originaux sont supprimés. Cette action est irréversible."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم نسخ العناصر إلى وحدة التخزين الأخرى وحذف الأصول. لا يمكن التراجع عن ذلك."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los elementos se copian al otro volumen y se eliminan los originales. No se puede deshacer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "项目将被拷贝到另一个宗卷,原始项目会被删除。此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "項目將被拷貝到另一個檔案卷宗,原始項目會被刪除。此操作無法還原。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목이 다른 볼륨으로 복사되고 원본은 삭제됩니다. 이 작업은 실행 취소할 수 없습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目は別のボリュームにコピーされ、元の項目は削除されます。この操作は取り消せません。"
          }
        }
      }
    },
    "fileExplorer.transfer.error.vault": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" is in an Obsidian vault, which is read-only here."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" bir Obsidian kasasında ve burada salt okunur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ befindet sich in einem Obsidian-Vault, der hier schreibgeschützt ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » se trouve dans un coffre Obsidian, en lecture seule ici."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" موجود في خزنة Obsidian وهي للقراءة فقط هنا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" está en un vault de Obsidian, que aquí es de solo lectura."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”位于 Obsidian 库中,此处为只读。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」位於 Obsidian 庫中,此處為唯讀。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" 항목은 Obsidian 볼트에 있으며 여기서는 읽기 전용입니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」はObsidian vault内にあり、ここでは読み取り専用です。"
          }
        }
      }
    },
    "fileExplorer.transfer.error.intoItself": {
      "extractionState": "manual",
