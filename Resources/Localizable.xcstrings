    "settings.betaFeatures.remoteTmux.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows tmux sessions on remote hosts as workspaces in the sidebar. The sessions keep running after Bree quits."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt tmux-Sitzungen auf Remote-Hosts als Arbeitsbereiche in der Seitenleiste an. Die Sitzungen laufen auch nach dem Beenden von Bree weiter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche les sessions tmux des hôtes distants comme des espaces de travail dans la barre latérale. Les sessions continuent de s’exécuter après la fermeture de Bree."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض جلسات tmux على المضيفين البعيدين كمساحات عمل في الشريط الجانبي. وتستمر الجلسات في العمل حتى بعد إنهاء Bree."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra las sesiones de tmux de hosts remotos como espacios de trabajo en la barra lateral. Las sesiones siguen ejecutándose al salir de Bree."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在側邊欄中將遠端主機上的 tmux 工作階段顯示為工作區。結束 Bree 後，這些工作階段仍會繼續執行。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在侧边栏中将远程主机上的 tmux 会话显示为工作区。退出 Bree 后，这些会话仍会继续运行。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원격 호스트의 tmux 세션을 사이드바에 작업 공간으로 표시합니다. Bree를 종료해도 세션은 계속 실행됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモートホストの tmux セッションをサイドバーにワークスペースとして表示します。Bree を終了してもセッションは動作し続けます。"
          }
        }
      }
    },
    "settings.browser.enabled.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens browser tabs and links from terminals in the Bree browser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Browser-Tabs und Links aus Terminals werden im Bree-Browser geöffnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre les onglets de navigateur et les liens des terminaux dans le navigateur Bree."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح علامات تبويب المتصفح والروابط من الطرفيات في متصفح Bree."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre pestañas del navegador y enlaces de las terminales en el navegador de Bree."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "瀏覽器標籤頁和從終端機開啟的連結都會在 Bree 瀏覽器中開啟。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览器标签页和从终端打开的链接都会在 Bree 浏览器中打开。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저 탭과 터미널에서 연 링크를 Bree 브라우저에서 엽니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザタブとターミナルから開いたリンクをBreeブラウザで開きます。"
          }
        }
      }
    },
    "settings.browser.hiddenWebViewDiscard.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frees page memory from hidden browser tabs. Scroll position, form input, and history come back when a tab is shown again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gibt den Seitenspeicher ausgeblendeter Browser-Tabs frei. Scrollposition, Formulareingaben und Verlauf werden wiederhergestellt, wenn ein Tab wieder angezeigt wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Libère la mémoire des pages des onglets de navigateur masqués. La position de défilement, les saisies de formulaire et l’historique sont restaurés lorsqu’un onglet réapparaît."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحرر ذاكرة الصفحات من علامات تبويب المتصفح المخفية. تتم استعادة موضع التمرير وإدخالات النماذج والسجل عند عرض علامة التبويب مجددًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Libera la memoria de página de las pestañas ocultas del navegador. La posición de desplazamiento, los datos de formularios y el historial se recuperan cuando la pestaña vuelve a mostrarse."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "釋放隱藏瀏覽器標籤頁的網頁記憶體。標籤頁再次顯示時，會恢復捲動位置、表單輸入和瀏覽記錄。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "释放隐藏浏览器标签页的页面内存。标签页再次显示时，会恢复滚动位置、表单输入和浏览历史。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숨겨진 브라우저 탭의 페이지 메모리를 해제합니다. 탭을 다시 표시하면 스크롤 위치, 양식 입력 및 방문 기록이 복원됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非表示のブラウザタブのページメモリを解放します。タブを再び表示すると、スクロール位置、フォーム入力、履歴が復元されます。"
          }
        }
      }
    },
    "settings.browser.theme.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose light or dark pages for sites that support both. System matches the app appearance."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie helle oder dunkle Seiten für Websites, die beides unterstützen. „System“ folgt dem Erscheinungsbild der App."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez des pages claires ou sombres pour les sites qui prennent en charge les deux. « Système » suit l’apparence de l’app."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر الصفحات الفاتحة أو الداكنة للمواقع التي تدعم الوضعين. يتبع خيار «النظام» مظهر التطبيق."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige páginas claras u oscuras para los sitios compatibles con ambos modos. «Sistema» sigue el aspecto de la app."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網站同時支援淺色與深色時，選擇要使用淺色或深色頁面。「系統」會跟隨 App 的外觀。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网站同时支持浅色和深色时，选择使用浅色还是深色页面。“系统”会跟随应用外观。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이트와 다크를 모두 지원하는 사이트에서 표시할 페이지 모드를 선택합니다. ‘시스템’은 앱의 외관 설정을 따릅니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライトとダークの両方に対応したサイトで、どちらのページを表示するかを選択します。「システム」はアプリの外観に合わせます。"
          }
        }
      }
    },
    "settings.globalHotkey.enable.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressing the shortcut in any app shows or hides all Bree windows."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Tastaturkürzel blendet in jeder App alle Bree-Fenster ein oder aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le raccourci affiche ou masque toutes les fenêtres Bree, quelle que soit l’app active."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُظهر الاختصار جميع نوافذ Bree أو يخفيها من أي تطبيق."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El atajo muestra u oculta todas las ventanas de Bree desde cualquier app."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在任何 App 中按下快速鍵，即可顯示或隱藏所有 Bree 視窗。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任意 App 中按下快捷键，即可显示或隐藏所有 Bree 窗口。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어느 앱에서든 단축키를 눌러 모든 Bree 윈도우를 표시하거나 숨길 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのアプリを使用中でも、ショートカットを押すと Bree のすべてのウィンドウを表示または非表示にできます。"
          }
        }
      }
    },
    "settings.shortcuts.showModifierHoldHints.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Holding Command or Control shows shortcut hints."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinweise zu Tastaturkürzeln erscheinen, solange die Befehlstaste oder die Control-Taste gedrückt ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les indices de raccourcis apparaissent tant que la touche Commande ou Contrôle est maintenue enfoncée."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر تلميحات الاختصارات عند الضغط مع الاستمرار على Command أو Control."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las sugerencias de atajos aparecen mientras se mantiene presionada la tecla Comando o Control."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 Command 或 Control 鍵時，會顯示快速鍵提示。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 Command 或 Control 键时，会显示快捷键提示。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Command 또는 Control 키를 누르고 있으면 단축키 힌트가 표시됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Command キーまたは Control キーを押したままにすると、ショートカットヒントが表示されます。"
          }
        }
      }
    },
    "settings.sidebar.rightMaxWidth.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets the panel in the right sidebar grow up to this width while leaving room for terminals."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Dock in der rechten Seitenleiste kann bis zu dieser Breite wachsen, lässt aber Platz für Terminals."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Dock de la barre latérale droite peut s’élargir jusqu’à cette largeur tout en laissant de la place aux terminaux."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن أن يتسع Dock في الشريط الجانبي الأيمن حتى هذا العرض مع ترك مساحة للطرفيات."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Dock de la barra lateral derecha puede ampliarse hasta este ancho, pero deja espacio para las terminales."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "右側邊欄中的 Dock 最寬可擴展至此寬度，並為終端機保留空間。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右侧边栏中的 Dock 最宽可扩展到此宽度，同时为终端保留空间。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽 사이드바의 Dock은 터미널 공간을 남겨 둔 채 이 너비까지 넓어질 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右サイドバーの Dock は、ターミナルの領域を残したまま、この幅まで広げられます。"
          }
        }
      }
    },
    "settings.terminal.adaptiveDefaultTheme.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matches terminal colors to the light or dark appearance when no Ghostty theme or colors are set."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passt die Terminalfarben an das helle oder dunkle Erscheinungsbild an, wenn in Ghostty kein Theme und keine Farben festgelegt sind."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si aucun thème ni aucune couleur Ghostty n’est défini, les couleurs du terminal suivent l’apparence claire ou sombre."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما لا تكون هناك سمة أو ألوان محددة في Ghostty، تتوافق ألوان الطرفية مع المظهر الفاتح أو الداكن."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no hay ningún tema ni colores de Ghostty definidos, los colores de la terminal siguen la apariencia clara u oscura."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未設定 Ghostty 主題或顏色時，終端機顏色會配合淺色或深色外觀。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未设置 Ghostty 主题或颜色时，终端颜色会随浅色或深色外观变化。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghostty 테마나 색상이 설정되어 있지 않으면 터미널 색상을 라이트 또는 다크 모드에 맞춥니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghostty のテーマや色が設定されていない場合、ターミナルの色をライトまたはダークの外観に合わせます。"
          }
        }
      }
    },
    "settings.terminal.agentAutoResume.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reopening Bree resumes agent sessions automatically."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim erneuten Öffnen von Bree werden Agenten-Sitzungen automatisch fortgesetzt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sessions d’agent reprennent automatiquement à la réouverture de Bree."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُستأنف جلسات الوكلاء تلقائيًا عند إعادة فتح Bree."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las sesiones de agentes se reanudan automáticamente al volver a abrir Bree."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新開啟 Bree 時，自動繼續先前的代理工作階段。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新打开 Bree 时，自动恢复之前的代理会话。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree를 다시 열면 에이전트 세션이 자동으로 재개됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree を開き直すと、エージェントのセッションが自動的に再開されます。"
          }
        }
      }
    },
    "settings.terminal.agentHibernation.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hibernates idle background agent terminals above the live terminal limit. Even when this is off, Bree may hibernate them under critical memory pressure."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versetzt inaktive Agenten-Terminals im Hintergrund in den Ruhezustand, sobald das Limit für aktive Terminals überschritten ist. Auch wenn diese Option deaktiviert ist, kann Bree sie bei kritischer Speicherauslastung in den Ruhezustand versetzen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Met en hibernation les terminaux d’agent inactifs en arrière-plan au-delà de la limite de terminaux actifs. Même si cette option est désactivée, Bree peut les mettre en hibernation en cas de pression mémoire critique."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُدخل طرفيات الوكلاء الخاملة في الخلفية في السبات عند تجاوز حد الطرفيات النشطة. وحتى عند إيقاف هذا الخيار، قد يُدخلها Bree في السبات عند ضغط الذاكرة الحرج."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pone en hibernación las terminales de agentes inactivas en segundo plano que superan el límite de terminales activas. Aunque esta opción esté desactivada, Bree puede ponerlas en hibernación si la presión de memoria es crítica."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "作用中終端機超過上限時，閒置的背景代理終端機會進入休眠。即使關閉此選項，Bree 仍可能在記憶體壓力達到嚴重程度時讓它們休眠。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "活动终端超过上限时，空闲的后台代理终端会进入休眠。即使关闭此选项，Bree 仍可能在内存压力达到严重程度时让它们休眠。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성 터미널 수가 한도를 넘으면 백그라운드에서 유휴 상태인 에이전트 터미널을 최대 절전 모드로 전환합니다. 이 옵션을 꺼도 메모리 압박이 심각하면 Bree가 해당 터미널을 최대 절전 모드로 전환할 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行中のターミナル数が上限を超えると、アイドル状態のバックグラウンドエージェントのターミナルを休止させます。この設定がオフでも、メモリ逼迫が深刻な場合は Bree がこれらを休止させることがあります。"
          }
        }
      }
    },
    "settings.terminal.copyOnSelect.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecting text in a terminal copies it to the clipboard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Terminal ausgewählter Text wird in die Zwischenablage kopiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte sélectionné dans un terminal est copié dans le presse-papiers."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُنسخ النص المحدد في الطرفية إلى الحافظة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto seleccionado en una terminal se copia al portapapeles."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在終端機中選取文字時，會將文字複製到剪貼簿。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在终端中选择文本时，会将文本复制到剪贴板。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널에서 텍스트를 선택하면 클립보드에 복사됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルでテキストを選択すると、クリップボードにコピーされます。"
          }
        }
      }
    },
    "settings.terminal.reflowHardWrapOnCopy.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copying text also joins line breaks a program printed at the full terminal width and drops a short continuation indent. Soft-wrapped lines always copy as one line."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Kopieren werden auch Zeilenumbrüche zusammengefügt, die ein Programm bei voller Terminalbreite ausgegeben hat, und ein kurzer Fortsetzungseinzug wird entfernt. Weich umbrochene Zeilen werden immer als eine Zeile kopiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lors de la copie, les sauts de ligne qu’un programme a insérés à pleine largeur du terminal sont aussi supprimés, ainsi qu’un court retrait de continuation. Les lignes à retour automatique sont toujours copiées sur une seule ligne."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند النسخ، تُدمج أيضًا فواصل الأسطر التي طبعها برنامج عند العرض الكامل للطرفية، وتُحذف مسافة البادئة القصيرة للسطر التالي. أما الأسطر الملتفّة تلقائيًا فتُنسخ دائمًا كسطر واحد."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al copiar, también se unen los saltos de línea que un programa imprimió al ancho completo de la terminal y se quita una sangría de continuación corta. Las líneas con ajuste automático siempre se copian como una sola línea."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "複製文字時，也會合併程式在終端機滿寬處輸出的換行，並移除較短的續行縮排。自動換行的行一律會複製為一行。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制文本时，也会合并程序在终端满宽处输出的换行，并移除较短的续行缩进。自动换行的行始终会复制为一行。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트를 복사할 때 프로그램이 터미널 전체 너비에서 넣은 줄바꿈도 합치고 짧은 연속 들여쓰기를 제거합니다. 자동 줄바꿈된 줄은 항상 한 줄로 복사됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストをコピーするとき、プログラムがターミナルの幅いっぱいで出力した改行もつなげ、短い継続インデントを取り除きます。ソフトラップされた行は常に 1 行としてコピーされます。"
          }
        }
      }
    },
    "settings.terminal.importFromTerminal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import from Another Terminal"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のターミナルから読み込む"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从其他终端导入"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus anderem Terminal importieren"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importer depuis un autre terminal"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استيراد من طرفية أخرى"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importar desde otra terminal"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從其他終端機匯入"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 터미널에서 가져오기"
          }
        }
      }
    },
    "settings.terminal.importFromTerminal.button": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込む…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importieren…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importer…"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استيراد…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importar…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가져오기…"
          }
        }
      }
    },
    "settings.terminal.importFromTerminal.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring over your font, colors, cursor and more from iTerm2, Terminal, Alacritty, Kitty, WezTerm or Warp."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iTerm2、ターミナル、Alacritty、Kitty、WezTerm、Warp からフォント、カラー、カーソルなどを引き継ぎます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 iTerm2、终端、Alacritty、Kitty、WezTerm 或 Warp 导入字体、颜色、光标等设置。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übernimmt Schrift, Farben, Cursor und mehr aus iTerm2, Terminal, Alacritty, Kitty, WezTerm oder Warp."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprend la police, les couleurs, le curseur et plus encore depuis iTerm2, Terminal, Alacritty, Kitty, WezTerm ou Warp."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقل الخط والألوان والمؤشر وغيرها من iTerm2 أو Terminal أو Alacritty أو Kitty أو WezTerm أو Warp."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trae la fuente, los colores, el cursor y más desde iTerm2, Terminal, Alacritty, Kitty, WezTerm o Warp."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從 iTerm2、終端機、Alacritty、Kitty、WezTerm 或 Warp 匯入字體、顏色、游標等設定。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iTerm2, 터미널, Alacritty, Kitty, WezTerm, Warp에서 글꼴, 색상, 커서 등을 가져옵니다."
          }
        }
      }
    },
    "settings.terminal.memoryGuardrail.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warns when the processes in one pane use too much memory."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warnt, wenn die Prozesse in einem Teilfenster zu viel Speicher verbrauchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avertit lorsque les processus d’un volet utilisent trop de mémoire."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينبّه عندما تستهلك العمليات في جزء واحد ذاكرة أكثر من اللازم."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisa cuando los procesos de un panel usan demasiada memoria."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "單一窗格中的處理程序使用過多記憶體時發出警告。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "某个窗格中的进程占用过多内存时发出警告。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 분할 창의 프로세스가 메모리를 너무 많이 사용하면 경고합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 つのペインのプロセスがメモリを使いすぎると警告します。"
          }
        }
      }
    },
    "settings.terminal.rendererRealization.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frees graphics memory from terminals that are out of view. Their processes keep running."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gibt den Grafikspeicher nicht sichtbarer Terminals frei. Ihre Prozesse laufen weiter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Libère la mémoire graphique des terminaux hors de vue. Leurs processus continuent de s’exécuter."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحرر ذاكرة الرسومات للطرفيات غير الظاهرة، مع استمرار تشغيل عملياتها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Libera la memoria gráfica de las terminales fuera de la vista. Sus procesos siguen ejecutándose."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "釋放不在畫面上的終端機所使用的圖形記憶體，其處理程序仍會繼續執行。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "释放不在屏幕上的终端所占用的图形内存，其进程仍会继续运行。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면에 보이지 않는 터미널의 그래픽 메모리를 해제합니다. 해당 프로세스는 계속 실행됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示されていないターミナルのグラフィックスメモリを解放します。プロセスは動作し続けます。"
          }
        }
      }
    },
    "settings.terminal.scrollBar.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows a scroll bar in terminals, except in full-screen apps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt in Terminals eine Bildlaufleiste an, außer in Vollbild-Apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche une barre de défilement dans les terminaux, sauf dans les apps en plein écran."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض شريط تمرير في الطرفيات، إلا في التطبيقات بملء الشاشة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra una barra de desplazamiento en las terminales, excepto en las apps a pantalla completa."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在終端機中顯示捲軸（全螢幕 App 除外）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在终端中显示滚动条（全屏 App 除外）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널에 스크롤 바를 표시합니다(전체 화면 앱 제외)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルにスクロールバーを表示します（フルスクリーンアプリを除く）。"
          }
        }
      }
    },
    "settings.terminal.sessionContentWidth.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wraps terminal and agent chat content at this width. Narrow panes still use their full width."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal- und Agenten-Chat-Inhalte werden bei dieser Breite umbrochen. Schmalere Teilfenster nutzen weiterhin ihre volle Breite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu du terminal et du chat de l’agent revient à la ligne à cette largeur. Les volets plus étroits conservent toute leur largeur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يلتف محتوى الطرفية ودردشة الوكيل عند هذا العرض. أما الأجزاء الأضيق فتستخدم عرضها الكامل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido de la terminal y del chat de agentes se ajusta a este ancho. Los paneles más estrechos siguen usando todo su ancho."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "終端機和代理對話的內容會在此寬度換行。較窄的窗格仍使用完整寬度。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终端和代理对话的内容会在此宽度处换行。较窄的窗格仍使用全部宽度。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널과 에이전트 채팅 내용을 이 너비에서 줄바꿈합니다. 이보다 좁은 분할 창에서는 전체 너비를 사용합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルとエージェントチャットの内容をこの幅で折り返します。これより狭いペインでは、ペインの幅いっぱいに表示します。"
          }
        }
      }
    },
    "settings.terminal.textEditingGestures.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Command and Option arrow and delete keys move and delete by line and word at the shell prompt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シェルのプロンプトでは、Command と Option の矢印キー・削除キーで行単位・単語単位に移動・削除します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 shell 提示符下，Command 和 Option 加方向键和删除键按行和按词移动和删除。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Befehls- und Wahltaste mit Pfeil- und Löschtasten bewegen und löschen an der Shell-Eingabeaufforderung zeilen- und wortweise."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À l'invite du shell, les flèches et la touche Supprimer avec Commande et Option déplacent et suppriment par ligne et par mot."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في موجه الصدفة، تنقل مفاتيح الأسهم والحذف مع Command وOption وتحذف حسب السطر والكلمة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el prompt de la shell, las flechas y la tecla Eliminar con Comando y Opción mueven y borran por línea y por palabra."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 shell 提示字元下，Command 與 Option 加方向鍵與刪除鍵會依行與依字移動與刪除。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "셸 프롬프트에서 Command 및 Option 화살표와 삭제 키가 줄 및 단어 단위로 이동하고 삭제합니다."
          }
        }
      }
    },
    "settings.textBox.focusOnNewTerminals.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening a terminal tab, split, or workspace puts keyboard focus in the TextBox."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ein Terminal-Tab, eine Teilung oder ein Arbeitsbereich geöffnet wird, liegt der Tastaturfokus in der TextBox."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À l’ouverture d’un onglet, d’une division ou d’un espace de travail de terminal, le focus du clavier est placé dans la TextBox."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند فتح علامة تبويب طرفية أو تقسيم أو مساحة عمل، ينتقل تركيز لوحة المفاتيح إلى TextBox."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al abrir una pestaña de terminal, una división o un espacio de trabajo, el enfoque del teclado se sitúa en el TextBox."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟終端機標籤頁、分割或工作區時，將鍵盤焦點移到 TextBox。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开终端标签页、分屏或工作区时，将键盘焦点移到 TextBox。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널 탭, 분할 또는 작업 공간을 열면 키보드 포커스가 TextBox로 이동합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルタブ、分割、またはワークスペースを開くと、キーボードフォーカスが TextBox に移動します。"
          }
        }
      }
    },
    "settings.textBox.showOnNewTerminals.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening a terminal tab, split, or workspace shows the TextBox."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Öffnen eines Terminal-Tabs, einer Teilung oder eines Arbeitsbereichs erscheint die TextBox."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À l’ouverture d’un onglet, d’une division ou d’un espace de travail de terminal, la TextBox s’affiche."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند فتح علامة تبويب طرفية أو تقسيم أو مساحة عمل، يظهر TextBox."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al abrir una pestaña de terminal, una división o un espacio de trabajo, se muestra el TextBox."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟終端機標籤頁、分割或工作區時顯示 TextBox。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开终端标签页、分屏或工作区时显示 TextBox。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널 탭, 분할 또는 작업 공간을 열면 TextBox가 표시됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルタブ、分割、またはワークスペースを開くと、TextBox が表示されます。"
          }
        }
      }
    },
