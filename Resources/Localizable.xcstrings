    "cli.tmux-compat.error.managedTerminalRequired": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ must be launched from a Bree-managed terminal surface. Open a terminal surface in Bree and run this command there."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ must be launched from a Bree-managed terminal surface. Open a terminal surface in Bree and run this command there."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は Bree が管理するターミナルサーフェスから起動する必要があります。Bree でターミナルサーフェスを開き、そこでこのコマンドを実行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 必须从 Bree 管理的终端表面启动。请在 Bree 中打开一个终端表面，并在其中运行此命令。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ muss von einer von Bree verwalteten Terminal-Oberfläche gestartet werden. Öffnen Sie eine Terminal-Oberfläche in Bree und führen Sie diesen Befehl dort aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ doit être lancé depuis une surface d'affichage de terminal gérée par Bree. Ouvrez une surface d'affichage de terminal dans Bree et exécutez-y cette commande."
          }
        },
        "ar": {
