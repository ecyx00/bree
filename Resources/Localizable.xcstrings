    "session.import.error.nothingRestored": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ içindeki hiçbir şey yeniden açılamadı."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
