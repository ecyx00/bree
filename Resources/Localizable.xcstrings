    "settings.browser.searchEngine.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُستخدم بواسطة شريط عنوان المتصفح عندما لا يكون الإدخال URL."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Koristi se u adresnoj traci preglednika kada unos nije URL."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruges af browserens adresselinje, når input ikke er en URL."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird von der Browser-Adressleiste verwendet, wenn die Eingabe keine URL ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used by the browser address bar when input is not a URL."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usado por la barra de direcciones del navegador cuando la entrada no es una URL."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé par la barre d'adresse du navigateur lorsque la saisie n'est pas une URL."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizzato dalla barra degli indirizzi del browser quando l'input non è un URL."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザのアドレスバーで入力がURLでない場合に使用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력이 URL이 아닌 경우 브라우저 주소 표시줄에서 사용됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Brukes av adressefeltet i nettleseren når inndataen ikke er en URL."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używana przez pasek adresu przeglądarki, gdy dane wejściowe nie są adresem URL."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usado pela barra de endereço do navegador quando a entrada não é uma URL."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется адресной строкой браузера, когда ввод не является URL."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้โดยแถบที่อยู่เบราว์เซอร์เมื่ออินพุตไม่ใช่ URL"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Giriş bir URL olmadığında tarayıcı adres çubuğu tarafından kullanılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовується адресним рядком браузера, коли введення не є URL."
          }
        },
        "zh-Hans": {
