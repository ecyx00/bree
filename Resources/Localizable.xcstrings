    "cli.sshPtyAttach.incompatibleDaemon": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH attach stopped because the remote daemon version does not match this Bree client. Install a Bree release with its matching remote daemon, then reconnect the workspace. Do not substitute a daemon from an older release."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモートデーモンのバージョンがこの Bree クライアントと一致しないため、SSH 接続を停止しました。対応するリモートデーモンを含む Bree リリースをインストールしてから、ワークスペースに再接続してください。古いリリースのデーモンで代用しないでください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der SSH-Verbindungsaufbau wurde gestoppt, weil die Version des Remote-Daemons nicht zu diesem Bree-Client passt. Installiere eine Bree-Version mit dem zugehörigen Remote-Daemon und verbinde den Arbeitsbereich erneut. Verwende keinen Daemon einer älteren Version."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion SSH a été interrompue car la version du démon distant ne correspond pas à ce client Bree. Installez une version de Bree avec le démon distant correspondant, puis reconnectez l’espace de travail. Ne le remplacez pas par le démon d’une ancienne version."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إيقاف اتصال SSH لأن إصدار البرنامج الخفي البعيد لا يطابق عميل Bree هذا. ثبّت إصدار Bree مع البرنامج الخفي البعيد المطابق له، ثم أعد توصيل مساحة العمل. لا تستخدم برنامجًا خفيًا من إصدار أقدم."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión SSH se detuvo porque la versión del demonio remoto no coincide con este cliente Bree. Instala una versión de Bree con su demonio remoto correspondiente y vuelve a conectar el espacio de trabajo. No uses un demonio de una versión anterior."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 連線已停止，因為遠端常駐程式版本與此 Bree 用戶端不符。請安裝包含對應遠端常駐程式的 Bree 版本，再重新連線工作區。請勿使用舊版本的常駐程式替代。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 连接已停止，因为远程守护进程版本与此 Bree 客户端不匹配。请安装包含对应远程守护进程的 Bree 版本，然后重新连接工作区。请勿使用旧版本的守护进程替代。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원격 데몬 버전이 이 Bree 클라이언트와 일치하지 않아 SSH 연결을 중단했습니다. 해당 원격 데몬이 포함된 Bree 릴리스를 설치한 후 작업 공간에 다시 연결하세요. 이전 릴리스의 데몬으로 대체하지 마세요."
          }
        }
      }
    },
    "cli.sshPtyAttach.terminalModeFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH attach stopped because terminal input could not be placed in raw forwarding mode. Reconnect the workspace to try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナル入力を raw 転送モードに切り替えられなかったため、SSH 接続を停止しました。ワークスペースに再接続して再試行してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der SSH-Verbindungsaufbau wurde gestoppt, weil die Terminaleingabe nicht in den Raw-Weiterleitungsmodus wechseln konnte. Verbinde den Arbeitsbereich erneut, um es noch einmal zu versuchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion SSH a été interrompue car la saisie du terminal n’a pas pu passer en mode de transmission brute. Reconnectez l’espace de travail pour réessayer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إيقاف اتصال SSH لتعذر وضع إدخال الطرفية في وضع التمرير الخام. أعد توصيل مساحة العمل للمحاولة مجددًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión SSH se detuvo porque la entrada del terminal no pudo pasar al modo de reenvío sin procesar. Vuelve a conectar el espacio de trabajo para intentarlo de nuevo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 連線已停止，因為無法將終端機輸入切換為原始轉送模式。請重新連線工作區再試一次。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 连接已停止，因为无法将终端输入切换为原始转发模式。请重新连接工作区再试一次。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널 입력을 원시 전달 모드로 전환할 수 없어 SSH 연결을 중단했습니다. 작업 공간에 다시 연결하여 재시도하세요."
          }
        }
      }
    },
