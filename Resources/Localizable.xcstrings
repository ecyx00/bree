    "settings.textBox.defaultSubmitAction.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used for new terminal sessions. Active Claude, Codex, OpenCode, and Pi sessions always submit as text entry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいターミナルセッションで使います。アクティブな Claude、Codex、OpenCode、Pi セッションでは常にテキスト入力として送信します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于新的终端会话。活动的 Claude、Codex、OpenCode 和 Pi 会话始终以文本输入方式提交。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird für neue Terminal-Sitzungen verwendet. Aktive Claude-, Codex-, OpenCode- und Pi-Sitzungen senden Eingaben immer als Texteintrag."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé pour les nouvelles sessions de terminal. Les sessions actives Claude, Codex, OpenCode et Pi envoient toujours sous forme de texte saisi."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم لجلسات الطرفية الجديدة. تقوم جلسات Claude و Codex و OpenCode و Pi النشطة دائمًا بالإرسال كإدخال نصي."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa para nuevas sesiones de terminal. Las sesiones activas de Claude, Codex, OpenCode y Pi siempre se envían como entrada de texto."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於新的終端機工作階段。作用中的 Claude、Codex、OpenCode 與 Pi 工作階段會始終以文字輸入形式送出。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 터미널 세션에 사용됩니다. 활성화된 Claude, Codex, OpenCode, Pi 세션은 항상 텍스트 입력으로 제출됩니다."
          }
        }
      }
    },
