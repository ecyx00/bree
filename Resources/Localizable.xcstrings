    "terminal.clipboardReadConfirmation.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A program in this terminal wants to read your clipboard. Allow it only if you trust the program."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يريد برنامج في هذه الطرفية قراءة الحافظة. اسمح بذلك فقط إذا كنت تثق بالبرنامج."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Programm in diesem Terminal möchte deine Zwischenablage lesen. Erlaube es nur, wenn du dem Programm vertraust."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un programa de esta terminal quiere leer tu portapapeles. Permítelo solo si confías en el programa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un programme de ce terminal veut lire votre presse-papiers. Ne l’autorisez que si vous faites confiance à ce programme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このターミナルのプログラムがクリップボードを読み取ろうとしています。信頼できるプログラムの場合にのみ許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 터미널의 프로그램이 클립보드를 읽으려고 합니다. 프로그램을 신뢰할 수 있을 때만 허용하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此终端中的程序想要读取你的剪贴板。只有在你信任该程序时才允许。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此終端機中的程式想要讀取你的剪貼簿。只有在你信任該程式時才允許。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Program u ovom terminalu želi čitati vaš međuspremnik. Dozvolite samo ako vjerujete programu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et program i denne terminal vil læse din udklipsholder. Tillad det kun, hvis du har tillid til programmet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un programma in questo terminale vuole leggere gli appunti. Consentilo solo se ti fidi del programma."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "កម្មវិធីក្នុងស្ថានីយនេះចង់អានក្ដារតម្បៀតខ្ទាស់របស់អ្នក។ អនុញ្ញាតតែបើអ្នកទុកចិត្តកម្មវិធីនេះ។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et program i denne terminalen vil lese utklippstavlen din. Tillat det bare hvis du stoler på programmet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Program w tym terminalu chce odczytać schowek. Zezwól tylko, jeśli ufasz temu programowi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um programa neste terminal quer ler sua área de transferência. Permita somente se você confiar no programa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Программа в этом терминале хочет прочитать буфер обмена. Разрешайте только программам, которым доверяете."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรแกรมในเทอร์มินัลนี้ต้องการอ่านคลิปบอร์ดของคุณ อนุญาตเฉพาะเมื่อคุณเชื่อถือโปรแกรมนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu terminaldeki bir program panonuzu okumak istiyor. Yalnızca programa güveniyorsanız izin verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Програма в цьому терміналі хоче прочитати ваш буфер обміну. Дозволяйте, лише якщо довіряєте програмі."
          }
        }
      }
    },
