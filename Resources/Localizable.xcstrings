    "settings.terminal.scrollSpeed.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Multiplier applied to terminal scroll wheel and trackpad deltas. Higher scrolls faster."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルのスクロールホイールとトラックパッドの移動量に適用される倍率です。大きいほど速くスクロールします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用于终端滚轮和触控板增量的倍数。数值越大滚动越快。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Multiplikator für Terminal-Mausrad- und Trackpad-Deltas. Höhere Werte scrollen schneller."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Multiplicateur appliqué aux deltas de la molette de défilement et du pavé tactile du terminal. Une valeur plus élevée fait défiler plus vite."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المضاعف المطبق على الفروق في عجلة تمرير الطرفية ولوحة التتبع. القيم الأعلى تمرر بشكل أسرع."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Multiplicador aplicado a los cambios de la rueda de desplazamiento y del trackpad de la terminal. Un valor más alto desplaza más rápido."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "套用至終端機滾輪與軌跡板位移量的倍數。數值越高，捲動越快。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널 스크롤 휠 및 트랙패드 델타에 적용되는 승수입니다. 높은 값일수록 더 빠르게 스크롤됩니다."
          }
        }
      }
    },
