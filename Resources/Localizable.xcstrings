        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "browser.hiddenWebViewDiscardMode memory saver budget timer hidden tabs discard unload توفير الذاكرة وضع ميزانية مؤقت علامات تبويب مخفية تجاهل إلغاء تحميل"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "browser.hiddenWebViewDiscardMode memory saver budget timer hidden tabs discard unload ahorro de memoria modo presupuesto temporizador pestañas ocultas descartar descargar"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "browser.hiddenWebViewDiscardMode memory saver budget timer hidden tabs discard unload 記憶體節省 方式 預算 計時器 隱藏 標籤頁 捨棄 卸載"
