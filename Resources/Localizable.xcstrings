    "socket.bree.error.pinNotAllowed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن تثبيت الملفات الموجودة داخل المشروع فقط."
          }
        },
        "de": {
