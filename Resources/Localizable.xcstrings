    "cli.workflow.guidance.recipe": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the recipe and copy only the needed top-level keys into .bree/bree.json or ~/.config/bree/bree.json. Add .bree/dock.json when the example uses Dock."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne das Rezept und kopiere nur die benötigten obersten Schlüssel nach .bree/bree.json oder ~/.config/bree/bree.json. Füge .bree/dock.json hinzu, wenn das Beispiel Dock verwendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez la recette et copiez uniquement les clés de premier niveau nécessaires dans .bree/bree.json ou ~/.config/bree/bree.json. Ajoutez .bree/dock.json si l’exemple utilise le Dock."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح الوصفة وانسخ المفاتيح العلوية المطلوبة فقط إلى .bree/bree.json أو ~/.config/bree/bree.json. أضف .bree/dock.json عندما يستخدم المثال Dock."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la receta y copia solo las claves de nivel superior necesarias en .bree/bree.json o ~/.config/bree/bree.json. Añade .bree/dock.json si el ejemplo usa Dock."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟配方，只將需要的頂層鍵複製到 .bree/bree.json 或 ~/.config/bree/bree.json。範例使用 Dock 時再加入 .bree/dock.json。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开配方，只将需要的顶层键复制到 .bree/bree.json 或 ~/.config/bree/bree.json。示例使用 Dock 时再添加 .bree/dock.json。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레시피를 열고 필요한 최상위 키만 .bree/bree.json 또는 ~/.config/bree/bree.json에 복사합니다. 예시가 Dock을 사용하면 .bree/dock.json도 추가합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシピを開き、必要なトップレベルキーだけを .bree/bree.json または ~/.config/bree/bree.json にコピーします。例で Dock を使う場合は .bree/dock.json も追加します。"
          }
        }
      }
    },
    "cli.workflow.guidance.adapt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace sample paths, commands, URLs, tool names, and placements with values for this repository."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ersetze Beispielpfade, Befehle, URLs, Toolnamen und Platzierungen durch Werte dieses Repositorys."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
