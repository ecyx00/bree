    "browser.import.warning.additionalDataUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bookmarks, settings, and extensions import are not available yet. Imported cookies and history only."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブックマーク、設定、拡張機能のインポートにはまだ対応していません。Cookieと履歴のみを取り込みました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "북마크, 설정, 확장 프로그램 가져오기는 아직 지원되지 않습니다. 쿠키와 방문 기록만 가져왔습니다."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Імпорт закладок, налаштувань і розширень ще недоступний. Імпортовано лише cookies та історію."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "书签、设置和扩展的导入尚不可用。仅导入了 Cookie 和历史记录。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Import von Lesezeichen, Einstellungen und Erweiterungen ist noch nicht verfügbar. Es wurden nur Cookies und der Verlauf importiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'importation des favoris, des paramètres et des extensions n'est pas encore disponible. Seuls les cookies et l'historique ont été importés."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استيراد الإشارات المرجعية والإعدادات والإضافات غير متاح بعد. تم استيراد ملفات تعريف الارتباط والسجل فقط."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La importación de marcadores, ajustes y extensiones aún no está disponible. Solo se han importado cookies e historial."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "書籤、設定和擴充功能尚不支援匯入。僅能匯入 Cookie 和瀏覽記錄。"
          }
        }
      }
    },
