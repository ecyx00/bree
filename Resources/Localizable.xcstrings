    "settings.automation.kiro.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hooks must be installed with `bree hooks kiro install`, then run Kiro with `kiro-cli chat --agent Bree` (or set it as your default agent). They no-op outside Bree terminals."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フックは`bree hooks kiro install`でインストールし、Kiroを`kiro-cli chat --agent Bree`で起動（またはデフォルトエージェントに設定）してください。Breeターミナル外では動作しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "`bree hooks kiro install`로 훅을 설치한 다음 `kiro-cli chat --agent Bree`로 Kiro를 실행(또는 기본 에이전트로 설정)하세요. Bree 터미널 외부에서는 작동하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "必须用 `bree hooks kiro install` 安装钩子，然后用 `kiro-cli chat --agent Bree` 运行 Kiro（或将其设为默认代理）。它们在 Bree 终端之外不生效。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hooks müssen mit `bree hooks kiro install` installiert werden, führen Sie Kiro dann mit `kiro-cli chat --agent Bree` aus (oder legen Sie es als Standardagent fest). Sie haben außerhalb von Bree-Terminals keine Funktion (no-op)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les hooks doivent être installés avec `bree hooks kiro install`, puis exécutez Kiro avec `kiro-cli chat --agent Bree` (ou définissez-le comme agent par défaut). Ils n’ont aucun effet en dehors des terminaux Bree."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب تثبيت الخطافات باستخدام `bree hooks kiro install` ثم تشغيل Kiro عبر `kiro-cli chat --agent Bree` (أو تعيينه كعميلك الافتراضي). وهي لا تؤدي أي وظيفة خارج طرفيات Bree."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ganchos se deben instalar con `bree hooks kiro install`, luego ejecute Kiro con `kiro-cli chat --agent Bree` (o establézcalo como su agente predeterminado). No realizan ninguna operación fuera de las terminales de Bree."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "必須透過 `bree hooks kiro install` 安裝 Hook，然後使用 `kiro-cli chat --agent Bree` 執行 Kiro（或將其設定為您的預設代理程式）。它們在 Bree 終端機外不會執行任何操作。"
          }
        }
      }
    },
