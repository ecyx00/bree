    "agentHibernation.manual.teardownRefused": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The agent changed or its session could not be protected, so it was left running. Try again later."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントが変化したか、セッションを保護できなかったため、実行したままにしました。後でもう一度お試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Agent hat sich geändert oder seine Sitzung konnte nicht geschützt werden, daher läuft er weiter. Versuche es später erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’agent a changé ou sa session n’a pas pu être protégée, il continue donc de tourner. Réessayez plus tard."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّر الوكيل أو تعذّرت حماية جلسته، لذا تُرك قيد التشغيل. حاول مرة أخرى لاحقًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El agente cambió o no se pudo proteger su sesión, así que sigue en ejecución. Inténtalo más tarde."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理程式有變動或其工作階段無法受保護，因此保持執行。請稍後再試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体有变化或其会话无法受到保护，因此保持运行。请稍后再试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
