    "ghosttyConfigDiagnostics.notice.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fix the file and save it; Bree reloads the config automatically."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أصلح الملف واحفظه؛ يعيد Bree تحميل الإعدادات تلقائيًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Korrigiere die Datei und speichere sie; Bree lädt die Konfiguration automatisch neu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrige el archivo y guárdalo; Bree vuelve a cargar la configuración automáticamente."
          }
        },
        "fr": {
