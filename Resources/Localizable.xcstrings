    "settings.app.fileDrop.defaultBehavior.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose what dropping files on a terminal or editor does. Holding Shift while dragging does the other."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie, was beim Ablegen von Dateien auf einem Terminal oder Editor passiert. Wenn Sie beim Ziehen die Umschalttaste gedrückt halten, gilt die andere Option."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez ce qui se passe lorsque vous déposez des fichiers sur un terminal ou un éditeur. Si vous maintenez la touche Maj enfoncée pendant le glissement, l’autre option s’applique."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر ما يحدث عند إفلات الملفات على طرفية أو محرر. يؤدي الضغط مع الاستمرار على مفتاح Shift أثناء السحب إلى تطبيق الخيار الآخر."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige qué ocurre al soltar archivos en una terminal o un editor. Si mantienes pulsada la tecla Mayúsculas al arrastrar, se usa la otra opción."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇將檔案拖放到終端機或編輯器時要執行的動作。拖移時按住 Shift 鍵可改用另一個動作。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择将文件拖放到终端或编辑器时执行的操作。拖动时按住 Shift 键可改用另一种操作。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 터미널이나 편집기에 드롭했을 때 수행할 동작을 선택합니다. 드래그 중에 Shift 키를 누르고 있으면 다른 쪽 동작을 수행합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルをターミナルやエディタにドロップしたときの動作を選択します。ドラッグ中に Shift キーを押したままにすると、もう一方の動作になります。"
          }
        }
      }
    },
    "settings.app.focusHistoryIncludesPanesAndTabs.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Using Back and Forward also returns to previous panes and tabs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit „Zurück“ und „Vor“ kehren Sie auch zu vorherigen Teilfenstern und Tabs zurück."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Précédent et Suivant ramènent aussi aux volets et aux onglets précédents."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينتقل «رجوع» و«تقدم» أيضًا إلى الأجزاء وعلامات التبويب السابقة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
