    "settings.browser.askWhereToSaveDownloads.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When off, browser downloads save directly to Downloads without a save panel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフの場合、ブラウザのダウンロードは保存パネルなしで直接「ダウンロード」に保存されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭时，浏览器下载会直接保存到「下载」文件夹，不显示存储面板。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn deaktiviert, werden Browser-Downloads ohne Speichern-Panel direkt im Downloads-Ordner gespeichert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsqu’elle est désactivée, les téléchargements du navigateur s’enregistrent directement dans Téléchargements sans panneau d’enregistrement."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند إيقاف التشغيل، تُحفظ تنزيلات المتصفح مباشرة في مجلد التنزيلات دون لوحة حفظ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando está desactivado, las descargas del navegador se guardan directamente en Descargas sin un panel de guardado."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉時，瀏覽器下載的檔案會直接儲存到「下載」資料夾，不顯示儲存面板。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 설정을 끄면 브라우저 다운로드 파일이 저장 패널 없이 다운로드 폴더에 바로 저장됩니다."
          }
        }
      }
    },
