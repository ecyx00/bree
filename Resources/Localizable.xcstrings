    "settings.app.preferredEditor.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Command used when Cmd-click file previews are disabled or a file is unsupported. Leave empty for system default."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cmd+クリックのファイルプレビューが無効な場合、またはファイルが未対応の場合に使うコマンドです。空欄のままにするとシステムの既定で開きます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "禁用 Cmd+点击文件预览或文件不受支持时使用的命令。留空则使用系统默认。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Befehl, der verwendet wird, wenn Cmd-Klick-Dateivorschauen deaktiviert sind oder eine Datei nicht unterstützt wird. Für Standardeinstellung des Systems leer lassen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commande utilisée lorsque les aperçus de fichiers par Cmd-clic sont désactivés ou qu’un fichier n’est pas pris en charge. Laisser vide pour utiliser la valeur par défaut du système."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأمر المستخدم عند تعطيل معاينات الملفات عبر Cmd-click أو عندما يكون الملف غير مدعوم. اتركه فارغًا لاستخدام الخيار الافتراضي للنظام."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comando utilizado cuando las previsualizaciones de archivos con Cmd-clic están deshabilitadas o un archivo no es compatible. Déjalo vacío para usar el valor predeterminado del sistema."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當停用 Cmd+點擊檔案預覽或不支援檔案時所使用的命令。留空則使用系統預設值。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일의 Cmd-클릭 미리보기가 비활성화되어 있거나 지원되지 않는 파일일 때 사용할 명령입니다. 시스템 기본값을 사용하려면 비워 두세요."
          }
        }
      }
    },
