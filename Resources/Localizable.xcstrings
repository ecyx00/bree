    "markdown.web.remoteImageConsentMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree will not contact this image URL until you load this image."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画像を読み込むまで、Bree はこの画像 URL に接続しません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree kontaktiert diese Bild-URL erst, wenn Sie dieses Bild laden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree ne contactera pas l'URL de cette image tant que vous n'aurez pas chargé cette image."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يتصل Bree بعنوان URL للصورة حتى تقوم بتحميل هذه الصورة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree no se comunicará con la URL de esta imagen hasta que la cargue."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在您載入此圖像之前，Bree 不會聯絡此圖像 URL。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你加载此图片之前，Bree 不会访问该图片 URL。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree는 이 이미지를 로드할 때까지 이 이미지 URL에 접속하지 않습니다."
          }
        }
      }
    },
