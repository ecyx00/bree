    "session.import.error.newerSchema": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ daha yeni bir Bree tarafından kaydedildi (oturum biçimi %2$@, bu Bree %3$@ okur). İçe aktarmak için Bree'yi güncelleyin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ was saved by a newer Bree (session format %2$@, this Bree reads %3$@). Update Bree to import it."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حُفظ %1$@ بواسطة إصدار أحدث من Bree (تنسيق الجلسة %2$@، ويقرأ هذا الـ Bree التنسيق %3$@). حدّث Bree لاستيراده."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ wurde von einem neueren Bree gespeichert (Sitzungsformat %2$@, dieses Bree liest %3$@). Aktualisieren Sie Bree, um die Datei zu importieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ se guardó con un Bree más reciente (formato de sesión %2$@; este Bree lee el %3$@). Actualiza Bree para importarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a été enregistré par une version plus récente de Bree (format de session %2$@, ce Bree lit le format %3$@). Mettez Bree à jour pour l'importer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ は新しい Bree で保存されています（セッション形式 %2$@、この Bree が読める形式は %3$@）。読み込むには Bree をアップデートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 파일은 더 새로운 Bree에서 저장되었습니다(세션 형식 %2$@, 이 Bree는 %3$@ 형식을 읽음). 가져오려면 Bree를 업데이트하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 由较新版本的 Bree 保存（会话格式 %2$@，此 Bree 读取 %3$@）。请更新 Bree 后再导入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 是由較新版本的 Bree 儲存（工作階段格式 %2$@，此 Bree 讀取 %3$@）。請更新 Bree 後再匯入。"
          }
        }
      }
    },
