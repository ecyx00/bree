    "feed.push.error.exclusiveEventShape": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "feed.push accepts either `event` or `events`, not both"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "feed.push には `event` または `events` のいずれか一方のみを指定できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "feed.push 只接受 `event` 或 `events` 之一，不能同时提供"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "feed.push akzeptiert entweder `event` oder `events`, nicht beides"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "feed.push accepte soit `event`, soit `events`, mais pas les deux"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقبل feed.push إما `event` أو `events` وليس كلاهما"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "feed.push acepta `` `event` `` o `` `events` ``, no ambos"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "feed.push 僅接受 `event` 或 `events` 其中之一，不能同時接受兩者"
          }
        },
        "ko": {
