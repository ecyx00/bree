    "cli.ssh.mosh.addressFallback": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] أعلن SSH البعيد عن عنوان غير صالح؛ سيتم تحديد عنوان Mosh عبر اتصال SSH."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Udaljeni SSH je prijavio neupotrebljivu adresu; Mosh adresa se određuje kroz SSH vezu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Fjern-SSH annoncerede en ugyldig adresse; Mosh-adressen findes via SSH-forbindelsen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Der Remote-SSH-Dienst meldete eine unbrauchbare Adresse; die Mosh-Adresse wird über die SSH-Verbindung ermittelt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Remote SSH advertised an unusable address; resolving the Mosh address through the SSH connection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] El SSH remoto anunció una dirección no utilizable; la dirección de Mosh se resolverá a través de la conexión SSH."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Le SSH distant a annoncé une adresse inutilisable ; l’adresse Mosh est résolue via la connexion SSH."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] SSH remoto ha annunciato un indirizzo inutilizzabile; l’indirizzo Mosh viene risolto tramite la connessione SSH."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] リモート SSH が使用できないアドレスを通知したため、SSH 接続経由で Mosh のアドレスを解決します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] SSH ពីចម្ងាយបានប្រកាសអាសយដ្ឋានដែលមិនអាចប្រើបាន ដូច្នេះដោះស្រាយអាសយដ្ឋាន Mosh តាមរយៈការតភ្ជាប់ SSH។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] 원격 SSH가 사용할 수 없는 주소를 알렸습니다. SSH 연결을 통해 Mosh 주소를 확인합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Ekstern SSH oppga en ubrukelig adresse; Mosh-adressen løses via SSH-forbindelsen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Zdalny SSH ogłosił nieużyteczny adres; adres Mosh jest ustalany przez połączenie SSH."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] O SSH remoto anunciou um endereço inutilizável; resolvendo o endereço do Mosh pela conexão SSH."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Удалённый SSH сообщил непригодный адрес; адрес Mosh определяется через SSH-подключение."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] SSH ระยะไกลแจ้งที่อยู่ที่ใช้ไม่ได้ จึงค้นหาที่อยู่ Mosh ผ่านการเชื่อมต่อ SSH"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Uzak SSH kullanılamayan bir adres bildirdi; Mosh adresi SSH bağlantısı üzerinden çözümleniyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Віддалений SSH повідомив непридатну адресу; адреса Mosh визначається через SSH-з’єднання."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] 远程 SSH 宣布的地址不可用；将通过 SSH 连接解析 Mosh 地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] 遠端 SSH 回報的位址無法使用；將透過 SSH 連線解析 Mosh 位址。"
          }
        }
      }
    },
    "cli.ssh.mosh.bootstrapInstallFailed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] فشل تثبيت التمهيد البعيد؛ جارٍ المتابعة عبر SSH."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Instalacija udaljenog pokretanja nije uspjela; nastavak putem SSH-a."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Installation af fjern-bootstrap mislykkedes; fortsætter via SSH."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Installation des Remote-Bootstraps fehlgeschlagen; Verbindung wird über SSH fortgesetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Remote bootstrap install failed; continuing over SSH."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Falló la instalación del arranque remoto; se continuará mediante SSH."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Échec de l’installation du bootstrap distant ; poursuite via SSH."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Installazione del bootstrap remoto non riuscita; continuazione tramite SSH."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] リモートブートストラップのインストールに失敗したため、SSH で接続を続行します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] ការដំឡើង bootstrap ពីចម្ងាយបានបរាជ័យ ដូច្នេះបន្តតាម SSH។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] 원격 부트스트랩 설치에 실패하여 SSH로 계속합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Installasjon av ekstern bootstrap mislyktes; fortsetter via SSH."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Instalacja zdalnego bootstrapu nie powiodła się; kontynuowanie przez SSH."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Falha ao instalar o bootstrap remoto; continuando por SSH."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Не удалось установить удалённый bootstrap; продолжение через SSH."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] ติดตั้ง bootstrap ระยะไกลไม่สำเร็จ จึงดำเนินการต่อผ่าน SSH"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Uzak bootstrap kurulamadı; SSH üzerinden devam ediliyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Не вдалося встановити віддалений bootstrap; продовження через SSH."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] 远程引导安装失败；将继续使用 SSH。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] 遠端 bootstrap 安裝失敗；將繼續使用 SSH。"
          }
        }
      }
    },
