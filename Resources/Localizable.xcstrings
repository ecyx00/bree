          "stringUnit": {
            "state": "translated",
            "value": "restore：儲存的程序無法啟動。請重試可見的 restore 指令。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: 저장된 프로세스를 시작할 수 없습니다. 표시된 restore 명령을 다시 시도하십시오."
          }
        }
      }
    },
    "cli.restore.error.currentSurfaceUnknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
