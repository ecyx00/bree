    "cli.socketControlStatus.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم ‎--json‎ لمصدر الملف الشخصي وملاحظة مسار المقبس. لا يتصل هذا الأمر بمقبس التشغيل الآلي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie --json für Profilquelle und Socket-Pfadstatus. Dieser Befehl verbindet sich nie mit dem Automatisierungs-Socket."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use --json for the profile source and socket-path observation. This command never connects to the automation socket."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa --json para ver el origen del perfil y el estado de la ruta del socket. Este comando nunca se conecta al socket de automatización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez --json pour la source du profil et l'observation du chemin du socket. Cette commande ne se connecte jamais au socket d'automatisation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロファイルのソースとソケットパスの状態は --json で確認できます。このコマンドは自動化ソケットに接続しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로필 소스와 소켓 경로 상태는 --json으로 확인하세요. 이 명령은 자동화 소켓에 연결하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 --json 查看配置文件来源和套接字路径观测。此命令不会连接自动化套接字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 --json 查看描述檔來源與 Socket 路徑觀測。此指令不會連線至自動化 Socket。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Koristite --json za izvor profila i stanje putanje socketa. Ova naredba se nikada ne povezuje na automatizacijski socket."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug --json til profilkilden og observation af socketstien. Denne kommando opretter aldrig forbindelse til automatiseringssocketen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa --json per la fonte del profilo e lo stato del percorso del socket. Questo comando non si connette mai al socket di automazione."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ប្រើ --json សម្រាប់ប្រភពប្រវត្តិរូប និងស្ថានភាពផ្លូវ socket។ ពាក្យបញ្ជានេះមិនភ្ជាប់ទៅ socket ស្វ័យប្រវត្តិកម្មទេ។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk --json for profilkilden og observasjon av socketbanen. Denne kommandoen kobler aldri til automatiseringssocketen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj --json, aby zobaczyć źródło profilu i stan ścieżki gniazda. To polecenie nigdy nie łączy się z gniazdem automatyzacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use --json para ver a origem do perfil e a observação do caminho do socket. Este comando nunca se conecta ao socket de automação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте --json для источника профиля и состояния пути сокета. Эта команда никогда не подключается к сокету автоматизации."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ --json เพื่อดูแหล่งที่มาของโปรไฟล์และสถานะเส้นทางซ็อกเก็ต คำสั่งนี้จะไม่เชื่อมต่อซ็อกเก็ตการทำงานอัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil kaynağını ve soket yolu gözlemini görmek için --json kullanın. Bu komut otomasyon soketine asla bağlanmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуйте --json для джерела профілю та стану шляху сокета. Ця команда ніколи не підключається до сокета автоматизації."
          }
        }
      }
    },
