    "browser.profile.automation.error.profileNotFound": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' ile eşleşen Bree tarayıcı profili yok. Mevcut profilleri listelemek için 'bree browser profiles' komutunu çalıştırın."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Bree browser profile matches '%@'. Run 'bree browser profiles' to list available profiles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' に一致する Bree ブラウザープロファイルが見つかりません。使用可能なプロファイルを表示するには 'bree browser profiles' を実行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有匹配 '%@' 的 Bree 浏览器配置文件。运行 'bree browser profiles' 可列出可用的配置文件。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Bree-Browserprofil entspricht „%@“. Führe 'bree browser profiles' aus, um die verfügbaren Profile aufzulisten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun profil de navigateur Bree ne correspond à '%@'. Exécutez 'bree browser profiles' pour lister les profils disponibles."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد ملف تعريف متصفح Bree يطابق '%@'. شغّل 'bree browser profiles' لسرد ملفات التعريف المتاحة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún perfil de navegador de Bree coincide con '%@'. Ejecuta 'bree browser profiles' para ver la lista de perfiles disponibles."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有符合「%@」的 Bree 瀏覽器設定檔。請執行 'bree browser profiles' 來列出所有可用的設定檔。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@'과 일치하는 Bree 브라우저 프로필이 없습니다. 사용 가능한 프로필 목록을 보려면 'bree browser profiles'를 실행하세요."
          }
        }
      }
    },
    "browser.profile.automation.error.profileRenameFailed": {
      "extractionState": "manual",
      "localizations": {
