    "socket.surfaceSyncCodexNativeTitle.invalidTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Missing or invalid title"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトルが指定されていないか無効です"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Titel fehlt oder ist ungültig"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Titre manquant ou non valide"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العنوان مفقود أو غير صالح"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta el título o no es válido"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "缺少標題或標題無效"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缺少标题或标题无效"
          }
        },
        "ko": {
