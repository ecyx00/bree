    "cli.restore.error.routedLauncherNotFound": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: this session was started with '%1$@ claude proxy', but '%1$@' is not on PATH in this shell. Add it to PATH, then retry."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: this session was started with '%1$@ claude proxy', but '%1$@' is not on PATH in this shell. Add it to PATH, then retry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: このセッションは「%1$@ claude proxy」で起動されましたが、このシェルの PATH に「%1$@」がありません。PATH に追加してから、再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "restore：此会话是通过“%1$@ claude proxy”启动的，但此 shell 的 PATH 中没有“%1$@”。请将其添加到 PATH，然后重试。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: Diese Sitzung wurde mit „%1$@ claude proxy“ gestartet, aber „%1$@“ ist in dieser Shell nicht im PATH. Fügen Sie es zum PATH hinzu und versuchen Sie es dann erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "restore : cette session a été démarrée avec « %1$@ claude proxy », mais « %1$@ » n'est pas dans le PATH de ce shell. Ajoutez-le au PATH, puis réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: بدأت هذه الجلسة باستخدام '%1$@ claude proxy'، لكن '%1$@' غير موجود في PATH في هذه الصدفة. أضفه إلى PATH، ثم أعد المحاولة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: esta sesión se inició con '%1$@ claude proxy', pero '%1$@' no está en el PATH de este shell. Agréguelo al PATH y vuelva a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "restore：此工作階段是以「%1$@ claude proxy」啟動的，但此 shell 的 PATH 中沒有「%1$@」。請將其加入 PATH，然後重試。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: 이 세션은 '%1$@ claude proxy'로 시작되었지만 이 셸의 PATH에 '%1$@'이(가) 없습니다. PATH에 추가한 후 다시 시도하십시오."
          }
        }
      }
    },
    "settings.terminal.textEditingCommandMovesByWord": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Command Moves by Word"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Command ينقل حسب الكلمة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Befehlstaste bewegt wortweise"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comando mueve por palabra"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commande déplace par mot"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Command で単語単位に移動"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Command로 단어 단위 이동"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Command 按词移动"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Command 依字移動"
          }
        }
      }
    },
    "settings.terminal.textEditingCommandMovesByWord.subtitleOn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Command arrow and delete keys move and delete by word, like Option. Control Left and Right Arrow move to the start and end of the line."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنقل مفاتيح الأسهم والحذف مع Command وتحذف حسب الكلمة، مثل Option. وينقل Control مع السهمين الأيسر والأيمن إلى بداية السطر ونهايته."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Befehlstaste mit Pfeil- und Löschtasten bewegt und löscht wortweise, wie die Wahltaste. Control mit Links- und Rechtspfeil springt an Anfang und Ende der Zeile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las flechas y la tecla Eliminar con Comando mueven y borran por palabra, como Opción. Control con las flechas izquierda y derecha va al inicio y al final de la línea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les flèches et la touche Supprimer avec Commande déplacent et suppriment par mot, comme Option. Contrôle avec les flèches gauche et droite va au début et à la fin de la ligne."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Command と矢印キー・削除キーで、Option と同じく単語単位に移動・削除します。Control と左右矢印キーで行頭・行末に移動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Command 화살표 및 삭제 키가 Option처럼 단어 단위로 이동하고 삭제합니다. Control 왼쪽 및 오른쪽 화살표는 줄의 시작과 끝으로 이동합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Command 加方向键和删除键按词移动和删除，与 Option 相同。Control 加左右方向键移到行首和行尾。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Command 加方向鍵與刪除鍵會依字移動與刪除，與 Option 相同。Control 加左右方向鍵會移到行首與行尾。"
          }
        }
      }
    },
    "settings.terminal.textEditingCommandMovesByWord.subtitleOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Command arrow and delete keys move and delete by line, as in macOS text fields."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنقل مفاتيح الأسهم والحذف مع Command وتحذف حسب السطر، كما في حقول النص في macOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Befehlstaste mit Pfeil- und Löschtasten bewegt und löscht zeilenweise, wie in macOS-Textfeldern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las flechas y la tecla Eliminar con Comando mueven y borran por línea, como en los campos de texto de macOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les flèches et la touche Supprimer avec Commande déplacent et suppriment par ligne, comme dans les champs de texte de macOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Command と矢印キー・削除キーで、macOS のテキストフィールドと同じく行単位に移動・削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Command 화살표 및 삭제 키가 macOS 텍스트 필드처럼 줄 단위로 이동하고 삭제합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Command 加方向键和删除键按行移动和删除，与 macOS 文本框相同。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Command 加方向鍵與刪除鍵會依行移動與刪除，與 macOS 文字欄位相同。"
          }
        }
      }
    },
    "settings.terminal.textEditingGesturesInFullScreenApps": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text Editing Gestures in Full-Screen Apps"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إيماءات تحرير النص في التطبيقات بملء الشاشة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Textbearbeitungsgesten in Vollbild-Apps"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestos de edición de texto en apps a pantalla completa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestes d’édition de texte dans les apps plein écran"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルスクリーンアプリでのテキスト編集ジェスチャー"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 화면 앱에서 텍스트 편집 제스처"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全屏应用中的文本编辑手势"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "全螢幕 App 中的文字編輯手勢"
          }
        }
      }
    },
    "settings.terminal.textEditingGesturesInFullScreenApps.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestures also apply while a full-screen app such as vim, less, or tmux is running, so they keep working at a shell inside tmux, screen, or zellij."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنطبق الإيماءات أيضًا أثناء تشغيل تطبيق بملء الشاشة مثل vim أو less أو tmux، فتظل تعمل في الصدفة داخل tmux أو screen أو zellij."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesten gelten auch, während eine Vollbild-App wie vim, less oder tmux läuft, und funktionieren so weiter an einer Shell in tmux, screen oder zellij."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los gestos también se aplican mientras se ejecuta una app a pantalla completa como vim, less o tmux, así que siguen funcionando en una shell dentro de tmux, screen o zellij."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les gestes s’appliquent aussi lorsqu’une app plein écran comme vim, less ou tmux est en cours d’exécution, et continuent donc de fonctionner dans un shell sous tmux, screen ou zellij."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "vim、less、tmux などのフルスクリーンアプリの実行中もジェスチャーが有効になるため、tmux、screen、zellij 内のシェルでも引き続き使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "vim, less, tmux 같은 전체 화면 앱이 실행 중일 때도 제스처가 적용되므로 tmux, screen, zellij 안의 셸에서도 계속 작동합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 vim、less 或 tmux 等全屏应用运行时手势也会生效，因此在 tmux、screen 或 zellij 中的 shell 里仍可使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 vim、less 或 tmux 等全螢幕 App 執行時手勢也會生效，因此在 tmux、screen 或 zellij 中的 shell 裡仍可使用。"
          }
        }
      }
    },
    "command.copyWorkingDirectory.title": {
      "extractionState": "manual",
      "localizations": {
