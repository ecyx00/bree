    "agent.codex.fork.notice.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree could not identify the new fork session. Start the fork again from the parent pane."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree は新しいフォーク セッションを特定できませんでした。親ペインからもう一度フォークしてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree konnte die neue Fork-Sitzung nicht erkennen. Starten Sie den Fork erneut im übergeordneten Pane."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree n’a pas pu identifier la nouvelle session forkée. Relancez le fork depuis le volet parent."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر على Bree تحديد جلسة التفريع الجديدة. ابدأ التفريع مرة أخرى من الجزء الأصلي."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree no pudo identificar la nueva sesión bifurcada. Inicia el fork de nuevo desde el panel principal."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree 無法識別新的分支工作階段。請從父窗格重新開始分支。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree 无法识别新的分支会话。请从父窗格重新开始分支。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree가 새 포크 세션을 식별하지 못했습니다. 부모 패널에서 포크를 다시 시작하세요."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree nije mogao prepoznati novu sesiju račvanja. Ponovo pokrenite račvanje iz nadređenog okna."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree kunne ikke identificere den nye forgreningssession. Start forgreningen igen fra forældreruden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree non ha potuto identificare la nuova sessione fork. Avvia di nuovo il fork dal riquadro principale."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree មិនអាចកំណត់អត្តសញ្ញាណសម័យ fork ថ្មីបានទេ។ ចាប់ផ្ដើម fork ម្ដងទៀតពីផ្ទាំងមេ។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree kunne ikke identifisere den nye forgreningsøkten. Start forgreningen på nytt fra den overordnede ruten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree nie mógł zidentyfikować nowej sesji forka. Uruchom fork ponownie z panelu nadrzędnego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Bree não conseguiu identificar a nova sessão bifurcada. Inicie o fork novamente no painel principal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree не удалось определить новый сеанс форка. Запустите форк снова из родительской панели."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree ไม่สามารถระบุเซสชันที่แยกใหม่ได้ เริ่มการแยกอีกครั้งจากบานหน้าต่างหลัก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree yeni fork oturumunu belirleyemedi. Fork'u üst panelden yeniden başlatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree не вдалося визначити новий сеанс форка. Запустіть форк ще раз із батьківської панелі."
          }
        }
      }
    },
    "agent.codex.fork.notice.parentClearFailed.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree could not safely detach the parent session, so the fork was not started. Retry the fork from the parent pane."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree は新しいフォーク セッションを安全にバインドできませんでした。親ペインからもう一度フォークしてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree konnte die neue Fork-Sitzung nicht sicher binden. Starten Sie den Fork erneut im übergeordneten Pane."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree n’a pas pu lier la nouvelle session forkée en toute sécurité. Relancez le fork depuis le volet parent."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر على Bree ربط جلسة التفريع الجديدة بأمان. أعد بدء التفريع من الجزء الأصلي."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree no pudo vincular de forma segura la nueva sesión bifurcada. Inicia el fork de nuevo desde el panel principal."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree 無法安全繫結新的分支工作階段。請從父窗格重新開始分支。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree 无法安全绑定新的分支会话。请从父窗格重新开始分支。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree가 새 포크 세션을 안전하게 연결하지 못했습니다. 부모 패널에서 포크를 다시 시작하세요."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree nije mogao sigurno povezati novu sesiju račvanja. Ponovo pokrenite račvanje iz nadređenog okna."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree kunne ikke binde den nye forgreningssession sikkert. Start forgreningen igen fra forældreruden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree non ha potuto associare in sicurezza la nuova sessione fork. Avvia di nuovo il fork dal riquadro principale."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree មិនអាចភ្ជាប់សម័យ fork ថ្មីដោយសុវត្ថិភាពបានទេ។ ចាប់ផ្ដើម fork ម្ដងទៀតពីផ្ទាំងមេ។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree kunne ikke binde den nye forgreningsøkten på en trygg måte. Start forgreningen på nytt fra den overordnede ruten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree nie mógł bezpiecznie powiązać nowej sesji forka. Uruchom fork ponownie z panelu nadrzędnego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Bree não conseguiu vincular com segurança a nova sessão bifurcada. Inicie o fork novamente no painel principal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree не удалось безопасно привязать новый сеанс форка. Запустите форк снова из родительской панели."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree ไม่สามารถผูกเซสชันที่แยกใหม่ได้อย่างปลอดภัย เริ่มการแยกอีกครั้งจากบานหน้าต่างหลัก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree yeni fork oturumunu güvenli bir şekilde bağlayamadı. Fork'u üst panelden yeniden başlatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree не вдалося безпечно прив’язати новий сеанс форка. Запустіть форк ще раз із батьківської панелі."
          }
        }
      }
    },
