    "dialog.saveWorkspaceLayout.message": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu çalışma alanını %@ içinde yeniden kullanılabilir bir düzen olarak kaydeder. Yeni çalışma alanı menüsünde ve Komut Paleti'nde görünür."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves this workspace as a reusable layout in %@. It appears in the new-workspace menu and the Command Palette."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このワークスペースを再利用可能なレイアウトとして %@ に保存します。新規ワークスペースメニューとコマンドパレットに表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将此工作区保存为可重用的布局，存放在 %@。它会出现在新建工作区菜单和命令面板中。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichert diesen Arbeitsbereich als wiederverwendbares Layout in %@. Es erscheint im Menü für neue Arbeitsbereiche und in der Befehlspalette."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre cet espace de travail en tant qu'agencement réutilisable dans %@. Il apparaît dans le menu de nouvel espace de travail et dans la Palette de commandes."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحفظ مساحة العمل هذه كمخطط قابل لإعادة الاستخدام في %@. سيظهر في قائمة مساحة العمل الجديدة ولوحة الأوامر Command Palette."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda este espacio de trabajo como un diseño reutilizable en %@. Aparecerá en el menú de nuevo espacio de trabajo y en la paleta de comandos."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將此工作區儲存為 %@ 中的可重複使用配置。它將會顯示在「新工作區」選單和命令面板中。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업 공간을 %@에 재사용 가능한 레이아웃으로 저장합니다. 저장된 레이아웃은 새 작업 공간 메뉴와 커맨드 팔레트에 표시됩니다."
          }
        }
      }
    },
