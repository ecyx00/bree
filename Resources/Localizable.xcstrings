          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动恢复已卸载的页面"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언로드된 페이지 자동 복원"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アンロードされたページを自動的に復元"
          }
        }
      }
    },
    "settings.browser.autoRestoreUnloadedPages.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brings back an unloaded page as soon as its tab is shown. When off, the tab shows the page's last snapshot until you click Restore."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellt eine entladene Seite wieder her, sobald ihr Tab angezeigt wird. Wenn deaktiviert, zeigt der Tab die letzte Momentaufnahme der Seite, bis Sie auf „Wiederherstellen“ klicken."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaure une page déchargée dès que son onglet est affiché. Si cette option est désactivée, l’onglet affiche le dernier aperçu de la page jusqu’à ce que vous cliquiez sur Restaurer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستعيد الصفحة التي أُلغي تحميلها بمجرد عرض علامة تبويبها. عند إيقاف هذا الخيار، تعرض علامة التبويب آخر لقطة للصفحة إلى أن تنقر على استعادة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recupera una página descargada en cuanto se muestra su pestaña. Si está desactivado, la pestaña muestra la última captura de la página hasta que hagas clic en Restaurar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤頁一顯示就還原已卸載的網頁。關閉時，標籤頁會顯示網頁的最後快照，直到你按一下「還原」。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签页一显示就恢复已卸载的页面。关闭时，标签页会显示页面的最后快照，直到你点击“恢复”。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭이 표시되는 즉시 언로드된 페이지를 복원합니다. 끄면 복원을 클릭할 때까지 탭에 페이지의 마지막 스냅샷이 표시됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブが表示されるとすぐに、アンロードされたページを復元します。オフの場合、「復元」をクリックするまでタブにはページの最後のスナップショットが表示されます。"
          }
        }
      }
    },
    "settings.search.alias.setting.browser.unloaded-page-auto-restore": {
