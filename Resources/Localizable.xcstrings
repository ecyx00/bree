    "sidebar.extensions.access.detail": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, istenen veri ve eylemleri vermenize kadar yalnızca üst veri erişimi kullanıyor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is using metadata-only access until you grant its requested data and actions."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "要求されたデータと操作を許可するまで、%@ はメタデータのみのアクセスを使用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你授予所请求的数据和操作权限之前，%@ 仅使用元数据访问权限。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ verwendet Zugriff nur für Metadaten, bis Sie die angeforderten Daten und Aktionen freigeben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ utilise un accès uniquement aux métadonnées jusqu'à ce que vous lui accordiez l'accès aux données et aux actions demandées."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم %@ وصولاً للبيانات الوصفية فقط حتى تمنحه حق الوصول إلى البيانات والإجراءات المطلوبة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está usando acceso solo a metadatos hasta que concedas los datos y acciones solicitados."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 在您授予其請求的資料與動作前，將僅能存取中介資料。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청된 데이터 및 작업 권한을 허용할 때까지 %@은(는) 메타데이터 전용 액세스를 사용합니다."
          }
        }
      }
    },
