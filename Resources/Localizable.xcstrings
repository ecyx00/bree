    "cli.automation.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage: bree automation <list|show|test|enable|disable|logs|reload> [args]\n\nRules live in ~/.bree/automations.json.\nExamples:\n  Bree automation list\n  Bree automation show surface-needs-input\n  Bree automation test surface-needs-input --event '{\"name\":\"agent.needs_input\"}'\n  Bree automation enable surface-needs-input\n  Bree automation disable surface-needs-input\n  Bree automation logs [--limit <n>]\n  Bree automation reload"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用法: bree automation <list|show|test|enable|disable|logs|reload> [引数]\n\nルールは ~/.bree/automations.json に保存されます。\n例:\n  Bree automation list\n  Bree automation show surface-needs-input\n  Bree automation test surface-needs-input --event '{\"name\":\"agent.needs_input\"}'\n  Bree automation enable surface-needs-input\n  Bree automation disable surface-needs-input\n  Bree automation logs [--limit <n>]\n  Bree automation reload"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用法：bree automation <list|show|test|enable|disable|logs|reload> [args]\n\n规则存放在 ~/.bree/automations.json。\n示例:\n  Bree automation list\n  Bree automation show surface-needs-input\n  Bree automation test surface-needs-input --event '{\"name\":\"agent.needs_input\"}'\n  Bree automation enable surface-needs-input\n  Bree automation disable surface-needs-input\n  Bree automation logs [--limit <n>]\n  Bree automation reload"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendung: bree automation <list|show|test|enable|disable|logs|reload> [args]\n\nRegeln befinden sich in ~/.bree/automations.json.\nBeispiele:\n  Bree automation list\n  Bree automation show surface-needs-input\n  Bree automation test surface-needs-input --event '{\"name\":\"agent.needs_input\"}'\n  Bree automation enable surface-needs-input\n  Bree automation disable surface-needs-input\n  Bree automation logs [--limit <n>]\n  Bree automation reload"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage : bree automation <list|show|test|enable|disable|logs|reload> [args]\n\nLes règles se trouvent dans ~/.bree/automations.json.\nExemples :\n  Bree automation list\n  Bree automation show surface-needs-input\n  Bree automation test surface-needs-input --event '{\"name\":\"agent.needs_input\"}'\n  Bree automation enable surface-needs-input\n  Bree automation disable surface-needs-input\n  Bree automation logs [--limit <n>]\n  Bree automation reload"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاستخدام: bree automation <list|show|test|enable|disable|logs|reload> [args]\n\nالقواعد موجودة في ~/.bree/automations.json.\nأمثلة:\n  Bree automation list\n  Bree automation show surface-needs-input\n  Bree automation test surface-needs-input --event '{\"name\":\"agent.needs_input\"}'\n  Bree automation enable surface-needs-input\n  Bree automation disable surface-needs-input\n  Bree automation logs [--limit <n>]\n  Bree automation reload"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Uso: bree automation <list|show|test|enable|disable|logs|reload> [args]\n\nLas reglas residen en ~/.bree/automations.json.\nEjemplos:\n  Bree automation list\n  Bree automation show surface-needs-input\n  Bree automation test surface-needs-input --event '{\"name\":\"agent.needs_input\"}'\n  Bree automation enable surface-needs-input\n  Bree automation disable surface-needs-input\n  Bree automation logs [--limit <n>]\n  Bree automation reload"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用法：bree automation <list|show|test|enable|disable|logs|reload> [args]\n\n規則位於 ~/.bree/automations.json。\n範例：\n  Bree automation list\n  Bree automation show surface-needs-input\n  Bree automation test surface-needs-input --event '{\"name\":\"agent.needs_input\"}'\n  Bree automation enable surface-needs-input\n  Bree automation disable surface-needs-input\n  Bree automation logs [--limit <n>]\n  Bree automation reload"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용법: bree automation <list|show|test|enable|disable|logs|reload> [args]\n\n규칙은 ~/.bree/automations.json에 저장됩니다.\n예시:\n  Bree automation list\n  Bree automation show surface-needs-input\n  Bree automation test surface-needs-input --event '{\"name\":\"agent.needs_input\"}'\n  Bree automation enable surface-needs-input\n  Bree automation disable surface-needs-input\n  Bree automation logs [--limit <n>]\n  Bree automation reload"
          }
        }
      }
    },
    "automation.error.encodeRPC": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not prepare the automation action. Check the rule configuration and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動化アクションを準備できませんでした。ルール設定を確認して、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法准备该自动化动作。请检查规则配置后重试。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Automatisierungsaktion konnte nicht vorbereitet werden. Überprüfen Sie die Regelkonfiguration und versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de préparer l’action d’automatisation. Vérifiez la configuration de la règle et réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر تحضير إجراء الأتمتة. تحقق من تكوين القاعدة وحاول مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo preparar la acción de automatización. Verifique la configuración de la regla e intente nuevamente."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法準備自動化動作。請檢查規則設定並重試。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동화 작업을 준비할 수 없습니다. 규칙 구성을 확인하고 다시 시도하세요."
          }
        }
      }
    },
    "automation.error.engineUnavailable": {
