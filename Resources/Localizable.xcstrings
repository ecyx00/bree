            "value": "restore: the current Bree surface could not be identified. Retry from this terminal or pass --surface <id|ref>."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: 現在の Bree サーフェスを特定できませんでした。このターミナルから再試行するか、--surface <id|ref> を指定してください。"
          }
