    "cli.fork.codexCheckpointUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: جلسة الوكيل المحفوظة غير متاحة. تظل الوحدة الطرفية في الدليل المحفوظ الخاص بها؛ أعد المحاولة لاحقًا أو ابدأ جلسة وكيل جديدة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: sačuvana sesija agenta nije dostupna. Terminal ostaje u svom sačuvanom direktorijumu; pokušajte kasnije ili započnite novu sesiju agenta."
          }
        },
        "da": {
          "stringUnit": {
