    "agentRestore.recovery.liveOwner": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ session is running in process %2$@. Waiting for its writer to become available…"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جلسة %1$@ تعمل في العملية %2$@. جارٍ انتظار إتاحة الكتابة…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sitzung von %1$@ läuft in Prozess %2$@. Warten auf die Schreibfreigabe…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión de %1$@ se ejecuta en el proceso %2$@. Esperando a que se libere la escritura…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La session %1$@ s’exécute dans le processus %2$@. En attente de la libération de l’écriture…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ セッションはプロセス %2$@ で実行中です。書き込みロックの解放を待っています…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 세션이 프로세스 %2$@에서 실행 중입니다. 쓰기 권한이 해제되기를 기다리는 중…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 会话正在进程 %2$@ 中运行。正在等待写入权限释放…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 工作階段正在程序 %2$@ 中執行。正在等待寫入權限釋出…"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesija %1$@ radi u procesu %2$@. Čeka se oslobađanje prava pisanja…"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessionen %1$@ kører i proces %2$@. Venter på, at skriveadgangen bliver ledig…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sessione %1$@ è in esecuzione nel processo %2$@. In attesa che l’accesso in scrittura sia disponibile…"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សម័យ %1$@ កំពុងដំណើរការក្នុងដំណើរការ %2$@។ កំពុងរង់ចាំសិទ្ធិសរសេរឱ្យទំនេរ…"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Økten %1$@ kjører i prosess %2$@. Venter på at skrivetilgangen blir ledig…"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesja %1$@ działa w procesie %2$@. Oczekiwanie na zwolnienie dostępu do zapisu…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sessão %1$@ está em execução no processo %2$@. Aguardando a liberação do acesso de escrita…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сеанс %1$@ выполняется в процессе %2$@. Ожидание освобождения доступа для записи…"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซสชัน %1$@ กำลังทำงานในโพรเซส %2$@ กำลังรอให้สิทธิ์การเขียนว่าง…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ oturumu %2$@ işleminde çalışıyor. Yazma erişiminin serbest kalması bekleniyor…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сеанс %1$@ виконується в процесі %2$@. Очікування звільнення доступу для запису…"
          }
        }
      }
    },
