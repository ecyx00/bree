    "cli.browser.help.replDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run Playwright-style JavaScript against this workspace's browser panes; see `browser repl guide`"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشغيل JavaScript بأسلوب Playwright على أجزاء المتصفح في مساحة العمل هذه؛ راجع `browser repl guide`"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Playwright-artiges JavaScript für die Browser-Bereiche dieses Arbeitsbereichs ausführen; siehe `browser repl guide`"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecuta JavaScript al estilo de Playwright en los paneles de navegador de este espacio de trabajo; consulta `browser repl guide`"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécuter du JavaScript de style Playwright sur les volets de navigateur de cet espace de travail ; voir `browser repl guide`"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このワークスペースのブラウザペインに対して Playwright 形式の JavaScript を実行します。`browser repl guide` を参照してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 워크스페이스의 브라우저 패널에서 Playwright 스타일 JavaScript를 실행합니다. `browser repl guide`를 참고하세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对此工作区的浏览器窗格运行 Playwright 风格的 JavaScript；请参阅 `browser repl guide`"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對此工作區的瀏覽器窗格執行 Playwright 風格的 JavaScript；請參閱 `browser repl guide`"
          }
        }
      }
    },
    "cli.browser.help.replMCPDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve the REPL as an MCP server on stdio (tools: eval, snapshot, screenshot, tabs, reset; its own session unless --session names one)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشغيل REPL كخادم MCP عبر stdio (الأدوات: eval وsnapshot وscreenshot وtabs وreset؛ جلسة خاصة به ما لم يُحدِّد --session جلسة)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den REPL als MCP-Server über stdio bereitstellen (Werkzeuge: eval, snapshot, screenshot, tabs, reset; eigene Sitzung, sofern --session keine benennt)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sirve el REPL como servidor MCP por stdio (herramientas: eval, snapshot, screenshot, tabs, reset; una sesión propia salvo que --session indique una)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exposer le REPL comme serveur MCP sur stdio (outils : eval, snapshot, screenshot, tabs, reset ; sa propre session sauf si --session en nomme une)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "REPL を stdio 上の MCP サーバーとして提供します（ツール: eval、snapshot、screenshot、tabs、reset。--session で指定しない限りサーバー専用のセッション）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "REPL을 stdio의 MCP 서버로 제공합니다(도구: eval, snapshot, screenshot, tabs, reset, --session으로 지정하지 않으면 서버 전용 세션)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 REPL 作为 stdio 上的 MCP 服务器提供（工具：eval、snapshot、screenshot、tabs、reset；未用 --session 指定时使用专属会话）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將 REPL 作為 stdio 上的 MCP 伺服器提供（工具：eval、snapshot、screenshot、tabs、reset；未用 --session 指定時使用專屬工作階段）"
          }
        }
      }
    },
