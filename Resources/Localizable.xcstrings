    "cli.help.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show top-level CLI usage, or one task-focused command group."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt die oberste CLI-Hilfe oder eine aufgabenbezogene Befehlsgruppe an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche l’utilisation générale de la CLI ou un groupe de commandes par tâche."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعرض استخدام CLI العام أو مجموعة أوامر تركز على مهمة واحدة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra el uso general de la CLI o un grupo de comandos centrado en una tarea."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示頂層 CLI 用法，或以任務為主的一組命令。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示顶层 CLI 用法，或按任务划分的一组命令。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최상위 CLI 사용법 또는 작업별 명령 그룹을 표시합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI のトップレベルの使い方、またはタスク別のコマンドグループを表示します。"
          }
        }
      }
    },
    "cli.help.noSocket": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Also works without a running Bree app or socket."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Funktioniert auch ohne laufende Bree-App oder Socket."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fonctionne aussi sans application Bree ni socket actif."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل أيضًا دون تشغيل تطبيق Bree أو المقبس."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También funciona sin una aplicación Bree ni un socket en ejecución."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即使沒有執行中的 Bree 應用程式或 socket 也能使用。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使没有运行中的 Bree 应用或 socket 也能使用。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행 중인 Bree 앱이나 소켓 없이도 작동합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行中の Bree アプリやソケットがなくても動作します。"
          }
        }
      }
    },
    "cli.help.taskHelp.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show one command group without connecting to the Bree socket."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt eine Befehlsgruppe an, ohne eine Verbindung zum Bree-Socket herzustellen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche un groupe de commandes sans se connecter au socket Bree."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعرض مجموعة أوامر واحدة دون الاتصال بمقبس Bree."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra un grupo de comandos sin conectarse al socket de Bree."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示一組命令，不連線到 Bree socket。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示一组命令，无需连接到 Bree socket。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree 소켓에 연결하지 않고 하나의 명령 그룹을 표시합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree ソケットに接続せずに 1 つのコマンドグループを表示します。"
          }
        }
      }
    },
