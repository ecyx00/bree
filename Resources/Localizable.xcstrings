        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널이 닫히는 중이라 읽을 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此终端正在关闭，无法读取。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此終端機正在關閉，無法讀取。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal se zatvara i ne može se pročitati."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminalen lukkes og kan ikke læses."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il terminale si sta chiudendo e non può essere letto."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ទែមីណាល់កំពុងបិទ ហើយមិនអាចអានបានទេ។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminalen lukkes og kan ikke leses."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal jest zamykany i nie można go odczytać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O terminal está sendo fechado e não pode ser lido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Терминал закрывается, и его нельзя прочитать."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เทอร์มินัลกำลังปิดและไม่สามารถอ่านได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal kapanıyor ve okunamıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Термінал закривається, і його не можна прочитати."
          }
        }
      }
    },
    "socket.terminal.notRunning.hibernated": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The terminal is hibernated: Bree suspended its idle agent to save memory. Wake it by showing it (this brings its window to the front), then retry: %@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الطرفية في وضع السبات: أوقف Bree وكيلها الخامل مؤقتًا لتوفير الذاكرة. أيقظها بعرضها (يؤدي ذلك إلى إحضار نافذتها إلى المقدمة)، ثم أعد المحاولة: %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Terminal ruht: Bree hat seinen inaktiven Agenten angehalten, um Speicher zu sparen. Wecke es, indem du es anzeigst (dadurch kommt sein Fenster in den Vordergrund), und versuche es dann erneut: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La terminal está hibernada: Bree suspendió su agente inactivo para ahorrar memoria. Despiértala mostrándola (esto trae su ventana al frente) y vuelve a intentarlo: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le terminal est en veille : Bree a suspendu son agent inactif pour économiser de la mémoire. Réveillez-le en l’affichant (sa fenêtre passe au premier plan), puis réessayez : %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルは休止中です。Bree がメモリ節約のためアイドル状態のエージェントを停止しました。表示すると再開します（ウィンドウが前面に出ます）。その後、再試行してください: %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널이 최대 절전 상태입니다. Bree가 메모리를 절약하려고 유휴 에이전트를 일시 중단했습니다. 터미널을 표시해 깨운 후(창이 앞으로 옵니다) 다시 시도하세요: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此终端已休眠：Bree 暂停了其空闲的代理以节省内存。显示它即可唤醒（这会将其窗口带到最前面），然后重试：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此終端機已休眠：Bree 暫停了其閒置的代理以節省記憶體。顯示它即可喚醒（這會將其視窗帶到最前面），然後再試一次：%@"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal je u hibernaciji: Bree je pauzirao njegovog neaktivnog agenta radi uštede memorije. Probudite ga tako što ćete ga prikazati (njegov prozor prelazi u prvi plan), pa pokušajte ponovo: %@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminalen er i dvale: Bree har sat dens inaktive agent på pause for at spare hukommelse. Væk den ved at vise den (dens vindue kommer forrest), og prøv igen: %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il terminale è ibernato: Bree ha sospeso il suo agente inattivo per risparmiare memoria. Riattivalo mostrandolo (la sua finestra passa in primo piano), quindi riprova: %@"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ទែមីណាល់កំពុងសម្រាក៖ Bree បានផ្អាកភ្នាក់ងារដែលទំនេររបស់វា ដើម្បីសន្សំអង្គចងចាំ។ ដាស់វាដោយបង្ហាញវា (បង្អួចរបស់វានឹងមកខាងមុខ) រួចព្យាយាមម្ដងទៀត៖ %@"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminalen er i dvale: Bree har satt den inaktive agenten på pause for å spare minne. Vekk den ved å vise den (vinduet kommer i forgrunnen), og prøv igjen: %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal jest uśpiony: Bree wstrzymał jego bezczynnego agenta, aby oszczędzić pamięć. Wybudź go, wyświetlając go (jego okno przejdzie na pierwszy plan), a potem spróbuj ponownie: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O terminal está hibernado: o Bree suspendeu o agente ocioso para economizar memória. Desperte-o exibindo-o (a janela vem para a frente) e tente novamente: %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Терминал в спящем режиме: Bree приостановил неактивного агента, чтобы сэкономить память. Разбудите его, показав терминал (его окно выйдет на передний план), и повторите попытку: %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เทอร์มินัลอยู่ในโหมดพัก: Bree หยุดเอเจนต์ที่ไม่ได้ใช้งานชั่วคราวเพื่อประหยัดหน่วยความจำ ปลุกโดยแสดงเทอร์มินัล (หน้าต่างจะมาอยู่ด้านหน้า) แล้วลองอีกครั้ง: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal hazırda bekliyor: Bree bellek tasarrufu için boştaki ajanını askıya aldı. Onu göstererek uyandırın (penceresi öne gelir), ardından yeniden deneyin: %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Термінал у режимі сну: Bree призупинив неактивного агента, щоб заощадити пам’ять. Розбудіть його, показавши термінал (його вікно перейде на передній план), і спробуйте ще раз: %@"
          }
        }
      }
    },
