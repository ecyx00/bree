    "sidebar.extensions.blocked.detail.connectionInterrupted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree lost the extension connection. No workspace data or actions are being shared."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Breeは拡張機能との接続を失いました。ワークスペースデータや操作は共有されていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree 已失去与扩展的连接。未共享任何工作区数据或操作。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree hat die Verbindung zur Erweiterung verloren. Es werden keine Arbeitsbereichsdaten oder Aktionen geteilt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree a perdu la connexion avec l’extension. Aucune donnée d’espace de travail ni aucune action ne sont partagées."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فقد Bree الاتصال بالامتداد. لا تتم مشاركة أي بيانات لمساحة العمل أو إجراءات."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree perdió la conexión con la extensión. No se están compartiendo datos ni acciones del espacio de trabajo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree 遺失擴充功能連線。未分享任何工作區資料或動作。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree가 확장 프로그램과의 연결을 잃었습니다. 작업 공간 데이터나 작업이 공유되지 않습니다."
          }
        }
      }
    },
