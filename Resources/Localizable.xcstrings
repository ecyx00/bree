    "error.breeConfigActionSaver.malformedConfig": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ geçerli bir JSON nesnesi değil, bu yüzden çalışma alanı düzeni güncellenemedi. Dosyayı düzeltip tekrar deneyin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ isn't a valid JSON object, so the workspace layout couldn't be updated. Fix the file and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は有効な JSON オブジェクトではないため、ワークスペースレイアウトを更新できませんでした。ファイルを修正して再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不是有效的 JSON 对象，因此无法更新工作区布局。请修复该文件后重试。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist kein gültiges JSON-Objekt, daher konnte das Layout des Arbeitsbereichs nicht aktualisiert werden. Beheben Sie den Fehler in der Datei und versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n'est pas un objet JSON valide, l'agencement de l'espace de travail n'a donc pas pu être mis à jour. Corrigez le fichier et réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ليس كائن JSON صالحاً، لذا تعذر تحديث تخطيط مساحة العمل. أصلح الملف وحاول مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no es un objeto JSON válido, por lo que no se pudo actualizar el diseño del espacio de trabajo. Corrige el archivo e inténtalo de nuevo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不是有效的 JSON 物件，因此無法更新工作區版面配置。請修正該檔案並重試。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 유효한 JSON 객체가 아니므로 작업 공간 레이아웃을 업데이트할 수 없었습니다. 파일을 수정하고 다시 시도하세요."
          }
        }
      }
    },
