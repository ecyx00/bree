    "dialog.textURL.error.multipleLinks": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن فتح رابط خارجي واحد من Bree فقط في كل مرة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Istovremeno se može otvoriti samo jedna vanjska Bree veza."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun ét eksternt Bree-link kan åbnes ad gangen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es kann jeweils nur ein externer Bree-Link geöffnet werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only one Bree external link can be opened at a time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se puede abrir un enlace externo de Bree a la vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul lien externe Bree peut être ouvert à la fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È possibile aprire solo un link esterno Bree alla volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree の外部リンクは一度に 1 つだけ開けます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មានតែតំណភ្ជាប់ខាងក្រៅ Bree មួយប៉ុណ្ណោះដែលអាចបើកបានក្នុងពេលតែមួយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번에 하나의 Bree 외부 링크만 열 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare én ekstern Bree-kobling kan åpnes om gangen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jednocześnie można otworzyć tylko jeden zewnętrzny link Bree."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas um link externo do Bree pode ser aberto por vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одновременно можно открыть только одну внешнюю ссылку Bree."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สามารถเปิดลิงก์ภายนอก Bree ได้ครั้งละหนึ่งรายการเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı anda yalnızca bir harici Bree bağlantısı açılabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одночасно можна відкрити лише одне зовнішнє посилання Bree."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次只能打开一个 Bree 外部链接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次只能開啟一個 Bree 外部連結。"
          }
        }
      }
    },
    "dialog.textURL.error.nameContainsUnsafeCharacters": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي اسم الارتباط على أحرف تحكم أو تنسيق مخفية، لذا رفضت Bree استخدامه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ime veze sadrži skrivene znakove za kontrolu ili formatiranje, tako da je Bree odbio da ga koristi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Linknavnet indeholder skjulte kontrol- eller formateringstegn, så Bree nægtede at bruge det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Linkname enthält versteckte Steuer- oder Formatierungszeichen, daher weigerte sich Bree, ihn zu verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The link name contains hidden control or formatting characters, so Bree refused to use it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre del enlace contiene caracteres de control o formato ocultos, por lo que Bree se negó a usarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom du lien contient des caractères de contrôle ou de formatage cachés, donc Bree a refusé de l'utiliser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nome del collegamento contiene caratteri di controllo o formattazione nascosti, quindi Bree ha rifiutato di utilizzarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンク名に非表示の制御文字または書式文字が含まれているため、Bree は使用を拒否しました。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ឈ្មោះតំណមានតួអក្សរដែលលាក់ ឬធ្វើទ្រង់ទ្រាយ ដូច្នេះ Bree បដិសេធមិនប្រើវាទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크 이름에 숨겨진 제어 또는 서식 지정 문자가 포함되어 있으므로 Bree는 이를 사용하기를 거부했습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Koblingsnavnet inneholder skjulte kontroll- eller formateringstegn, så Bree nektet å bruke det."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwa łącza zawiera ukryte znaki sterujące lub formatujące, więc Bree odmówił jego użycia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome do link contém controles ocultos ou caracteres de formatação, então Bree se recusou a usá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя ссылки содержит скрытые управляющие или форматирующие символы, поэтому Bree отказался ее использовать."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อลิงก์มีอักขระควบคุมหรือการจัดรูปแบบที่ซ่อนอยู่ ดังนั้น Bree จึงปฏิเสธที่จะใช้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı adı gizli kontrol veya biçimlendirme karakterleri içerdiğinden Bree onu kullanmayı reddetti."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назва посилання містить приховані символи керування або форматування, тому Bree відмовився від її використання."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "链接名称包含隐藏控制或格式字符，因此 Bree 拒绝使用它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連結名稱包含隱藏控製或格式字符，因此 Bree 拒絕使用它。"
          }
        }
      }
    },
