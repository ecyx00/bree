        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: збережена сесія агента недоступна. Термінал залишається у збереженому каталозі; повторіть спробу пізніше або почніть новий сеанс агента."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: 保存的代理会话不可用。终端保留在其保存的目录中；稍后重试或启动新的代理会话。"
          }
