    "browser.externalOpenFailure.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree could not open this link. You can copy it and open it in another app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree はこのリンクを開けませんでした。リンクをコピーして別のアプリで開けます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree 无法打开此链接。你可以复制它并在其他应用中打开。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree konnte diesen Link nicht öffnen. Sie können ihn kopieren und in einer anderen App öffnen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree n’a pas pu ouvrir ce lien. Vous pouvez le copier et l’ouvrir dans une autre application."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر على Bree فتح هذا الرابط. يمكنك نسخه وفتحه في تطبيق آخر."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree no pudo abrir este enlace. Puedes copiarlo y abrirlo en otra aplicación."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree 無法開啟此連結。您可以複製連結並在其他應用程式中開啟。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree가 이 링크를 열 수 없습니다. 링크를 복사하여 다른 앱에서 열 수 있습니다."
          }
        }
      }
    },
