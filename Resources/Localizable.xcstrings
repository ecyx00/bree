    "settings.terminal.colors.note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدأ من ألوان السمة الحالية. تُحفظ التغييرات كتجاوزات في إعدادات Ghostty الخاصة بـ Bree وتُطبَّق فورًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginnt mit den Farben des aktuellen Themes. Änderungen werden als Überschreibungen in der Ghostty-Konfiguration von Bree gespeichert und sofort angewendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts from the colors of your current theme. Changes are saved as overrides in Bree's Ghostty config and apply right away."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte de los colores del tema actual. Los cambios se guardan como anulaciones en la configuración de Ghostty de Bree y se aplican al instante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Part des couleurs du thème actuel. Les modifications sont enregistrées comme remplacements dans la configuration Ghostty de Bree et s'appliquent immédiatement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のテーマの色から始まります。変更は Bree の Ghostty 設定に上書きとして保存され、すぐに反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 테마의 색상에서 시작합니다. 변경 사항은 Bree의 Ghostty 설정에 재정의로 저장되며 즉시 적용됩니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçerli temanın renkleriyle başlar. Değişiklikler Bree'nin Ghostty yapılandırmasına geçersiz kılma olarak kaydedilir ve hemen uygulanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以当前主题的颜色为起点。更改会作为覆盖项保存到 Bree 的 Ghostty 配置中，并立即生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以目前主題的顏色為起點。變更會作為覆寫項儲存到 Bree 的 Ghostty 設定中，並立即生效。"
          }
        }
      }
    },
