    "settings.terminal.memoryGuardrail.threshold.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A pane is flagged once its combined process-tree memory crosses this many gigabytes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペインのプロセスツリーの合計メモリがこのギガバイト数を超えるとフラグが立てられます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当窗格的进程树内存合计超过这么多 GB 时，该窗格会被标记。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Teilfenster wird markiert, sobald der Speicher des gesamten Prozessbaums diese Anzahl an Gigabytes überschreitet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un volet est signalé dès que la mémoire combinée de son arborescence de processus dépasse ce nombre de gigaoctets."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تمييز الجزء بمجرد أن تتجاوز الذاكرة المجمعة لشجرة عملياته هذا العدد من الجيجابايت."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un panel se marca una vez que la memoria combinada de su árbol de procesos supera esta cantidad de gigabytes."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一旦窗格的處理程序樹合併記憶體超過此 GB 數，該窗格就會被標記。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "분할 창의 결합된 프로세스 트리 메모리가 지정된 기가바이트를 초과하면 해당 분할 창에 플래그가 지정됩니다."
          }
        }
      }
    },
    "settings.terminal.rendererRealization": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclaim Offscreen Terminal Memory"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面外のターミナルのメモリを回収"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回收屏幕外终端内存"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speicher von nicht sichtbaren Terminals freigeben"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Récupérer la mémoire des terminaux hors écran"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحرير ذاكرة الطرفيات غير الظاهرة"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Liberar la memoria de las terminales fuera de pantalla"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回收螢幕外終端機記憶體"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 밖 터미널 메모리 회수"
          }
        }
      }
    },
    "settings.terminal.rendererRealization.idleSeconds": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclaim After Idle Seconds"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイドル秒数経過後に回収"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空闲多少秒后回收"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freigeben nach Sekunden im Leerlauf"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Récupérer après plusieurs secondes d'inactivité"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاستعادة بعد ثوانٍ من الخمول"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclamar después de segundos de inactividad"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "閒置指定秒數後回收"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유휴 시간(초) 후 회수"
          }
        }
      }
    },
    "settings.terminal.rendererRealization.idleSeconds.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An off-screen terminal must stay off-screen this long before its renderer memory is reclaimed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフスクリーンの端末は、レンダラーのメモリが回収されるまでこの時間オフスクリーンのままである必要があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕外终端必须保持在屏幕外这么久，其渲染器内存才会被回收。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein nicht sichtbares Terminal muss so lange außerhalb des Bildschirms bleiben, bevor der Speicher seines Renderers freigegeben wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un terminal hors écran doit le rester pendant cette durée avant que la mémoire de son moteur de rendu ne soit récupérée."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن تظل الطرفية الخارجة عن الشاشة خارج الشاشة لهذه المدة قبل استعادة ذاكرة مصيرها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una terminal fuera de pantalla debe permanecer fuera de pantalla este tiempo antes de que se reclame la memoria de su renderizador."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "螢幕外終端機必須保持在螢幕外達此長度，其轉譯器記憶體才會被回收。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 밖의 터미널이 이 시간 동안 화면 밖에 유지되어야 렌더러 메모리가 회수됩니다."
          }
        }
      }
    },
    "settings.terminal.rendererRealization.maxWarmRenderers": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Max Warm Renderers"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォームレンダラーの最大数"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最大热渲染器数"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximale Anzahl warmer Renderer"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombre max de moteurs de rendu prêts"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحد الأقصى للمصيرات الجاهزة"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Renderizadores listos máximos"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持預熱的轉譯器數量上限"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최대 웜 렌더러 수"
          }
        }
      }
    },
    "settings.terminal.rendererRealization.maxWarmRenderers.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The most recently visible terminals keep their renderer ready so switching stays instant. Extra off-screen renderers are reclaimed oldest first."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近表示した端末はレンダラーを準備状態に保ち、切り替えを高速に保ちます。余分なオフスクリーンのレンダラーは古いものから回収されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近可见的终端会保留其渲染器就绪状态，以便切换保持瞬时。多出的屏幕外渲染器按最旧优先回收。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die zuletzt sichtbaren Terminals halten ihren Renderer bereit, damit das Umschalten sofort erfolgt. Zusätzliche nicht sichtbare Renderer werden beginnend mit dem ältesten freigegeben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les terminaux les plus récemment visibles maintiennent leur moteur de rendu prêt pour un changement instantané. Les moteurs de rendu hors écran supplémentaires sont récupérés en commençant par les plus anciens."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتفظ الطرفيات الأحدث ظهورًا بمصيرها جاهزًا بحيث يظل التبديل فوريًا. يتم استعادة المصيرات الخارجة عن الشاشة الإضافية، الأقدم أولاً."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las terminales visibles más recientemente mantienen su renderizador listo para que el cambio siga siendo instantáneo. Los renderizadores fuera de pantalla adicionales se reclaman empezando por el más antiguo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最近顯示的終端機會保持其轉譯器就緒，以便即時進行切換。超出上限的螢幕外轉譯器將從最舊的開始回收。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 최근에 표시된 터미널은 렌더러를 준비 상태로 유지하여 전환이 즉시 이루어지도록 합니다. 추가로 존재하는 화면 밖의 렌더러는 가장 오래된 것부터 차례대로 회수됩니다."
          }
        }
      }
    },
