          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用「返回」與「前進」時，也會回到先前的窗格與標籤頁。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“后退”和“前进”也会回到之前的窗格和标签页。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뒤로 가기와 앞으로 가기로 이전 분할 창과 탭에도 돌아갈 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「戻る」と「進む」で、以前のペインやタブにも戻れます。"
          }
        }
      }
    },
    "settings.app.globalFontMagnification.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scales all text in Bree. Command-Plus and Command-Minus still zoom the focused pane."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändert die Größe des gesamten Texts in Bree. Mit Befehlstaste-Plus und Befehlstaste-Minus lässt sich das fokussierte Teilfenster weiterhin zoomen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifie la taille de tout le texte de Bree. Commande + Plus et Commande + Moins continuent de régler le zoom du volet actif."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يغيّر حجم جميع النصوص في Bree. ولا يزال الاختصاران Command-علامة الجمع وCommand-علامة الطرح يكبّران الجزء المركّز عليه ويصغّرانه."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia el tamaño de todo el texto de Bree. Comando + Más y Comando + Menos siguen ajustando el zoom del panel enfocado."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "調整 Bree 中所有文字的大小。Command + 加號和 Command + 減號仍可用來縮放目前聚焦的窗格。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整 Bree 中所有文本的大小。Command + 加号和 Command + 减号仍可用于缩放当前聚焦的窗格。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree의 모든 텍스트 크기를 조절합니다. 포커스된 분할 창은 계속 Command-더하기와 Command-빼기로 확대/축소할 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree 内のすべてのテキストの大きさを変更します。フォーカス中のペインは、これまでどおり Command + プラスと Command + マイナスで拡大縮小できます。"
          }
        }
      }
    },
