    "settings.terminal.agentHibernation.maxLiveTerminals.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Visible terminals stay live. Extra idle background agent terminals hibernate oldest first."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示中の端末はライブのままです。余分なアイドル中のバックグラウンドエージェント端末は古い順に休止します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可见的终端保持活动。多出的空闲后台代理终端按最旧优先休眠。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichtbare Terminals bleiben aktiv. Zusätzliche im Hintergrund befindliche, inaktive Agenten-Terminals werden beginnend mit dem ältesten in den Ruhezustand versetzt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les terminaux visibles restent actifs. Les terminaux d’agent inactifs supplémentaires en arrière-plan hibernent en commençant par les plus anciens."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظل الطرفيات المرئية نشطة. وتدخل طرفيات الوكيل الخلفية الخاملة الإضافية في السبات، الأقدم أولاً."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las terminales visibles permanecen activas. Las terminales de agentes inactivas adicionales en segundo plano se hibernan empezando por la más antigua."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可見的終端機會保持作用中。超出上限的閒置背景代理終端機將從最舊的開始休眠。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면에 보이는 터미널은 활성 상태로 유지됩니다. 백그라운드에 있는 추가 유휴 에이전트 터미널은 오래된 순서대로 최대 절전 모드로 전환됩니다."
          }
        }
      }
    },
