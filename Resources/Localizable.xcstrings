    "cli.fork.error.unsupportedMode": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: بيانات الشوكة المحفوظة لهذه الجلسة غير متوافقة. قم بتشغيل الوكيل مرة أخرى في هذه المحطة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: sačuvani podaci račvanja ove sesije nisu kompatibilni. Ponovo pokrenite agenta u ovom terminalu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: denne sessions gemte gaffeldata er ikke kompatible. Start agenten igen i denne terminal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: Die gespeicherten Fork-Daten dieser Sitzung sind nicht kompatibel. Starten Sie den Agenten in diesem Terminal erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: this session's saved fork data is not compatible. Start the agent again in this terminal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: Los datos de bifurcación guardados de esta sesión no son compatibles. Inicie el agente nuevamente en esta terminal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: les données de fork enregistrées de cette session ne sont pas compatibles. Redémarrez l'agent dans ce terminal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: i dati fork salvati di questa sessione non sono compatibili. Avvia nuovamente l'agente in questo terminale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: このセッションの保存済みフォークデータには互換性がありません。このターミナルでエージェントをもう一度起動してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
