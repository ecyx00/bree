    "settings.automation.autoNamingAgent.status.failed": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ad üretemedi — hız sınırına takılmış, jetonu bitmiş veya oturumu kapatılmış olabilir. Mevcut adlar değiştirilmedi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ couldn't generate a name — it may be rate-limited, out of tokens, or signed out. Existing names are left unchanged."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は名前を生成できませんでした。レート制限、トークン不足、またはサインアウトの可能性があります。既存の名前はそのまま保持されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 无法生成名称 — 可能是被限流、令牌用尽或已退出登录。现有名称保持不变。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ konnte keinen Namen generieren — eventuell gilt eine Ratenbegrenzung, es sind keine Token mehr vorhanden oder die Anmeldung fehlt. Bestehende Namen bleiben unverändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n'a pas pu générer de nom — il est peut-être limité par le débit, à court de jetons ou déconnecté. Les noms existants restent inchangés."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر على %@ توليد اسم — قد يكون مقيد المعدل، أو نفدت الرموز المميزة لديه، أو تم تسجيل الخروج. تظل الأسماء الحالية دون تغيير."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no pudo generar un nombre; puede tener el límite de frecuencia excedido, haberse quedado sin tokens o haber cerrado sesión. Los nombres existentes no se modificarán."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 無法產生名稱 —— 它可能受到速率限制、權杖用盡或已登出。現有名稱將保持不變。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 이름을 생성할 수 없습니다. 비율 제한이 초과되었거나, 토큰이 부족하거나, 로그아웃된 상태일 수 있습니다. 기존 이름은 변경되지 않은 상태로 유지됩니다."
          }
        }
      }
    },
    "settings.automation.autoNamingAgent.status.notInstalled": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kurulu değil, bu yüzden adlandırmada her oturumun kendi aracısı kullanıldı."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ isn't installed, so naming used each session's own agent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ がインストールされていないため、命名には各セッション自身のエージェントが使用されました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未安装，因此命名改用了每个会话自身的代理。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist nicht installiert, daher wurde für die Benennung der eigene Agent der jeweiligen Sitzung verwendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n'est pas installé, le nommage a donc utilisé le propre agent de chaque session."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إنّ %@ غير مثبت، لذا تم استخدام العميل الخاص بكل جلسة للتسمية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no está instalado, por lo que la asignación de nombres utilizó el propio agente de cada sesión."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未安裝，因此命名使用每個工作階段專屬的代理程式。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 설치되어 있지 않아 각 세션의 자체 에이전트를 사용하여 이름을 지정했습니다."
          }
        }
      }
    },
