            "value": "تتطلب مصادقة SSH طرفية. شغّل هذا الأمر من صدفة تفاعلية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die SSH-Authentifizierung benötigt ein Terminal. Führen Sie diesen Befehl in einer interaktiven Shell aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La autenticación SSH requiere un terminal. Ejecuta este comando desde un intérprete de órdenes interactivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’authentification SSH nécessite un terminal. Exécutez cette commande depuis un shell interactif."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 認証にはターミナルが必要です。対話型シェルからこのコマンドを実行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 인증에는 터미널이 필요합니다. 대화형 셸에서 이 명령을 실행하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 身份验证需要终端。请在交互式 Shell 中运行此命令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 驗證需要終端機。請在互動式 Shell 中執行此命令。"
          }
        }
      }
    },
    "cli.ssh.authenticationForegroundFailed": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not hand the terminal to SSH for %@. Authentication was cancelled to avoid a hang (%@)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not hand the terminal to SSH for %@. Authentication was cancelled to avoid a hang (%@)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر تسليم الطرفية إلى SSH للاتصال بـ %@. أُلغيت المصادقة لتجنب التعليق (%@)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Terminal konnte SSH für %@ nicht übergeben werden. Die Authentifizierung wurde abgebrochen, um ein Hängenbleiben zu vermeiden (%@)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo ceder el terminal a SSH para %@. Se canceló la autenticación para evitar un bloqueo (%@)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de confier le terminal à SSH pour %@. L’authentification a été annulée pour éviter un blocage (%@)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ への接続でターミナルを SSH に渡せませんでした。ハングを防ぐため認証をキャンセルしました（%@）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 연결하기 위해 터미널을 SSH에 넘길 수 없습니다. 멈춤을 방지하기 위해 인증을 취소했습니다(%@)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法将终端交给 SSH 以连接到 %@。为避免卡住，已取消身份验证（%@）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法將終端機交給 SSH 以連線至 %@。為避免停滯，已取消驗證（%@）。"
          }
        }
      }
    },
