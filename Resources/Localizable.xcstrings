    "cli.localZellij.error.existingSessionCommand": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "local-zellij session already exists; use attach or close it before supplying a new command"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جلسة local-zellij موجودة بالفعل; استخدم attach أو أغلقها قبل توفير أمر جديد"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "local-zellij-Sitzung existiert bereits; verwenden Sie attach oder schließen Sie sie, bevor Sie einen neuen Befehl angeben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "la sesión de local-zellij ya existe; usa attach o ciérrala antes de proporcionar un nuevo comando"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "la session local-zellij existe déjà ; utilisez attach ou fermez-la avant de fournir une nouvelle commande"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "local-zellij セッションは既に存在します。新しいコマンドを指定する前に attach または close を使用してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "local-zellij 세션이 이미 존재합니다. 새 명령을 입력하기 전에 attach를 사용하거나 해당 세션을 닫으십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "local-zellij 会话已存在；请在提供新命令前进行连接 (attach) 或将其关闭"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "local-zellij 工作階段已存在；請在提供新命令之前先連接 (attach) 或關閉它"
          }
        }
      }
    },
