    "cli.focus.defaultHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default: focus when run interactively, stay in the background when run by an agent or script."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既定: 対話的に実行した場合はフォーカスし、エージェントやスクリプトから実行した場合はバックグラウンドのままにします。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard: bei interaktiver Ausführung fokussieren, bei Ausführung durch einen Agenten oder ein Skript im Hintergrund bleiben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par défaut : prend le focus en exécution interactive, reste en arrière-plan quand un agent ou un script l’exécute."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الافتراضي: التركيز عند التشغيل التفاعلي، والبقاء في الخلفية عند التشغيل بواسطة وكيل أو برنامج نصي."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Predeterminado: enfoca al ejecutarse de forma interactiva y se queda en segundo plano cuando lo ejecuta un agente o un script."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設：互動執行時取得焦點；由代理程式或指令稿執行時保持在背景。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认：交互式运行时获得焦点；由代理或脚本运行时保持在后台。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값: 대화형으로 실행하면 포커스를 가져오고, 에이전트나 스크립트가 실행하면 백그라운드에 머뭅니다."
          }
        }
      }
    },
    "cli.help.openFocusFlags": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus:\n  --focus                 Switch to the new workspace\n  --no-focus              Open it in the background"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーカス:\n  --focus                 新しいワークスペースに切り替えます\n  --no-focus              バックグラウンドで開きます"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fokus:\n  --focus                 Zum neuen Workspace wechseln\n  --no-focus              Im Hintergrund öffnen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus :\n  --focus                 Bascule vers le nouvel espace de travail\n  --no-focus              L’ouvre en arrière-plan"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التركيز:\n  --focus                 ينتقل إلى مساحة العمل الجديدة\n  --no-focus              يفتحها في الخلفية"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Foco:\n  --focus                 Cambia al nuevo espacio de trabajo\n  --no-focus              Lo abre en segundo plano"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "焦點：\n  --focus                 切換到新的工作區\n  --no-focus              在背景開啟"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "焦点：\n  --focus                 切换到新的工作区\n  --no-focus              在后台打开"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포커스:\n  --focus                 새 워크스페이스로 전환합니다\n  --no-focus              백그라운드에서 엽니다"
          }
        }
      }
    },
    "settings.app.compactAgentStatus": {
