    "settings.shortcuts.baseKeymap.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start from another terminal's shortcuts. Only the differences are written to bree.json; choose Bree to remove them."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ من اختصارات طرفية أخرى. تُكتب الاختلافات فقط في bree.json؛ اختر Bree لإزالتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit den Tastaturkürzeln eines anderen Terminals beginnen. Nur die Unterschiede werden in bree.json geschrieben; wählen Sie Bree, um sie zu entfernen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte de los atajos de otro terminal. Solo se escriben las diferencias en bree.json; elige Bree para eliminarlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partez des raccourcis d’un autre terminal. Seules les différences sont écrites dans bree.json ; choisissez Bree pour les supprimer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のターミナルのショートカットから始めます。差分だけが bree.json に書き込まれ、Bree を選ぶと削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 터미널의 단축키에서 시작합니다. 차이점만 bree.json에 기록되며, Bree를 선택하면 제거됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以其他终端的快捷键为起点。只会将差异写入 bree.json；选择 Bree 即可移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以其他終端機的快速鍵為起點。只會將差異寫入 bree.json；選擇 Bree 即可移除。"
          }
        }
      }
    },
