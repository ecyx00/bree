    "cli.session.restore.cleanQuit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No agent sessions restored: Bree last quit normally. To restore one anyway, pass --session <id> from --list."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Agent-Sitzungen wiederhergestellt: Bree wurde zuletzt normal beendet. Um trotzdem eine wiederherzustellen, übergib --session <id> aus --list."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune session d’agent restaurée : Bree s’est fermé normalement la dernière fois. Pour en restaurer une quand même, passez --session <id> depuis --list."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تتم استعادة أي جلسات وكيل: أُغلق Bree بشكل طبيعي آخر مرة. لاستعادة جلسة على أي حال، مرّر --session <id> من --list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se restauró ninguna sesión de agente: Bree se cerró normalmente la última vez. Para restaurar una de todos modos, pasa --session <id> de --list."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未還原任何代理工作階段：Bree 上次是正常結束。若仍要還原，請傳入 --list 中的 --session <id>。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未恢复任何代理会话：Bree 上次是正常退出。若仍要恢复，请传入 --list 中的 --session <id>。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복원된 에이전트 세션이 없습니다. Bree가 마지막에 정상적으로 종료되었습니다. 그래도 복원하려면 --list에서 확인한 --session <id>를 전달하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントセッションは復元されませんでした。Bree は前回正常に終了しています。それでも復元する場合は、--list の --session <id> を指定してください。"
          }
        }
      }
    },
