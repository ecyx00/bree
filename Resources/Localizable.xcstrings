    "terminal.unsafePasteConfirmation.message": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu metin yapıştırılır yapıştırılmaz komut çalıştırabilir; örneğin satır sonu içerdiği için. Yalnızca güvendiğiniz bir metni yapıştırın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد ينفّذ هذا النص أوامر فور لصقه، مثلًا لأنه يحتوي على فاصل أسطر. الصقه فقط إذا كنت تثق به."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Text könnte beim Einfügen sofort Befehle ausführen, zum Beispiel weil er einen Zeilenumbruch enthält. Füge ihn nur ein, wenn du ihm vertraust."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This text could run commands as soon as it is pasted, for example because it contains a line break. Paste it only if you trust it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este texto podría ejecutar comandos en cuanto se pegue, por ejemplo porque contiene un salto de línea. Pégalo solo si confías en él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce texte pourrait exécuter des commandes dès qu’il est collé, par exemple parce qu’il contient un saut de ligne. Ne le collez que si vous lui faites confiance."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このテキストには改行が含まれているなどの理由で、貼り付けた直後にコマンドが実行される可能性があります。信頼できる場合にのみ貼り付けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 텍스트는 줄바꿈이 들어 있는 등의 이유로 붙여넣는 즉시 명령을 실행할 수 있습니다. 신뢰할 수 있을 때만 붙여넣으세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这段文本可能在粘贴后立即运行命令，例如因为其中包含换行。只有在你信任它时才粘贴。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這段文字可能在貼上後立即執行指令，例如因為其中包含換行。只有在你信任它時才貼上。"
          }
        }
      }
    },
