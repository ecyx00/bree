        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить файл в удалённый сеанс: %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถอัปโหลดไฟล์ไปยังเซสชันระยะไกลได้: %@"
          }
        },
        "tr": {
          "stringUnit": {
