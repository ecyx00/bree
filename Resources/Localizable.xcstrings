    "shortcut.keymap.summary.conflict": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ aynı zamanda bir macOS kısayoludur (%2$@). macOS onu Bree'den önce işleyebilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is also a macOS shortcut (%2$@). macOS may handle it before Bree."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ هو أيضًا اختصار في macOS (%2$@). قد يعالجه macOS قبل Bree."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ist auch ein macOS-Tastaturkürzel (%2$@). macOS verarbeitet es möglicherweise vor Bree."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ también es un atajo de macOS (%2$@). macOS puede procesarlo antes que Bree."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ est aussi un raccourci macOS (%2$@). macOS peut le traiter avant Bree."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ は macOS のショートカット（%2$@）でもあります。Bree より先に macOS が処理する場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@은(는) macOS 단축키(%2$@)이기도 합니다. macOS가 Bree보다 먼저 처리할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 也是 macOS 快捷键（%2$@）。macOS 可能会先于 Bree 处理它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 也是 macOS 快速鍵（%2$@）。macOS 可能會先於 Bree 處理它。"
          }
        }
      }
    },
    "shortcut.keymap.summary.kept": {
      "extractionState": "manual",
      "localizations": {
