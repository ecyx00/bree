    "cli.session.move.error.transcriptsDiverged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "session move: the transcripts diverged (the destination copy is not a prefix of the source); resolve by hand"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "session move: تباعدت النصوص (نسخة الوجهة ليست بادئة للمصدر)؛ عالج ذلك يدويًا"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "session move: Die Transkripte sind auseinandergelaufen (die Kopie am Ziel ist kein Präfix der Quelle); bitte manuell auflösen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "session move: las transcripciones divergieron (la copia del destino no es un prefijo del origen); resuélvelo a mano"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "session move : les transcriptions ont divergé (la copie de destination n'est pas un préfixe de la source) ; résolvez manuellement"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "session move: トランスクリプトが分岐しました (移動先のコピーが元の先頭部分ではありません)。手動で解決してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
