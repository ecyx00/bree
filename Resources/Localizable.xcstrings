    "dialog.textURL.error.titleContainsUnsafeCharacters": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي عنوان الارتباط على عناصر تحكم أو أحرف تنسيق مخفية، لذا رفضت Bree استخدامه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Naslov veze sadrži skrivene znakove za kontrolu ili formatiranje, tako da je Bree odbio da ga koristi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Linktitlen indeholder skjulte kontrol- eller formateringstegn, så Bree nægtede at bruge den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Linktitel enthält versteckte Steuer- oder Formatierungszeichen, daher weigerte sich Bree, diese zu verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The link title contains hidden control or formatting characters, so Bree refused to use it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El título del enlace contiene caracteres de control o formato ocultos, por lo que Bree se negó a usarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le titre du lien contient des caractères de contrôle ou de formatage cachés, donc Bree a refusé de l'utiliser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il titolo del collegamento contiene caratteri di controllo o formattazione nascosti, quindi Bree ha rifiutato di utilizzarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクタイトルに非表示の制御文字または書式文字が含まれているため、Bree は使用を拒否しました。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ចំណងជើងតំណមានវត្ថុបញ្ជាដែលលាក់ ឬទម្រង់តួអក្សរ ដូច្នេះ Bree បដិសេធមិនប្រើវាទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크 제목에 숨겨진 제어 또는 서식 지정 문자가 포함되어 있어 Bree는 이를 사용을 거부했습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Koblingstittelen inneholder skjulte kontroll- eller formateringstegn, så Bree nektet å bruke den."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tytuł linku zawiera ukryte znaki sterujące lub formatujące, więc Bree odmówił jego użycia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O título do link contém controles ocultos ou caracteres de formatação, então Bree se recusou a usá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заголовок ссылки содержит скрытые управляющие или форматирующие символы, поэтому Bree отказался его использовать."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อลิงก์มีอักขระควบคุมหรือการจัดรูปแบบที่ซ่อนอยู่ ดังนั้น Bree จึงปฏิเสธที่จะใช้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı başlığı gizli kontrol veya biçimlendirme karakterleri içerdiğinden Bree bunu kullanmayı reddetti."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Заголовок посилання містить приховані символи керування або форматування, тому Bree відмовився його використовувати."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "链接标题包含隐藏的控制或格式字符，因此 Bree 拒绝使用它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連結標題包含隱藏的控製或格式字符，因此 Bree 拒絕使用它。"
          }
        }
      }
    },
