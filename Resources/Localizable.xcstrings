    "dialog.textURL.error.textContainsUnsafeCharacters": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي نص الارتباط على أحرف غير مدعومة أو مخفية، لذا رفضت Bree استخدامه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst veze sadrži nepodržane ili skrivene znakove, pa je Bree odbio da ga koristi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Linkteksten indeholder ikke-understøttede eller skjulte tegn, så Bree nægtede at bruge den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Linktext enthält nicht unterstützte oder versteckte Zeichen, daher weigerte sich Bree, ihn zu verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The link text contains unsupported or hidden characters, so Bree refused to use it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto del enlace contiene caracteres ocultos o no admitidos, por lo que Bree se negó a utilizarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte du lien contient des caractères non pris en charge ou masqués, donc Bree a refusé de l'utiliser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo del collegamento contiene caratteri non supportati o nascosti, quindi Bree ha rifiutato di utilizzarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクテキストに未対応または非表示の文字が含まれているため、Bree は使用を拒否しました。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អត្ថបទតំណមានតួអក្សរដែលមិនគាំទ្រ ឬលាក់ ដូច្នេះ Bree បដិសេធមិនប្រើវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크 텍스트에 지원되지 않거나 숨겨진 문자가 포함되어 있어 Bree가 사용을 거부했습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Linkteksten inneholder ustøttede eller skjulte tegn, så Bree nektet å bruke den."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst łącza zawiera nieobsługiwane lub ukryte znaki, dlatego Bree odmówił jego użycia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto do link contém caracteres não suportados ou ocultos, então Bree recusou-se a usá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст ссылки содержит неподдерживаемые или скрытые символы, поэтому Bree отказался ее использовать."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความลิงก์มีอักขระที่ไม่รองรับหรือซ่อนไว้ ดังนั้น Bree จึงปฏิเสธที่จะใช้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı metni desteklenmeyen veya gizli karakterler içerdiğinden Bree onu kullanmayı reddetti."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст посилання містить непідтримувані або приховані символи, тому Bree відмовився його використовувати."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "链接文本包含不支持或隐藏的字符，因此 Bree 拒绝使用它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連結文字包含不支援或隱藏的字符，因此 Bree 拒絕使用它。"
          }
        }
      }
    },
