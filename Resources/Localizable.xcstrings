    "settings.automation.autoNamingAgent.requirement.unsupported": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ henüz ad üretemiyor, bu yüzden Bree her oturumun kendi aracısını kullanır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ can't generate names yet, so Bree uses each session's own agent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はまだ名前を生成できないため、Bree は各セッション自身のエージェントを使用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 目前无法生成名称，因此 Bree 会使用每个会话自身的代理。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kann noch keine Namen generieren, daher verwendet Bree den eigenen Agenten der jeweiligen Sitzung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne peut pas encore générer de noms, Bree utilise donc le propre agent de chaque session."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن لـ %@ توليد أسماء بعد، لذا يستخدم Bree العميل الخاص بكل جلسة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ aún no puede generar nombres, por lo que Bree utiliza el propio agente de cada sesión."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 目前還無法產生名稱，因此 Bree 會使用每個工作階段專屬的代理程式。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 아직 이름을 생성할 수 없으므로, Bree는 각 세션의 자체 에이전트를 사용합니다."
          }
        }
      }
    },
