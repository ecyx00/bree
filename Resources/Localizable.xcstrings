    "settings.app.warnBeforeClosingTab.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closing a tab asks for confirmation first."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Schließen eines Tabs wird zuerst nach einer Bestätigung gefragt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une confirmation est demandée avant la fermeture d’un onglet."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُطلب التأكيد قبل إغلاق علامة التبويب."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pide confirmación antes de cerrar una pestaña."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉標籤頁前先要求確認。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭标签页前先要求确认。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭을 닫기 전에 확인을 요청합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブを閉じる前に確認します。"
          }
        }
      }
    },
    "settings.app.warnBeforeClosingTabXButton.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clicking a tab's close button asks for confirmation first."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Klicken auf die Schließen-Taste eines Tabs wird zuerst nach einer Bestätigung gefragt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une confirmation est demandée avant la fermeture d’un onglet avec son bouton de fermeture."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُطلب التأكيد قبل إغلاق علامة التبويب بالنقر على زر الإغلاق الخاص بها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pide confirmación antes de cerrar una pestaña con su botón de cerrar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下標籤頁上的關閉按鈕後，會先要求確認再關閉。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按标签页上的关闭按钮后，会先要求确认再关闭。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭의 닫기 버튼을 클릭하면 탭을 닫기 전에 확인을 요청합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブの閉じるボタンをクリックしたとき、閉じる前に確認します。"
          }
        }
      }
    },
    "settings.app.warnBeforeQuit.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose when quitting with Command-Q asks for confirmation. Dirty Only asks only when a workspace would ask before closing."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie, wann beim Beenden mit Befehlstaste-Q nach einer Bestätigung gefragt wird. „Nur bei Bedarf“ fragt nur, wenn ein Arbeitsbereich vor dem Schließen nachfragen würde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez quand une confirmation est demandée pour quitter avec Commande + Q. « Si nécessaire » ne la demande que si un espace de travail la demanderait avant sa fermeture."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر متى يُطلب التأكيد عند الإنهاء باستخدام Command-Q. يطلب خيار «عند الحاجة فقط» التأكيد فقط عندما تطلبه مساحة عمل قبل إغلاقها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige cuándo se pide confirmación al salir con Comando + Q. «Solo si hace falta» solo la pide cuando un espacio de trabajo la pediría antes de cerrarse."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇按 Command + Q 結束時，在什麼情況下要求確認。「僅在需要時」只會在某個工作區關閉前需要確認時才詢問。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择按 Command + Q 退出时，在什么情况下要求确认。“仅在需要时”只会在某个工作区关闭前需要确认时才询问。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Command-Q로 종료할 때 확인을 요청할 조건을 선택합니다. ‘필요 시에만’은 닫기 전에 확인이 필요한 작업 공간이 있을 때만 확인을 요청합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Command + Q で終了するときに、どのような場合に確認するかを選択します。「必要時のみ」では、閉じる前に確認が必要なワークスペースがある場合だけ確認します。"
          }
        }
      }
    },
    "settings.app.workspaceInheritWorkingDirectory.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts new workspaces in the working directory of the current workspace."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet neue Arbeitsbereiche im Arbeitsverzeichnis des aktuellen Arbeitsbereichs."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre les nouveaux espaces de travail dans le répertoire de travail de l’espace de travail actuel."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدأ مساحات العمل الجديدة في دليل العمل الخاص بمساحة العمل الحالية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia los nuevos espacios de trabajo en el directorio de trabajo del espacio de trabajo actual."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新工作區會沿用目前工作區的工作目錄。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新工作区会沿用当前工作区的工作目录。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 작업 공간은 현재 작업 공간의 작업 디렉터리에서 시작됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいワークスペースは、現在のワークスペースと同じ作業ディレクトリで開始します。"
          }
        }
      }
    },
    "settings.app.wrapWorkspaceTitles.subtitle": {
