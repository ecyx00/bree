        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចផ្ទុកការកំណត់រចនាសម្ព័ន្ធ Dock បានទេ។ ពិនិត្យ dock.json រួចព្យាយាមម្ដងទៀត។"
