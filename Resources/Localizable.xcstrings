    "cli.sshPtyAttach.launchAcknowledgementTimeoutRetry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Bree did not acknowledge the SSH launch; retrying %s in %ss."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Bree hat den SSH-Start nicht bestätigt; neuer Versuch %s in %ss."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Bree n’a pas confirmé le démarrage SSH ; nouvelle tentative %s dans %ss."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] لم يؤكد Bree بدء SSH؛ ستتم إعادة المحاولة %s خلال %s ث."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Bree no confirmó el inicio de SSH; reintentando %s en %ss."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Bree 未確認 SSH 啟動；將在第 %s 次於 %s 秒後重試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Bree 未确认 SSH 启动；将在第 %s 次于 %s 秒后重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Bree가 SSH 시작을 확인하지 못했습니다. %s번째로 %s초 후 다시 시도합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Bree が SSH の起動を確認できないため、%s 回目を %s 秒後に再試行します。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Bree nije potvrdio SSH pokretanje; ponovni pokušaj %s za %ss."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Bree bekræftede ikke SSH-starten; prøver igen %s om %ss."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Bree non ha confermato l’avvio SSH; nuovo tentativo %s tra %ss."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Bree មិនបានបញ្ជាក់ការចាប់ផ្តើម SSH ទេ; កំពុងព្យាយាមម្តងទៀត %s ក្នុងរយៈពេល %ss។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Bree bekreftet ikke SSH-oppstarten; prøver på nytt %s om %ss."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Bree nie potwierdził uruchomienia SSH; ponawianie próby %s za %ss."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] o Bree não confirmou o início do SSH; tentando novamente %s em %ss."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Bree не подтвердил запуск SSH; повторная попытка %s через %ss."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Bree ไม่ยืนยันการเริ่มต้น SSH; กำลังลองใหม่ครั้งที่ %s ในอีก %s วินาที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Bree SSH başlatmasını onaylamadı; %s saniye içinde %s. deneme yapılıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Bree не підтвердив запуск SSH; повторна спроба %s через %s с."
          }
        }
      }
    },
