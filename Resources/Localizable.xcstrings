    "agentRestore.unverifiable.notice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree could not verify whether this agent session is already running, so it did not resume the session automatically. Run 'bree restore --surface' to resume it here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このエージェントセッションがすでに実行中かどうかを Bree で確認できなかったため、セッションを自動的に再開しませんでした。このターミナルで再開するには「Bree restore --surface」を実行してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree konnte nicht überprüfen, ob diese Agent-Sitzung bereits ausgeführt wird, daher wurde die Sitzung nicht automatisch fortgesetzt. Führen Sie 'bree restore --surface' aus, um sie hier fortzusetzen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree n'a pas pu vérifier si cette session d'agent est déjà en cours d'exécution, elle n'a donc pas repris la session automatiquement. Exécutez 'bree restore --surface' pour la reprendre ici."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتمكن Bree من التحقق مما إذا كانت جلسة الوكيل هذه تعمل بالفعل، لذلك لم يستأنف الجلسة تلقائيًا. قم بتشغيل 'bree restore --surface' لاستئنافها هنا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree no pudo verificar si esta sesión de agente ya se está ejecutando, por lo que no reanudó la sesión automáticamente. Ejecute 'bree restore --surface' para reanudarla aquí."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree 無法驗證此代理程式工作階段是否已在執行中，因此未自動恢復工作階段。請執行 'bree restore --surface' 以在此處恢復它。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree 无法验证此代理会话是否已在运行，因此未自动恢复该会话。请运行 'bree restore --surface' 在此处恢复它。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree가 이 에이전트 세션의 중복 실행 여부를 확인할 수 없어 세션을 자동으로 재개하지 않았습니다. 여기서 재개하려면 'bree restore --surface'를 실행하세요."
          }
        }
      }
    },
