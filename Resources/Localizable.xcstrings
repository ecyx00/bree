    "sudo.cli.queued": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: request %@ queued; waiting up to %d seconds for approval in Bree…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: リクエスト %1$@ をキューに追加しました。Bree での承認を最大 %2$d 秒待ちます…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: Anfrage %1$@ in der Warteschlange; wartet bis zu %2$d Sekunden auf Genehmigung in Bree…"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: طلب %@ في قائمة الانتظار؛ الانتظار لمدة تصل إلى %d ثانية للحصول على الموافقة في Bree..."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: zahtjev %@ u redu čekanja; čekanje do %d sekundi za odobrenje u Bree…"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo:request%@ i kø; venter op til %d sekunder på godkendelse i Bree..."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: solicitud %@ en cola; esperando hasta %d segundos para la aprobación en Bree…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo : demande %@ en file d'attente ; attendre jusqu'à %d secondes pour l'approbation dans Bree…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: richiesta %@ accodata; attesa fino a %d secondi per l’approvazione in Bree…"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo៖ សំណើ %@ បានតម្រង់ជួរ; រង់ចាំរហូតដល់ %d វិនាទីសម្រាប់ការយល់ព្រមនៅក្នុង Bree…"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: forespørsel om %@ i kø; venter opptil %d sekunder på godkjenning i Bree..."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: żądanie %@ w kolejce; oczekiwanie do %d sekund na zatwierdzenie w Bree…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: solicitação %@ enfileirada; aguardando até %d segundos pela aprovação no Bree…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: запрос %@ поставлен в очередь; ожидание до %d секунд для одобрения в Bree…"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: การร้องขอ %@ อยู่ในคิว; รอถึง %d วินาทีสำหรับการอนุมัติใน Bree..."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: %@ isteği sıraya alındı; Bree'de onay için %d saniyeye kadar bekleniyor…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: запит %@ поставлено в чергу; очікування до %d секунд для схвалення в Bree…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo：请求%@已排队；在 Bree 中等待 %d 秒的批准..."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo：請求%@已排隊；在 Bree 中等待 %d 秒的批准..."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: %@ 요청이 대기 중입니다. Bree에서 승인을 받기 위해 최대 %d초를 기다리는 중…"
          }
        }
      }
    },
