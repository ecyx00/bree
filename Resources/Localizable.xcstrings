        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings could not load. Please restart Bree and report this issue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron cargar los ajustes. Reinicia Bree e informa de este problema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger les réglages. Veuillez redémarrer Bree et signaler ce problème."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare le impostazioni. Riavvia Bree e segnala questo problema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を読み込めませんでした。Bree を再起動して、この問題を報告してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចផ្ទុកការកំណត់បានទេ។ សូមចាប់ផ្ដើម Bree ឡើងវិញ ហើយរាយការណ៍អំពីបញ្ហានេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정을 불러올 수 없습니다. Bree를 다시 시작하고 이 문제를 신고해 주세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Innstillingene kunne ikke lastes. Start Bree på nytt og rapporter dette problemet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się wczytać ustawień. Uruchom Bree ponownie i zgłoś ten problem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar os ajustes. Reinicie o Bree e informe este problema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить настройки. Перезапустите Bree и сообщите об этой проблеме."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถโหลดการตั้งค่าได้ โปรดรีสตาร์ท Bree และรายงานปัญหานี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar yüklenemedi. Lütfen Bree'yi yeniden başlatın ve bu sorunu bildirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завантажити налаштування. Перезапустіть Bree і повідомте про цю проблему."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载设置。请重启 Bree 并报告此问题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法載入設定。請重新啟動 Bree 並回報此問題。"
          }
        }
      }
    },
