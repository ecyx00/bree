    "cli.hooks.campfire.error.notBreeExtension": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ موجود وليس امتداد Bree؛ سيتم تركه كما هو"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ postoji i nije Bree ekstenzija; ostavljam ga netaknutim"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ findes og er ikke en Bree-udvidelse; lader den være"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ existiert und ist keine Bree-Erweiterung; wird unverändert belassen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ exists and is not a Bree extension; leaving it alone"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ existe y no es una extensión de Bree; se dejará intacto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ existe et n’est pas une extension Bree ; aucun changement n’y sera apporté"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ esiste e non è un'estensione Bree; verrà lasciato invariato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は存在しますが Bree 拡張ではありません。そのままにします"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ មានរួចហើយ ហើយមិនមែនជា​ផ្នែកបន្ថែម Bree ទេ; ទុកវាដូចដើម"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 존재하지만 Bree 확장이 아니므로 그대로 둡니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ finnes og er ikke en Bree-utvidelse; lar den være i fred"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ istnieje i nie jest rozszerzeniem Bree; pozostawiam bez zmian"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ existe e não é uma extensão do Bree; será deixado como está"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ существует и не является расширением Bree; оставляем без изменений"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ มีอยู่แล้วและไม่ใช่ส่วนขยาย Bree; จะปล่อยไว้ตามเดิม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ mevcut ve bir Bree uzantısı değil; olduğu gibi bırakılıyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ існує і не є розширенням Bree; залишаємо без змін"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已存在且不是 Bree 扩展；将保持不变"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已存在且不是 Bree 擴充功能；將維持原樣"
          }
        }
      }
    },
