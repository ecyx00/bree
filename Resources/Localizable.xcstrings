    "settings.automation.suppressSubagentNotifications.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lists subagent completions in Feed without sending notifications."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgeschlossene Subagenten erscheinen im Feed, ohne dass Benachrichtigungen gesendet werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sous-agents terminés apparaissent dans le Flux, sans notification."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظهر اكتمال مهام الوكلاء الفرعيين في Feed دون إرسال إشعارات."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los subagentes finalizados aparecen en el Feed sin enviar notificaciones."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "子代理完成時只會列在 Feed 中，不會傳送通知。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "子代理完成时只会列在 Feed 中，不会发送通知。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하위 에이전트가 완료되면 알림을 보내지 않고 피드에만 표시합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブエージェントが完了しても通知は送らず、フィードにのみ表示します。"
          }
        }
      }
    },
    "settings.automation.workspaceAutoNaming.subtitle": {
