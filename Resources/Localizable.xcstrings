    "session.import.error.olderSchema": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bu Bree'nin artık okumadığı eski bir oturum biçimi (%2$@) kullanıyor (%3$@)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ uses an older session format (%2$@) that this Bree no longer reads (%3$@)."
          }
