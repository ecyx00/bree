          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce terminal n’est pas en cours d’exécution, il n’y a donc rien à mettre en veille."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
