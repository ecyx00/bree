    "cli.ssh.mosh.localUnsupported": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] يفتقر عميل Mosh المحلي إلى تكامل SSH المطلوب؛ جارٍ المتابعة عبر SSH."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Lokalnom Mosh klijentu nedostaje potrebna SSH integracija; nastavak putem SSH-a."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Den lokale Mosh-klient mangler den nødvendige SSH-integration; fortsætter via SSH."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Dem lokalen Mosh-Client fehlt die erforderliche SSH-Integration; Verbindung wird über SSH fortgesetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] The local Mosh client lacks required SSH integration; continuing over SSH."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] El cliente Mosh local no admite la integración SSH requerida; se continuará mediante SSH."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Le client Mosh local ne prend pas en charge l’intégration SSH requise ; poursuite via SSH."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Il client Mosh locale non supporta l’integrazione SSH richiesta; continuazione tramite SSH."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] ローカルの Mosh クライアントが必要な SSH 連携に対応していないため、SSH で接続を続行します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] កម្មវិធី Mosh ក្នុងម៉ាស៊ីនមិនគាំទ្រការរួមបញ្ចូល SSH ដែលត្រូវការទេ ដូច្នេះបន្តតាម SSH។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] 로컬 Mosh 클라이언트가 필요한 SSH 연동을 지원하지 않아 SSH로 계속합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Den lokale Mosh-klienten mangler nødvendig SSH-integrasjon; fortsetter over SSH."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Lokalny klient Mosh nie obsługuje wymaganej integracji SSH; kontynuowanie przez SSH."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] O cliente Mosh local não oferece a integração SSH necessária; continuando por SSH."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Локальный клиент Mosh не поддерживает требуемую интеграцию с SSH; продолжение через SSH."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] ไคลเอนต์ Mosh ในเครื่องไม่รองรับการผสานรวม SSH ที่จำเป็น จึงดำเนินการต่อผ่าน SSH"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Yerel Mosh istemcisi gerekli SSH entegrasyonunu desteklemiyor; SSH üzerinden devam ediliyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Локальний клієнт Mosh не підтримує потрібну інтеграцію з SSH; продовження через SSH."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] 本地 Mosh 客户端不支持所需的 SSH 集成；将继续使用 SSH。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] 本機 Mosh 用戶端不支援所需的 SSH 整合；將繼續使用 SSH。"
          }
        }
      }
    },
    "cli.ssh.mosh.probeFailed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] تعذّر التحقق من دعم Mosh على المضيف البعيد؛ جارٍ المتابعة عبر SSH."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Nije moguće potvrditi udaljenu Mosh podršku; nastavak putem SSH-a."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Fjernunderstøttelse af Mosh kunne ikke bekræftes; fortsætter via SSH."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Remote-Mosh-Unterstützung konnte nicht bestätigt werden; Verbindung wird über SSH fortgesetzt."
          }
        },
        "en": {
