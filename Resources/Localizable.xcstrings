    "settings.search.alias.setting.browser.hidden-webview-discard-mode": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "browser.hiddenWebViewDiscardMode memory saver budget timer hidden tabs discard unload"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "browser.hiddenWebViewDiscardMode memory saver budget timer hidden tabs discard unload メモリセーバー モード 予算 タイマー 非表示 タブ 破棄 解放"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "browser.hiddenWebViewDiscardMode memory saver budget timer hidden tabs discard unload Speichersparmodus Modus Budget zeitgesteuert ausgeblendete Tabs verwerfen entladen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "browser.hiddenWebViewDiscardMode memory saver budget timer hidden tabs discard unload économiseur de mémoire mode budget minuteur onglets masqués rejeter décharger"
          }
