    "cli.ssh.autoReconnect.stopHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] أغلق هذا الجزء أو اضغط Ctrl-C لإيقاف إعادة الاتصال."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] zatvorite ovo okno ili pritisnite Ctrl-C za zaustavljanje ponovnog povezivanja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] luk denne rude, eller tryk Ctrl-C for at stoppe genoprettelsen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] schließen Sie diesen Bereich oder drücken Sie Ctrl-C, um das erneute Verbinden zu stoppen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] close this pane or press Ctrl-C to stop reconnecting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] cierra este panel o pulsa Ctrl-C para detener la reconexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] fermez ce volet ou appuyez sur Ctrl-C pour arrêter la reconnexion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] chiudi questo riquadro o premi Ctrl-C per interrompere la riconnessione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] 再接続を停止するには、このペインを閉じるか Ctrl-C を押してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] បិទផ្ទាំងនេះ ឬចុច Ctrl-C ដើម្បីបញ្ឈប់ការភ្ជាប់ឡើងវិញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] 다시 연결을 중지하려면 이 창을 닫거나 Ctrl-C를 누르세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] lukk denne ruten eller trykk Ctrl-C for å stoppe ny tilkobling."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] zamknij ten panel albo naciśnij Ctrl-C, aby zatrzymać ponowne łączenie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] feche este painel ou pressione Ctrl-C para interromper a reconexão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] закройте эту панель или нажмите Ctrl-C, чтобы остановить переподключение."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] ปิดบานหน้าต่างนี้หรือกด Ctrl-C เพื่อหยุดการเชื่อมต่อใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] yeniden bağlanmayı durdurmak için bu bölmeyi kapatın veya Ctrl-C'ye basın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] закрийте цю панель або натисніть Ctrl-C, щоб зупинити повторне підключення."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] 关闭此窗格或按 Ctrl-C 停止重新连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] 關閉此窗格或按 Ctrl-C 停止重新連線。"
          }
        }
      }
    },
    "cli.ssh.manualReconnectPrompt.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] the SSH connection ended; the remote session may still be running."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] SSH 接続が終了しました。リモートセッションはまだ実行中の可能性があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] SSH 连接已结束；远程会话可能仍在运行。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] Die SSH-Verbindung wurde beendet; die Remote-Sitzung läuft möglicherweise noch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] la connexion SSH a pris fin ; la session distante est peut-être encore en cours d'exécution."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] انتهى اتصال SSH؛ قد لا تزال الجلسة البعيدة قيد التشغيل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] finalizó la conexión SSH; es posible que la sesión remota aún se esté ejecutando."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] SSH 連線已結束；遠端工作階段可能仍在執行。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] SSH 연결이 종료되었습니다. 원격 세션은 계속 실행 중일 수 있습니다."
          }
        }
      }
    },
    "cli.ssh.manualReconnectPrompt.prompt": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] اضغط Enter لإغلاق هذا الجزء. اضغط r ثم Enter لإعادة الاتصال."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] pritisnite Enter za zatvaranje ovog okna. Pritisnite r pa Enter za ponovno povezivanje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] tryk på Enter for at lukke denne rude. Tryk på r og derefter Enter for at genoprette forbindelsen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] drücken Sie Enter, um diesen Bereich zu schließen. Drücken Sie r und dann Enter zum erneuten Verbinden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] press Enter to close this pane. Press r then Enter to reconnect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] pulsa Enter para cerrar este panel. Pulsa r y luego Enter para reconectar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] appuyez sur Entrée pour fermer ce volet. Appuyez sur r puis Entrée pour reconnecter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] premi Invio per chiudere questo riquadro. Premi r e poi Invio per riconnettere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] 閉じるには Enter を押してください。再接続するには r を押して Enter を押してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] ចុច Enter ដើម្បីបិទផ្ទាំងនេះ។ ចុច r បន្ទាប់មក Enter ដើម្បីភ្ជាប់ឡើងវិញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] 이 창을 닫으려면 Enter를 누르세요. 다시 연결하려면 r을 누른 뒤 Enter를 누르세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] trykk Enter for å lukke denne ruten. Trykk r og deretter Enter for å koble til på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] naciśnij Enter, aby zamknąć ten panel. Naciśnij r, a potem Enter, aby połączyć ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] pressione Enter para fechar este painel. Pressione r e depois Enter para reconectar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] нажмите Enter, чтобы закрыть эту панель. Нажмите r, затем Enter, чтобы переподключиться."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] กด Enter เพื่อปิดบานหน้าต่างนี้ กด r แล้วกด Enter เพื่อเชื่อมต่อใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] bu bölmeyi kapatmak için Enter'a basın. Yeniden bağlanmak için r sonra Enter'a basın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] натисніть Enter, щоб закрити цю панель. Натисніть r, потім Enter, щоб повторно підключитися."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] 按 Enter 关闭此窗格。按 r 后再按 Enter 重新连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bree] 按 Enter 關閉此窗格。按 r 再按 Enter 重新連線。"
          }
        }
      }
    },
