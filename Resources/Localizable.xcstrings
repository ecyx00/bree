    "browser.screenshotSection.instructions": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر واسحب للتحديد. Esc للإلغاء."
          }
        },
        "bs": {
          "stringUnit": {
