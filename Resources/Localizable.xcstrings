    "browser.dialog.auth.basic.messageHost": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب %@ اسم مستخدم وكلمة مرور."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zahtijeva korisničko ime i lozinku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kræver et brugernavn og en adgangskode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ erfordert einen Benutzernamen und ein Passwort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ requires a username and password."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ requiere un nombre de usuario y una contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nécessite un nom d'utilisateur et un mot de passe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ richiede un nome utente e una password."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ にアクセスするにはユーザー名とパスワードが必要です。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ត្រូវការឈ្មោះអ្នកប្រើ និងពាក្យសម្ងាត់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 접근하려면 사용자 이름과 암호가 필요합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ krever et brukernavn og passord."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wymaga nazwy użytkownika i hasła."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ requer um nome de usuário e uma senha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для %@ требуется имя пользователя и пароль."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ต้องใช้ชื่อผู้ใช้และรหัสผ่าน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kullanıcı adı ve parola gerektiriyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для %@ потрібні ім’я користувача та пароль."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 需要用户名和密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 需要使用者名稱和密碼。"
          }
        }
      }
    },
