    "settings.shortcuts.chords.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add tmux-style multi-step shortcuts in bree.json, for example [\"ctrl+b\", \"c\"]."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "bree.json で tmux 風の2段階ショートカットを追加できます。例: [\"ctrl+b\", \"c\"]。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "bree.json에서 tmux 스타일의 다단계 단축키를 추가할 수 있습니다. 예: [\"ctrl+b\", \"c\"]."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 bree.json 中添加 tmux 风格的多步快捷键，例如 [\"ctrl+b\", \"c\"]。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie mehrstufige Tastaturkürzel im tmux-Stil in bree.json hinzu, zum Beispiel [\"ctrl+b\", \"c\"]."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des raccourcis à étapes multiples de style tmux dans bree.json, par exemple [\"ctrl+b\", \"c\"]."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إضافة اختصارات متعددة الخطوات بنمط tmux في bree.json، على سبيل المثال [\"ctrl+b\", \"c\"]."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade atajos de varios pasos al estilo de tmux en bree.json, por ejemplo [\"ctrl+b\", \"c\"]."
          }
        },
        "zh-Hant": {
