    "cli.browser.inputFiles.error.usage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "set-input-files requires --selector <css> and either --file <path> (repeatable) or --clear"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب set-input-files الخيار --selector <css> مع --file <path> (يمكن تكراره) أو --clear"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "set-input-files benötigt --selector <css> und entweder --file <path> (wiederholbar) oder --clear"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "set-input-files requiere --selector <css> y --file <path> (repetible) o --clear"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "set-input-files nécessite --selector <css> et soit --file <path> (répétable), soit --clear"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "set-input-files には --selector <css> と、--file <path>（複数指定可）または --clear が必要です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "set-input-files에는 --selector <css>와 --file <path>(반복 가능) 또는 --clear가 필요합니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "set-input-files 需要 --selector <css>，以及 --file <path>（可重复）或 --clear"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "set-input-files 需要 --selector <css>，以及 --file <path>（可重複）或 --clear"
          }
        }
      }
    },
    "cli.browser.inputFiles.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "set-input-files --selector <css> (--file <path> ... | --clear) [--snapshot-after]\n    Select local files (up to 128 files, 32 MiB total) or clear the selection. Directory uploads are unsupported."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "set-input-files --selector <css> (--file <path> ... | --clear) [--snapshot-after]\n    اختر ملفات محلية (حتى 128 ملفًا بإجمالي 32 MiB) أو امسح الاختيار. رفع المجلدات غير مدعوم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "set-input-files --selector <css> (--file <path> ... | --clear) [--snapshot-after]\n    Lokale Dateien auswählen (bis zu 128 Dateien, insgesamt 32 MiB) oder die Auswahl leeren. Ordner-Uploads werden nicht unterstützt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "set-input-files --selector <css> (--file <path> ... | --clear) [--snapshot-after]\n    Selecciona archivos locales (hasta 128 archivos, 32 MiB en total) o borra la selección. No se admite subir carpetas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "set-input-files --selector <css> (--file <path> ... | --clear) [--snapshot-after]\n    Sélectionner des fichiers locaux (jusqu’à 128 fichiers, 32 MiB au total) ou effacer la sélection. L’envoi de dossiers n’est pas pris en charge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "set-input-files --selector <css> (--file <path> ... | --clear) [--snapshot-after]\n    ローカルファイルを選択（最大128個、合計32 MiB）するか、選択を解除します。ディレクトリのアップロードには対応していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "set-input-files --selector <css> (--file <path> ... | --clear) [--snapshot-after]\n    로컬 파일을 선택하거나(최대 128개, 총 32 MiB) 선택을 지웁니다. 디렉터리 업로드는 지원되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "set-input-files --selector <css> (--file <path> ... | --clear) [--snapshot-after]\n    选择本地文件（最多 128 个文件，总计 32 MiB）或清除选择。不支持上传目录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "set-input-files --selector <css> (--file <path> ... | --clear) [--snapshot-after]\n    選取本機檔案（最多 128 個檔案，總計 32 MiB）或清除選取。不支援上傳目錄。"
          }
        }
      }
    },
    "browser.inputFiles.error.invalidTarget": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selector must match a file input without directory selection"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يطابق المحدد حقل إدخال ملفات لا يستخدم اختيار المجلدات"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Selektor muss ein Dateieingabefeld ohne Ordnerauswahl treffen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El selector debe coincidir con un campo de archivos sin selección de carpetas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sélecteur doit correspondre à un champ de fichier sans sélection de dossier"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セレクターはディレクトリ選択を使わないファイル入力欄に一致する必要があります"
