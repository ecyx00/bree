      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notify when an agent has been idle waiting for your input. Suppressed while background work is still running."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントがあなたの入力を待って待機しているときに通知します。バックグラウンド作業の実行中は抑制されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 사용자의 입력을 기다리며 유휴 상태일 때 알립니다. 백그라운드 작업이 실행 중일 때는 억제됩니다."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сповіщати, коли агент неактивний і очікує вашого вводу. Придушується, доки виконується фонова робота."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当代理空闲等待你输入时通知。后台工作仍在运行时不通知。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtigen, wenn ein Agent im Leerlauf ist und auf Ihre Eingabe wartet. Unterdrückt, während noch Hintergrundarbeit läuft."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifier lorsqu'un agent est resté inactif en attente de votre saisie. Désactivé tant que le travail en arrière-plan est toujours en cours d'exécution."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعلامي عندما يكون الوكيل خاملاً في انتظار إدخالك. يتم كتمه أثناء استمرار تشغيل العمل في الخلفية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Notificar cuando un agente haya estado inactivo esperando tu respuesta. Se silencia mientras el trabajo en segundo plano sigue ejecutándose."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當代理程式因等待您的輸入而閒置時發出通知。若背景工作仍在執行中，則會隱藏此通知。"
          }
        }
      }
    },
    "settings.notifications.agentIdleReminder.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
