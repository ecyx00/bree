          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le message contient des caractères de contrôle. Seuls le texte, les retours à la ligne et les tabulations sont autorisés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージに制御文字が含まれています。使えるのはテキスト、改行、タブだけです。"
