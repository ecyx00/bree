    "cli.current.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage: bree current [--limit <1...200>] [--json]\n\nRead bounded current-work facts already known to Bree across local and remote surfaces.\nDoes not refresh machines, read transcripts, or mutate work.\n\nFlags:\n  --limit <1...200>  Maximum items (default: 100)\n  --json            Exact owner payload with identities, evidence and freshness\n\nText and JSON use the same snapshot. Unknown facts remain unknown; possible\nhuman obligations are observations, not permission to act. --window does not\nfocus or filter this app-wide query; --id-format does not rewrite its identities.\n\nExamples:\n  bree current\n  bree current --json --limit 50"
          }
        }
      }
    },
    "cli.current.limited": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit reached; more work was observed. Use --limit (maximum 200)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit erreicht; weitere Arbeit wurde erfasst. --limit verwenden (maximal 200)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite atteinte ; d’autres travaux ont été observés. Utilisez --limit (maximum 200)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم بلوغ الحد؛ رُصد عمل إضافي. استخدم --limit (الحد الأقصى 200)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se alcanzó el límite; se observó más trabajo. Usa --limit (máximo 200)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已達上限；還有其他已觀察到的工作。請使用 --limit（最多 200）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已达上限；还有其他已观察到的工作。请使用 --limit（最多 200）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한도에 도달했습니다. 추가 작업이 관찰되었습니다. --limit를 사용하세요(최대 200)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上限に達しました。ほかにも作業が確認されています。--limit を使用してください（最大 200）。"
          }
        }
      }
    },
