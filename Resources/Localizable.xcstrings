    "debug.startupAppearance.profile.freshInstall.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No user Ghostty settings, so Bree applies its managed default colors."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザーの Ghostty 設定がないため、Bree の管理するデフォルト色を適用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有用户的 Ghostty 设置，因此 Bree 应用它托管的默认配色。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Ghostty-Einstellungen des Benutzers, daher wendet Bree seine verwalteten Standardfarben an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun paramètre utilisateur Ghostty, Bree applique donc ses couleurs par défaut managées."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد إعدادات Ghostty للمستخدم، لذا يطبق Bree ألوانه الافتراضية المدارة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ajustes de Ghostty del usuario, por lo que Bree aplica sus colores predeterminados administrados."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有使用者 Ghostty 設定，因此 Bree 會套用其管理的預設色彩。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 Ghostty 설정이 없으므로, Bree가 관리하는 기본 색상을 적용합니다."
          }
        }
      }
    },
