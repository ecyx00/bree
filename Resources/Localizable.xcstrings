          "stringUnit": {
            "state": "translated",
            "value": "تمت إعادة كتابة المسارات: %1$@ -> %2$@. لا تزال المسارات المطلقة داخل النص تشير إلى المجلد الرئيسي القديم."
          }
        },
        "de": {
          "stringUnit": {
