    "cli.workflow.ci-watch.instantiate.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the CI Watch recipe, merge the controls into .bree/dock.json, adapt commands for the repository, validate the JSON, then reload the Dock/config."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Vorlage CI Watch öffnen, Steuerelemente in .bree/dock.json übernehmen, Befehle an das Repository anpassen, JSON validieren und Dock bzw. Konfiguration neu laden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez la recette CI Watch, ajoutez les contrôles à .bree/dock.json, adaptez les commandes au dépôt, validez le JSON, puis rechargez le Dock et la configuration."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la receta CI Watch, incorpora los controles en .bree/dock.json, adapta los comandos al repositorio, valida el JSON y recarga el Dock y la configuración."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح وصفة CI Watch، وأضف عناصر التحكم إلى .bree/dock.json، وعدّل الأوامر للمستودع، وتحقق من صحة JSON، ثم أعد تحميل Dock والإعدادات."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 CI Watch 配方，将控件合并到 .bree/dock.json，按仓库需要调整命令，验证 JSON，然后重新加载 Dock 和配置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟 CI Watch 配方，將控制項合併到 .bree/dock.json，依儲存庫需求調整命令，驗證 JSON，然後重新載入 Dock 和設定。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CI Watch 설정 예제를 열고 컨트롤을 .bree/dock.json에 병합한 뒤 저장소에 맞게 명령을 수정하고 JSON을 검증한 다음 Dock과 설정을 다시 불러오세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CI Watch レシピを開き、コントロールを .bree/dock.json に追加し、コマンドをリポジトリに合わせ、JSON を検証して Dock と設定を再読み込みします。"
          }
        }
      }
    },
