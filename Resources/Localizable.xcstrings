    "cli.architecture.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check or build the Architecture page from the diagrams your agent wrote in .architecture/agent/. Needs python3; check also needs a Chromium-family browser (set BREE_ARCHITECTURE_BROWSER to pick one). No running app is needed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mimari sayfasını, ajanınızın .architecture/agent/ içine yazdığı diyagramlardan doğrulayın veya üretin. python3 gerekir; check için ayrıca Chromium tabanlı bir tarayıcı gerekir (seçmek için BREE_ARCHITECTURE_BROWSER ayarlayın). Çalışan bir uygulama gerekmez."
          }
        }
      }
    },
    "cli.architecture.check.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Validate the diagrams (code anchors, SVG safety, layout in a browser). Exit 1 on any FAIL."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diyagramları doğrular (kod bağlantıları, SVG güvenliği, tarayıcıda yerleşim). Herhangi bir FAIL'de 1 ile çıkar."
          }
        }
      }
    },
    "cli.architecture.render.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build .architecture/current.html from .architecture/agent/."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ".architecture/agent/ içinden .architecture/current.html üretir."
          }
        }
      }
    },
    "cli.architecture.root.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "root defaults to the nearest folder above the current directory that holds .architecture or .git."
          }
        },
        "tr": {
