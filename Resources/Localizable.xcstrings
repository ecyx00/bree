    "workspace.closeProtected.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinned workspaces can't be closed while pinned. Unpin the workspace first."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピン留めされたワークスペースは閉じられません。先にピンを外してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고정된 워크스페이스는 고정된 상태에서 닫을 수 없습니다. 먼저 워크스페이스의 고정을 해제하세요."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закріплені робочі області не можна закрити, поки вони закріплені. Спочатку відкріпіть робочу область."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已固定的工作区在固定状态下无法关闭。请先取消固定该工作区。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angepinnte Arbeitsbereiche können nicht geschlossen werden, solange sie angepinnt sind. Hebe zuerst das Anpinnen des Arbeitsbereichs auf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les espaces de travail épinglés ne peuvent pas être fermés. Désépinglez d’abord l’espace de travail."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن إغلاق مساحات العمل المثبتة أثناء تثبيتها. قم بإلغاء تثبيت مساحة العمل أولاً."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los espacios de trabajo fijados no se pueden cerrar mientras estén fijados. Desfija el espacio de trabajo primero."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "釘選的工作區在釘選狀態下無法關閉。請先取消釘選該工作區。"
          }
        }
      }
    },
