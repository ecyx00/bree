            "value": "Memory Budget"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ميزانية الذاكرة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speicherbudget"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Presupuesto de memoria"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Budget mémoire"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモリ予算"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모리 예산"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内存预算"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記憶體預算"
          }
        }
      }
    },
    "settings.browser.hiddenWebViewDiscardMode.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Memory Budget frees the tabs hidden longest once hidden tabs use more than the budget. Timer frees every tab hidden longer than the delay."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحرر «ميزانية الذاكرة» علامات التبويب المخفية منذ أطول مدة عندما تتجاوز علامات التبويب المخفية الميزانية. ويحرر «المؤقت» كل علامة تبويب مخفية لمدة أطول من التأخير."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Speicherbudget“ gibt die am längsten ausgeblendeten Tabs frei, sobald ausgeblendete Tabs mehr als das Budget belegen. „Zeitgesteuert“ gibt jeden Tab frei, der länger als die Verzögerung ausgeblendet ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Presupuesto de memoria» libera las pestañas ocultas desde hace más tiempo cuando las pestañas ocultas superan el presupuesto. «Temporizador» libera cada pestaña oculta durante más tiempo que la demora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Budget mémoire » libère les onglets masqués depuis le plus longtemps dès que les onglets masqués dépassent le budget. « Minuteur » libère chaque onglet masqué depuis plus longtemps que le délai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「メモリ予算」は、非表示のタブが予算を超えてメモリを使うと、最も長く非表示になっているタブから解放します。「タイマー」は、遅延時間より長く非表示になっているすべてのタブを解放します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'메모리 예산'은 숨겨진 탭이 예산보다 많은 메모리를 사용하면 가장 오래 숨겨진 탭부터 해제합니다. '타이머'는 지연 시간보다 오래 숨겨진 모든 탭을 해제합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“内存预算”会在隐藏标签页占用的内存超过预算时，释放隐藏最久的标签页。“计时器”会释放隐藏时间超过延迟的每个标签页。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「記憶體預算」會在隱藏標籤頁使用的記憶體超過預算時，釋放隱藏最久的標籤頁。「計時器」會釋放隱藏時間超過延遲的每個標籤頁。"
          }
        }
      }
    },
    "settings.browser.hiddenWebViewDiscardMode.timer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timer"
