    "settings.app.watchGitStatus.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدّث بيانات الفرع وطلبات السحب في الشريط الجانبي من تغييرات ملفات المستودع دون استطلاع git."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ažuriraj granu i PR metapodatke u bočnoj traci iz promjena datoteka repozitorija bez anketiranja git-a."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opdater sidepanelets gren- og PR-metadata fra ændringer i repositoryfiler uden at polle git."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisiert Branch- und PR-Metadaten in der Seitenleiste aus Repository-Dateiänderungen, ohne git abzufragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update sidebar branch and PR metadata from repository file changes without polling git."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualiza la rama y los metadatos de PR de la barra lateral desde cambios de archivos del repositorio sin consultar git periódicamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Met à jour la branche et les métadonnées de PR de la barre latérale depuis les changements de fichiers du dépôt, sans interroger git."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiorna ramo e metadati PR nella barra laterale dalle modifiche ai file del repository senza interrogare git."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "git をポーリングせず、リポジトリのファイル変更からサイドバーのブランチと PR メタデータを更新します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "git을 폴링하지 않고 저장소 파일 변경으로 사이드바 브랜치와 PR 메타데이터를 업데이트합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppdater sidepanelets gren- og PR-metadata fra endringer i repositoryfiler uten å spørre git."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualizuj gałąź i metadane PR na pasku bocznym na podstawie zmian plików repozytorium bez odpytywania git."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualize a branch e os metadados de PR da barra lateral a partir de mudanças nos arquivos do repositório sem consultar o git periodicamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновлять ветку и метаданные PR на боковой панели по изменениям файлов репозитория без опроса git."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อัปเดตสาขาและข้อมูลเมตา PR ในแถบด้านข้างจากการเปลี่ยนแปลงไฟล์ของที่เก็บโดยไม่ต้อง polling git"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kenar çubuğu dal ve PR meta verilerini git’i yoklamadan depo dosyası değişikliklerinden güncelle."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оновлювати гілку та метадані PR на бічній панелі за змінами файлів репозиторію без опитування git."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据仓库文件变化更新侧边栏分支和 PR 元数据，而不轮询 git。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "根據儲存庫檔案變更更新側邊欄分支與 PR 中繼資料，而不輪詢 git。"
          }
        }
      }
    },
