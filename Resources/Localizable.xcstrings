          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El estado de la sesión remota de PTY no está disponible para uno o más espacios de trabajo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
