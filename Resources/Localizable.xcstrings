    "agentRestore.admission.invalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent restore admission requires a valid workspace, surface, kind, and session."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントの復元許可には、有効なワークスペース、サーフェス、種類、セッションが必要です。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zulassung zur Agent-Wiederherstellung erfordert einen gültigen Arbeitsbereich, eine gültige Oberfläche, einen gültigen Typ und eine gültige Sitzung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’admission de restauration de l’agent requiert un espace de travail, une surface d’affichage, un type et une session valides."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب قبول استعادة الوكيل مساحة عمل، وسطح، ونوع، وجلسة صالحة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La admisión de restauración del agente requiere un espacio de trabajo, superficie, tipo y sesión válidos."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理程式還原准入需要有效的工作區、介面、種類及工作階段。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复智能体准入需要有效的工作区、表面、类型和会话。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트 복구 승인에는 유효한 작업 공간, 화면, 종류 및 세션이 필요합니다."
          }
        }
      }
    },
    "agentRestore.admission.releaseInvalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent restore claim release requires a valid kind, session, and claim identifier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントの復元要求を解放するには、有効な種類、セッション、要求 ID が必要です。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Freigabe der Agent-Wiederherstellungsanforderung erfordert einen gültigen Typ, eine gültige Sitzung und eine gültige Anforderungskennung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La libération de la revendication de restauration de l’agent requiert un type, une session et un identifiant de revendication valides."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب تحرير مطالبة استعادة الوكيل نوع، وجلسة، ومعرف مطالبة صالح."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La liberación de reclamación de restauración del agente requiere un tipo, sesión e identificador de reclamación válidos."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理程式還原宣告釋放需要有效的種類、工作階段及宣告識別碼。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "释放智能体恢复所有权需要有效的类型、会话和所有权标识符。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트 복구 클레임 해제에는 유효한 종류, 세션 및 클레임 식별자가 필요합니다."
          }
        }
      }
    },
    "agentRestore.admission.targetChanged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The surface restore record changed. Run 'bree restore --surface' again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーフェスの復元レコードが変更されました。もう一度「Bree restore --surface」を実行してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Wiederherstellungsdatensatz der Oberfläche hat sich geändert. Führe 'bree restore --surface' erneut aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement de restauration de la surface d’affichage a changé. Exécutez à nouveau 'bree restore --surface'."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغير سجل استعادة السطح. قم بتشغيل 'bree restore --surface' مجددًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El registro de restauración de la superficie ha cambiado. Ejecuta 'bree restore --surface' de nuevo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "介面還原記錄已變更。請重新執行 'bree restore --surface'。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "表面恢复记录已更改。请重新运行 'bree restore --surface'。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 복구 기록이 변경되었습니다. 'bree restore --surface'를 다시 실행하십시오."
          }
        }
      }
    },
    "agentRestore.admission.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree could not verify whether this agent session is already running. Retry 'bree restore --surface'."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このエージェントセッションがすでに実行中かどうかを Bree で確認できませんでした。「Bree restore --surface」を再試行してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree konnte nicht überprüfen, ob diese Agenten-Sitzung bereits läuft. Versuche 'bree restore --surface' erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree n’a pas pu vérifier si cette session d’agent est déjà en cours d’exécution. Réessayez 'bree restore --surface'."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر على Bree التحقق مما إذا كانت جلسة الوكيل هذه قيد التشغيل بالفعل. أعد محاولة 'bree restore --surface'."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree no pudo verificar si esta sesión del agente ya se está ejecutando. Reintenta 'bree restore --surface'."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree 無法驗證此代理程式工作階段是否已在執行。請重試 'bree restore --surface'。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree 无法验证此智能体会话是否已在运行。请重试 'bree restore --surface'。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree에서 이 에이전트 세션이 이미 실행 중인지 확인할 수 없습니다. 'bree restore --surface'를 다시 시도하십시오."
          }
        }
      }
    },
    "agentRestore.liveOwner.notice": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu aracı oturumu zaten %1$lld numaralı işlemde çalışıyor. Bree başka bir kopya başlatmadı. Burada devralmak için %1$lld numaralı işlemi durdurun, ardından 'bree restore --surface' komutunu yeniden çalıştırın."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This agent session is already running in process %1$lld. Bree did not start another copy. To take it over here, stop process %1$lld, then run 'bree restore --surface' again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このエージェントセッションはプロセス %1$lld ですでに実行中です。Bree は別のコピーを起動しませんでした。このターミナルで引き継ぐには、プロセス %1$lld を停止してから、もう一度「Bree restore --surface」を実行してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Agenten-Sitzung läuft bereits im Prozess %1$lld. Bree hat keine weitere Kopie gestartet. Um sie hier zu übernehmen, stoppe den Prozess %1$lld und führe dann 'bree restore --surface' erneut aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette session d’agent est déjà en cours d’exécution dans le processus %1$lld. Bree n’a pas démarré d’autre instance. Pour en prendre le contrôle ici, arrêtez le processus %1$lld, puis exécutez à nouveau 'bree restore --surface'."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جلسة الوكيل هذه قيد التشغيل بالفعل في العملية %1$lld. لم يقم Bree ببدء نسخة أخرى. للاستحواذ عليها هنا، أوقف العملية %1$lld، ثم قم بتشغيل 'bree restore --surface' مجددًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta sesión del agente ya se está ejecutando en el proceso %1$lld. Bree no inició otra copia. Para tomar el control aquí, detén el proceso %1$lld, luego ejecuta 'bree restore --surface' de nuevo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此代理程式工作階段已在程序 %1$lld 中執行。Bree 未啟動另一個複本。若要在此接管，請停止程序 %1$lld，然後重新執行 'bree restore --surface'。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此智能体会话已在进程 %1$lld 中运行。Bree 没有启动另一个副本。若要在此处接管它，请停止进程 %1$lld，然后重新运行 'bree restore --surface'。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 에이전트 세션은 프로세스 %1$lld에서 이미 실행 중입니다. Bree가 다른 사본을 시작하지 않았습니다. 여기서 세션을 인수하려면 프로세스 %1$lld을(를) 중지한 다음 'bree restore --surface'를 다시 실행하십시오."
          }
        }
      }
    },
    "cli.restore.error.admissionIdentityMissing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: this session's live ownership could not be verified. Run 'bree restore --surface' again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: このセッションの実行中の所有者を確認できませんでした。もう一度「bree restore --surface」を実行してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: Die Live-Inhaberschaft dieser Sitzung konnte nicht verifiziert werden. Führe 'bree restore --surface' erneut aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "restore : la propriété active de cette session n’a pas pu être vérifiée. Exécutez à nouveau 'bree restore --surface'."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: تعذر التحقق من الملكية النشطة لهذه الجلسة. قم بتشغيل 'bree restore --surface' مجددًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: no se pudo verificar la propiedad activa de esta sesión. Ejecuta 'bree restore --surface' de nuevo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "restore：無法驗證此工作階段的即時擁有權。請重新執行 'bree restore --surface'。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: 无法验证此会话的活动所有权。请重新运行 'bree restore --surface'。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: 이 세션의 라이브 소유권을 확인할 수 없습니다. 'bree restore --surface'를 다시 실행하십시오."
          }
        }
      }
    },
    "cli.restore.error.launchPending": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: another launch of this agent session is already starting. Wait for it to appear, or retry 'bree restore --surface'."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: このエージェントセッションの別の起動がすでに始まっています。表示されるまで待つか、「bree restore --surface」を再試行してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: Ein weiterer Start dieser Agenten-Sitzung beginnt bereits. Warte, bis sie erscheint, oder versuche 'bree restore --surface' erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "restore : un autre lancement de cette session d’agent est déjà en cours. Attendez qu’elle apparaisse ou réessayez 'bree restore --surface'."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: هناك تشغيل آخر لجلسة الوكيل هذه قيد البدء بالفعل. انتظر حتى تظهر، أو أعد محاولة 'bree restore --surface'."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: ya se está iniciando otro lanzamiento de esta sesión del agente. Espera a que aparezca o reintenta 'bree restore --surface'."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "restore：此代理程式工作階段的另一個啟動已在開始。請等待其出現，或重試 'bree restore --surface'。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: 此智能体会话的另一个启动进程已在运行。请等待其出现，或重试 'bree restore --surface'。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: 이 에이전트 세션의 다른 실행이 이미 시작 중입니다. 나타날 때까지 기다리거나 'bree restore --surface'를 다시 시도하십시오."
          }
        }
      }
    },
