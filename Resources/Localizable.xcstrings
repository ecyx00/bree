          }
        }
      }
    },
    "browser.viewport.error.elementFullscreen": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exit browser element fullscreen before changing the browser viewport"
