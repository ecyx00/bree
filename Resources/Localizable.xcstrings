            "value": "التحذير قبل إغلاق النافذة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor dem Schließen eines Fensters warnen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Advertir antes de cerrar una ventana"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avertir avant de fermer une fenêtre"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウィンドウを閉じる前に警告"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "윈도우를 닫기 전에 경고"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Попереджати перед закриттям вікна"
          }
        },
        "zh-Hans": {
