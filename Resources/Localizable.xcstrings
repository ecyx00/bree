        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已自動繼續 ×%lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已自动继续 ×%lld"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 재개 ×%lld"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動再開 ×%lld"
          }
        }
      }
    },
    "settings.automation.agentAutoResume": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-Resume Agents After Errors"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenten nach Fehlern automatisch fortsetzen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relancer automatiquement les agents après une erreur"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استئناف الوكلاء تلقائيًا بعد الأخطاء"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reanudar agentes automáticamente tras errores"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錯誤後自動恢復代理"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出错后自动恢复代理"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오류 후 에이전트 자동 재개"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エラー後にエージェントを自動再開"
          }
        }
      }
    },
    "settings.automation.agentAutoResume.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send “continue” when an agent's turn ends on a retryable error such as model capacity or a dropped connection."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet „continue“, wenn der Zug eines Agenten mit einem wiederholbaren Fehler endet, etwa ausgelasteter Modellkapazität oder einer getrennten Verbindung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie « continue » quand le tour d’un agent se termine sur une erreur réessayable, comme un modèle saturé ou une connexion interrompue."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرسل \"continue\" عندما ينتهي دور الوكيل بخطأ يمكن إعادة المحاولة بعده، مثل امتلاء سعة النموذج أو انقطاع الاتصال."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía «continue» cuando el turno de un agente termina con un error reintentable, como falta de capacidad del modelo o una conexión perdida."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當代理的回合因可重試的錯誤（例如模型容量不足或連線中斷）而結束時，傳送「continue」。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当代理的回合因可重试的错误（例如模型容量不足或连接中断）而结束时，发送“continue”。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델 용량 초과나 연결 끊김처럼 재시도 가능한 오류로 에이전트의 턴이 끝나면 “continue”를 보냅니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルの容量不足や接続切断など、再試行可能なエラーでエージェントのターンが終了したときに「continue」を送信します。"
          }
        }
      }
    },
    "settings.search.alias.setting.automation.agent-error-auto-resume": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "automation.agentAutoResume auto resume continue retry capacity overloaded agent error"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "automation.agentAutoResume auto resume continue retry capacity overloaded agent error automatisch fortsetzen fortfahren wiederholen kapazität überlastet agent fehler"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "automation.agentAutoResume auto resume continue retry capacity overloaded agent error reprise automatique continuer réessayer capacité surchargé agent erreur"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "automation.agentAutoResume auto resume continue retry capacity overloaded agent error استئناف تلقائي متابعة إعادة المحاولة سعة حمل زائد وكيل خطأ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "automation.agentAutoResume auto resume continue retry capacity overloaded agent error reanudar automáticamente continuar reintentar capacidad sobrecargado agente error"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "automation.agentAutoResume auto resume continue retry capacity overloaded agent error 自動恢復 繼續 重試 容量 過載 代理 錯誤"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "automation.agentAutoResume auto resume continue retry capacity overloaded agent error 自动恢复 继续 重试 容量 过载 代理 错误"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "automation.agentAutoResume auto resume continue retry capacity overloaded agent error 자동 재개 계속 재시도 용량 과부하 에이전트 오류"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "automation.agentAutoResume auto resume continue retry capacity overloaded agent error 自動再開 続行 再試行 容量 過負荷 エージェント エラー"
          }
        }
      }
    },
    "cli.send.error.dialogOpen": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ is waiting on a question or dialog, so nothing was sent. Retry once it is answered, or pass --force to send anyway."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ is waiting on a question or dialog, so nothing was sent. Retry once it is answered, or pass --force to send anyway."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: ينتظر %2$@ إجابة على سؤال أو مربع حوار، لذا لم يُرسل شيء. أعد المحاولة بعد الإجابة، أو مرّر --force للإرسال على أي حال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ wartet auf eine Frage oder einen Dialog, daher wurde nichts gesendet. Versuche es erneut, sobald sie beantwortet ist, oder übergib --force, um trotzdem zu senden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ está esperando una pregunta o un diálogo, así que no se envió nada. Vuelve a intentarlo cuando se responda, o pasa --force para enviarlo de todos modos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ : %2$@ attend la réponse à une question ou à une boîte de dialogue, rien n'a donc été envoyé. Réessayez une fois la réponse donnée, ou passez --force pour envoyer quand même."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ は質問またはダイアログへの応答を待っているため、何も送信しませんでした。応答後に再試行するか、--force を指定して送信してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@에서 질문 또는 대화상자가 응답을 기다리고 있어 아무것도 보내지 않았습니다. 응답한 후 다시 시도하거나 --force를 지정해 그래도 보내세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@：%2$@ 正在等待问题或对话框的回应，因此未发送任何内容。请在回应后重试，或传入 --force 强制发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@：%2$@ 正在等待問題或對話框的回應，因此未傳送任何內容。請在回應後重試，或傳入 --force 強制傳送。"
          }
        }
      }
    },
    "cli.send.error.draftPresent": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: the agent prompt in %2$@ holds text someone is typing, so nothing was sent. Retry when the prompt is clear, or pass --force to send anyway."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: the agent prompt in %2$@ holds text someone is typing, so nothing was sent. Retry when the prompt is clear, or pass --force to send anyway."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: تحتوي مطالبة الوكيل في %2$@ على نص يكتبه شخص ما، لذا لم يُرسل شيء. أعد المحاولة عندما تصبح المطالبة فارغة، أو مرّر --force للإرسال على أي حال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: Die Agent-Eingabe in %2$@ enthält Text, den jemand gerade tippt, daher wurde nichts gesendet. Versuche es erneut, wenn die Eingabe leer ist, oder übergib --force, um trotzdem zu senden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: el prompt del agente en %2$@ contiene texto que alguien está escribiendo, así que no se envió nada. Vuelve a intentarlo cuando el prompt esté vacío, o pasa --force para enviarlo de todos modos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ : l'invite de l'agent dans %2$@ contient du texte en cours de saisie, rien n'a donc été envoyé. Réessayez quand l'invite est vide, ou passez --force pour envoyer quand même."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ のエージェントのプロンプトに誰かが入力中のテキストがあるため、何も送信しませんでした。プロンプトが空になってから再試行するか、--force を指定して送信してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@의 에이전트 프롬프트에 누군가 입력 중인 텍스트가 있어 아무것도 보내지 않았습니다. 프롬프트가 비면 다시 시도하거나 --force를 지정해 그래도 보내세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@：%2$@ 中的代理提示里有人正在输入文本，因此未发送任何内容。请在提示清空后重试，或传入 --force 强制发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@：%2$@ 中的代理程式提示裡有人正在輸入文字，因此未傳送任何內容。請在提示清空後重試，或傳入 --force 強制傳送。"
          }
        }
      }
    },
    "cli.agentMessage.noAgent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No agent activity seen on that surface yet. The message waits until an agent there picks it up."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُرصد أي نشاط لوكيل على هذا السطح بعد. تنتظر الرسالة حتى يستلمها وكيل هناك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dieser Oberfläche wurde noch keine Agent-Aktivität erkannt. Die Nachricht wartet, bis ein Agent dort sie abholt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no se ha visto actividad de ningún agente en esa superficie. El mensaje espera hasta que un agente allí lo recoja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune activité d'agent détectée sur cette surface pour l'instant. Le message attend qu'un agent l'y récupère."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのサーフェスではまだエージェントの動きが確認されていません。そこのエージェントが受け取るまでメッセージは待機します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 표면에서 아직 에이전트 활동이 없습니다. 그곳의 에이전트가 가져갈 때까지 메시지가 대기합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未在该表面看到代理活动。消息会等待，直到那里的代理取走它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未在該表面看到代理活動。訊息會等待，直到那裡的代理取走它。"
          }
        }
      }
    },
    "cli.agentMessage.queued": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Queued message %@ for %@ (%@)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Queued message %@ for %@ (%@)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وُضعت الرسالة %1$@ في قائمة الانتظار لـ %2$@ (%3$@)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachricht %1$@ für %2$@ (%3$@) in die Warteschlange gestellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mensaje %1$@ en cola para %2$@ (%3$@)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Message %1$@ mis en file pour %2$@ (%3$@)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージ %1$@ を %2$@（%3$@）宛てにキューに入れました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시지 %1$@을(를) %2$@(%3$@) 앞으로 대기열에 넣었습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已将消息 %1$@ 排入 %2$@（%3$@）的队列。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已將訊息 %1$@ 排入 %2$@（%3$@）的佇列。"
          }
        }
      }
    },
    "cli.help.agentInbox": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاستخدام: bree agent inbox [--surface <target>] [--state queued|delivered|read|failed] [--limit <n>] [--mark-read] [--json]\n\nيعرض رسائل الوكلاء، الأحدث أولًا. بدون --surface، يعرض الرسائل لكل\nالأسطح. يضع --mark-read علامة مقروءة على الرسائل المعروضة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendung: bree agent inbox [--surface <target>] [--state queued|delivered|read|failed] [--limit <n>] [--mark-read] [--json]\n\nListet Agent-Nachrichten auf, neueste zuerst. Ohne --surface werden Nachrichten für\nalle Oberflächen aufgelistet. --mark-read markiert die aufgelisteten Nachrichten als gelesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage: bree agent inbox [--surface <target>] [--state queued|delivered|read|failed] [--limit <n>] [--mark-read] [--json]\n\nList agent messages, newest first. Without --surface, lists messages for\nevery surface. --mark-read marks the listed messages read."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Uso: bree agent inbox [--surface <target>] [--state queued|delivered|read|failed] [--limit <n>] [--mark-read] [--json]\n\nLista los mensajes de agentes, del más reciente al más antiguo. Sin --surface, lista los mensajes de\ntodas las superficies. --mark-read marca como leídos los mensajes listados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisation : bree agent inbox [--surface <target>] [--state queued|delivered|read|failed] [--limit <n>] [--mark-read] [--json]\n\nListe les messages d'agent, du plus récent au plus ancien. Sans --surface, liste les messages de\ntoutes les surfaces. --mark-read marque les messages listés comme lus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使い方: bree agent inbox [--surface <target>] [--state queued|delivered|read|failed] [--limit <n>] [--mark-read] [--json]\n\nエージェントのメッセージを新しい順に一覧表示します。--surface を指定しないと\nすべてのサーフェスのメッセージを表示します。--mark-read は表示したメッセージを既読にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용법: bree agent inbox [--surface <target>] [--state queued|delivered|read|failed] [--limit <n>] [--mark-read] [--json]\n\n에이전트 메시지를 최신순으로 나열합니다. --surface가 없으면\n모든 표면의 메시지를 나열합니다. --mark-read는 나열된 메시지를 읽음으로 표시합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用法： bree agent inbox [--surface <target>] [--state queued|delivered|read|failed] [--limit <n>] [--mark-read] [--json]\n\n列出代理消息，最新的在前。未指定 --surface 时，列出\n所有表面的消息。--mark-read 会将列出的消息标记为已读。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用法： bree agent inbox [--surface <target>] [--state queued|delivered|read|failed] [--limit <n>] [--mark-read] [--json]\n\n列出代理訊息，最新的在前。未指定 --surface 時，列出\n所有表面的訊息。--mark-read 會將列出的訊息標為已讀。"
          }
        }
      }
    },
    "cli.help.agentMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاستخدام: bree agent message <target> [--from <name>] [--thread <id>] [--json] [--] <text|->\n       Bree agent message --reply-to <message-id> [--from <name>] [--json] [--] <text|->\n\nيرسل رسالة إلى الوكيل الذي يعمل في مساحة عمل أو سطح آخر. يوصلها Bree\nعبر خطافات ذلك الوكيل، ولا يكتبها أبدًا في طرفيته،\nلذا لا يمكن أن تقع داخل موجّه مكتوب نصفه. تستيقظ جلسة Claude Code الخاملة\nلقراءتها، وتقرأها الجلسة المشغولة في خطوتها التالية.\n\n<target> هو معرّف أو مرجع مساحة عمل أو سطح (workspace:2، surface:5)، أو\nعنوان مساحة عمل (مطابقة تامة أولًا، ثم بادئة فريدة). استخدم - لقراءة النص من\nstdin. القيمة الافتراضية لـ --from هي عنوان مساحة العمل المرسِلة.\n\nأمثلة:\n  Bree agent message bree-remote-status \"The relay fix is on main, rebase when free.\"\n  Bree agent message --reply-to 3f2a... \"Done, PR is #123.\""
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendung: bree agent message <target> [--from <name>] [--thread <id>] [--json] [--] <text|->\n       Bree agent message --reply-to <message-id> [--from <name>] [--json] [--] <text|->\n\nSendet eine Nachricht an den Agenten in einem anderen Workspace oder einer anderen Oberfläche. Bree\nliefert sie über die Hooks dieses Agenten aus, nie durch Tippen in sein Terminal,\ndaher kann sie nicht in einem halb getippten Prompt landen. Eine untätige Claude-Code-Sitzung wacht\nauf, um sie zu lesen; eine beschäftigte liest sie bei ihrem nächsten Schritt.\n\n<target> ist eine Workspace- oder Oberflächen-ID bzw. -Referenz (workspace:2, surface:5) oder ein\nWorkspace-Titel (zuerst exakt, dann ein eindeutiges Präfix). Mit - wird der Text von\nstdin gelesen. --from ist standardmäßig der Titel des sendenden Workspace.\n\nBeispiele:\n  Bree agent message bree-remote-status \"The relay fix is on main, rebase when free.\"\n  Bree agent message --reply-to 3f2a... \"Done, PR is #123.\""
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage: bree agent message <target> [--from <name>] [--thread <id>] [--json] [--] <text|->\n       Bree agent message --reply-to <message-id> [--from <name>] [--json] [--] <text|->\n\nSend a message to the agent running in another workspace or surface. Bree\ndelivers it through that agent's hooks, never by typing into its terminal,\nso it cannot land in a half-typed prompt. An idle Claude Code session wakes\nup to read it; a busy one reads it at its next step.\n\n<target> is a workspace or surface id or ref (workspace:2, surface:5), or a\nworkspace title (exact, then a unique prefix). Use - to read the text from\nstdin. --from defaults to the sending workspace's title.\n\nExamples:\n  Bree agent message bree-remote-status \"The relay fix is on main, rebase when free.\"\n  Bree agent message --reply-to 3f2a... \"Done, PR is #123.\""
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Uso: bree agent message <target> [--from <name>] [--thread <id>] [--json] [--] <text|->\n       Bree agent message --reply-to <message-id> [--from <name>] [--json] [--] <text|->\n\nEnvía un mensaje al agente que se ejecuta en otro espacio de trabajo o superficie. Bree\nlo entrega a través de los hooks de ese agente, nunca escribiendo en su terminal,\npor lo que no puede acabar en un prompt a medio escribir. Una sesión inactiva de Claude Code se despierta\npara leerlo; una ocupada lo lee en su siguiente paso.\n\n<target> es un ID o referencia de espacio de trabajo o superficie (workspace:2, surface:5), o un\ntítulo de espacio de trabajo (exacto, luego un prefijo único). Usa - para leer el texto desde\nstdin. --from usa por defecto el título del espacio de trabajo que envía.\n\nEjemplos:\n  Bree agent message bree-remote-status \"The relay fix is on main, rebase when free.\"\n  Bree agent message --reply-to 3f2a... \"Done, PR is #123.\""
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisation : bree agent message <target> [--from <name>] [--thread <id>] [--json] [--] <text|->\n       Bree agent message --reply-to <message-id> [--from <name>] [--json] [--] <text|->\n\nEnvoie un message à l'agent d'un autre espace de travail ou d'une autre surface. Bree\nle remet via les hooks de cet agent, jamais en tapant dans son terminal,\nil ne peut donc pas atterrir dans un prompt à moitié tapé. Une session Claude Code inactive se réveille\npour le lire ; une session occupée le lit à sa prochaine étape.\n\n<target> est un identifiant ou une référence d'espace de travail ou de surface (workspace:2, surface:5), ou un\ntitre d'espace de travail (exact, puis un préfixe unique). Utilisez - pour lire le texte depuis\nstdin. Par défaut, --from vaut le titre de l'espace de travail expéditeur.\n\nExemples :\n  Bree agent message bree-remote-status \"The relay fix is on main, rebase when free.\"\n  Bree agent message --reply-to 3f2a... \"Done, PR is #123.\""
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使い方: bree agent message <target> [--from <name>] [--thread <id>] [--json] [--] <text|->\n       Bree agent message --reply-to <message-id> [--from <name>] [--json] [--] <text|->\n\n別のワークスペースまたはサーフェスで動いているエージェントにメッセージを送ります。Bree は\nそのエージェントのフック経由で届け、ターミナルに打ち込むことはないので、\n入力途中のプロンプトに紛れ込みません。アイドル中の Claude Code セッションは起きて\n読み、作業中のセッションは次のステップで読みます。\n\n<target> はワークスペースかサーフェスの ID または参照（workspace:2、surface:5）、または\nワークスペースのタイトル（完全一致、次に一意な前方一致）です。- を指定すると\nstdin からテキストを読みます。--from の既定値は送信元ワークスペースのタイトルです。\n\n例:\n  Bree agent message bree-remote-status \"The relay fix is on main, rebase when free.\"\n  Bree agent message --reply-to 3f2a... \"Done, PR is #123.\""
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용법: bree agent message <target> [--from <name>] [--thread <id>] [--json] [--] <text|->\n       Bree agent message --reply-to <message-id> [--from <name>] [--json] [--] <text|->\n\n다른 워크스페이스나 표면에서 실행 중인 에이전트에게 메시지를 보냅니다. Bree는\n해당 에이전트의 훅을 통해 전달하며, 절대 터미널에 입력하지 않으므로\n반쯤 입력된 프롬프트에 섞일 수 없습니다. 유휴 상태의 Claude Code 세션은 깨어나서\n읽고, 작업 중인 세션은 다음 단계에서 읽습니다.\n\n<target>은 워크스페이스나 표면의 ID 또는 참조(workspace:2, surface:5), 또는\n워크스페이스 제목(먼저 정확히 일치, 그다음 고유한 접두사)입니다. -를 쓰면\nstdin에서 텍스트를 읽습니다. --from의 기본값은 보내는 워크스페이스의 제목입니다.\n\n예시:\n  Bree agent message bree-remote-status \"The relay fix is on main, rebase when free.\"\n  Bree agent message --reply-to 3f2a... \"Done, PR is #123.\""
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用法： bree agent message <target> [--from <name>] [--thread <id>] [--json] [--] <text|->\n       Bree agent message --reply-to <message-id> [--from <name>] [--json] [--] <text|->\n\n向在另一个工作区或表面中运行的代理发送消息。Bree\n通过该代理的 hook 投递消息，绝不会向它的终端输入按键，\n因此消息不会落入输入到一半的提示中。空闲的 Claude Code 会话会醒来\n阅读它；忙碌的会话会在下一步阅读。\n\n<target> 是工作区或表面的 ID 或引用（workspace:2、surface:5），或\n工作区标题（先完全匹配，再找唯一前缀）。使用 - 从\nstdin 读取文本。--from 默认为发送端工作区的标题。\n\n示例：\n  Bree agent message bree-remote-status \"The relay fix is on main, rebase when free.\"\n  Bree agent message --reply-to 3f2a... \"Done, PR is #123.\""
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用法： bree agent message <target> [--from <name>] [--thread <id>] [--json] [--] <text|->\n       Bree agent message --reply-to <message-id> [--from <name>] [--json] [--] <text|->\n\n傳送訊息給在另一個工作區或表面中執行的代理。Bree\n透過該代理的 hook 遞送訊息，絕不會打字到它的終端機，\n因此訊息不會落入打到一半的提示中。閒置的 Claude Code 工作階段會醒來\n閱讀它；忙碌中的工作階段會在下一步閱讀。\n\n<target> 是工作區或表面的 ID 或參照（workspace:2、surface:5），或\n工作區標題（先完全符合，再找唯一前綴）。使用 - 從\nstdin 讀取文字。--from 預設為傳送端工作區的標題。\n\n範例：\n  Bree agent message bree-remote-status \"The relay fix is on main, rebase when free.\"\n  Bree agent message --reply-to 3f2a... \"Done, PR is #123.\""
          }
        }
      }
    },
    "socket.agentMessage.error.bodyTooLarge": {
