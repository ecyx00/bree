    "browser.automation.error.documentReadinessTimedOut": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت مهلة انتظار جاهزية مستند المتصفح."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Isteklo je vrijeme čekanja da dokument preglednika bude spreman."
