    "cli.help.unknownTopic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unknown topics keep the top-level help behavior."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unbekannte Themen zeigen weiterhin die oberste Hilfe an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sujets inconnus conservent le comportement de l’aide générale."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحافظ المواضيع غير المعروفة على سلوك المساعدة العامة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los temas desconocidos mantienen el comportamiento de la ayuda general."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未知主題會維持頂層說明行為。"
          }
