    "sudo.cli.error.request_capacity": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: too many approval requests are pending; resolve one in Bree and retry"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: 承認待ちのリクエストが多すぎます。Bree でいずれかを処理してから再試行してください"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: zu viele Genehmigungsanfragen sind ausstehend; lösen Sie eine in Bree und versuchen Sie es erneut"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: هناك عدد كبير جدًا من طلبات الموافقة معلقة؛ قم بحل واحد في Bree ثم أعد المحاولة"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: previše zahtjeva za odobrenje je na čekanju; riješite jedan u Bree i pokušajte ponovo"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: Der afventer for mange godkendelsesanmodninger; løs en i Bree og prøv igen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: hay demasiadas solicitudes de aprobación pendientes; resuelve una en Bree y vuelve a intentarlo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo : trop de demandes d'approbation sont en attente ; résolvez-en un dans Bree et réessayez"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: troppe richieste di approvazione sono in sospeso; risolverne uno in Bree e riprovare"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo៖ សំណើអនុម័តច្រើនពេកកំពុងរង់ចាំ។ ដោះស្រាយមួយនៅក្នុង Bree ហើយព្យាយាមម្តងទៀត"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: for mange godkjenningsforespørsler venter; løs en i Bree og prøv på nytt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: zbyt wiele próśb o zatwierdzenie oczekuje na realizację; rozwiąż jeden w Bree i spróbuj ponownie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: há muitas solicitações de aprovação pendentes; resolva uma no Bree e tente novamente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: ожидается слишком много запросов на утверждение; разрешите один в Bree и повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: มีคำขออนุมัติมากเกินไปที่รอดำเนินการ แก้ไขหนึ่งใน Bree แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: çok fazla onay isteği beklemede; Bree'de bir tanesini çözümleyin ve yeniden deneyin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: занадто багато запитів на схвалення очікують на розгляд; вирішити один у Bree і повторити спробу"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo：太多批准请求正在等待；解析 Bree 中的一个并重试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo：太多批准請求正在等待；解析 Bree 中的一個並重試"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: 보류 중인 승인 요청이 너무 많습니다. Bree에서 문제를 해결하고 다시 시도하세요."
          }
        }
      }
    },
