          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На боковой панели отображаются состояние сеанса Pi и уведомления."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แถบด้านข้างจะแสดงสถานะเซสชัน Pi และการแจ้งเตือน"
          }
        },
        "tr": {
