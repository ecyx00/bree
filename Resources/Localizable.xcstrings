    "remoteDaemon.bootstrap.noDaemonForPlatform": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Bree build has no remote daemon for the remote host's platform"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Bree ビルドには、リモートホストのプラットフォーム用のリモートデーモンが含まれていません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Bree 版本不包含适用于远程主机平台的远程守护进程"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Bree-Build enthält keinen Remote-Daemon für die Plattform des Remote-Hosts"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version de Bree ne contient aucun démon distant pour la plateforme de l’hôte distant"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يتضمن إصدار Bree هذا برنامجًا خفيًا بعيدًا لمنصة المضيف البعيد"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta compilación de Bree no incluye un demonio remoto para la plataforma del host remoto"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Bree 版本不包含適用於遠端主機平台的遠端背景服務"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Bree 빌드에는 원격 호스트 플랫폼용 원격 데몬이 포함되어 있지 않습니다."
          }
        }
      }
    },
    "remoteSession.parked.cleanupBlocked": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree, %@ adresine yapılan önceki SSH bağlantısını temizleyemedi. Ana makineye ulaşılabildiğini kontrol edin, ardından yeniden denemek için Yeniden Bağlan'ı kullanın."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree could not clean up the previous SSH connection to %@. Check that the host is reachable, then use Reconnect to try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree は %@ への以前の SSH 接続をクリーンアップできませんでした。ホストに到達できることを確認してから、「再接続」で再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree 无法清理之前到 %@ 的 SSH 连接。请确认主机可以访问，然后用「重新连接」再试。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree konnte die vorherige SSH-Verbindung zu %@ nicht bereinigen. Prüfen Sie, ob der Host erreichbar ist, und verwenden Sie dann „Wieder verbinden“, um es erneut zu versuchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree n’a pas pu nettoyer la connexion SSH précédente à %@. Vérifiez que l’hôte est joignable, puis utilisez Reconnecter pour réessayer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر على Bree تنظيف اتصال SSH السابق بـ %@. تحقق من إمكانية الوصول إلى المضيف، ثم استخدم \"أعد الاتصال\" للمحاولة مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree no pudo limpiar la conexión SSH anterior con %@. Comprueba que el host sea accesible y luego usa Reconectar para volver a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree 無法清理先前與 %@ 的 SSH 連線。請確認主機可以連線，然後使用「重新連接」重試。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree가 %@에 대한 이전 SSH 연결을 정리하지 못했습니다. 호스트에 연결할 수 있는지 확인한 후 '재연결'을 사용하여 다시 시도하세요."
          }
        }
      }
    },
    "remoteSession.parked.notActive": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The SSH connection is not active. Use Reconnect to try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 接続はアクティブではありません。「再接続」で再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 连接未处于活动状态。请用「重新连接」再试。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die SSH-Verbindung ist nicht aktiv. Verwenden Sie „Wieder verbinden“, um es erneut zu versuchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion SSH n’est pas active. Utilisez Reconnecter pour réessayer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتصال SSH غير نشط. استخدم \"أعد الاتصال\" للمحاولة مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión SSH no está activa. Usa Reconectar para volver a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 連線未處於作用中狀態。請使用「重新連接」重試。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 연결이 활성 상태가 아닙니다. '재연결'을 사용하여 다시 시도하세요."
          }
        }
      }
    },
    "remoteSession.parked.proxyNotReady": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ adresine Bree proxy tüneli hazır olmadı. Otomatik yeniden bağlanma duraklatıldı; yeniden denemek için Yeniden Bağlan'ı kullanın."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Bree proxy tunnel to %@ did not become ready. Automatic reconnect paused; use Reconnect to try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ への Bree プロキシトンネルが準備完了になりませんでした。自動再接続を一時停止しました。「再接続」で再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到 %@ 的 Bree 代理隧道未能就绪。自动重连已暂停；请用「重新连接」再试。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bree-Proxy-Tunnel zu %@ ist nicht bereit geworden. Automatische Wiederverbindung pausiert; verwenden Sie „Wieder verbinden“, um es erneut zu versuchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tunnel proxy Bree vers %@ n’est pas devenu prêt. Reconnexion automatique en pause ; utilisez Reconnecter pour réessayer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يصبح نفق وكيل Bree إلى %@ جاهزًا. تم إيقاف إعادة الاتصال التلقائي مؤقتًا؛ استخدم \"أعد الاتصال\" للمحاولة مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El túnel proxy de Bree hacia %@ no llegó a estar listo. Reconexión automática pausada; usa Reconectar para volver a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通往 %@ 的 Bree 代理通道未能就緒。自動重新連線已暫停；請使用「重新連接」重試。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 대한 Bree 프록시 터널이 준비되지 않았습니다. 자동 재연결이 일시 중지되었습니다. '재연결'을 사용하여 다시 시도하세요."
          }
        }
      }
    },
    "remoteSession.parked.relayNotReady": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ üzerindeki Bree rölesi hazır olmadı (ana makine SSH uzak bağlantı noktası yönlendirmesine izin vermiyor olabilir). Otomatik yeniden bağlanma duraklatıldı; yeniden denemek için Yeniden Bağlan'ı kullanın."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Bree relay on %@ did not become ready (the host may not allow SSH remote port forwarding). Automatic reconnect paused; use Reconnect to try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 上の Bree リレーが準備完了になりませんでした（ホストが SSH リモートポート転送を許可していない可能性があります）。自動再接続を一時停止しました。「再接続」で再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 上的 Bree 中继未能就绪（该主机可能不允许 SSH 远程端口转发）。自动重连已暂停；请用「重新连接」再试。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Bree-Relay auf %@ ist nicht bereit geworden (der Host erlaubt möglicherweise keine SSH-Remote-Portweiterleitung). Automatische Wiederverbindung pausiert; verwenden Sie „Wieder verbinden“, um es erneut zu versuchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le relais Bree sur %@ n’est pas devenu prêt (l’hôte n’autorise peut-être pas la redirection de port distante SSH). Reconnexion automatique en pause ; utilisez Reconnecter pour réessayer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يصبح مرحّل Bree على %@ جاهزًا (قد لا يسمح المضيف بإعادة توجيه المنافذ البعيدة عبر SSH). تم إيقاف إعادة الاتصال التلقائي مؤقتًا؛ استخدم \"أعد الاتصال\" للمحاولة مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El relé de Bree en %@ no llegó a estar listo (es posible que el host no permita el reenvío remoto de puertos por SSH). Reconexión automática pausada; usa Reconectar para volver a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 上的 Bree 中繼未能就緒（該主機可能不允許 SSH 遠端連接埠轉送）。自動重新連線已暫停；請使用「重新連接」重試。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 Bree 릴레이가 준비되지 않았습니다(호스트가 SSH 원격 포트 포워딩을 허용하지 않을 수 있습니다). 자동 재연결이 일시 중지되었습니다. '재연결'을 사용하여 다시 시도하세요."
          }
        }
      }
    },
