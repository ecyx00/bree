        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "session move: 移動先の %1$@ にチェックアウトがなく、%2$@ にリポジトリもありません。先にそこでクローンしてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "session move: 대상의 %1$@에 체크아웃이 없고 %2$@에 저장소도 없습니다. 먼저 그곳에 클론하세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
