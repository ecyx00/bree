    "socket.sidebar.closeSurface.confirmationRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Surface has a running process; retry with --force"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتوي السطح على عملية قيد التشغيل؛ أعد المحاولة باستخدام --force"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Oberfläche hat einen laufenden Prozess; erneut mit --force versuchen"
          }
        },
