    "settings.app.iMessageMode.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move a workspace to the top and show the submitted message when you send an agent prompt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントのプロンプトを送信したときにワークスペースを一番上へ移動し、送信したメッセージを表示します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送代理提示时，将工作区移至顶部并显示已提交的消息。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen Arbeitsbereich nach oben verschieben und die gesendete Nachricht anzeigen, wenn Sie einen Agenten-Prompt senden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacer un espace de travail vers le haut et afficher le message soumis lorsque vous envoyez une invite à l’agent."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نقل مساحة العمل إلى الأعلى وعرض الرسالة المرسلة عندما ترسل مطالبة الوكيل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve un espacio de trabajo al principio y muestra el mensaje enviado cuando mandas una instrucción al agente."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當您傳送代理程式提示時，將工作區移至最上方並顯示已送出的訊息。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트 프롬프트를 전송할 때 작업 공간을 맨 위로 이동하고 제출된 메시지를 표시합니다."
          }
        }
      }
    },
