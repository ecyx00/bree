    "settings.terminal.confirmUnsafePaste": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأكيد اللصق غير الآمن"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsicheres Einfügen bestätigen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm Unsafe Pastes"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmar pegados no seguros"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmer les collages non sûrs"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全でない貼り付けを確認"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안전하지 않은 붙여넣기 확인"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认不安全的粘贴"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認不安全的貼上"
          }
        }
      }
    },
    "settings.terminal.confirmUnsafePaste.subtitleOff": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم اللصق الذي يصنّفه Ghostty على أنه غير آمن دون سؤال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von Ghostty als unsicher markierte Einfügungen werden ohne Nachfrage ausgeführt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastes Ghostty flags as unsafe go through without asking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los pegados que Ghostty marca como no seguros se realizan sin preguntar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les collages que Ghostty signale comme non sûrs sont effectués sans demander."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghostty が安全でないと判定した貼り付けも、確認せずに実行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghostty가 안전하지 않다고 표시한 붙여넣기도 묻지 않고 진행합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghostty 标记为不安全的粘贴会直接执行，不会询问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghostty 標記為不安全的貼上會直接執行，不會詢問。"
          }
        }
      }
    },
    "settings.terminal.confirmUnsafePaste.subtitleOn": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينتظر اللصق الذي يصنّفه Ghostty على أنه غير آمن، مثل عدة أسطر في برنامج لا يستخدم اللصق المحاط (bracketed paste)، تأكيدك في ورقة مرفقة بالنافذة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Einfügen, das Ghostty als unsicher markiert, etwa mehrere Zeilen in ein Programm ohne Bracketed Paste, wartet auf deine Bestätigung in einem Sheet am Fenster."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A paste Ghostty flags as unsafe, such as several lines into a program without bracketed paste, waits for you to confirm it in a sheet on the window."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pegado que Ghostty marca como no seguro, como varias líneas en un programa sin pegado entre corchetes (bracketed paste), espera tu confirmación en una hoja de la ventana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un collage que Ghostty signale comme non sûr, par exemple plusieurs lignes dans un programme sans collage entre crochets (bracketed paste), attend votre confirmation dans une feuille attachée à la fenêtre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghostty が安全でないと判定した貼り付け（ブラケットペーストを使わないプログラムへの複数行の貼り付けなど）は、ウインドウのシートで確認するまで待機します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghostty가 안전하지 않다고 표시한 붙여넣기(예: 브래킷 붙여넣기를 쓰지 않는 프로그램에 여러 줄 붙여넣기)는 창에 붙은 시트에서 확인할 때까지 기다립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghostty 标记为不安全的粘贴（例如将多行文本粘贴到未启用括号粘贴的程序中）会先在窗口上的表单中等待你确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghostty 標記為不安全的貼上（例如將多行文字貼到未啟用括號貼上的程式中）會先在視窗上的表單中等待你確認。"
          }
        }
      }
    },
