            "value": "افتح مساحة عمل أو طرفية أو سطح متصفح لرؤيته هنا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra un espacio de trabajo, terminal o superficie de navegador para verlo aquí."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟工作區、終端機或瀏覽器介面以在此處檢視。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에 표시하려면 작업 공간, 터미널 또는 브라우저 화면을 여세요."
          }
        }
      }
    },
