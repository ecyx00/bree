            "value": "Antwort konnte nicht gesendet werden. Bitte versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo enviar la respuesta. Inténtalo de nuevo."
          }
