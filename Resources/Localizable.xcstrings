        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masaüstü bildirimleri hızlı inceleme için burada görünecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сповіщення робочого столу з'являтимуться тут для швидкого перегляду."
