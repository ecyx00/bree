            "state": "translated",
            "value": "claude 二进制文件的自定义路径。留空则使用 PATH。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benutzerdefinierter Pfad zur Claude-Binärdatei. Leer lassen, um PATH zu verwenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chemin personnalisé vers le binaire claude. Laisser vide pour utiliser le PATH."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مسار مخصص لملف claude الثنائي. اتركه فارغًا لاستخدام PATH."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
