    "cli.codexTeams.watcher.subagent.depthExceeded": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "bree codex-teams watcher skipped a Codex subagent: depth %1$lld exceeds the automatic pane limit %2$lld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "bree codex-teams watcher skipped a Codex subagent: depth %1$lld exceeds the automatic pane limit %2$lld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "bree codex-teams ウォッチャーは Codex サブエージェントをスキップしました: 深さ %1$lld がペイン自動作成の上限 %2$lld を超えています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "bree codex-teams 监视器跳过了一个 Codex 子代理：深度 %1$lld 超过自动窗格上限 %2$lld。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree codex-teams-Watcher hat einen Codex-Subagenten übersprungen: Die Tiefe %1$lld überschreitet das automatische Teilfenster-Limit %2$lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’observateur Bree codex-teams a ignoré un sous-agent Codex : la profondeur %1$lld dépasse la limite automatique de volets de %2$lld."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تخطى مراقب Bree codex-teams وكيل Codex فرعي: يتجاوز العمق %1$lld حد الجزء التلقائي %2$lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El observador de Bree codex-teams omitió un subagente de Codex: la profundidad %1$lld supera el límite automático de paneles de %2$lld."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "bree codex-teams watcher 跳過了一個 Codex 子代理：深度 %1$lld 超出自動窗格限制 %2$lld。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "bree codex-teams watcher가 Codex 서브에이전트(subagent)를 건너뛰었습니다: 깊이 %1$lld이(가) 자동 분할 창 제한인 %2$lld(을)를 초과합니다."
          }
        }
      }
    },
    "cli.codexTeams.watcher.subagent.paneCreationFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
