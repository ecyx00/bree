    "settings.terminal.shellEditor.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type commands in an editor docked under the terminal at a local shell prompt. Full-screen apps and running commands get the keys directly."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルのシェルプロンプトで、ターミナルの下に固定されたエディタにコマンドを入力します。フルスクリーンアプリや実行中のコマンドにはキーが直接送られます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Befehle an einer lokalen Shell-Eingabeaufforderung in einem unter dem Terminal angedockten Editor eingeben. Vollbild-Apps und laufende Befehle erhalten die Tasten direkt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez les commandes dans un éditeur ancré sous le terminal à une invite de shell locale. Les apps plein écran et les commandes en cours reçoivent directement les touches."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب الأوامر في محرر مثبت أسفل الطرفية عند موجه الصدفة المحلي. تتلقى التطبيقات بملء الشاشة والأوامر الجارية المفاتيح مباشرة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe comandos en un editor acoplado bajo el terminal en un prompt local del shell. Las apps a pantalla completa y los comandos en ejecución reciben las teclas directamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在本地 shell 提示符处，于终端下方停靠的编辑器中输入命令。全屏应用和正在运行的命令会直接接收按键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在本機 shell 提示符號處，於終端機下方停靠的編輯器中輸入指令。全螢幕應用程式與執行中的指令會直接接收按鍵。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 셸 프롬프트에서 터미널 아래에 고정된 편집기에 명령을 입력합니다. 전체 화면 앱과 실행 중인 명령은 키를 직접 받습니다."
          }
        }
      }
    },
