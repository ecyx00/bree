    "debug.browserProfilePopover.liveNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes apply live to the browser profile popover."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更はブラウザープロファイルポップオーバーにライブで反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항이 브라우저 프로필 팝오버에 실시간으로 적용됩니다."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміни застосовуються до спливного вікна профілю браузера в реальному часі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改会实时应用到浏览器配置文件弹出框。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen werden live auf das Browser-Profil-Popover angewendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications s’appliquent en direct à la fenêtre contextuelle du profil de navigateur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تطبق التغييرات مباشرة على نافذة ملف تعريف المتصفح المنبثقة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios se aplican en vivo al popover de perfil de navegador."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "變更會即時套用至瀏覽器設定檔彈出視窗。"
          }
        }
      }
    },
    "debug.browserProfilePopover.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tune the profile popover padding live while comparing it against the browser toolbar menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザーツールバーのメニューと見比べながら、プロファイルポップオーバーの余白をライブで調整します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저 도구 모음 메뉴와 비교하면서 프로필 팝오버 패딩을 실시간으로 조정합니다."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштуйте відступи спливного вікна профілю в реальному часі, порівнюючи з меню панелі інструментів браузера."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时调整配置文件弹出框的内边距，同时与浏览器工具栏菜单作对比。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passen Sie den Innenabstand des Profil-Popovers live an, während Sie ihn mit dem Browser-Symbolleistenmenü vergleichen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustez la marge intérieure de la fenêtre contextuelle de profil en direct tout en la comparant au menu de la barre d'outils du navigateur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضبط حشوة نافذة ملف التعريف المنبثقة مباشرة أثناء مقارنتها بقائمة شريط أدوات المتصفح."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste el relleno del popover de perfil en vivo mientras lo compara con el menú de la barra de herramientas del navegador."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一邊與瀏覽器工具列選單比對，一邊即時調整設定檔彈出視窗的內距。"
          }
        }
      }
    },
