    "featureFlags.agentInbox.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows a keyboard-summoned inbox for agent messages, pending Feed decisions, and finished turns."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض صندوق وارد يُفتح من لوحة المفاتيح لرسائل الوكلاء وقرارات Feed المعلقة والجولات المكتملة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt einen per Tastenkürzel geöffneten Posteingang für Agentennachrichten, ausstehende Feed-Entscheidungen und abgeschlossene Durchläufe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra una bandeja de entrada invocable con el teclado para mensajes de agentes, decisiones pendientes del Feed y turnos finalizados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche une boîte de réception ouverte au clavier pour les messages d’agents, les décisions Feed en attente et les tours terminés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントメッセージ、保留中のFeed判断、完了したターンをキーボードで呼び出せる受信トレイに表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트 메시지, 대기 중인 Feed 결정 및 완료된 턴을 보여 주는 키보드 호출 받은 편지함을 표시합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示可用键盘召唤的收件箱，集中代理消息、待处理的 Feed 决策和已完成回合。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示可用鍵盤叫出的收件匣，集中代理程式訊息、待處理的 Feed 決策與已完成回合。"
          }
        }
      }
    },
