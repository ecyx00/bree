    "sidebar.extensions.error": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر على Bree تحميل امتدادات الشريط الجانبي."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree nije mogao učitati ekstenzije bočne trake."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree kunne ikke indlæse sidebjælkeudvidelser."
          }
