    "remoteTmux.error.unsupportedVersion": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خادم الجلسة البعيد قديم جدًا (تم العثور على %@؛ يتطلب Bree الإصدار %@ أو أحدث)"
          }
