            "value": "Vazgeç"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скасувати"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "settings.automation.openAccess.dialog.confirm": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تفعيل الوصول المفتوح الكامل"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Omogući potpuni otvoreni pristup"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiver fuld åben adgang"
          }
        },
        "de": {
          "stringUnit": {
