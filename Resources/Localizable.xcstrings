    },
    "cli.help.newWindow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage: bree new-window [--name <title>]\n\nCreate a new window.\n\nFlags:\n  --name <title>   Set the initial workspace and window title before the window appears.\n\nExamples:\n  Bree new-window\n  Bree new-window --name \"Build server\""
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使い方: bree new-window [--name <title>]\n\n新しいウィンドウを作成します。\n\nオプション:\n  --name <title>   表示前に初期ワークスペース名とウィンドウ名を設定します。\n\n例:\n  Bree new-window\n  Bree new-window --name \"Build server\""
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendung: bree new-window [--name <Titel>]\n\nErstellt ein neues Fenster.\n\nOptionen:\n  --name <Titel>   Legt den anfänglichen Arbeitsbereichs- und Fenstertitel vor dem Anzeigen fest.\n\nBeispiele:\n  Bree new-window\n  Bree new-window --name \"Build server\""
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisation : bree new-window [--name <titre>]\n\nCrée une nouvelle fenêtre.\n\nOptions :\n  --name <titre>   Définit le titre initial avant l’affichage.\n\nExemples :\n  Bree new-window\n  Bree new-window --name \"Build server\""
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاستخدام: bree new-window [--name <العنوان>]\n\nينشئ نافذة جديدة.\n\nالخيارات:\n  --name <العنوان>   يعيّن العنوان قبل ظهور النافذة.\n\nأمثلة:\n  Bree new-window\n  Bree new-window --name \"Build server\""
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Uso: bree new-window [--name <título>]\n\nCrea una ventana nueva.\n\nOpciones:\n  --name <título>   Establece el título antes de mostrarla.\n\nEjemplos:\n  Bree new-window\n  Bree new-window --name \"Build server\""
