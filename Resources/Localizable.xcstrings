    "browser.profile.automation.error.profileRequiresBrowserPane": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browser profiles can only be used when creating a browser pane"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザープロファイルはブラウザーペインの作成時にのみ使用できます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览器配置文件仅在创建浏览器窗格时可用"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Browserprofile können nur beim Erstellen eines Browser-Teilfensters verwendet werden"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les profils de navigateur ne peuvent être utilisés que lors de la création d'un volet de navigateur"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن استخدام ملفات تعريف المتصفح فقط عند إنشاء جزء متصفح"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los perfiles de navegador solo se pueden usar al crear un panel de navegador"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅能在建立瀏覽器窗格時使用瀏覽器設定檔"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저 프로필은 브라우저 분할 창을 생성할 때만 사용할 수 있습니다."
          }
        }
      }
    },
    "browser.profile.automation.error.profileUnavailableInRemoteWorkspace": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browser profiles cannot be selected when creating a browser pane in a remote workspace"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモートワークスペースでブラウザーペインを作成する場合、ブラウザープロファイルは選択できません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在远程工作区中创建浏览器窗格时无法选择浏览器配置文件"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Browserprofile können beim Erstellen eines Browser-Teilfensters in einem Remote-Arbeitsbereich nicht ausgewählt werden"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de sélectionner des profils de navigateur lors de la création d'un volet de navigateur dans un espace de travail distant"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن تحديد ملفات تعريف المتصفح عند إنشاء جزء متصفح في مساحة عمل بعيدة"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pueden seleccionar perfiles de navegador al crear un panel de navegador en un espacio de trabajo remoto"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在遠端工作區建立瀏覽器窗格時，無法選取瀏覽器設定檔"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원격 작업 공간에서 브라우저 분할 창을 생성할 때는 브라우저 프로필을 선택할 수 없습니다."
