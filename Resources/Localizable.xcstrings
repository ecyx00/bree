    "alert.moveTab.failed.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتمكن Bree من نقل علامة التبويب هذه إلى الوجهة المحددة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
