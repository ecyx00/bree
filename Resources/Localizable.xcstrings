    "cli.session.move.error.transcriptNewer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "session move: the destination transcript is newer; the session continued there, so move it the other way"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "session move: نص الجلسة في الوجهة أحدث؛ استمرت الجلسة هناك، لذا انقلها في الاتجاه الآخر"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "session move: Das Transkript am Ziel ist neuer; die Sitzung wurde dort fortgesetzt, verschiebe sie also in die andere Richtung"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "session move: la transcripción del destino es más reciente; la sesión continuó allí, así que muévela en sentido contrario"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "session move : la transcription de destination est plus récente ; la session s'y est poursuivie, déplacez-la dans l'autre sens"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "session move: 移動先のトランスクリプトのほうが新しいです。セッションはそこで続行されたので、逆方向に移動してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "session move: 대상의 트랜스크립트가 더 최신입니다. 세션이 그곳에서 계속되었으니 반대 방향으로 이동하세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "session move：目标上的记录更新；会话已在那里继续，请反向移动"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "session move：目的地的對話紀錄較新；工作階段已在那裡繼續，請反向移動"
          }
        }
      }
    },
