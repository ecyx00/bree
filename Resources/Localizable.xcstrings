    "cli.events.error.timeout": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timed out waiting for a matching event"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一致するイベントを待機中にタイムアウトしました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待匹配事件超时"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeitüberschreitung beim Warten auf ein passendes Ereignis"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Délai d’attente dépassé lors de l’attente d’un événement correspondant"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت المهلة أثناء انتظار حدث مطابق"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se agotó el tiempo de espera buscando un evento coincidente"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等候相符事件逾時"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일치하는 이벤트를 기다리는 동안 시간 초과가 발생했습니다."
          }
        }
      }
    },
    "cli.events.help.snapshot": {
      "extractionState": "manual",
      "localizations": {
        "en": {
