          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les profils sources sélectionnés sont regroupés dans un seul profil Bree."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
