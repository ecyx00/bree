    "cli.workflow.worktree-agents.instantiate.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the Worktree Agents recipe, merge its actions/ui/commands entries into bree.json, adapt the worktree cwd and agent commands, then run bree reload-config."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Vorlage Worktree Agents öffnen, ihre actions/ui/commands-Einträge in bree.json übernehmen, Worktree-cwd und Agentenbefehle anpassen und Bree reload-config ausführen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez la recette Worktree Agents, ajoutez ses entrées actions/ui/commands à bree.json, adaptez le cwd du worktree et les commandes d’agent, puis exécutez Bree reload-config."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la receta Worktree Agents, incorpora sus entradas actions/ui/commands en bree.json, adapta el cwd del worktree y los comandos de agentes, y ejecuta Bree reload-config."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح وصفة Worktree Agents، وأضف عناصر actions/ui/commands إلى bree.json، وعدّل cwd لشجرة العمل وأوامر الوكلاء، ثم شغّل Bree reload-config."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Worktree Agents 配方，将 actions/ui/commands 条目合并到 bree.json，调整 worktree 的 cwd 和代理命令，然后运行 Bree reload-config。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟 Worktree Agents 配方，將 actions/ui/commands 項目合併到 bree.json，調整 worktree 的 cwd 和代理命令，然後執行 Bree reload-config。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Worktree Agents 설정 예제를 열고 actions/ui/commands 항목을 bree.json에 병합한 뒤 worktree의 cwd와 에이전트 명령을 수정하고 Bree reload-config를 실행하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Worktree Agents レシピを開き、actions/ui/commands を bree.json に追加し、worktree の cwd とエージェントのコマンドを調整して Bree reload-config を実行します。"
          }
        }
      }
    },
