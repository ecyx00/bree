    "settings.automation.amp.note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يثبّت Bree خطافات Amp ويحدّثها تلقائيًا في طرفيات Bree. ولا تنفّذ أي إجراء خارج طرفيات Bree. عند تعطيلها، تظل إضافة Amp المثبّتة غير نشطة دون الحاجة إلى إزالتها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree automatski instalira i osvježava Amp hookove u Bree terminalima. Izvan Bree terminala ne rade ništa. Kada je onemogućeno, instalirani Amp dodatak ostaje neaktivan bez potrebe za uklanjanjem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree installerer og opdaterer automatisk Amp-hooks i Bree-terminaler. De gør intet uden for Bree-terminaler. Når funktionen er deaktiveret, forbliver det installerede Amp-plugin inaktivt uden at skulle fjernes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree installiert und aktualisiert Amp-Hooks automatisch in Bree-Terminals. Außerhalb von Bree-Terminals bleiben sie ohne Wirkung. Wenn die Integration deaktiviert ist, bleibt das installierte Amp-Plugin inaktiv und muss nicht entfernt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree installs and refreshes Amp hooks automatically in Bree terminals. They no-op outside Bree terminals. When disabled, the installed Amp plugin stays inactive without needing to be removed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree instala y actualiza automáticamente los hooks de Amp en los terminales de Bree. Fuera de los terminales de Bree, no hacen nada. Al desactivarlos, el plugin de Amp instalado permanece inactivo sin necesidad de eliminarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree installe et actualise automatiquement les hooks Amp dans les terminaux Bree. Ils restent sans effet en dehors des terminaux Bree. Lorsque cette option est désactivée, le plugin Amp installé reste inactif sans qu’il soit nécessaire de le supprimer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree installa e aggiorna automaticamente gli hook di Amp nei terminali Bree. Al di fuori dei terminali Bree non eseguono alcuna operazione. Quando l’integrazione è disattivata, il plugin Amp installato rimane inattivo senza dover essere rimosso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Breeターミナルでは、BreeがAmpフックを自動的にインストールして更新します。Breeターミナル外では動作しません。無効にすると、インストール済みのAmpプラグインは削除しなくても停止状態になります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree ដំឡើង និងធ្វើឱ្យ Amp hooks ថ្មីដោយស្វ័យប្រវត្តិនៅក្នុងស្ថានីយ Bree។ វាមិនធ្វើអ្វីនៅក្រៅស្ថានីយ Bree ទេ។ នៅពេលបិទ កម្មវិធីបន្ថែម Amp ដែលបានដំឡើងនឹងនៅតែអសកម្ម ដោយមិនចាំបាច់លុបចេញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree 터미널에서는 Bree가 Amp 훅을 자동으로 설치하고 갱신합니다. Bree 터미널 외부에서는 작동하지 않습니다. 비활성화하면 설치된 Amp 플러그인을 제거하지 않아도 비활성 상태로 유지됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree installerer og oppdaterer Amp-hooks automatisk i Bree-terminaler. De gjør ingenting utenfor Bree-terminaler. Når integrasjonen er deaktivert, forblir den installerte Amp-utvidelsen inaktiv uten at den må fjernes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree automatycznie instaluje i odświeża hooki Amp w terminalach Bree. Poza terminalami Bree nie wykonują one żadnych działań. Po wyłączeniu zainstalowana wtyczka Amp pozostaje nieaktywna i nie trzeba jej usuwać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Bree instala e atualiza automaticamente os hooks do Amp nos terminais do Bree. Fora dos terminais do Bree, eles não realizam nenhuma ação. Quando a integração é desativada, o plugin do Amp instalado permanece inativo sem precisar ser removido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree автоматически устанавливает и обновляет хуки Amp в терминалах Bree. Вне терминалов Bree они ничего не делают. Когда интеграция отключена, установленный плагин Amp остаётся неактивным, и удалять его не требуется."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree จะติดตั้งและอัปเดตฮุกของ Amp โดยอัตโนมัติในเทอร์มินัล Bree ฮุกเหล่านี้จะไม่ทำงานนอกเทอร์มินัล Bree เมื่อปิดใช้งาน ปลั๊กอิน Amp ที่ติดตั้งไว้จะยังคงไม่ทำงานโดยไม่จำเป็นต้องลบออก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree, Amp kancalarını Bree terminallerinde otomatik olarak yükler ve yeniler. Bu kancalar Bree terminalleri dışında işlem yapmaz. Devre dışı bırakıldığında yüklü Amp eklentisi kaldırılması gerekmeden etkisiz kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree автоматично встановлює та оновлює хуки Amp у терміналах Bree. Поза терміналами Bree вони не виконують жодних дій. Коли інтеграцію вимкнено, встановлений плагін Amp залишається неактивним, і видаляти його не потрібно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree 会在 Bree 终端中自动安装并刷新 Amp 钩子。这些钩子在 Bree 终端之外不会执行任何操作。禁用后，已安装的 Amp 插件会保持非活动状态，无需将其移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree 會在 Bree 終端機中自動安裝並更新 Amp 掛鉤。這些掛鉤在 Bree 終端機之外不會執行任何動作。停用後，已安裝的 Amp 外掛程式會維持非作用中狀態，無須將其移除。"
          }
        }
      }
    },
