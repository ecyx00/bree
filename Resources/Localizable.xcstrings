    "agentHibernation.manual.lifecycleUnknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree can't tell whether this agent is idle, so it was left running."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree はこのエージェントがアイドル状態か判断できないため、実行したままにしました。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree kann nicht erkennen, ob dieser Agent untätig ist, daher läuft er weiter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree ne peut pas savoir si cet agent est inactif, il continue donc de tourner."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع Bree معرفة ما إذا كان هذا الوكيل خاملًا، لذا تُرك قيد التشغيل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree no puede saber si este agente está inactivo, así que sigue en ejecución."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree 無法判斷此代理程式是否閒置，因此保持執行。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree 无法判断此智能体是否空闲，因此保持运行。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree가 이 에이전트의 유휴 여부를 알 수 없어 실행 상태로 두었습니다."
          }
        }
      }
    },
    "agentHibernation.manual.notRestorable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This terminal has no agent that Bree can resume the way it was started."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このターミナルには、起動時と同じ方法で Bree が再開できるエージェントがありません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Terminal hat keinen Agenten, den Bree so fortsetzen kann, wie er gestartet wurde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce terminal n’a aucun agent que Bree peut reprendre de la façon dont il a été lancé."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تحتوي هذه الطرفية على وكيل يستطيع Bree استئنافه بالطريقة التي بدأ بها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta terminal no tiene un agente que Bree pueda reanudar tal como se inició."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此終端機沒有 Bree 能以原本啟動方式恢復的代理程式。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此终端没有 Bree 能按原启动方式恢复的智能体。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 터미널에는 시작된 방식 그대로 Bree가 재개할 수 있는 에이전트가 없습니다."
          }
        }
      }
    },
    "agentHibernation.manual.notRunning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This terminal is not running, so there is nothing to hibernate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
