    "dialog.enableNotifications.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإشعارات معطلة لـ Bree. قم بتفعيلها في إعدادات النظام لرؤية التنبيهات."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obavještenja su onemogućena za Bree. Omogućite ih u Postavkama sistema da biste vidjeli upozorenja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikationer er deaktiveret for Bree. Aktiver dem i Systemindstillinger for at se advarsler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtigungen sind für Bree deaktiviert. Aktivieren Sie sie in den Systemeinstellungen, um Hinweise zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are disabled for Bree. Enable them in System Settings to see alerts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están desactivadas para Bree. Actívalas en Ajustes del Sistema para ver alertas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont désactivées pour Bree. Activez-les dans les Réglages Système pour voir les alertes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche sono disabilitate per Bree. Abilitale nelle Impostazioni di Sistema per visualizzare gli avvisi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Breeの通知が無効になっています。アラートを表示するにはシステム設定で有効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree에 대한 알림이 비활성화되어 있습니다. 알림을 보려면 시스템 설정에서 활성화하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsler er deaktivert for Bree. Aktiver dem i Systeminnstillinger for å se varsler."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienia są wyłączone dla Bree. Włącz je w Ustawieniach systemowych, aby widzieć alerty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações estão desativadas para o Bree. Ative-as nos Ajustes do Sistema para ver os alertas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления для Bree отключены. Включите их в Системных настройках, чтобы видеть оповещения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแจ้งเตือนถูกปิดใช้งานสำหรับ Bree เปิดใช้งานในการตั้งค่าระบบเพื่อดูการแจ้งเตือน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree için bildirimler devre dışı. Uyarıları görmek için Sistem Ayarları'nda etkinleştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сповіщення для Bree вимкнено. Увімкніть їх у Системних налаштуваннях, щоб бачити повідомлення."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree 的通知已被禁用。请在系统设置中启用通知以接收提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Bree 的通知已停用。請在「系統設定」中啟用，以接收提示。"
          }
        }
      }
    },
