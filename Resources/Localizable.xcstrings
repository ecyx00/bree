    "debug.notification.error.missingEnabled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pass enabled=true or enabled=false to turn notification debug mode on or off."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "enabled=true または enabled=false を指定して、通知デバッグモードのオン/オフを切り替えてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "传入 enabled=true 或 enabled=false 以开启或关闭通知调试模式。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übergeben Sie enabled=true oder enabled=false, um den Benachrichtigungs-Debug-Modus ein- oder auszuschalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez enabled=true ou enabled=false pour activer ou désactiver le mode de débogage de notification."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرر enabled=true أو enabled=false لتشغيل أو إيقاف وضع تصحيح أخطاء الإشعارات."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasa enabled=true o enabled=false para activar o desactivar el modo de depuración de notificaciones."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請傳送 enabled=true 或 enabled=false 以開啟或關閉通知偵錯模式。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림 디버그 모드를 켜거나 끄려면 enabled=true 또는 enabled=false를 전달하세요."
          }
        }
      }
    },
    "debug.notification.error.missingKind": {
