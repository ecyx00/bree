          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブランチを 1 行にまとめて表示するか、それぞれ別の行に表示するかを選択します。"
          }
        }
      }
    },
    "settings.app.stackBranchDirectory.subtitle": {
      "extractionState": "manual",
      "localizations": {
