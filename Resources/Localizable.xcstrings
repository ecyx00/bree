          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: den lagrede prosessen kunne ikke startes. Prøv synlig gaffel-kommandoen på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: nie można uruchomić zapisanego procesu. Ponów polecenie widocznego rozwidlenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: o processo salvo não pôde ser iniciado. Tente novamente o comando de fork visível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: сохраненный процесс не удалось запустить. Повторите команду видимой вилки."
          }
        },
        "th": {
