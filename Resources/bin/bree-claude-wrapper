#!/usr/bin/env bash
# bree claude wrapper - injects hooks and session tracking
#
# When running inside a bree terminal (BREE_SURFACE_ID is set), this wrapper
# intercepts `claude` invocations to inject --session-id and --settings flags
# so that Claude Code hooks fire back into bree for notifications/status.
# Outside bree, it passes through to the real claude binary unchanged.

# Every [[ == ]] below is an exact comparison (restore tokens, the generated
# settings fast path); an inherited nocasematch (BASH_ENV, BASHOPTS) must not
# make them case-insensitive.
shopt -u nocasematch 2>/dev/null || true

bree_claude_wrapper_is_self_or_shim() {
    local candidate="$1"
    [[ -n "$candidate" ]] || return 1
    if [[ -e "$candidate" && "$candidate" -ef "$0" ]]; then
        return 0
    fi
    if [[ -n "${BREE_CLAUDE_WRAPPER_SHIM:-}" &&
          -e "$candidate" &&
          -e "$BREE_CLAUDE_WRAPPER_SHIM" &&
          "$candidate" -ef "$BREE_CLAUDE_WRAPPER_SHIM" ]]; then
        return 0
    fi
    if [[ -n "${BREE_CLAUDE_WRAPPER_SHIM_ROOT:-}" &&
          "$candidate" == "${BREE_CLAUDE_WRAPPER_SHIM_ROOT%/}/claude" ]]; then
        return 0
    fi
    case "$candidate" in
        */bree-cli-shims/*/claude|*/bree-cli-shims/claude)
            return 0
            ;;
        */Contents/Resources/bin/claude|*/Resources/bin/claude)
            return 0
            ;;
    esac
    return 1
}

bree_claude_wrapper_reexec_guard_limit=16
bree_claude_wrapper_reexec_hops=0
# Newline-delimited, not PATH/colon-delimited: custom executable paths can
# legally contain ':' even though PATH entries cannot.
bree_claude_wrapper_reexec_target_history=""

# Keep argument inspection bounded. Apart from protecting the shell's pattern
# matcher, this prevents a caller from turning the wrapper's own launch metadata
# into another ARG_MAX-sized environment value.
# Stay below Linux's 128 KiB per-argument exec limit so the same guard can be
# exercised portably; larger settings should be supplied by file path.
bree_claude_wrapper_max_argument_bytes=122880

bree_claude_wrapper_validate_arguments() {
    local arg
    local byte_length
    local had_lc_all=0
    local previous_lc_all="${LC_ALL-}"
    local too_large=0
    if [[ ${LC_ALL+x} ]]; then
        had_lc_all=1
    fi
    export LC_ALL=C
    for arg in "$@"; do
        byte_length=${#arg}
        if (( byte_length > bree_claude_wrapper_max_argument_bytes )); then
            too_large=1
            break
        fi
    done
    if (( had_lc_all == 1 )); then
        export LC_ALL="$previous_lc_all"
    else
        unset LC_ALL
    fi
    if (( too_large == 1 )); then
        printf 'Bree: argument too large (maximum %s bytes)\n' \
            "$bree_claude_wrapper_max_argument_bytes" >&2
        return 2
    fi
    return 0
}

bree_claude_wrapper_settings_value_is_managed() {
    local value="$1"
    local trimmed="${value#"${value%%[![:space:]]*}"}"
    if [[ "$trimmed" == \{* || "$trimmed" == \[* ]]; then
        case "$trimmed" in
            *'"__bree":{"managed":"claude-hooks"'*|*'hooks feed --source claude'*)
                return 0
                ;;
        esac
        return 1
    fi
    [[ -f "$trimmed" ]] || return 1
    grep -Fq '"__bree":{"managed":"claude-hooks"' "$trimmed" 2>/dev/null && return 0
    grep -Fq 'hooks feed --source claude' "$trimmed" 2>/dev/null
}

bree_claude_wrapper_args_have_managed_settings() {
    local collect=false
    local arg
    for arg in "$@"; do
        if [[ "$collect" == true ]]; then
            bree_claude_wrapper_settings_value_is_managed "$arg" && return 0
            collect=false
            continue
        fi
        if [[ "$arg" == "--settings" ]]; then
            collect=true
        elif [[ "${arg:0:11}" == "--settings=" ]]; then
            bree_claude_wrapper_settings_value_is_managed "${arg#--settings=}" && return 0
        fi
    done
    return 1
}

bree_claude_wrapper_path_without_shims() {
    local current_path="${PATH:-}"
    local shim_root="${BREE_CLAUDE_WRAPPER_SHIM_ROOT:-}"
    local old_ifs="$IFS"
    local entry
    local result=""
    local globbing_was_disabled=0

    case "$-" in
        *f*) globbing_was_disabled=1 ;;
        *) set -f ;;
    esac
    IFS=:
    for entry in ${current_path:-}; do
        if [[ "$entry" == "$shim_root" ||
              "$entry" == */bree-cli-shims/* ||
              "$entry" == */bree-cli-shims ]]; then
            continue
        fi
        if [[ -z "$result" ]]; then
            result="$entry"
        else
            result="$result:$entry"
        fi
    done
    IFS="$old_ifs"
    if (( globbing_was_disabled == 0 )); then
        set +f
    fi
    printf '%s' "$result"
}

bree_claude_wrapper_target_is_custom_path() {
    local target="$1"
    local custom="${BREE_CUSTOM_CLAUDE_PATH:-}"
    custom="${custom#"${custom%%[![:space:]]*}"}"
    custom="${custom%"${custom##*[![:space:]]}"}"
    [[ -n "$custom" && -n "$target" ]] || return 1
    [[ "$target" == "$custom" ]] && return 0
    [[ -e "$target" && -e "$custom" && "$target" -ef "$custom" ]]
}

bree_claude_wrapper_prepare_custom_path_environment() {
    local target="$1"
    [[ "${IN_BREE:-0}" == "1" ]] || return 0
    bree_claude_wrapper_target_is_custom_path "$target" || return 0
    local cleaned_path
    if cleaned_path="$(bree_claude_wrapper_path_without_shims)" && [[ -n "$cleaned_path" ]]; then
        export PATH="$cleaned_path"
    fi
}

bree_claude_wrapper_is_nonnegative_integer() {
    case "$1" in
        ''|*[!0-9]*)
            return 1
            ;;
    esac
    return 0
}

bree_claude_wrapper_fail_reexec_guard() {
    cat >&2 <<'EOF'
Bree: stopped a possible infinite claude shim loop.
Bree's per-surface claude shim re-entered before the real binary started.
This is usually caused by a conflicting `claude` shim from another tool on PATH.
Set BREE_CUSTOM_CLAUDE_PATH, or set Automation > Claude Binary Path to the real
claude binary, then start a new surface.
EOF
    exit 126
}

bree_claude_wrapper_init_reexec_guard() {
    local guard="${bree_claude_wrapper_reexec_guard:-}"
    local hops

    case "$guard" in
        *[!0-9]*|'')
            unset bree_claude_wrapper_reexec_guard
            unset bree_claude_wrapper_reexec_targets
            bree_claude_wrapper_reexec_hops=0
            bree_claude_wrapper_reexec_target_history=""
            ;;
        *)
            hops="$guard"
            bree_claude_wrapper_is_nonnegative_integer "$hops" || hops=0
            bree_claude_wrapper_reexec_hops="$hops"
            bree_claude_wrapper_reexec_target_history="${bree_claude_wrapper_reexec_targets:-}"
            ;;
    esac
}

bree_claude_wrapper_reexec_target_seen() {
    local target="$1"
    local seen
    while IFS= read -r seen; do
        [[ "$seen" == "$target" ]] && return 0
    done <<< "$bree_claude_wrapper_reexec_target_history"
    return 1
}

bree_claude_wrapper_custom_target_is_direct_absolute_claude() {
    local snippet="$1"
    local line rest token
    while IFS= read -r line; do
        case "$line" in
            *exec\ *)
                rest="${line#*exec }"
                rest="${rest#\"}"
                rest="${rest#\'}"
                token="${rest%%[[:space:]]*}"
                token="${token%\"}"
                token="${token%\'}"
                if [[ "$token" == /*/claude || "$token" == /claude ]] &&
                   [[ -e "$token" && -x "$token" ]] &&
                   ! bree_claude_wrapper_is_self_or_shim "$token"; then
                    return 0
                fi
                ;;
        esac
    done <<< "$snippet"
    return 1
}

bree_claude_wrapper_target_looks_like_reexec_shim() {
    local target="$1"
    bree_claude_wrapper_is_self_or_shim "$target" && return 0
    [[ -f "$target" && -r "$target" ]] || return 1

    case "$target" in
        */.asdf/shims/claude|*/.mise/shims/claude|*/.local/share/mise/shims/claude|*/.volta/bin/claude)
            return 1
            ;;
    esac

    local magic
    magic="$(od -An -N2 -tx1 "$target" 2>/dev/null | tr -d '[:space:]')"
    [[ "$magic" == "2321" ]] || return 1

    local first_line snippet
    IFS= read -r first_line < "$target" || first_line=""
    snippet="$(sed -n '1,160p' "$target" 2>/dev/null || true)"

    case "$snippet" in
        *"exec claude"*|*"exec \"claude\""*|*"exec 'claude'"*|\
        *"exec env claude"*|*"exec /usr/bin/env claude"*|\
        *"env claude"*|*"env \"claude\""*|*"env 'claude'"*|\
        *"command claude"*|*"command \"claude\""*|*"command 'claude'"*|\
        *"spawn(\"claude\""*|*"spawn('claude'"*|\
        *"spawnSync(\"claude\""*|*"spawnSync('claude'"*|\
        *"execFile(\"claude\""*|*"execFile('claude'"*|\
        *"execFileSync(\"claude\""*|*"execFileSync('claude'"*|\
        *"execSync(\"claude"*|*"execSync('claude"*|\
        *"os.execvp(\"claude\""*|*"os.execvp('claude'"*|\
        *"os.execlp(\"claude\""*|*"os.execlp('claude'"*|\
        *"subprocess.run([\"claude\""*|*"subprocess.run(['claude'"*|\
        *"subprocess.call([\"claude\""*|*"subprocess.call(['claude'"*|\
        *"subprocess.Popen([\"claude\""*|*"subprocess.Popen(['claude'"*)
            return 0
            ;;
    esac
    case "$snippet" in
        *'=claude'*|*'="claude"'*|*"='claude'"*|\
        *':-claude}'*|*':-"claude"}'*|*":-'claude'}"*)
            case "$snippet" in
                *'exec "$'*|*'exec ${'*)
                    return 0
                    ;;
            esac
            ;;
    esac
    case "$snippet" in
        *'@anthropic-ai/claude-code'*|*'claude-code/cli.js'*)
            return 1
            ;;
    esac
    local target_is_custom=false
    if [[ "${IN_BREE:-0}" == "1" ]] && bree_claude_wrapper_target_is_custom_path "$target"; then
        target_is_custom=true
    fi
    if [[ "$target_is_custom" != true ]]; then
        case "$first_line" in
            *node*|*Node*)
                return 1
                ;;
        esac
    fi

    # A configured launcher can delegate through another executable (for
    # example `exec some-launcher claude "$@"`) without matching the finite
    # command forms above. Treat a bare Claude token in that launcher as a
    # possible re-entry, but keep direct absolute `/.../claude` launchers on
    # the real-binary side of the boundary.
    if [[ "$target_is_custom" == true ]]; then
        bree_claude_wrapper_custom_target_is_direct_absolute_claude "$snippet" && return 1
        local launcher_line
        while IFS= read -r launcher_line; do
            if [[ "$launcher_line" == *'exec "'*'/claude" '* ||
                  "$launcher_line" == *'exec '*/claude' '* ]]; then
                continue
            fi
            case "$launcher_line" in
                *'exec '*claude*|*'spawn'*claude*|*'which'*claude*|*'command -v '*claude*)
                    return 0
                    ;;
            esac
        done <<< "$snippet"

        # A configured script is a launcher boundary unless it is an explicit
        # absolute Claude executable. Keep the re-entry counter across generic
        # launcher syntax (`exec "$LAUNCHER"`, `env`, etc.) so an indirect PATH
        # lookup cannot reset it between wrapper passes.
        case "$snippet" in
            *'exec '*|*'command '*|*'spawn'*|*'which '*)
                return 0
                ;;
        esac
    fi
    return 1
}

bree_claude_wrapper_exec_real_after_managed_reentry() {
    local previous_custom_path="${BREE_CUSTOM_CLAUDE_PATH:-}"
    unset BREE_CUSTOM_CLAUDE_PATH
    local fallback
    fallback="$(find_real_claude)"
    if [[ -n "$previous_custom_path" ]]; then
        export BREE_CUSTOM_CLAUDE_PATH="$previous_custom_path"
    fi
    [[ -n "$fallback" ]] || bree_claude_wrapper_fail_reexec_guard
    bree_claude_wrapper_target_looks_like_reexec_shim "$fallback" &&
        bree_claude_wrapper_fail_reexec_guard
    unset BREE_AGENT_RESTORE_LAUNCH
    unset BREE_CLAUDE_TEAMS_WRAPPER_LAUNCH
    unset bree_claude_wrapper_reexec_guard
    unset bree_claude_wrapper_reexec_targets
    exec "$fallback" "$@"
}

bree_claude_wrapper_exec_resolved_claude() {
    local target="$1"
    shift

    if ! bree_claude_wrapper_target_looks_like_reexec_shim "$target"; then
        # A non-shim target is the boundary where a real Claude process starts.
        # Custom launcher scripts that can delegate to Claude are classified as
        # re-entry shims above, so this reset is only reached for a proven real
        # boundary. Real Claude children that invoke `claude` later can therefore
        # begin a fresh wrapper resolution without inheriting the hop counter.
        unset BREE_AGENT_RESTORE_LAUNCH
        unset BREE_CLAUDE_TEAMS_WRAPPER_LAUNCH
        unset bree_claude_wrapper_reexec_guard
        unset bree_claude_wrapper_reexec_targets
        # A configured Claude path is often a launcher script rather than the
        # Claude executable itself. It must not inherit bree's PATH shim: a
        # downstream `which`/execvp/command -v lookup would otherwise route back
        # into this wrapper after the guard was cleared.
        bree_claude_wrapper_prepare_custom_path_environment "$target"
        exec "$target" "$@"
    fi
    if bree_claude_wrapper_reexec_target_seen "$target"; then
        if bree_claude_wrapper_args_have_managed_settings "$@"; then
            bree_claude_wrapper_exec_real_after_managed_reentry "$@"
        fi
        bree_claude_wrapper_fail_reexec_guard "$target"
    fi
    if (( bree_claude_wrapper_reexec_hops >= bree_claude_wrapper_reexec_guard_limit )); then
        bree_claude_wrapper_fail_reexec_guard
    fi

    local hops="${bree_claude_wrapper_reexec_hops:-0}"
    bree_claude_wrapper_is_nonnegative_integer "$hops" || hops=0
    hops=$((hops + 1))
    export bree_claude_wrapper_reexec_guard="$hops"
    if [[ -n "$bree_claude_wrapper_reexec_target_history" ]]; then
        bree_claude_wrapper_reexec_target_history="$bree_claude_wrapper_reexec_target_history"$'\n'"$target"
    else
        bree_claude_wrapper_reexec_target_history="$target"
    fi
    bree_claude_wrapper_reexec_targets="$bree_claude_wrapper_reexec_target_history"
    export bree_claude_wrapper_reexec_targets
    if [[ "${bree_claude_app_restore_owned:-0}" == "1" ]]; then
        # A supported shim will invoke this wrapper again. Re-issue the exact
        # authorization for that pass; the next wrapper consumes it immediately.
        export BREE_AGENT_RESTORE_LAUNCH="$bree_claude_app_restore_launch"
    fi
    if [[ "${bree_claude_teams_wrapper_launch:-0}" == "1" ]]; then
        # Keep the one-shot launch signal across finite version-manager shim
        # hops. The final real-Claude boundary above consumes it.
        export BREE_CLAUDE_TEAMS_WRAPPER_LAUNCH=1
    fi
    bree_claude_wrapper_prepare_custom_path_environment "$target"
    exec "$target" "$@"
}

bree_claude_wrapper_init_reexec_guard

# `bree claude-teams` resolves the real provider itself, then deliberately
# enters this app-owned wrapper so hooks can bind the lead session. Preserve its
# structured launcher capture for that one process only. The marker is consumed
# before Claude starts, so teammate `claude` commands inherit no launch signal
# and receive their own ordinary Claude capture below.
bree_claude_teams_wrapper_launch=0
if [[ "${BREE_CLAUDE_TEAMS_WRAPPER_LAUNCH:-}" == "1" &&
      "${BREE_AGENT_LAUNCH_KIND:-}" == "claudeTeams" &&
      -n "${BREE_AGENT_LAUNCH_EXECUTABLE:-}" &&
      "${BREE_AGENT_LAUNCH_EXECUTABLE:-}" == "${BREE_CLAUDE_TEAMS_BREE_BIN:-}" &&
      -n "${BREE_AGENT_LAUNCH_ARGV_B64:-}" ]]; then
    bree_claude_teams_wrapper_launch=1
fi
unset BREE_CLAUDE_TEAMS_WRAPPER_LAUNCH

# Find the real claude binary, skipping bree's wrapper and temp shell shims.
find_real_claude() {
    # Honor custom path from Settings > Automation > Claude Code > Claude Binary Path.
    # Guard against self-reference (user pointing back to this wrapper).
    local custom="${BREE_CUSTOM_CLAUDE_PATH:-}"
    custom="${custom#"${custom%%[![:space:]]*}"}"  # trim leading whitespace
    custom="${custom%"${custom##*[![:space:]]}"}"  # trim trailing whitespace
    if [[ -n "$custom" && -f "$custom" && -x "$custom" ]]; then
        # Use -ef to detect same underlying file even through symlinks.
        if ! bree_claude_wrapper_is_self_or_shim "$custom"; then
            printf '%s' "$custom"
            return 0
        fi
    fi
    local self_dir
    self_dir="$(cd "$(dirname "$0")" && pwd)"
    local IFS=:
    for d in $PATH; do
        [[ "$d" == "$self_dir" ]] && continue
        local candidate="$d/claude"
        bree_claude_wrapper_is_self_or_shim "$candidate" && continue
        [[ -x "$candidate" ]] && printf '%s' "$candidate" && return 0
    done
    return 1
}

# Return 0 only when BREE_SOCKET_PATH points to a live bree socket.
bree_socket_available() {
    local socket="${BREE_SOCKET_PATH:-}"
    [[ -n "$socket" && -S "$socket" ]] || return 1

    local self_dir bree_bin
    self_dir="$(cd "$(dirname "$0")" && pwd)"
    bree_bin="$self_dir/bree"
    [[ -x "$bree_bin" ]] || bree_bin="$(command -v bree || true)"
    [[ -n "$bree_bin" ]] || return 1

    # Keep stale/hung socket checks bounded so claude startup does not block
    # behind the CLI default timeout (15s).
    BREE_CLI_RESPONSE_TIMEOUT_SEC=0.75 \
        "$bree_bin" --socket "$socket" ping >/dev/null 2>&1
}

resolve_hook_bree_bin() {
    local self_dir bundled_cli
    bundled_cli="${BREE_BUNDLED_CLI_PATH:-}"
    if [[ -n "$bundled_cli" && -x "$bundled_cli" ]]; then
        printf '%s' "$bundled_cli"
        return 0
    fi

    self_dir="$(cd "$(dirname "$0")" && pwd)"
    bundled_cli="$self_dir/bree"
    if [[ -x "$bundled_cli" ]]; then
        printf '%s' "$bundled_cli"
        return 0
    fi

    bundled_cli="$(command -v bree || true)"
    if [[ -n "$bundled_cli" ]]; then
        printf '%s' "$bundled_cli"
        return 0
    fi

    printf '%s' "bree"
}

CLAUDE_AUTH_SELECTION_ENV_KEYS=(
    ANTHROPIC_API_KEY
    ANTHROPIC_MODEL
    ANTHROPIC_SMALL_FAST_MODEL
    CLAUDE_CODE_USE_BEDROCK
    CLAUDE_CODE_USE_VERTEX
)

PRESERVE_CLAUDE_AUTH_SELECTION_ENV=false
case "${BREE_PRESERVE_CLAUDE_AUTH_SELECTION_ENV:-}" in
    1|true|TRUE|yes|YES) PRESERVE_CLAUDE_AUTH_SELECTION_ENV=true ;;
esac

# Return 0 when an ANTHROPIC_MODEL / ANTHROPIC_SMALL_FAST_MODEL value carries a
# Vertex/Bedrock-specific shape that is only valid against those backends and
# would mis-route (or be rejected) on the default Anthropic API:
#   - Vertex pins the publisher date with '@', e.g. claude-sonnet-4-5@20250929
#   - Bedrock uses the dotted vendor namespace + version/profile suffix, e.g.
#     us.anthropic.claude-sonnet-4-5-20250929-v1:0 (and regional eu./apac./
#     us-gov. variants), bare anthropic.<model>-v1:0, or an arn:aws:bedrock ARN.
# Plain ids such as claude-opus-4-8 or claude-opus-4-8[1m] carry none of these
# markers and are valid on the default Anthropic path, so they are NOT
# backend-qualified. https://github.com/ecyx00/bree/issues/7047
claude_model_id_is_backend_qualified() {
    case "$1" in
        *@*|*:*|*/*) return 0 ;;
        *anthropic.*) return 0 ;;
    esac
    return 1
}

should_preserve_claude_auth_selection_key() {
    if [[ "$PRESERVE_CLAUDE_AUTH_SELECTION_ENV" == true ]]; then
        local configured_keys="${BREE_PRESERVE_CLAUDE_AUTH_SELECTION_ENV_KEYS:-}"
        if [[ -z "$configured_keys" ]]; then
            return 0
        fi
        configured_keys="${configured_keys//,/ }"
        local configured_key
        for configured_key in $configured_keys; do
            [[ "$configured_key" == "$1" ]] && return 0
        done
        # Key not in the explicit list: do NOT early-return — fall through to
        # the Vertex/Bedrock auto-preserve below. BREE_PRESERVE_CLAUDE_AUTH_SELECTION_ENV_KEYS
        # is an additive allow-list, not an exclusion list, so an operator
        # who opts in with a narrower key list still gets Vertex/Bedrock
        # selection signals preserved when those backends are active.
    fi

    # Auto-preserve Vertex/Bedrock auth selection so users with valid
    # CLAUDE_CODE_USE_VERTEX=1 / CLAUDE_CODE_USE_BEDROCK=1 setups in their
    # shell rc authenticate inside bree the same way they do in plain
    # Terminal. Without this, the wrapper silently drops the selection
    # signal and claude reports "not logged in".
    # Refs: https://github.com/ecyx00/bree/issues/3641 (Vertex)
    #       https://github.com/ecyx00/bree/issues/3638 (Bedrock)
    local vertex_on=false bedrock_on=false
    case "${CLAUDE_CODE_USE_VERTEX:-}" in
        1|true|TRUE|yes|YES) vertex_on=true ;;
    esac
    case "${CLAUDE_CODE_USE_BEDROCK:-}" in
        1|true|TRUE|yes|YES) bedrock_on=true ;;
    esac

    case "$1" in
        CLAUDE_CODE_USE_VERTEX)
            [[ "$vertex_on" == true ]] && return 0
            ;;
        CLAUDE_CODE_USE_BEDROCK)
            [[ "$bedrock_on" == true ]] && return 0
            ;;
        ANTHROPIC_MODEL|ANTHROPIC_SMALL_FAST_MODEL)
            # Vertex and Bedrock require backend-specific full model ids
            # (e.g. "claude-sonnet-4-5@20250929" for Vertex,
            # "us.anthropic.claude-sonnet-4-5-20250929-v1:0" for Bedrock).
            # Preserve the user's selection when one of those backends is
            # active.
            if [[ "$vertex_on" == true || "$bedrock_on" == true ]]; then
                return 0
            fi
            # Default Anthropic API path (no Vertex/Bedrock backend active):
            # preserve a user-pinned PLAIN model id (e.g. "claude-opus-4-8[1m]")
            # so bree behaves like a plain Terminal and a Max-plan 1M context
            # window selection survives every new pane/reboot. Still strip
            # backend-qualified ids: a stale "...@<date>" / "...anthropic...:..."
            # value is invalid on the Anthropic path and is exactly the leak the
            # scrub guards against. https://github.com/ecyx00/bree/issues/7047
            local model_key="$1"
            local model_value="${!model_key-}"
            if [[ -n "$model_value" ]] &&
               ! claude_model_id_is_backend_qualified "$model_value"; then
                return 0
            fi
            ;;
    esac

    return 1
}

normalize_claude_config_dir() {
    [[ -n "${CLAUDE_CONFIG_DIR:-}" ]] || return 0
    [[ -n "${HOME:-}" ]] || return 0

    local value="$CLAUDE_CONFIG_DIR"
    local legacy_root="$HOME/.subrouter/codex/claude"
    local account_root="$HOME/.codex-accounts/claude"
    if [[ "$value" == "~/"* ]]; then
        value="$HOME/${value#~/}"
    fi

    case "$value" in
        "$legacy_root"|"$legacy_root"/*)
            local suffix="${value#$legacy_root}"
            local candidate="$account_root$suffix"
            if [[ -e "$candidate" || -L "$candidate" ]]; then
                export CLAUDE_CONFIG_DIR="$candidate"
            fi
            ;;
    esac
}

# Claude stores transcripts at <config-dir>/projects/<encode(cwd)>/<id>.jsonl and
# `--resume <id>` only resolves a session under the *current* CLAUDE_CONFIG_DIR.
# bree can launch with a foreign CLAUDE_CONFIG_DIR (the .app inherits the env of
# whatever opened it, e.g. a terminal whose agent set one), so resuming a session
# created under a different config root fails with "No conversation found" and drops
# the user to a bare shell. Self-heal by relocating CLAUDE_CONFIG_DIR to the root
# that actually holds the transcript, but only when the current root lacks it (so a
# correct resume is never repointed). https://github.com/ecyx00/bree/issues/6194
bree_claude_config_dir_has_session() {
    local root="$1" sid="$2"
    [[ -n "$root" && -d "$root/projects" ]] || return 1
    local transcript
    for transcript in \
        "$root"/projects/*/"$sid".jsonl \
        "$root"/projects/*/*/"$sid".jsonl \
        "$root"/projects/*/*/*/"$sid".jsonl \
        "$root"/projects/*/*/*/*/"$sid".jsonl \
        "$root"/projects/*/*/*/*/*/"$sid".jsonl; do
        [[ -f "$transcript" && -s "$transcript" ]] && return 0
    done
    return 1
}

claude_option_consumes_value() {
    case "$1" in
        --add-dir|--agent|--agents|--allowedTools|--allowed-tools|\
        --append-system-prompt|--betas|--debug-file|--disallowedTools|\
        --disallowed-tools|--effort|--fallback-model|--file|\
        --input-format|--json-schema|--max-budget-usd|--mcp-config|\
        --model|-m|-n|--name|--output-format|--permission-mode|--plugin-dir|\
        --plugin-url|--remote-control-session-name-prefix|--setting-sources|\
        --settings|--system-prompt|--tools)
            return 0
            ;;
    esac
    return 1
}

claude_remaining_args_have_resume_flag() {
    local arg
    for arg in "$@"; do
        case "$arg" in
            --)
                return 1
                ;;
            --resume|-r|--resume=*)
                return 0
                ;;
        esac
    done
    return 1
}

claude_remaining_args_have_explicit_session_flag() {
    local arg
    for arg in "$@"; do
        case "$arg" in
            --)
                return 1
                ;;
            --resume|--resume=*|-r|--session-id|--session-id=*|--continue|-c)
                return 0
                ;;
        esac
    done
    return 1
}

claude_unknown_option_should_skip_value_before_resume_flag() {
    local index="$1"
    local -a args=("${@:2}")
    local next_index=$((index + 1))
    local rest_index=$((index + 2))
    (( next_index < ${#args[@]} )) || return 1
    [[ "${args[$next_index]}" != -* ]] || return 1
    claude_remaining_args_have_resume_flag "${args[@]:$rest_index}"
}

claude_unknown_option_should_skip_value_before_explicit_session_flag() {
    local index="$1"
    local -a args=("${@:2}")
    local next_index=$((index + 1))
    local rest_index=$((index + 2))
    (( next_index < ${#args[@]} )) || return 1
    [[ "${args[$next_index]}" != -* ]] || return 1
    claude_remaining_args_have_explicit_session_flag "${args[@]:$rest_index}"
}

extract_claude_resume_session_id() {
    local -a args=("$@")
    local index=0
    local arg
    while (( index < ${#args[@]} )); do
        arg="${args[$index]}"
        case "$arg" in
            --)
                return 1
                ;;
            --resume|-r)
                index=$((index + 1))
                (( index < ${#args[@]} )) || return 1
                printf '%s' "${args[$index]}"
                return 0
                ;;
            --resume=*)
                printf '%s' "${arg#--resume=}"
                return 0
                ;;
            -*)
                if [[ "$arg" != *=* ]]; then
                    if claude_option_consumes_value "$arg" ||
                       claude_unknown_option_should_skip_value_before_resume_flag "$index" "${args[@]}"; then
                        index=$((index + 2))
                        continue
                    fi
                fi
                ;;
            *)
                ;;
        esac
        index=$((index + 1))
    done
    return 1
}

claude_explicit_session_flag_present() {
    local -a args=("$@")
    local index=0
    local arg
    while (( index < ${#args[@]} )); do
        arg="${args[$index]}"
        case "$arg" in
            --)
                return 1
                ;;
            --resume|--resume=*|-r|--session-id|--session-id=*|--continue|-c)
                return 0
                ;;
            -*)
                if [[ "$arg" != *=* ]]; then
                    if claude_option_consumes_value "$arg" ||
                       claude_unknown_option_should_skip_value_before_explicit_session_flag "$index" "${args[@]}"; then
                        index=$((index + 2))
                        continue
                    fi
                fi
                ;;
            *)
                ;;
        esac
        index=$((index + 1))
    done
    return 1
}

reconcile_claude_config_dir_for_resume() {
    local sid="$1"
    [[ -n "$sid" && -n "${HOME:-}" ]] || return 0
    # Only safe filename tokens (claude session ids are uuids); never glob-walk on
    # path separators or dot segments.
    case "$sid" in
        *[!A-Za-z0-9._-]*|''|.|..) return 0 ;;
    esac

    local current_root="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
    bree_claude_config_dir_has_session "$current_root" "$sid" && return 0

    local root
    for root in "$HOME/.claude" "$HOME"/.codex-accounts/claude/* "$HOME/.subrouter/codex/claude" "$HOME"/.subrouter/codex/claude/*; do
        [[ "$root" == "$current_root" ]] && continue
        if bree_claude_config_dir_has_session "$root" "$sid"; then
            export CLAUDE_CONFIG_DIR="$root"
            return 0
        fi
    done
}

clear_inherited_claude_auth_selection_env() {
    if [[ "${IN_BREE:-0}" == "1" ]]; then
        local key
        for key in "${CLAUDE_AUTH_SELECTION_ENV_KEYS[@]}"; do
            should_preserve_claude_auth_selection_key "$key" && continue
            unset "$key"
        done
    fi
    # Safe outside bree: this only rewrites an existing subrouter path when the account alias exists.
    normalize_claude_config_dir
}

clear_inherited_claude_session_identity_env() {
    # Generated from scripts/claude-launch-environment-policy.json.
    # ClaudeWrapperResumeEnvironmentTests exercises every session identity key here.
    # BEGIN GENERATED CLAUDE LAUNCH ENVIRONMENT POLICY
    unset CLAUDECODE
    unset CLAUDE_CODE
    unset CLAUDE_CODE_CHILD_SESSION
    unset CLAUDE_CODE_BRIDGE_SESSION_ID
    unset CLAUDE_CODE_PARENT_SESSION_ID
    unset CLAUDE_CODE_SESSION_ID
    unset CLAUDE_CODE_ENTRYPOINT
    unset CLAUDE_CODE_EXECPATH
    unset CLAUDE_CODE_SSE_PORT
    # END GENERATED CLAUDE LAUNCH ENVIRONMENT POLICY
}

# `bree hooks claude inject-settings` prints a fixed document and never
# touches the app socket, so it can run while the socket ping below decides
# whether this launch gets hooks at all. A background job runs the generator
# under its 1 s watchdog and writes its output to a private file; the wrapper
# either collects it (hook injection) or discards it (every passthrough). An
# unexpected `exit` in between discards it via the EXIT trap; exec does not run
# that trap.
unset bree_claude_hook_settings_file bree_claude_hook_settings_job_pid bree_claude_hook_settings_value
bree_claude_hook_settings_file=""
bree_claude_hook_settings_job_pid=""
bree_claude_hook_settings_value=""

# Background job body; stdout is the collection file. The generator and its
# watchdog are children of this job, so the job reaps the generator and stops
# the watchdog as soon as it exits, and TERM from a discard stops both.
bree_claude_run_hook_settings_generator() {
    local hook_bree_bin="$1" generator_pid="" watchdog_pid="" generator_status
    local term_requested=0
    # Record a TERM that lands while the children are being spawned; act on it
    # once both pids are known.
    trap 'term_requested=1' TERM

    BREE_CLI_RESPONSE_TIMEOUT_SEC=0.75 \
        "$hook_bree_bin" hooks claude inject-settings 2>/dev/null &
    generator_pid=$!
    (
        bree_generator_timer_pid=""
        trap 'if [[ -n "$bree_generator_timer_pid" ]]; then kill "$bree_generator_timer_pid" 2>/dev/null || true; fi' EXIT
        trap 'exit 0' HUP INT TERM
        /bin/sleep 1 &
        bree_generator_timer_pid=$!
        wait "$bree_generator_timer_pid" 2>/dev/null || exit 0
        bree_generator_timer_pid=""
        trap - EXIT HUP INT TERM
        kill -KILL "$generator_pid" 2>/dev/null || true
    ) >/dev/null &
    watchdog_pid=$!
    trap 'kill -KILL "$generator_pid" 2>/dev/null; kill "$watchdog_pid" 2>/dev/null; exit 143' TERM
    if (( term_requested )); then
        kill -KILL "$generator_pid" 2>/dev/null
        kill "$watchdog_pid" 2>/dev/null
        exit 143
    fi

    wait "$generator_pid" 2>/dev/null
    generator_status=$?
    kill "$watchdog_pid" 2>/dev/null || true
    wait "$watchdog_pid" 2>/dev/null || true
    exit "$generator_status"
}

bree_claude_start_hook_settings() {
    local hook_bree_bin="$1"
    bree_claude_hook_settings_file="$(mktemp "${TMPDIR:-/tmp}/bree-claude-hook-settings.XXXXXX" 2>/dev/null)" || {
        bree_claude_hook_settings_file=""
        return 1
    }
    trap bree_claude_discard_hook_settings EXIT
    bree_claude_run_hook_settings_generator "$hook_bree_bin" >"$bree_claude_hook_settings_file" &
    bree_claude_hook_settings_job_pid=$!
}

# Waits for the job (at most until its watchdog fires) and sets
# bree_claude_hook_settings_value to the generator's output. Returns the
# generator status, or 1 when the job could not be started.
bree_claude_collect_hook_settings() {
    local hook_bree_bin="$1"
    if [[ -z "$bree_claude_hook_settings_job_pid" ]]; then
        bree_claude_start_hook_settings "$hook_bree_bin" || return 1
    fi
    bree_claude_finish_hook_settings
}

bree_claude_finish_hook_settings() {
    local generator_status=1
    bree_claude_hook_settings_value=""
    if [[ -n "$bree_claude_hook_settings_job_pid" ]]; then
        wait "$bree_claude_hook_settings_job_pid" 2>/dev/null
        generator_status=$?
    fi
    if [[ $generator_status -eq 0 && -n "$bree_claude_hook_settings_file" ]]; then
        bree_claude_hook_settings_value="$(<"$bree_claude_hook_settings_file")"
    fi
    if [[ -n "$bree_claude_hook_settings_file" ]]; then
        rm -f -- "$bree_claude_hook_settings_file"
    fi
    bree_claude_hook_settings_file=""
    bree_claude_hook_settings_job_pid=""
    trap - EXIT
    return "$generator_status"
}

bree_claude_discard_hook_settings() {
    [[ -n "$bree_claude_hook_settings_job_pid$bree_claude_hook_settings_file" ]] || return 0
    # Signal the job only while bash still lists it as running: once it has
    # exited, bash has already reaped it and the pid may belong to someone else.
    local newline=$'\n'
    if [[ -n "$bree_claude_hook_settings_job_pid" &&
          "$newline$(jobs -rp)$newline" == *"$newline$bree_claude_hook_settings_job_pid$newline"* ]]; then
        kill -TERM "$bree_claude_hook_settings_job_pid" 2>/dev/null || true
    fi
    bree_claude_finish_hook_settings >/dev/null 2>&1 || true
    bree_claude_hook_settings_value=""
}

# Pass through if not in a bree terminal, hooks are disabled, or the bree
# socket is unavailable (stale env / app not running).
IN_BREE=0
if [[ -n "$BREE_SURFACE_ID" ]]; then
    IN_BREE=1
fi

if [[ "$IN_BREE" == "1" ]]; then
    bree_claude_wrapper_validate_arguments "$@" || exit $?
fi

# BREE_AGENT_RESTORE_LAUNCH is a provider/session-bound one-shot token attached
# only to app-generated restore input. Consume it before every eventual exec so
# it can authorize this launch without leaking to Claude or hooks.
bree_claude_app_restore_launch="${BREE_AGENT_RESTORE_LAUNCH:-}"
unset BREE_AGENT_RESTORE_LAUNCH

clear_bree_claude_passthrough_env() {
    if [[ "$IN_BREE" == "1" ]]; then
        clear_inherited_claude_session_identity_env
        local bree_key
        for bree_key in "${!BREE_@}"; do
            unset "$bree_key"
        done
        unset TERMINFO
    fi
}

exec_real_claude_passthrough() {
    # Passthrough launches get no hooks; drop any speculative settings job.
    bree_claude_discard_hook_settings
    clear_bree_claude_passthrough_env
    bree_claude_wrapper_exec_resolved_claude "$REAL_CLAUDE" "$@"
}

# Find real claude.
REAL_CLAUDE="$(find_real_claude)" || { echo "Error: claude not found in PATH" >&2; exit 127; }

ensure_node_options_restore_module() {
    # The restore preload must outlive the Claude session: every Node child
    # loads it via NODE_OPTIONS, and macOS purges $TMPDIR under long-lived
    # sessions (https://github.com/ecyx00/bree/issues/12022). Keep it
    # next to the other CLI shims in ~/.bree.
    [[ -n "${HOME:-}" && "$HOME" == /* ]] || return 1
    local shim_dot=.bree
    case "${BREE_BUNDLE_ID:-}" in
        com.bree.app) shim_dot=.bree ;;
        com.bree.app.debug.bree) shim_dot=.bree-dev ;;
    esac
    local guard_dir="${HOME%/}/$shim_dot/bree-claude-node-options"
    local guard_path="$guard_dir/restore-node-options.cjs"
    [[ ! -L "$guard_dir" && ! -L "$guard_path" ]] || return 1
    mkdir -p "$guard_dir" || return 1
    chmod 0700 "$guard_dir" || return 1
    local temp_path
    temp_path="$(mktemp "$guard_dir/.restore-node-options.cjs.XXXXXX")" || return 1
    cat >"$temp_path" <<'EOF'
const hadOriginalNodeOptions = process.env.BREE_ORIGINAL_NODE_OPTIONS_PRESENT === "1";
if (hadOriginalNodeOptions) {
  process.env.NODE_OPTIONS = process.env.BREE_ORIGINAL_NODE_OPTIONS ?? "";
} else {
  delete process.env.NODE_OPTIONS;
}
delete process.env.BREE_ORIGINAL_NODE_OPTIONS;
delete process.env.BREE_ORIGINAL_NODE_OPTIONS_PRESENT;
EOF
    chmod 0644 "$temp_path" || {
        rm -f "$temp_path"
        return 1
    }
    if [[ -f "$guard_path" ]] && cmp -s "$temp_path" "$guard_path"; then
        rm -f "$temp_path" || return 1
    else
        mv -f "$temp_path" "$guard_path" || {
            rm -f "$temp_path"
            return 1
        }
    fi
    printf '%s' "$guard_path"
}

node_options_require_flag() {
    local path="$1"
    # NODE_OPTIONS splits on whitespace; quote the path when $HOME has spaces.
    if [[ "$path" == *[[:space:]]* ]]; then
        printf '%s' "--require=\"$path\""
    else
        printf '%s' "--require=$path"
    fi
}

merge_node_options() {
    local guard_path="$1"
    local require_flag
    require_flag="$(node_options_require_flag "$guard_path")"
    local memory_flag="--max-old-space-size=4096"
    local existing="${NODE_OPTIONS:-}"
    local -a filtered=()
    local -a tokens=()
    local token
    local skip_next=0

    if [[ -z "$guard_path" ]]; then
        printf '%s' "$existing"
        return 0
    fi

    read -r -a tokens <<<"$existing"
    for token in "${tokens[@]}"; do
        if (( skip_next )); then
            skip_next=0
            continue
        fi
        if [[ "$token" == "--max-old-space-size" ]]; then
            skip_next=1
            continue
        fi
        if [[ "$token" == --max-old-space-size=* ]]; then
            continue
        fi
        filtered+=("$token")
    done

    if (( ${#filtered[@]} == 0 )); then
        printf '%s %s' "$require_flag" "$memory_flag"
        return 0
    fi
    printf '%s %s' "$require_flag" "$memory_flag"
    printf ' %s' "${filtered[@]}"
}

normalize_node_options_for_restore() {
    local existing="${1:-}"
    local -a tokens=()
    local -a normalized=()
    local token
    local index=0

    read -r -a tokens <<<"$existing"
    while (( index < ${#tokens[@]} )); do
        token="${tokens[$index]}"
        if [[ "$token" == "--max-old-space-size" && $((index + 1)) -lt ${#tokens[@]} ]]; then
            normalized+=("--max-old-space-size=${tokens[$((index + 1))]}")
            index=$((index + 2))
            continue
        fi
        normalized+=("$token")
        index=$((index + 1))
    done

    if (( ${#normalized[@]} == 0 )); then
        return 0
    fi
    printf '%s' "${normalized[0]}"
    if (( ${#normalized[@]} > 1 )); then
        printf ' %s' "${normalized[@]:1}"
    fi
}

bree_claude_wrapper_resolve_symlinks() {
    local path="$1" link hops=0
    while [[ -L "$path" && $hops -lt 40 ]]; do
        link="$(readlink "$path")" || break
        case "$link" in
            /*) path="$link" ;;
            *) path="$(dirname "$path")/$link" ;;
        esac
        hops=$((hops + 1))
    done
    printf '%s' "$path"
}

bree_claude_wrapper_target_is_native_executable() {
    # Volta and mise shims are native launchers (symlinks to their own binary)
    # that may run a Node claude, so they keep the restore preload.
    case "$(basename "$(bree_claude_wrapper_resolve_symlinks "$1")")" in
        volta-shim|mise|rtx) return 1 ;;
    esac
    local magic
    magic="$(LC_ALL=C od -An -tx1 -N4 "$1" 2>/dev/null | tr -d ' \n')" || return 1
    case "$magic" in
        # Mach-O 64/32-bit, universal (fat), and ELF.
        cffaedfe|cefaedfe|feedfacf|feedface|cafebabe|cafebabf|7f454c46) return 0 ;;
    esac
    return 1
}

# Removes the restore preload bree injects, and the heap flag merge_node_options
# places right after it, keeping every other option.
strip_bree_node_options() {
    local -a tokens=()
    local -a kept=()
    local index=0
    local token
    read -r -a tokens <<<"$1"
    while (( index < ${#tokens[@]} )); do
        token="${tokens[$index]}"
        index=$((index + 1))
        # node_options_require_flag quotes the path when $HOME has spaces;
        # rejoin the quoted flag before matching it.
        if [[ "$token" == --require=\"* ]]; then
            while [[ "$token" != --require=\"*\" && $index -lt ${#tokens[@]} ]]; do
                token+=" ${tokens[$index]}"
                index=$((index + 1))
            done
        fi
        if [[ "$token" == --require=*/bree-claude-node-options/restore-node-options.cjs ||
              "$token" == --require=\"*/bree-claude-node-options/restore-node-options.cjs\" ]]; then
            if [[ "${tokens[$index]:-}" == "--max-old-space-size=4096" ]]; then
                index=$((index + 1))
            fi
            continue
        fi
        kept+=("$token")
    done
    if (( ${#kept[@]} > 0 )); then
        printf '%s' "${kept[*]}"
    fi
}

install_bree_node_options() {
    # A native claude never runs the --require restore module, so the injected
    # NODE_OPTIONS would leak to every child it spawns, including sandboxed
    # apps that cannot read the module. https://github.com/ecyx00/bree/issues/14681
    # An earlier bree layer (claude-teams, a re-entering shim) may already have
    # injected it, so do the module's restore here instead.
    if bree_claude_wrapper_target_is_native_executable "$1"; then
        if [[ "${NODE_OPTIONS:-}" == *"/bree-claude-node-options/restore-node-options.cjs"* ]]; then
            if [[ "${BREE_ORIGINAL_NODE_OPTIONS_PRESENT:-}" == "1" ]]; then
                export NODE_OPTIONS="${BREE_ORIGINAL_NODE_OPTIONS:-}"
            else
                local remaining
                remaining="$(strip_bree_node_options "$NODE_OPTIONS")"
                if [[ -n "$remaining" ]]; then
                    export NODE_OPTIONS="$remaining"
                else
                    unset NODE_OPTIONS
                fi
            fi
        fi
        unset BREE_ORIGINAL_NODE_OPTIONS BREE_ORIGINAL_NODE_OPTIONS_PRESENT
        return 0
    fi
    local guard_path
    if guard_path="$(ensure_node_options_restore_module)"; then
        if [[ ${NODE_OPTIONS+x} && "${NODE_OPTIONS:-}" == *"$(node_options_require_flag "$guard_path")"* ]]; then
            return 0
        fi
        if [[ ${NODE_OPTIONS+x} ]]; then
            export BREE_ORIGINAL_NODE_OPTIONS_PRESENT=1
            export BREE_ORIGINAL_NODE_OPTIONS="$(normalize_node_options_for_restore "$NODE_OPTIONS")"
        else
            export BREE_ORIGINAL_NODE_OPTIONS_PRESENT=0
            unset BREE_ORIGINAL_NODE_OPTIONS
        fi
        export NODE_OPTIONS="$(merge_node_options "$guard_path")"
    fi
}

encode_launch_argv() {
    {
        printf '%s\0' "$REAL_CLAUDE"
        if (( $# > 0 )); then
            printf '%s\0' "$@"
        fi
    } | base64 | tr -d '\n'
}

bree_claude_wrapper_create_settings_file() {
    local contents="$1"
    local temp_dir="${TMPDIR:-/tmp}"
    local settings_path
    [[ -d "$temp_dir" ]] || temp_dir="/tmp"
    # mktemp gives each launch a private name; do not sweep matching files here,
    # because another surface may still be handing one to Claude.
    settings_path="$(mktemp "${temp_dir%/}/bree-claude-settings.XXXXXX")" || return 1
    if ! printf '%s' "$contents" >"$settings_path"; then
        rm -f -- "$settings_path"
        return 1
    fi
    printf '%s' "$settings_path"
}

bree_claude_wrapper_create_settings_values_file() {
    local temp_dir="${TMPDIR:-/tmp}"
    local settings_path
    [[ -d "$temp_dir" ]] || temp_dir="/tmp"
    settings_path="$(mktemp "${temp_dir%/}/bree-claude-settings-inputs.XXXXXX")" || return 1
    if ! printf '%s\0' "$@" >"$settings_path"; then
        rm -f -- "$settings_path"
        return 1
    fi
    printf '%s' "$settings_path"
}

claude_interactive_entry_flag() {
    case "$1" in
        --print|--print=*|-p|--resume|--resume=*|-r|--continue|-c|\
        --session-id|--session-id=*|--remote-control|--remote-control=*|\
        --from-pr|--from-pr=*|--worktree|--worktree=*|-w|-w=*)
            return 0
            ;;
    esac
    return 1
}

claude_passthrough_option_flag() {
    case "$1" in
        --help|-h|--version|-v)
            return 0
            ;;
    esac
    return 1
}

claude_builtin_command_name() {
    # Compatibility floor for hidden commands and unavailable help. Advertised
    # commands are also discovered below so new Claude releases need no update.
    case "$1" in
        agents|attach|auth|auto-mode|config|api-key|daemon|doctor|gateway|import|install|\
        kill|logs|mcp|respawn|rm|stop|\
        experimental-next|plugin|plugins|project|rc|remote-control|setup-token|\
        ultrareview|update|upgrade)
            return 0
            ;;
    esac
    return 1
}

claude_discovered_command_name() (
    # Keep discovery optional, bounded, and outside the project. Perl ships on
    # macOS and already supplies process deadlines for the other agent wrappers.
    [[ -x /usr/bin/perl && "${HOME:-}" == /* ]] || return 1
    bree_claude_wrapper_prepare_custom_path_environment "$REAL_CLAUDE"
    clear_inherited_claude_auth_selection_env
    clear_bree_claude_passthrough_env
    LC_ALL=C /usr/bin/perl - "$REAL_CLAUDE" "$1" \
        "$HOME/Library/Caches/bree/claude-commands-v1" 2>/dev/null <<'PERL'
use strict;
use warnings;
use Cwd qw(abs_path);
use Digest::SHA qw(sha256_hex);
use File::Path qw(make_path);
use File::Temp qw(tempfile);
use POSIX qw(setpgid);
use Time::HiRes qw(alarm stat time);

my ($executable, $candidate, $directory) = @ARGV;
my $binary = abs_path($executable) or exit 1;
my @metadata = stat($binary);
exit 1 unless @metadata;
my $identity = sha256_hex(join("\0", $binary, @metadata[0, 1, 7],
    map { sprintf("%.9f", $_) } @metadata[9, 10]));
my $cache = "$directory/" . sha256_hex($binary);
my $word = qr/[a-z][a-z0-9_-]*/;
umask 0077;

# A cache is data, never shell code. Ignore malformed/partial files. Atomic
# replacement lets concurrent launches read complete snapshots without a lock.
if (-f $cache && !-l $cache && -s $cache <= 65536 && open(my $file, "<", $cache)) {
    my @lines = <$file>;
    close $file;
    chomp @lines;
    my ($cached_identity, $expires, @commands) = @lines;
    if (defined($expires) && $cached_identity eq $identity &&
        $expires =~ /^\d+$/ && $expires > time() &&
        !grep { !/^$word$/ } @commands) {
        exit((grep { $_ eq $candidate } @commands) ? 0 : 1);
    }
}

pipe(my $reader, my $writer) or exit 1;
my $pid = fork();
exit 1 unless defined $pid;
if ($pid == 0) {
    # Own the probe process group so a launcher that spawns children cannot
    # keep the pipe open or survive its deadline. Never read the terminal.
    setpgid(0, 0) == 0 or exit 1;
    close $reader;
    open(STDIN, "<", "/dev/null") or exit 1;
    open(STDOUT, ">&", $writer) or exit 1;
    close $writer;
    $ENV{NO_COLOR} = 1;
    exec { $executable } $executable, "--help";
    exit 1;
}
close $writer;
my $stop_probe = sub {
    return unless defined $pid;
    kill "KILL", -$pid;
    kill "KILL", $pid;
    waitpid($pid, 0);
    undef $pid;
};
$SIG{HUP} = sub { $stop_probe->(); exit 129; };
$SIG{INT} = sub { $stop_probe->(); exit 130; };
$SIG{TERM} = sub { $stop_probe->(); exit 143; };
my $output = "";
my $success = eval {
    local $SIG{ALRM} = sub { die "help deadline\n" };
    alarm(0.75);
    while (1) {
        my $read = sysread($reader, my $chunk, 8192);
        die "help read\n" unless defined $read;
        last unless $read;
        $output .= $chunk;
        die "help too large\n" if length($output) > 65536;
    }
    waitpid($pid, 0) == $pid or die "help wait\n";
    my $status = $?;
    undef $pid;
    alarm(0);
    $status == 0;
};
alarm(0);
if (!defined $success) {
    $stop_probe->();
}
close $reader;

my %commands;
if ($success) {
    $output =~ s/\e\[[0-?]*[ -\/]*[\@-~]//g;
    my $in_commands = 0;
    for my $line (split /\r?\n/, $output) {
        if ($line =~ /^Commands:\s*$/) { $in_commands = 1; next; }
        next unless $in_commands;
        last if $line =~ /^\S/;
        # Only command rows, not wrapped descriptions, options, or examples.
        if ($line =~ /^  ($word(?:\|$word)*)(?:\s|$)/) {
            $commands{$_} = 1 for split /\|/, $1;
        }
    }
}

# Retry failed/empty help after a minute. Also refresh successful discovery
# hourly: a version-manager launcher can select a new binary without changing
# its own path/mtime. Native binary replacements still invalidate immediately.
my $expires = int(time()) + (%commands ? 3600 : 60);
eval {
    make_path($directory, { mode => 0700 });
    my ($file, $temporary) = tempfile(".commands-XXXXXX", DIR => $directory);
    my $saved = print $file join("\n", $identity, $expires, sort keys %commands), "\n";
    $saved = close($file) && $saved;
    unlink $temporary unless $saved && rename($temporary, $cache);
};
exit(exists($commands{$candidate}) ? 0 : 1);
PERL
)

claude_command_like_invocation() {
    local candidate="$1"
    [[ -n "$candidate" ]] || return 1
    case "$candidate" in
        *[![:alnum:]_-]*)
            return 1
            ;;
    esac
    claude_builtin_command_name "$candidate" && return 0
    # Empty launches, explicit session flags and multiword prompts never reach
    # discovery. An unknown single word still gets hooks unless help names it.
    [[ "$candidate" =~ ^[a-z][a-z0-9_-]*$ ]] || return 1
    claude_discovered_command_name "$candidate"
}

should_inject_claude_hooks() {
    (( $# == 0 )) && return 0

    local arg command_status
    local skip_next=false
    for arg in "$@"; do
        if [[ "$skip_next" == true ]]; then
            skip_next=false
            continue
        fi
        case "$arg" in
            --)
                return 0
                ;;
            -*)
                if claude_passthrough_option_flag "$arg"; then
                    return 1
                fi
                if claude_interactive_entry_flag "$arg"; then
                    return 0
                fi
                if [[ "$arg" != *=* ]] && claude_option_consumes_value "$arg"; then
                    skip_next=true
                fi
                continue
                ;;
            *)
                claude_command_like_invocation "$arg"
                command_status=$?
                case "$command_status" in
                    0) return 1 ;;
                    # Cancellation is not a failed lookup: do not start a
                    # prompt session after the user interrupts discovery.
                    129|130|143) exit "$command_status" ;;
                esac
                return 0
                ;;
        esac
    done

    return 0
}

# BREE_CLAUDE_HOOKS_DISABLED is the documented MASTER opt-out: the wrapper
# stays fully inert — no bree calls, no argv changes
# (the disabled-integration regression asserts exactly this).
if [[ "$BREE_CLAUDE_HOOKS_DISABLED" == "1" ]]; then
    # User-managed hooks need the original bree terminal environment.
    if [[ "$IN_BREE" == "1" ]]; then
        clear_inherited_claude_session_identity_env
    fi
    clear_inherited_claude_auth_selection_env
    if [[ "$IN_BREE" == "1" ]]; then
        reconcile_claude_config_dir_for_resume "$(extract_claude_resume_session_id "$@")"
    fi
    bree_claude_wrapper_exec_resolved_claude "$REAL_CLAUDE" "$@"
fi

if [[ "$IN_BREE" == "0" ]]; then
    clear_inherited_claude_auth_selection_env
    exec_real_claude_passthrough "$@"
fi

# App-generated restore input plus an explicit resume id proves bree owns this
# launch, so a transient socket miss cannot permanently strip its hooks.
# An unmarked resume from a detached shell/tmux keeps
# the bounded ownership probe and preserves native behavior when its inherited
# bree environment is stale.
bree_claude_resume_sid="$(extract_claude_resume_session_id "$@")"
bree_claude_app_restore_owned=0
if [[ "$bree_claude_resume_sid" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ \
      && "$bree_claude_app_restore_launch" == "claude:$bree_claude_resume_sid" ]]; then
    bree_claude_app_restore_owned=1
fi
# Start the settings generator now so it overlaps the ping. This is only a
# head start: hook injection collects it later and starts it then if it was
# skipped here. Skip it where hooks are clearly not coming: re-entry forwards
# argv unchanged, a missing socket file passes through before any ping, and
# `--version`/`--help` or a known subcommand as the first argument pass through.
unset bree_claude_hook_bree_bin
bree_claude_hook_bree_bin=""
if (( bree_claude_wrapper_reexec_hops == 0 )) &&
   ! claude_passthrough_option_flag "${1:-}" &&
   ! claude_builtin_command_name "${1:-}" &&
   [[ "$bree_claude_app_restore_owned" == "1" ||
      ( -n "${BREE_SOCKET_PATH:-}" && -S "${BREE_SOCKET_PATH:-}" ) ]]; then
    bree_claude_hook_bree_bin="$(resolve_hook_bree_bin)"
    bree_claude_start_hook_settings "$bree_claude_hook_bree_bin" || true
fi
if [[ "$bree_claude_app_restore_owned" != "1" ]] \
      && ! bree_socket_available; then
    clear_inherited_claude_session_identity_env
    clear_inherited_claude_auth_selection_env
    reconcile_claude_config_dir_for_resume "$bree_claude_resume_sid"
    exec_real_claude_passthrough "$@"
fi

if (( bree_claude_wrapper_reexec_hops > 0 )); then
    # A previous wrapper pass already made the bree launch decision and may have
    # injected --session-id/--settings. While resolving a finite shim chain,
    # refresh per-process hook metadata, then forward argv unchanged so hooks are
    # not merged again on re-entry.
    unset CLAUDECODE
    clear_inherited_claude_auth_selection_env
    export BREE_CLAUDE_PID=$$
    export BREE_CLAUDE_HOOK_BREE_BIN="$(resolve_hook_bree_bin)"
    if [[ "$bree_claude_teams_wrapper_launch" != "1" ]]; then
        # Do not carry a pre-file-handoff launch capture from an older wrapper
        # pass; it may contain the oversized inline settings payload we are
        # replacing here.
        unset BREE_AGENT_LAUNCH_ARGV_B64
        export BREE_AGENT_LAUNCH_KIND="claude"
        export BREE_AGENT_LAUNCH_EXECUTABLE="$REAL_CLAUDE"
        export BREE_AGENT_LAUNCH_CWD="$PWD"
    fi
    install_bree_node_options "$REAL_CLAUDE"
    bree_claude_wrapper_exec_resolved_claude "$REAL_CLAUDE" "$@"
fi

# Only inject hooks for Claude session entrypoints. Command-like invocations
# pass through so Claude subcommands do not receive session/hook flags.
if ! should_inject_claude_hooks "$@"; then
    clear_inherited_claude_auth_selection_env
    exec_real_claude_passthrough "$@"
fi

# Unset CLAUDECODE to avoid "nested session" detection — bree terminals are
# independent sessions even when the parent shell was launched from Claude Code.
clear_inherited_claude_session_identity_env
clear_inherited_claude_auth_selection_env

# Check if the user already specified a session/resume flag.
# If so, don't inject our own --session-id (it would conflict).
SKIP_SESSION_ID=false
if claude_explicit_session_flag_present "$@"; then
    SKIP_SESSION_ID=true
fi

# For an explicit `--resume <id>`, point CLAUDE_CONFIG_DIR at the config root that
# actually holds the transcript so an inherited/foreign config dir cannot turn the
# resume into "No conversation found". https://github.com/ecyx00/bree/issues/6194
reconcile_claude_config_dir_for_resume "$bree_claude_resume_sid"
if [[ -n "$bree_claude_resume_sid" ]]; then
    export BREE_AGENT_RESUME_LAUNCH=1
else
    unset BREE_AGENT_RESUME_LAUNCH
fi

# Export the wrapper's PID. Because we exec claude below, this PID becomes
# the actual claude process PID, which hooks use for stale-session detection.
export BREE_CLAUDE_PID=$$
# Headless (`-p`/`--print`) runs share the pane's surface with any interactive
# session there, so the agent message hooks skip them.
export BREE_CLAUDE_HEADLESS=0
bree_claude_skip_next=false
for bree_claude_arg in "$@"; do
    if [[ "$bree_claude_skip_next" == true ]]; then
        bree_claude_skip_next=false
        continue
    fi
    case "$bree_claude_arg" in
        --) break ;;
        -p|--print|--print=*) export BREE_CLAUDE_HEADLESS=1; break ;;
        -*)
            if [[ "$bree_claude_arg" != *=* ]] && claude_option_consumes_value "$bree_claude_arg"; then
                bree_claude_skip_next=true
            fi
            ;;
    esac
done
unset bree_claude_arg bree_claude_skip_next
# A parent session's hook spool belongs to that session; this launch starts its own below.
unset BREE_CLAUDE_HOOK_SPOOL_DIR
if [[ -z "$bree_claude_hook_bree_bin" ]]; then
    bree_claude_hook_bree_bin="$(resolve_hook_bree_bin)"
fi
export BREE_CLAUDE_HOOK_BREE_BIN="$bree_claude_hook_bree_bin"

# Prints the routed launcher's private `--settings` file when the argv carries
# one that still exists.
claude_launch_subrouter_private_settings_path() {
    local argument value expects_value=0
    for argument in "$@"; do
        [[ "$argument" == "--" ]] && break
        value=""
        if (( expects_value )); then
            value="$argument"
            expects_value=0
        else
            case "$argument" in
                --settings) expects_value=1; continue ;;
                --settings=*) value="${argument#--settings=}" ;;
                *) continue ;;
            esac
        fi
        case "$value" in
            */subrouter-claude-settings-*/settings.json)
                if [[ -f "$value" ]]; then
                    printf '%s\n' "$value"
                    return 0
                fi
                ;;
        esac
    done
    return 1
}

bind_subrouter_claude_resume_marker() {
    unset BREE_AGENT_LAUNCH_SUBROUTER_CLAUDE_RESUME_COMMAND
    case "${SUBROUTER_CLAUDE_RESUME_COMMAND:-}" in
        "sr claude proxy --resume"|"subrouter claude proxy --resume") ;;
        *) return 0 ;;
    esac
    claude_launch_subrouter_private_settings_path "$@" >/dev/null || return 0
    export BREE_AGENT_LAUNCH_SUBROUTER_CLAUDE_RESUME_COMMAND="$SUBROUTER_CLAUDE_RESUME_COMMAND"
}

# Records the account a routed launch was pinned to, so a restore keeps it.
# The pin is read from the routing headers the launcher wrote into its private
# settings file for this launch (the file is gone once the launcher exits), so
# it holds however the launcher was invoked or what it appended to the argv it
# forwarded. A pooled launch has no pin header and records nothing.
bind_routed_claude_account() {
    unset BREE_AGENT_LAUNCH_ROUTED_CLAUDE_ACCOUNT
    local settings_path account
    settings_path="$(claude_launch_subrouter_private_settings_path "$@")" || return 0
    # The headers are one JSON string whose lines are joined by an escaped
    # newline, so the id ends at `\n` or at the closing quote. An id with any
    # other character is left unrecorded rather than cut short.
    account="$(LC_ALL=C sed -nE 's/.*X-Subrouter-Account-ID: ([A-Za-z0-9._@+:=-]+)(\\n|").*/\1/p' "$settings_path" 2>/dev/null | head -n 1)"
    [[ -n "$account" && "$account" != -* && ${#account} -le 256 ]] || return 0
    export BREE_AGENT_LAUNCH_ROUTED_CLAUDE_ACCOUNT="$account"
}

if [[ "$bree_claude_teams_wrapper_launch" != "1" ]]; then
    export BREE_AGENT_LAUNCH_KIND="claude"
    export BREE_AGENT_LAUNCH_EXECUTABLE="$REAL_CLAUDE"
    export BREE_AGENT_LAUNCH_CWD="$PWD"
    bind_subrouter_claude_resume_marker "$@"
    bind_routed_claude_account "$@"
fi
install_bree_node_options "$REAL_CLAUDE"

# Build Claude settings JSON. The bundled CLI owns the lifecycle-hook delivery
# contract so Claude and the installed agent integrations cannot drift. A
# missing/older CLI or malformed output falls back atomically to decision hooks
# only. Lifecycle telemetry is omitted in degraded mode so it cannot reintroduce
# a blocking socket round-trip or disable Claude's native notifications.
bree_claude_plutil_raw() {
    local value="$1"
    local keypath="$2"
    local expected_type="$3"
    printf '%s' "$value" \
        | /usr/bin/plutil -extract "$keypath" raw -expect "$expected_type" -o - -- - 2>/dev/null
}

bree_claude_plutil_has_command() {
    local value="$1"
    local event="$2"
    local needle="$3"
    local required_matcher="$4"
    local require_sync="$5"
    local group_count group_index hook_count hook_index matcher command async_value

    group_count="$(bree_claude_plutil_raw "$value" "hooks.$event" array)" || return 1
    [[ "$group_count" =~ ^[0-9]+$ ]] || return 1
    group_index=0
    while (( group_index < group_count )); do
        if [[ -n "$required_matcher" ]]; then
            matcher="$(bree_claude_plutil_raw "$value" "hooks.$event.$group_index.matcher" string)" \
                || {
                    group_index=$((group_index + 1))
                    continue
                }
            if [[ "$matcher" != "$required_matcher" ]]; then
                group_index=$((group_index + 1))
                continue
            fi
        fi

        hook_count="$(bree_claude_plutil_raw "$value" "hooks.$event.$group_index.hooks" array)" \
            || {
                group_index=$((group_index + 1))
                continue
            }
        [[ "$hook_count" =~ ^[0-9]+$ ]] || return 1
        hook_index=0
        while (( hook_index < hook_count )); do
            command="$(bree_claude_plutil_raw "$value" "hooks.$event.$group_index.hooks.$hook_index.command" string)" \
                || {
                    hook_index=$((hook_index + 1))
                    continue
                }
            if [[ "$command" == *"$needle"* ]]; then
                if [[ "$require_sync" != "1" ]]; then
                    return 0
                fi
                async_value="$(
                    bree_claude_plutil_raw \
                        "$value" \
                        "hooks.$event.$group_index.hooks.$hook_index.async" \
                        bool \
                        || true
                )"
                if [[ "$async_value" != "true" ]]; then
                    return 0
                fi
            fi
            hook_index=$((hook_index + 1))
        done
        group_index=$((group_index + 1))
    done
    return 1
}

bree_claude_plutil_hook_settings_are_safe() {
    local value="$1"
    local preferred_channel event subcommand

    bree_claude_plutil_has_command \
        "$value" "PreToolUse" "hooks claude cron-create-guard" "CronCreate" 1 \
        || return 1
    bree_claude_plutil_has_command \
        "$value" "PermissionRequest" "hooks feed --source claude" "" 1 \
        || return 1

    preferred_channel="$(
        bree_claude_plutil_raw "$value" preferredNotifChannel string || true
    )"
    if [[ "$preferred_channel" == "notifications_disabled" ]]; then
        while read -r event subcommand; do
            bree_claude_plutil_has_command \
                "$value" "$event" "hooks enqueue claude $subcommand" "" 0 \
                || return 1
        done <<'BREE_CLAUDE_LIFECYCLE_HOOKS'
SessionStart session-start
Stop stop
SessionEnd session-end
Notification notification
UserPromptSubmit prompt-submit
BREE_CLAUDE_LIFECYCLE_HOOKS
    fi
    return 0
}

# Sets bree_claude_standard_hook_settings_value to the exact bytes the bundled
# CLI prints for `bree hooks claude inject-settings`
# (CLI/BREECLI+ClaudeHookSettings.swift: JSONSerialization with sorted keys
# and unescaped slashes). The text is fixed: it does not depend on the
# environment, the socket, or user settings.
bree_claude_build_standard_hook_settings() {
    local queued direct_cli
    # JSON-escaped body of AgentHookSpoolProducer(agent: "claude").command(...)
    # wrapping BREECLI.queuedAgentHookShellCommand(agent: "claude") as its fallback.
    IFS= read -r queued <<'BREE_CLAUDE_QUEUED_HOOK_COMMAND'
if [ -n \"${BREE_CLAUDE_HOOK_SPOOL_DIR:-}\" ] && [ -x /bin/zsh ]; then exec /bin/zsh -fc 'LC_ALL=C\nexport BREE_CLAUDE_PID=${BREE_CLAUDE_PID:-$PPID}\nbree_fallback() { { print -rn -- \"$bree_p\"; /bin/cat; } | /bin/sh -c \"$1\" >&3; exit $?; }\nzmodload zsh/system zsh/datetime zsh/files 2>/dev/null || exec /bin/sh -c \"$1\" >&3\nbree_p= bree_c= bree_e=0\nwhile (( ${#bree_p} < 262144 )); do sysread -i 0 -s 65536 bree_c || { bree_e=$?; break; }; bree_p+=$bree_c; done\n[[ -n ${BREE_SURFACE_ID:-} && ${BREE_CLAUDE_HOOKS_DISABLED:-} != 1 ]] || { (( bree_e == 5 )) || /bin/cat >/dev/null; print -r -- '\\''{}'\\'' >&3; exit 0; }\nbree_d=$BREE_CLAUDE_HOOK_SPOOL_DIR\n(( bree_e == 5 )) && [[ -f $bree_d/keys ]] || bree_fallback \"$1\"\nbree_r=\"bree-agent-hook-v1\"$'\\''\\n'\\''\"claude\"$'\\''\\n'\\''\"$2\"$'\\''\\n'\\''\nfor bree_k in ${(f)\"$(<$bree_d/keys)\"}; do (( ${+parameters[$bree_k]} )) && bree_r+=\"$bree_k=${(P)bree_k}\"$'\\''\\0'\\''; done\nbree_r+=$'\\''\\0'\\''\"$bree_p\"\n(( ${#bree_r} <= 524288 )) || bree_fallback \"$1\"\numask 077\nbree_n=$bree_d/$epochtime[1].$epochtime[2]-$$\n{ print -rn -- \"$bree_r\" >| $bree_n.tmp && mv -f -- $bree_n.tmp $bree_n.rec; } 2>/dev/null || { rm -f -- $bree_n.tmp 2>/dev/null; bree_fallback \"$1\"; }\nif zsystem flock -t 0 -r -f bree_l $bree_d/forwarder.lock 2>/dev/null; then\n  zsystem flock -u $bree_l\n  rm -- $bree_n.rec 2>/dev/null && bree_fallback \"$1\"\nfi\nprint -r -- '\\''{}'\\'' >&3' bree-hook 'bree_cli=\"${BREE_CLAUDE_HOOK_BREE_BIN:-${BREE_BUNDLED_CLI_PATH:-}}\"; if [ -z \"$bree_cli\" ] || [ ! -x \"$bree_cli\" ]; then bree_cli=\"$(command -v bree 2>/dev/null || true)\"; fi; agent_pid=\"${BREE_CLAUDE_PID:-${PPID:-}}\"; if [ -n \"$BREE_SURFACE_ID\" ] && [ \"$BREE_CLAUDE_HOOKS_DISABLED\" != \"1\" ] && [ -n \"$bree_cli\" ]; then if [ -n \"${BREE_SOCKET_PATH:-}\" ]; then BREE_CLAUDE_PID=\"$agent_pid\" BREE_CLI_RESPONSE_TIMEOUT_SEC=0.5 \"$bree_cli\" --socket \"$BREE_SOCKET_PATH\" hooks enqueue claude @SUBCOMMAND@ 2>/dev/null || { cat >/dev/null; echo '\\''{}'\\''; }; else BREE_CLAUDE_PID=\"$agent_pid\" BREE_CLI_RESPONSE_TIMEOUT_SEC=0.5 \"$bree_cli\" hooks enqueue claude @SUBCOMMAND@ 2>/dev/null || { cat >/dev/null; echo '\\''{}'\\''; }; fi; else cat >/dev/null; echo '\\''{}'\\''; fi' @SUBCOMMAND@ 3>&1 1>&2; else bree_cli=\"${BREE_CLAUDE_HOOK_BREE_BIN:-${BREE_BUNDLED_CLI_PATH:-}}\"; if [ -z \"$bree_cli\" ] || [ ! -x \"$bree_cli\" ]; then bree_cli=\"$(command -v bree 2>/dev/null || true)\"; fi; agent_pid=\"${BREE_CLAUDE_PID:-${PPID:-}}\"; if [ -n \"$BREE_SURFACE_ID\" ] && [ \"$BREE_CLAUDE_HOOKS_DISABLED\" != \"1\" ] && [ -n \"$bree_cli\" ]; then if [ -n \"${BREE_SOCKET_PATH:-}\" ]; then BREE_CLAUDE_PID=\"$agent_pid\" BREE_CLI_RESPONSE_TIMEOUT_SEC=0.5 \"$bree_cli\" --socket \"$BREE_SOCKET_PATH\" hooks enqueue claude @SUBCOMMAND@ 2>/dev/null || { cat >/dev/null; echo '{}'; }; else BREE_CLAUDE_PID=\"$agent_pid\" BREE_CLI_RESPONSE_TIMEOUT_SEC=0.5 \"$bree_cli\" hooks enqueue claude @SUBCOMMAND@ 2>/dev/null || { cat >/dev/null; echo '{}'; }; fi; else cat >/dev/null; echo '{}'; fi; fi
BREE_CLAUDE_QUEUED_HOOK_COMMAND
    direct_cli='\"${BREE_CLAUDE_HOOK_BREE_BIN:-bree}\"'

    local q_prefix='{"hooks":[{"command":"' q_suffix='","timeout":5,"type":"command"}],"matcher":"'
    local notification="${queued//@SUBCOMMAND@/notification}"
    local push_notification="${queued//@SUBCOMMAND@/push-notification}"
    local pre_tool_use="${queued//@SUBCOMMAND@/pre-tool-use}"
    local session_end="${queued//@SUBCOMMAND@/session-end}"
    local session_start="${queued//@SUBCOMMAND@/session-start}"
    local stop="${queued//@SUBCOMMAND@/stop}"
    local feed="${queued//@SUBCOMMAND@/feed}"
    local prompt_submit="${queued//@SUBCOMMAND@/prompt-submit}"
    # Background agent-message wait hook (asyncRewake), on SessionStart and Stop.
    local inbox_wait='{"hooks":[{"async":true,"asyncRewake":true,"command":"'"$direct_cli"' hooks claude inbox-wait","timeout":86400,"type":"command"}],"matcher":""}'

    bree_claude_standard_hook_settings_value='{"hooks":{'
    bree_claude_standard_hook_settings_value+='"Notification":['"$q_prefix$notification$q_suffix"'"}],'
    bree_claude_standard_hook_settings_value+='"PermissionRequest":[{"hooks":[{"command":"'"$direct_cli"' hooks feed --source claude","timeout":125,"type":"command"}],"matcher":""}],'
    bree_claude_standard_hook_settings_value+='"PostToolUse":['"$q_prefix$push_notification$q_suffix"'PushNotification"}],'
    bree_claude_standard_hook_settings_value+='"PreToolUse":[{"hooks":[{"command":"'"$direct_cli"' hooks claude cron-create-guard","timeout":5,"type":"command"}],"matcher":"CronCreate"},'"$q_prefix$pre_tool_use$q_suffix"'"}],'
    bree_claude_standard_hook_settings_value+='"SessionEnd":['"$q_prefix$session_end$q_suffix"'"}],'
    bree_claude_standard_hook_settings_value+='"SessionStart":['"$q_prefix$session_start$q_suffix"'"},'"$inbox_wait"'],'
    bree_claude_standard_hook_settings_value+='"Stop":['"$q_prefix$stop$q_suffix"'"},'"$q_prefix$feed$q_suffix"'"},{"hooks":[{"async":true,"command":"'"$direct_cli"' hooks claude auto-name","timeout":120,"type":"command"}],"matcher":""},'"$inbox_wait"'],'
    bree_claude_standard_hook_settings_value+='"StopFailure":['"$q_prefix$stop$q_suffix"'"},'"$inbox_wait"'],'
    bree_claude_standard_hook_settings_value+='"SubagentStop":['"$q_prefix$feed$q_suffix"'"}],'
    bree_claude_standard_hook_settings_value+='"UserPromptSubmit":['"$q_prefix$prompt_submit$q_suffix"'"},{"hooks":[{"command":"'"$direct_cli"' hooks claude inbox-drain 2>/dev/null || echo '"'"'{}'"'"'","timeout":5,"type":"command"}],"matcher":""}]'
    bree_claude_standard_hook_settings_value+='},"preferredNotifChannel":"notifications_disabled"}'
}

# Fast path for the Node check below. It accepts one exact string: the
# bundled CLI's standard document, which satisfies every Node requirement
# (valid JSON object; synchronous cron-create-guard under the CronCreate
# matcher; synchronous PermissionRequest feed; all five lifecycle hooks since
# it sets notifications_disabled). Any other byte sequence, including a
# different CLI version's output, returns 1 and takes the Node path unchanged.
bree_claude_generated_hook_settings_are_standard() {
    local value="$1"
    local bree_claude_standard_hook_settings_value=""
    bree_claude_build_standard_hook_settings
    [[ -n "$bree_claude_standard_hook_settings_value" &&
          "$value" == "$bree_claude_standard_hook_settings_value" ]]
}

bree_claude_generated_hook_settings_are_safe() {
    local value="$1"
    (( ${#value} > 0 && ${#value} <= 1048576 )) || return 1
    [[ "$value" =~ ^[[:space:]]*\{ ]] || return 1

    bree_claude_generated_hook_settings_are_standard "$value" && return 0

    if command -v node >/dev/null 2>&1; then
        printf '%s' "$value" | node -e '
const fs=require("fs");
try {
  const x=JSON.parse(fs.readFileSync(0,"utf8"));
  if(!x||Array.isArray(x)||typeof x!=="object")process.exit(1);
  const hooks=x.hooks;
  if(!hooks||Array.isArray(hooks)||typeof hooks!=="object")process.exit(1);
  const commands=(event,matcher)=>{
    const groups=hooks[event];
    if(!Array.isArray(groups))return [];
    return groups.flatMap(group=>{
      if(!group||typeof group!=="object")return [];
      if(matcher!==undefined&&group.matcher!==matcher)return [];
      return Array.isArray(group.hooks)?group.hooks:[];
    });
  };
  const hasSyncCommand=(event,needle,matcher)=>commands(event,matcher).some(hook=>
    hook&&typeof hook==="object"&&typeof hook.command==="string"&&
    hook.command.includes(needle)&&hook.async!==true
  );
  if(!hasSyncCommand("PreToolUse","hooks claude cron-create-guard","CronCreate"))process.exit(1);
  if(!hasSyncCommand("PermissionRequest","hooks feed --source claude"))process.exit(1);
  if(x.preferredNotifChannel==="notifications_disabled"){
    const lifecycle=[
      ["SessionStart","session-start"],
      ["Stop","stop"],
      ["SessionEnd","session-end"],
      ["Notification","notification"],
      ["UserPromptSubmit","prompt-submit"],
    ];
    if(!lifecycle.every(([event,subcommand])=>
      commands(event).some(hook=>
        hook&&typeof hook==="object"&&typeof hook.command==="string"&&
        hook.command.includes(`hooks enqueue claude ${subcommand}`)
      )
    ))process.exit(1);
  }
}
catch (_) { process.exit(1); }
' >/dev/null 2>&1
        return $?
    fi
    if [[ -x /usr/bin/plutil ]]; then
        bree_claude_plutil_hook_settings_are_safe "$value"
        return $?
    fi
    return 1
}

# Claude Code merges --settings additively with the user's own settings.json.
# Generated settings also set preferredNotifChannel to disable Claude Code's OSC/terminal notification
#   channel inside bree so hooks are the only notification source.
# - SessionStart/Stop/Notification: existing lifecycle hooks
# - StopFailure: a turn that died on an API error (usage limit, dropped
#   connection) shows the error instead of staying "Running"
# - SessionEnd: cleanup when Claude exits (covers Ctrl+C where Stop doesn't fire)
# - UserPromptSubmit: clears "Needs input" and sets "Running" on new prompt
# - PreToolUse: rejects unsupported durable cron requests synchronously, then
#   (async) clears "Needs input" / sets "Running" for ordinary tools, and flags
#   "Needs input" for the blocking AskUserQuestion / ExitPlanMode tools. With
#   --dangerously-skip-permissions (permission_mode "bypassPermissions") Claude
#   fires no PermissionRequest/Notification for those two, so the handler also
#   publishes the full needs-input status + bell itself. See
#   https://github.com/ecyx00/bree/issues/6606
# - PostToolUse (PushNotification): bridges Claude's PushNotification tool
#   into a bree notification. The tool delivers via a raw OSC desktop
#   notification, which bree suppresses for surfaces running a hook-integrated
#   agent, and it never fires the Notification hook — so this PostToolUse
#   bridge is the only way its message reaches the user inside bree. ASYNC;
#   the handler mirrors the tool's own sent/skipped decision via
#   tool_response.localSent.
# - PermissionRequest: bree hooks feed. SYNC with a 125s timeout.
#   This is Claude Code's native blocking decision hook. Outside
#   bypassPermissions it covers permissions, ExitPlanMode, and AskUserQuestion
#   without using PreToolUse denial as a side channel; under bypassPermissions it
#   does not fire, and PreToolUse is the needs-input fallback (see above).
# - SubagentStop: feed telemetry only. It must not run the visible Stop
#   hook because a subagent finishing should not notify like the parent.
# - Stop auto-name: opt-in AI workspace/tab naming. ASYNC with a long
#   timeout because it may run a summarization subprocess; it gates itself
#   on the workspaceAutoNaming setting via a socket probe, so it is a
#   no-op when the feature is disabled.
HOOKS_JSON='{"hooks":{"PreToolUse":[{"matcher":"CronCreate","hooks":[{"type":"command","command":"\"${BREE_CLAUDE_HOOK_BREE_BIN:-bree}\" hooks claude cron-create-guard","timeout":5}]}],"PermissionRequest":[{"matcher":"","hooks":[{"type":"command","command":"\"${BREE_CLAUDE_HOOK_BREE_BIN:-bree}\" hooks feed --source claude","timeout":125}]}]}}'
if bree_claude_collect_hook_settings "$BREE_CLAUDE_HOOK_BREE_BIN" \
    && bree_claude_generated_hook_settings_are_safe "$bree_claude_hook_settings_value"; then
    HOOKS_JSON="$bree_claude_hook_settings_value"
fi
unset bree_claude_hook_settings_value

# Fold any user-provided --settings into HOOKS_JSON before launching.
#
# bree injects its hook configuration via --settings. Passing it as a separate
# flag alongside a user's own --settings is fragile: with two --settings on the
# command line Claude Code reads only ONE of them (a pure replace, not a merge),
# and which one is undocumented and has already changed across CLI versions --
# first-wins on <=2.1.168 (the user's flag was dropped: the original #2816
# symptom), last-wins on >=2.1.169 (the user's flag wins but bree's hook
# --settings is dropped, silently breaking bree notifications/status). Either
# way one side is lost. Deep-merge the user's settings into ours, write the
# combined document to a private temporary file, and pass one path-valued
# --settings flag. Hook arrays from a genuine user document are retained, while
# bree's marked block is replaced on re-entry. This is precedence-agnostic -- it
# does not rely on the CLI's multi-flag behavior. Requires `node`; if node is
# missing or the merge fails, preserve the user's original settings and disable
# bree hooks for that launch rather than passing an ambiguous pair of flags.
unset BREE_USER_SETTINGS_B64
BREE_FILTERED_ARGS=()
BREE_USER_SETTINGS=()
bree_collect_settings_value=false
bree_pending_option_value=false
bree_positional_only=false
for arg in "$@"; do
    if [[ "$bree_positional_only" == true ]]; then
        BREE_FILTERED_ARGS+=("$arg")
        continue
    fi
    if [[ "$bree_collect_settings_value" == true ]]; then
        BREE_USER_SETTINGS+=("$arg")
        bree_collect_settings_value=false
        continue
    fi
    if [[ "$bree_pending_option_value" == true ]]; then
        BREE_FILTERED_ARGS+=("$arg")
        bree_pending_option_value=false
        continue
    fi
    if [[ "$arg" == "--" ]]; then
        bree_positional_only=true
        BREE_FILTERED_ARGS+=("$arg")
    elif [[ "$arg" == "--settings" ]]; then
        # The fixed-width prefix checks above avoid a wildcard match against a
        # potentially very large JSON value.
        bree_collect_settings_value=true
    elif [[ "${arg:0:11}" == "--settings=" ]]; then
        BREE_USER_SETTINGS+=("${arg#--settings=}")
    elif [[ "${arg:0:1}" == "-" ]]; then
        BREE_FILTERED_ARGS+=("$arg")
        if [[ "${arg%%=*}" == "$arg" ]] && claude_option_consumes_value "$arg"; then
            bree_pending_option_value=true
        fi
    else
        BREE_FILTERED_ARGS+=("$arg")
    fi
done
if [[ "$bree_collect_settings_value" == true ]]; then
    # Dangling --settings with no value; keep it so the real CLI reports the error.
    BREE_FILTERED_ARGS+=("--settings")
fi

BREE_SETTINGS_PATH=""
BREE_SETTINGS_BASE_PATH=""
BREE_SETTINGS_INPUTS_PATH=""
BREE_MERGED_SETTINGS_PATH=""
BREE_SETTINGS_MERGE_SUCCEEDED=false

# The settings artifact is file-backed so re-entry carries a bounded identity
# instead of copying an ever-growing JSON value through argv and the environment.
if BREE_SETTINGS_BASE_PATH="$(bree_claude_wrapper_create_settings_file "$HOOKS_JSON")"; then
    BREE_SETTINGS_PATH="$BREE_SETTINGS_BASE_PATH"
else
    printf 'Bree: warning: unable to create hook settings file; hooks were not injected\n' >&2
fi

if (( ${#BREE_USER_SETTINGS[@]} > 0 )) && [[ -n "$BREE_SETTINGS_BASE_PATH" ]] && command -v node >/dev/null 2>&1; then
    if BREE_SETTINGS_INPUTS_PATH="$(bree_claude_wrapper_create_settings_values_file "${BREE_USER_SETTINGS[@]}")" &&
       BREE_MERGED_SETTINGS_PATH="$(bree_claude_wrapper_create_settings_file "")"; then
        BREE_BASE_SETTINGS_PATH="$BREE_SETTINGS_BASE_PATH" \
        BREE_USER_SETTINGS_PATH="$BREE_SETTINGS_INPUTS_PATH" \
        BREE_MERGED_SETTINGS_PATH="$BREE_MERGED_SETTINGS_PATH" \
        node -e '
const fs=require("fs"),os=require("os"),path=require("path");
const isObj=x=>x&&typeof x==="object"&&!Array.isArray(x);
const clone=x=>JSON.parse(JSON.stringify(x));
const canonical=x=>JSON.stringify(x,(key,value)=>{
  if(!isObj(value)) return value;
  return Object.keys(value).sort().reduce((out,k)=>{out[k]=value[k];return out;},{});
});
const marker=x=>isObj(x)&&isObj(x.__bree)&&x.__bree.managed==="claude-hooks";
const expand=p=>p.indexOf("~/")===0?path.join(os.homedir(),p.slice(2)):p;
const load=value=>{
  const text=String(value).trim();
  if(text==="") throw new Error("empty --settings value");
  return (text[0]==="{"||text[0]==="[")?JSON.parse(text):JSON.parse(fs.readFileSync(expand(text),"utf8"));
};
const merge=(a,b)=>{
  if(Array.isArray(a)&&Array.isArray(b)) return a.concat(b);
  if(isObj(a)&&isObj(b)){
    const out=Object.assign({},a);
    for(const key of Object.keys(b)) out[key]=(key in a)?merge(a[key],b[key]):clone(b[key]);
    return out;
  }
  if(isObj(a)||Array.isArray(a)) return a;
  return b;
};
const stripManaged=(settings,base,hasMarker)=>{
  if(!isObj(settings)||!isObj(settings.hooks)) return settings;
  const out=clone(settings);
  const fingerprints=new Set(
    hasMarker&&isObj(settings.__bree)&&Array.isArray(settings.__bree.hookFingerprints)
      ? settings.__bree.hookFingerprints
      : []
  );
  for(const event of Object.keys(out.hooks)){
    const values=out.hooks[event];
    if(!Array.isArray(values)) continue;
    const baseValues=isObj(base.hooks)&&Array.isArray(base.hooks[event])?base.hooks[event]:[];
    out.hooks[event]=values.filter(value=>{
      if(baseValues.some(baseValue=>canonical(baseValue)===canonical(value))) return false;
      return !fingerprints.has(canonical(value));
    });
  }
  return out;
};
const base=load(process.env.BREE_BASE_SETTINGS_PATH);
const raw=fs.readFileSync(process.env.BREE_USER_SETTINGS_PATH,"utf8");
const values=raw.split("\0").slice(0,-1);
let acc=clone(base);
try{
  for(const value of values.reverse()){
    const loaded=load(value);
    const hasBaseHook=()=>isObj(loaded)&&isObj(loaded.hooks)&&Object.keys(loaded.hooks).some(event=>{
      const values=loaded.hooks[event];
      const baseValues=isObj(base.hooks)&&Array.isArray(base.hooks[event])?base.hooks[event]:[];
      return Array.isArray(values)&&values.some(value=>baseValues.some(baseValue=>canonical(baseValue)===canonical(value)));
    });
    const managed=marker(loaded)||hasBaseHook();
    acc=merge(acc,managed?stripManaged(loaded,base,marker(loaded)):loaded);
  }
}catch(error){
  process.stderr.write("Bree: settings merge failed; using user settings unchanged\n");
  process.exit(1);
}
const baseMarker=clone(base.__bree||{managed:"claude-hooks",version:1});
const hookFingerprints=[];
for(const event of Object.keys(base.hooks||{})){
  const groups=Array.isArray(base.hooks[event])?base.hooks[event]:[];
  for(const group of groups) hookFingerprints.push(canonical(group));
}
baseMarker.hookFingerprints=hookFingerprints;
acc.__bree=baseMarker;
fs.writeFileSync(process.env.BREE_MERGED_SETTINGS_PATH,JSON.stringify(acc),{encoding:"utf8",mode:0o600});
'
        bree_merge_status=$?
        if [[ $bree_merge_status -eq 0 && -s "$BREE_MERGED_SETTINGS_PATH" ]]; then
            BREE_SETTINGS_PATH="$BREE_MERGED_SETTINGS_PATH"
            BREE_SETTINGS_MERGE_SUCCEEDED=true
            set -- "${BREE_FILTERED_ARGS[@]}"
        else
            rm -f -- "$BREE_MERGED_SETTINGS_PATH"
        fi
    fi
fi

if [[ "$BREE_SETTINGS_MERGE_SUCCEEDED" != true && ${#BREE_USER_SETTINGS[@]} -gt 0 ]]; then
    printf 'Bree: warning: settings merge failed; Bree hooks are disabled for this launch and your settings were preserved unchanged; install Node or correct the settings file before retrying\n' >&2
    BREE_SETTINGS_PATH=""
fi
if [[ "$BREE_SETTINGS_MERGE_SUCCEEDED" != true && -n "$BREE_MERGED_SETTINGS_PATH" ]]; then
    rm -f -- "$BREE_MERGED_SETTINGS_PATH"
fi
if [[ -n "$BREE_SETTINGS_INPUTS_PATH" ]]; then
    rm -f -- "$BREE_SETTINGS_INPUTS_PATH"
fi
if [[ -n "$BREE_SETTINGS_BASE_PATH" && "$BREE_SETTINGS_PATH" != "$BREE_SETTINGS_BASE_PATH" ]]; then
    rm -f -- "$BREE_SETTINGS_BASE_PATH"
fi
unset BREE_MERGED_SETTINGS_PATH bree_merge_status BREE_SETTINGS_INPUTS_PATH

# Capture only the compact post-merge argv. The previous implementation encoded
# the inline JSON here as a second ARG_MAX multiplier.
if [[ "$bree_claude_teams_wrapper_launch" != "1" ]]; then
    if [[ "$BREE_SETTINGS_MERGE_SUCCEEDED" == true ]]; then
        # A successful merge has replaced settings with the private file path,
        # so the filtered argv is the authoritative compact launch snapshot.
        export BREE_AGENT_LAUNCH_ARGV_B64="$(encode_launch_argv "${BREE_FILTERED_ARGS[@]}")"
    else
        # Preserve the caller's original settings in restore metadata when the
        # merge is unavailable; the argument-size guard keeps this bounded.
        export BREE_AGENT_LAUNCH_ARGV_B64="$(encode_launch_argv "$@")"
    fi
fi

# One private hook spool and forwarder per session. Queued hooks then publish
# events with zsh builtins instead of launching the bree CLI for every event;
# the forwarder admits them over one socket connection. The exec below keeps
# this PID, so the forwarder is Claude's child and exits after Claude does.
# Remote relays and settings without the spool path keep the CLI transport.
if [[ -n "$BREE_SETTINGS_PATH" && "$OSTYPE" == darwin* && -x /bin/zsh
      && "$BREE_CLAUDE_HOOKS_DISABLED" != "1"
      && -x "$BREE_CLAUDE_HOOK_BREE_BIN" && "$BREE_CLAUDE_HOOK_BREE_BIN" == /*
      && "${BREE_SOCKET_PATH:-/}" == /* && -z "${BREE_RELAY_ID:-}"
      && "$HOOKS_JSON" == *BREE_CLAUDE_HOOK_SPOOL_DIR* ]]; then
    bree_claude_hook_spool_dir="$(umask 077; mktemp -d "${TMPDIR:-/tmp}/bree-claude-hooks.XXXXXXXX" 2>/dev/null)" \
        || bree_claude_hook_spool_dir=""
    if [[ -n "$bree_claude_hook_spool_dir" ]]; then
        export BREE_CLAUDE_HOOK_SPOOL_DIR="$bree_claude_hook_spool_dir"
        # Signals for Claude's process group must not end the forwarder before
        # its final drain; it exits on its own when Claude exits.
        ( trap '' HUP INT QUIT TERM; exec "$BREE_CLAUDE_HOOK_BREE_BIN" hooks claude spool-forwarder ) \
            </dev/null >/dev/null 2>&1 &
    fi
    unset bree_claude_hook_spool_dir
fi

if [[ "$SKIP_SESSION_ID" == true ]]; then
    if [[ -n "$BREE_SETTINGS_PATH" ]]; then
        bree_claude_wrapper_exec_resolved_claude "$REAL_CLAUDE" --settings "$BREE_SETTINGS_PATH" "$@"
    else
        bree_claude_wrapper_exec_resolved_claude "$REAL_CLAUDE" "$@"
    fi
else
    SESSION_ID="$(uuidgen | tr '[:upper:]' '[:lower:]')"
    if [[ -n "$BREE_SETTINGS_PATH" ]]; then
        bree_claude_wrapper_exec_resolved_claude "$REAL_CLAUDE" --session-id "$SESSION_ID" --settings "$BREE_SETTINGS_PATH" "$@"
    else
        bree_claude_wrapper_exec_resolved_claude "$REAL_CLAUDE" --session-id "$SESSION_ID" "$@"
    fi
fi
